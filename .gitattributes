*.sh text eol=lf
# Unified diff context uses a single space for empty source lines. The build
# additionally runs git apply --whitespace=error-all on the patched Rust.
engine/patches/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Fixture byte hashes must survive Windows checkout without newline conversion.
fixtures/rag-evaluation/** -text
scripts/generate-rag-corpus.mjs text eol=lf
scripts/verify-rag-corpus.mjs text eol=lf
# Preserve storage validation artifacts byte-for-byte, including raw runner output.
docs/evidence/state-storage-2026-10-16/** -text whitespace=cr-at-eol
# Node TAP includes an empty-string fixture in the subtest name (trailing space).
docs/evidence/state-storage-2026-10-16/unit-tests.txt whitespace=cr-at-eol,-blank-at-eol

# Keep raw recovery-integrity evidence identical to the verified artifacts.
docs/evidence/recovery-integrity-2026-10-16/** -text whitespace=cr-at-eol
docs/evidence/recovery-integrity-2026-10-16/unit-tests.txt whitespace=cr-at-eol,-blank-at-eol

# Preserve final file-storage test logs and byte hashes across checkout.
docs/evidence/file-preservation-2026-10-17/** -text whitespace=cr-at-eol
docs/evidence/file-preservation-2026-10-17/unit-tests.txt whitespace=cr-at-eol,-blank-at-eol

# Independent Hancom pairs and follow-up reports carry byte-level provenance.
docs/evidence/file-completion-2026-10-17/** -text whitespace=cr-at-eol
# Raw accessibility includes intentionally empty text elements with a trailing space.
docs/evidence/file-completion-2026-10-17/native/actual-picker/*accessibility.txt whitespace=cr-at-eol,-blank-at-eol

# Preserve independently saved typography controls and byte-level provenance.
docs/evidence/typeset-controls-2026-10-17/** -text whitespace=cr-at-eol
# Rust's raw test runner output intentionally ends with an empty line.
docs/evidence/file-completion-2026-10-17/engine56/rust-g069.log whitespace=cr-at-eol,-blank-at-eof
docs/evidence/file-completion-2026-10-17/textbox42-heading43/rust-six.log whitespace=cr-at-eol,-blank-at-eof
docs/evidence/file-completion-2026-10-17/engine63/unit839.tap.log whitespace=cr-at-eol,-blank-at-eol
