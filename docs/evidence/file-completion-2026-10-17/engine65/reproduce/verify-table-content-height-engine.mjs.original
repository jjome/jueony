import assert from 'node:assert/strict';
import{readFile,writeFile,mkdir}from'node:fs/promises';
import{resolve,isAbsolute}from'node:path';import{pathToFileURL}from'node:url';import{createHash}from'node:crypto';
import{capturePreservationEvidence,verifyPreservedExport}from'../src/adapters/rhwp/preservation.ts';
import{planSaveTableFrames,applySaveTableFrames}from'../src/adapters/rhwp/save-table-frames.ts';
import{snapshot,differences}from'./lib/hancom-review.mjs';
for(const key of['JUEONY_ENGINE_PACKAGE','JUEONY_TABLE_HEIGHT_CONTROLS','JUEONY_TEST_OUTPUT'])assert.ok(isAbsolute(process.env[key]??''),key+' requires absolute path');
const pkg=resolve(process.env.JUEONY_ENGINE_PACKAGE),input=resolve(process.env.JUEONY_TABLE_HEIGHT_CONTROLS),out=resolve(process.env.JUEONY_TEST_OUTPUT),j=JSON.parse,sha=x=>createHash('sha256').update(x).digest('hex');await mkdir(out,{recursive:true});
const engine=j(await readFile(pkg+'/jueony-engine-build.json','utf8'));for(const[n,k]of[['rhwp.js','jsSha256'],['rhwp_bg.wasm','wasmSha256']])assert.equal(sha(await readFile(pkg+'/'+n)),engine[k]);const m=await import(pathToFileURL(pkg+'/rhwp.js'));await m.default({module_or_path:await readFile(pkg+'/rhwp_bg.wasm')});
const{HwpDocument}=m,results=[],failures=[],observations=[];async function fixture(name){return new HwpDocument(await readFile(input+'/'+name+'.hwpx'));}const plan=d=>j(d.getTableContentHeightPlan(0,1,0)),apply=(d,p)=>j(d.applyTableContentHeightPlan(0,1,0,p.beforeHeight,p.afterHeight));
async function scenario(name,run){try{await run();results.push(name);console.log('PASS',name);}catch(e){failures.push({name,error:String(e),stack:e.stack});console.error('FAIL',name,e.message??String(e));}}
for(const[name,before,after,rows,reference]of[['auto-zero',0,5181,[2417,1482,1282],'auto-zero-hancom'],['large',9000,5181,[2417,1482,1282],'large-hancom'],['large-hancom',5181,5181,[2417,1482,1282],'large-hancom'],['explicit-rows-9000',9000,9000,[3000,3000,3000],'explicit-rows-9000-hancom']])await scenario(name+': explicit height command matches independent Hancom, strict both-format repeat save and exact undo',async()=>{
 const d=await fixture(name),golden=await fixture(reference);try{const initial=d.exportHwp(),events=d.getEventLog(),source=capturePreservationEvidence(d),p=plan(d);assert.equal(p.contract,'plain-unprotected-content-frame-v1');assert.equal(p.beforeHeight,before);assert.equal(p.afterHeight,after);assert.deepEqual(p.rowHeightsHu,rows);assert.deepEqual(d.exportHwp(),initial);assert.equal(d.getEventLog(),events);assert.deepEqual(capturePreservationEvidence(d),source);
 const token=d.saveSnapshot(),reply=apply(d,p);assert.equal(reply.changed,before!==after);const live=snapshot(d),oracle=snapshot(golden),semantic=differences(live.semantic.values,oracle.semantic.values,0),geometry=differences(live.layout,oracle.layout,0.2);assert.deepEqual(semantic,[],'all semantic fields including commonHeight and real cell minima match independent Hancom');assert.deepEqual(geometry,[],'every published geometry field matches independent Hancom within unchanged0.2');assert.equal(live.pages,oracle.pages);
 for(const format of['hwp','hwpx']){const a=format==='hwp'?d.exportHwpWithReport():d.exportHwpxWithReport();try{const bytes=a.takeBytes();verifyPreservedExport(d,bytes,format,j(a.contentLoss()),b=>new HwpDocument(b));const reopened=new HwpDocument(bytes);try{const r=snapshot(reopened);assert.deepEqual(differences(live.semantic.values,r.semantic.values,0),[]);assert.deepEqual(differences(live.layout,r.layout,0.2),[]);const again=format==='hwp'?reopened.exportHwpWithReport():reopened.exportHwpxWithReport();try{const repeated=again.takeBytes();verifyPreservedExport(reopened,repeated,format,j(again.contentLoss()),b=>new HwpDocument(b));const twice=new HwpDocument(repeated);try{assert.deepEqual(differences(live.semantic.values,snapshot(twice).semantic.values,0),[]);assert.deepEqual(differences(live.layout,snapshot(twice).layout,0.2),[]);}finally{twice.free();}}finally{again.free();}await writeFile(out+'/'+name+'.'+format,bytes);observations.push({name,format,sha256:sha(bytes),independentHancom:reference,referenceSha256:sha(await readFile(input+'/'+reference+'.hwpx')),before,after,rows,semanticDifferences:semantic.length,geometryDifferences:geometry.length});}finally{reopened.free();}}finally{a.free();}}
 const noop=plan(d),sameBytes=d.exportHwp(),sameEvents=d.getEventLog();assert.equal(apply(d,noop).changed,false);assert.deepEqual(d.exportHwp(),sameBytes);assert.equal(d.getEventLog(),sameEvents);d.restoreSnapshot(token);d.discardSnapshot(token);assert.deepEqual(d.exportHwp(),initial);
 }finally{d.free();golden.free();}
});
async function rejected(name,alter){const d=await fixture(name);try{alter?.(d);const bytes=d.exportHwp(),events=d.getEventLog();assert.throws(()=>plan(d));assert.throws(()=>d.applyTableContentHeightPlan(0,1,0,0,5181));assert.deepEqual(d.exportHwp(),bytes);assert.equal(d.getEventLog(),events);}finally{d.free();}}
for(const name of['small-protected','large-protected'])await scenario(name+': protection is rejected without normalizing its clipped frame',()=>rejected(name));
for(const[name,alter]of[['cell-protect',d=>d.setCellProperties(0,1,0,0,'{"cellProtect":true}')],['object-lock',d=>d.setControlLock(1,0,true)],['merged-cell',d=>d.mergeTableCells(0,1,0,0,0,1,0)],['form-field',d=>d.setCellProperties(0,1,0,0,'{"fieldName":"source"}')],['row-break',d=>d.setTableProperties(0,1,0,'{"pageBreak":2}')]])await scenario(name+': unsupported scope remains byte-exact and emits no event',()=>rejected('large',alter));
for(const[before,after]of[[9001,5181],[9000,5182]])await scenario('stale '+before+'->'+after+' is rejected atomically',async()=>{const d=await fixture('large');try{const b=d.exportHwp(),e=d.getEventLog();assert.throws(()=>d.applyTableContentHeightPlan(0,1,0,before,after));assert.deepEqual(d.exportHwp(),b);assert.equal(d.getEventLog(),e);}finally{d.free();}});
await scenario('padding grow and shrink changes aggregate while preserving real minima',async()=>{const d=await fixture('auto-zero');try{apply(d,plan(d));for(const c of[0,1])d.setCellProperties(0,1,0,c,'{"paddingTop":141,"paddingBottom":141}');assert.equal(plan(d).afterHeight,4046);apply(d,plan(d));for(const c of[0,1])d.setCellProperties(0,1,0,c,'{"paddingTop":283,"paddingBottom":1134}');assert.equal(plan(d).afterHeight,5181);apply(d,plan(d));}finally{d.free();}});
await scenario('invalid address is read-only and fails instead of guessing an owner',async()=>{const d=await fixture('large');try{const b=d.exportHwp();assert.throws(()=>d.getTableContentHeightPlan(0,999,0));assert.deepEqual(d.exportHwp(),b);}finally{d.free();}});
await scenario('content change invalidates a previously measured after-height',async()=>{const d=await fixture('auto-zero');try{const old=plan(d);for(const c of[0,1])d.setCellProperties(0,1,0,c,'{"paddingTop":141,"paddingBottom":141}');const b=d.exportHwp();assert.throws(()=>apply(d,old));assert.deepEqual(d.exportHwp(),b);}finally{d.free();}});
for(const format of['hwp','hwpx'])await scenario('save facade real three-table '+format+': whole-preservation, strict export and exact snapshot undo',async()=>{
 const d=await fixture('auto-zero');try{const original=d.exportHwp(),events=d.getEventLog(),token=d.saveSnapshot();const plans=planSaveTableFrames(d);assert.equal(plans.length,1);assert.equal(plans[0].paraIdx,1);assert.equal(plans[0].beforeHeight,0);assert.equal(plans[0].afterHeight,5181);assert.deepEqual(d.exportHwp(),original);assert.equal(d.getEventLog(),events);applySaveTableFrames(d,plans,format);assert.equal(planSaveTableFrames(d).length,0);const artifact=d[format==='hwp'?'exportHwpWithReport':'exportHwpxWithReport']();try{verifyPreservedExport(d,artifact.takeBytes(),format,artifact.contentLoss(),b=>new HwpDocument(b));}finally{artifact.free();}d.restoreSnapshot(token);d.discardSnapshot(token);assert.deepEqual(d.exportHwp(),original);}finally{d.free();}
});
await scenario('save facade distinguishes unsupported scope from unexpected engine failure',async()=>{
 const d=await fixture('small-protected');try{assert.deepEqual(planSaveTableFrames(d),[]);const facade=new Proxy(d,{get(t,key){if(key==='getTableContentHeightPlan')return()=>{throw new Error('Injected unexpected reader failure');};const v=t[key];return typeof v==='function'?v.bind(t):v;}});assert.throws(()=>planSaveTableFrames(facade),/Injected unexpected reader failure/);}finally{d.free();}
});
await scenario('save facade blocks a non-overlapping table geometry mismatch and allows exact rollback',async()=>{
 const d=await fixture('auto-zero');try{
  const original=d.exportHwp(),token=d.saveSnapshot();
  const facade=new Proxy(d,{get(t,key){
   if(key==='getPageControlLayout')return(...args)=>{const value=j(t.getPageControlLayout(...args));const table=value.controls.find(c=>c.type==='table');assert.ok(table);table.y+=8;return JSON.stringify(value);};
   const value=t[key];return typeof value==='function'?value.bind(t):value;
  }});
  assert.throws(()=>applySaveTableFrames(facade,planSaveTableFrames(facade),'hwpx'),/표·본문 배치가 달라졌습니다/);
  assert.equal(d.canvasMetricsActive(),false);d.restoreSnapshot(token);d.discardSnapshot(token);assert.deepEqual(d.exportHwp(),original);
 }finally{d.free();}
});
await writeFile(out+'/result.json',JSON.stringify({results,failures,observations,engine,verifierSha256:sha(await readFile(new URL(import.meta.url))),scope:{independentHancomAndCrossFormat:4,unsupportedAtomic:7,staleBeforeAfter:2,growShrink:1,invalidOwner:1,staleMeasuredContent:1,applicationFacade:4},pageErrors:[],consoleErrors:[],externalRequests:[],note:'Explicit engine mutation only; no getter/preservation normalization, dropped fields or geometry relaxation. Protected/unknown/merged/nested/partial inputs stay unsupported. Actual input/golden Hancom SaveAs was performed separately by the parent through visible UI; automated save/reopen here does not count as a fresh Hancom UI run.'},null,2));if(failures.length)process.exitCode=1;
