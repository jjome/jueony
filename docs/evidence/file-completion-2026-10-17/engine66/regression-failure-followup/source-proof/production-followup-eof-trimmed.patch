+
+            let before:serde_json::Value=serde_json::from_str(&core.get_page_control_layout_native(0).unwrap()).unwrap();
+            let b=if format=="hwp" {core.export_hwp_with_adapter_snapshot().unwrap()}else{core.export_hwpx_native().unwrap()};let mut read=DocumentCore::from_bytes(&b).unwrap();read.paginate();
+            let after:serde_json::Value=serde_json::from_str(&read.get_page_control_layout_native(0).unwrap()).unwrap();
+            let before_text:serde_json::Value=serde_json::from_str(&core.get_page_text_layout_native(0).unwrap()).unwrap();
+            let after_text:serde_json::Value=serde_json::from_str(&read.get_page_text_layout_native(0).unwrap()).unwrap();
+            fn same(a:&serde_json::Value,b:&serde_json::Value)->bool{match(a,b){
+                (serde_json::Value::Number(a),serde_json::Value::Number(b))=>(a.as_f64().unwrap()-b.as_f64().unwrap()).abs()<=0.2,
+                (serde_json::Value::Array(a),serde_json::Value::Array(b))=>a.len()==b.len()&&a.iter().zip(b).all(|(a,b)|same(a,b)),
+                (serde_json::Value::Object(a),serde_json::Value::Object(b))=>a.len()==b.len()&&a.iter().all(|(k,a)|b.get(k).is_some_and(|b|same(a,b))),
+                _=>a==b}}
+            if !same(&before,&after)||!same(&before_text,&after_text){failures.push(format!("{stem}: whole control/text geometry differs"));}
+        }}
+        assert!(failures.is_empty(),"{}",failures.join("; "));
+    }
