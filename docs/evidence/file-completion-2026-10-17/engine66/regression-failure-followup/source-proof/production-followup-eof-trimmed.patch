+    fn g050_live_outer_four_command_paths_match_saved_reopen() {
+        use crate::document_core::DocumentCore;
+        let mut failures=Vec::new();
+        for format in ["hwp","hwpx"] {for loaded in [false,true] {
+            let mut core=DocumentCore::new_empty();core.create_blank_document_native().unwrap();
+            core.insert_text_native(0,0,0,"앞 본문").unwrap();core.split_paragraph_native(0,0,4,None).unwrap();
+            let t:serde_json::Value=serde_json::from_str(&core.create_table_native(0,1,0,3,2).unwrap()).unwrap();
+            let ci=t["controlIdx"].as_u64().unwrap() as usize;
+            for i in 0..6 {core.insert_text_in_cell_native(0,1,ci,i,0,0,&format!("내용 {i}")).unwrap();}
+            if loaded {let b=if format=="hwp" {core.export_hwp_with_adapter_snapshot().unwrap()}else{core.export_hwpx_native().unwrap()};core=DocumentCore::from_bytes(&b).unwrap();}
+            core.set_table_properties_native(0,1,ci,r#"{"outerLeft":567,"outerRight":850,"outerTop":1134,"outerBottom":1417}"#).unwrap();core.paginate();
+
