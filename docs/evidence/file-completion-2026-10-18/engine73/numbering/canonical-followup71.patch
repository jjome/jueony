+/// HWP stores number format, not an independent XML checkable bit.
+/// The actual Hancom2024 matrix (all15 formats × both checkable values), saved
+/// as HWP, closed, reloaded from disk and saved as HWPX, observed these exact
+/// canonical values. An explicitly different XML value still reports loss.
+pub(crate) fn canonical_checkable(number_format: u8) -> Option<bool> {
+    const OBSERVED: [bool; 15] = [
+        false, true, false, true, false, true, false, true, false, true, false, true, false, true,
+        false,
+    ];
+    OBSERVED.get(number_format as usize).copied()
+}
 impl Extension {
-    /// No independent HWP5 checkable bit was present in actual single-attribute A/B.
-    /// Hancom disk reload normalizes circled heads from checkable=0 to1. Do not
-    /// claim either direction preserves that XML value without a native codec.
-    pub(crate) fn has_unrepresentable_checkable(&self) -> bool {
-        self.checked.iter().any(|checked| *checked)
-            || self
-                .heads
-                .iter()
-                .any(|head| matches!(head.number_format, 1 | 6 | 7 | 9 | 11 | 14))
+    pub(crate) fn explicit_checkable_differs_from_native(&self) -> bool {
+        self.heads.iter().zip(self.checked).any(|(head, checked)| {
+            canonical_checkable(head.number_format).is_none_or(|expected| expected != checked)
+        })
+    }
+    pub(crate) fn native_checkable_unresolved(&self) -> bool {
+        self.heads
+            .iter()
+            .any(|head| canonical_checkable(head.number_format).is_none())
     }
 }
 
