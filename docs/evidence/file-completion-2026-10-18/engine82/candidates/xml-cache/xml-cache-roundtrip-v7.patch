+    /// The original b"1" marker was also produced for HWP5-origin XML in
+    /// legacy releases. Only this new exact payload owns the cache import
+    /// contract; conflicting raw HWP3/HWP5 source evidence always wins.
+    fn owns_versioned_xml_cache_origin(document: &Document, source: crate::parser::FileFormat) -> bool {
+        use crate::model::document::{HWPX_ORIGIN_STREAM_PATH,HWP3_ORIGIN_STREAM_PATH,
+            HWP3_ORIGIN_HWPX_MARKER_PATH,HWP5_ORIGIN_HWPX_MARKER_PATH};
+        matches!(source,crate::parser::FileFormat::Hwp)
+            && document.provenance.format == crate::model::provenance::SourceFormat::Hwp5
+            && document.provenance.hwpx_lineage && document.is_hwpx_variant
+            && !document.provenance.hwp3_lineage && !document.is_hwp3_variant
+            && document.hwpx_aux_entry(HWP3_ORIGIN_HWPX_MARKER_PATH).is_none()
+            && document.hwpx_aux_entry(HWP5_ORIGIN_HWPX_MARKER_PATH).is_none()
+            && !document.extra_streams.iter().any(|(path,_)|path == HWP3_ORIGIN_STREAM_PATH)
+            && document.extra_streams.iter().filter(|(path,_)|path == HWPX_ORIGIN_STREAM_PATH).count() == 1
+            && document.extra_streams.iter().any(|(path,bytes)|
+                path == HWPX_ORIGIN_STREAM_PATH && bytes.as_slice() == b"2:xml-import-v1")
+    }
+
+    /// Creation authority is distinct from read authority. No original
