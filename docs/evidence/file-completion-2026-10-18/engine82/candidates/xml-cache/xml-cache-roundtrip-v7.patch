+    fn can_create_xml_cache_origin(&self) -> bool {
+        use crate::model::document::{HWPX_ORIGIN_STREAM_PATH,HWP3_ORIGIN_STREAM_PATH,
+            HWP3_ORIGIN_HWPX_MARKER_PATH,HWP5_ORIGIN_HWPX_MARKER_PATH};
+        let document=&self.document;
+        matches!(self.source_format,crate::parser::FileFormat::Hwpx)
+            && document.provenance.format == crate::model::provenance::SourceFormat::Hwpx
+            && !document.provenance.hwp3_lineage && !document.is_hwp3_variant
+            && !document.provenance.hwpx_lineage
+            && document.hwpx_aux_entry(HWP3_ORIGIN_HWPX_MARKER_PATH).is_none()
+            && document.hwpx_aux_entry(HWP5_ORIGIN_HWPX_MARKER_PATH).is_none()
+            && !document.extra_streams.iter().any(|(path,_)|
+                path == HWPX_ORIGIN_STREAM_PATH || path == HWP3_ORIGIN_STREAM_PATH)
+    }
