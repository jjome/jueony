+    /// Match the existing HWPX writer's no-source-cache contract for plain
+    /// generated body rows. Do not serialize cumulative render-only rows as
+    /// authoritative HWP physical positions. No stored/empty/nested rows change.
+    fn omit_generated_xml_body_caches(&self, snapshot: &mut Document) {
+        if !(self.can_create_xml_cache_origin()
+            || Self::owns_versioned_xml_cache_origin(&self.document,self.source_format)) { return; }
+        for (si, section) in self.document.sections.iter().enumerate() {
+            for (pi, para) in section.paragraphs.iter().enumerate() {
+                if para.text.is_empty() || para.text.chars().any(char::is_control)
+                    || !para.controls.is_empty() || !para.field_ranges.is_empty()
+                    || !para.orphan_field_ends.is_empty() || !para.range_tags.is_empty()
+                    || !para.title_marks.is_empty() || !para.markpen_marks.is_empty()
+                    || para.ctrl_data_records.iter().any(Option::is_some)
+                    || !para.tab_extended.is_empty() || para.numbering_restart.is_some()
+                    || para.layout_only_fill_lines != 0 || para.cell_format_vpos_dirty
+                    || para.stored_text_partition_is_dirty() || para.source_line_seg_vertical_pos.is_some()
+                    || para.column_type != crate::model::paragraph::ColumnBreakType::None
+                    || para.line_segs.is_empty() || para.line_segs.iter().any(|line|
+                        line.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+                            || line.line_height <= 0 || line.text_height <= 0
+                            || line.segment_width <= 0 || line.line_spacing < 0)
+                { continue; }
+                snapshot.sections[si].paragraphs[pi].line_segs.clear();
+            }
+        }
+    }
