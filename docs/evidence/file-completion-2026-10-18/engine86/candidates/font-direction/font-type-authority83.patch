+/// XML type spelling is source evidence, not permission to infer a TTF face.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
+pub enum FontTypeOrigin { Representative, TrueType, HwpFont, Missing, Unrecognized(String) }
+impl FontTypeOrigin {
+    pub fn from_lexical(value:String)->Self { match value.as_str(){
+        "REP"=>Self::Representative,"TTF"=>Self::TrueType,"HFT"=>Self::HwpFont,
+        _=>Self::Unrecognized(value),
+    }}
+    pub fn native_type(&self)->Option<u8>{match self{
+        Self::Representative=>Some(0),Self::TrueType=>Some(1),Self::HwpFont=>Some(2),_=>None,
+    }}
+}
