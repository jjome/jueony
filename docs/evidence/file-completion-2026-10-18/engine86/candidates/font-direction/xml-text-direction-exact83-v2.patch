+/// Explicit XML paragraph direction, retained separately from unproven HWP5 bits.
+/// Known lexical values acquire a semantic enum; unknown source values keep their
+/// exact original spelling and never silently become AUTO.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
+pub enum ParagraphTextDirection { Auto, Ltr, Rtl, Unknown(String) }
+impl ParagraphTextDirection {
+    pub fn from_lexical(value: String) -> Self { match value.as_str() {
+        "AUTO" => Self::Auto, "LTR" => Self::Ltr, "RTL" => Self::Rtl,
+        _ => Self::Unknown(value),
+    }}
+    pub fn lexical(&self) -> &str { match self {
+        Self::Auto => "AUTO", Self::Ltr => "LTR", Self::Rtl => "RTL",
+        Self::Unknown(value) => value.as_str(),
+    }}
+}
