+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn wrap(raw: &str, context: &[(String,String)]) -> String {
+        let (name,attrs)=owner("numbering",Some(raw),Some(context)).unwrap();
+        let mut xml=format!("<hh:head xmlns:hh=\"{HEAD}\"><{name}");
+        for (key,value) in attrs {xml.push_str(&format!(" {key}=\"{}\"",quick_xml::escape::escape(&value)));}
+        xml.push('>');xml.push_str(raw);xml.push_str(&format!("</{name}></hh:head>"));xml
+    }
+    #[test] fn raw_namespace83_inherited_alias_fragment_stays_exact() {
+        let raw="<!--kept--><ns0:paraHead level=\"8\" checkable=\"1\">^8.&amp;</ns0:paraHead>";
+        let xml=format!("<ns0:head xmlns:ns0=\"{HEAD}\"><ns0:numbering id=\"1\">{raw}</ns0:numbering></ns0:head>");
+        let contexts=capture(&xml).unwrap();let context=contexts.values().next().unwrap();
+        let output=wrap(raw,context);assert!(output.contains(raw));
+        assert!(output.contains(&format!("xmlns:ns0=\"{HEAD}\"")));
+        let (info,_)=super::super::header::parse_hwpx_header(&output).unwrap();
+        assert_eq!(info.numberings[0].raw_para_heads.as_deref(),Some(raw));
+    }
+    #[test] fn raw_namespace83_shadowed_prefixes_stay_local() {
+        let xml=format!("<h:head xmlns:h=\"{HEAD}\" xmlns:x=\"urn:outer\"><h:numbering><h:paraHead x:a=\"1\"/></h:numbering><h:numbering xmlns:x=\"urn:inner\"><h:paraHead x:a=\"2\"/></h:numbering><h:numbering><h:paraHead x:a=\"3\"/></h:numbering></h:head>");
+        let contexts=capture(&xml).unwrap();let values:Vec<_>=contexts.values().collect();
+        for (index,expected) in ["urn:outer","urn:inner","urn:outer"].iter().enumerate() {
+            assert_eq!(values[index].iter().find(|(k,_)|k=="x").unwrap().1,*expected);
+            assert!(wrap("<h:paraHead x:a=\"kept\"/>",values[index]).contains(expected));
+        }
+    }
+    #[test] fn raw_namespace83_head_prefix_collision_and_stable_roundtrip() {
+        let raw="<ns0:paraHead><hh:extension hh:value=\"retained\"/></ns0:paraHead>";
+        let mut context=vec![("hh".into(),"urn:vendor".into()),("ns0".into(),HEAD.into())];
+        let mut previous=None;
+        for _ in 0..4 {
+            let output=wrap(raw,&context);assert!(output.contains(raw));
+            assert!(output.contains("<ns0:numbering"));
+            let current=capture(&output).unwrap().into_values().next().unwrap();
+            if let Some(before)=previous {assert_eq!(before,current);}
+            previous=Some(current.clone());context=current;
+        }
+    }
+    #[test] fn raw_namespace83_default_and_escaped_uri_preserved_once() {
+        let raw="<paraHead x:a=\"1\"/>";
+        let xml=format!("<h:head xmlns:h=\"{HEAD}\" xmlns=\"{HEAD}\" xmlns:x=\"urn:a&amp;b\"><h:numbering>{raw}</h:numbering></h:head>");
+        let contexts=capture(&xml).unwrap();let context=contexts.values().next().unwrap();
+        assert!(context.contains(&("x".into(),"urn:a&b".into())));
+        let output=wrap(raw,context);assert!(output.contains("xmlns:x=\"urn:a&amp;b\""));
+        assert!(!output.contains("&amp;amp;"));assert!(output.contains(raw));
+    }
+    #[test] fn raw_namespace83_unbound_and_duplicate_contexts_rejected() {
+        assert!(owner("numbering",Some("<missing:paraHead/>"),Some(&[])).is_err());
+        assert!(owner("numbering",Some("<hh:paraHead/>"),None).is_err());
+        let canonical=vec![("hh".into(),HEAD.into())];
+        assert!(owner("numbering",Some("<hh:paraHead missing:a=\"1\"/>"),Some(&canonical)).is_err());
+        let bindings=vec![("x".into(),"urn:a".into()),("x".into(),"urn:b".into())];
+        assert!(owner("numbering",Some("<hh:paraHead/>"),Some(&bindings)).is_err());
+    }
+    #[test] fn raw_namespace83_ownership_limits_fail_closed() {
+        let mut xml=String::from("<root");
+        for i in 0..257 {xml.push_str(&format!(" xmlns:p{i}=\"urn:{i}\""));}
+        xml.push_str("><numbering/></root>");assert!(capture(&xml).is_err());
+        let huge=vec![("x".into(),"u".repeat(MAX_CONTEXT_BYTES+1))];
+        assert!(owner("numbering",Some("<hh:paraHead/>"),Some(&huge)).is_err());
+    }
+    #[test] fn raw_namespace83_generated_xml_is_validated_without_repair() {
+        for bad in ["<a/><b/>","<a>\0</a>","<a>&unknown;</a>","<a missing:x=\"1\"/>","<!DOCTYPE a><a/>","<a>"] {assert!(validate(bad).is_err(),"{bad:?}");}
+        assert!(validate("<?xml version=\"1.0\"?><a xmlns:x=\"urn:x\" x:v=\"&amp;\">&#65;&amp;<!--x--><![CDATA[<kept>]]></a>").is_ok());
+    }
+}
