+//! Carry the lexical namespace owner alongside an untouched resource fragment.
+use std::collections::BTreeMap;
+use quick_xml::{events::Event, name::{PrefixDeclaration, ResolveResult}, reader::NsReader};
+use super::{HwpxError, utils::local_name};
+
+const HEAD: &str = "http://www.hancom.co.kr/hwpml/2011/head";
+const MAX_CONTEXT_BYTES: usize = 4 * 1024 * 1024;
+pub(crate) type Contexts = BTreeMap<usize, Vec<(String, String)>>;
+
+/// A single namespace-aware pass; never rescan the header once per resource.
+pub(crate) fn capture(xml: &str) -> Result<Contexts, HwpxError> {
+    let mut reader = NsReader::from_str(xml);
+    reader.resolver_mut().set_max_namespace_bindings(256);
+    let mut result = Contexts::new();
+    let mut allocated = 0usize;
+    loop {
+        match reader.read_event().map_err(|e| HwpxError::XmlError(format!("raw resource namespace: {e}")))? {
+            Event::Start(e) if matches!(local_name(e.name().as_ref()), b"numbering" | b"bullet") => {
+                let mut bindings = BTreeMap::new();
+                for (prefix, uri) in reader.resolver().bindings() {
+                    let prefix = match prefix { PrefixDeclaration::Default => "", PrefixDeclaration::Named(p) => p };
+                    let uri = quick_xml::escape::unescape(uri.into_inner())
+                        .map_err(|e| HwpxError::XmlError(format!("namespace URI: {e}")))?;
+                    allocated = allocated.checked_add(prefix.len() + uri.len())
+                        .ok_or_else(|| HwpxError::XmlError("namespace ownership budget overflow".into()))?;
+                    if allocated > MAX_CONTEXT_BYTES {
+                        return Err(HwpxError::XmlError("raw resource namespace ownership exceeds 4 MiB".into()));
+                    }
+                    bindings.insert(prefix.to_owned(), uri.into_owned());
+                }
+                result.insert(reader.buffer_position() as usize, bindings.into_iter().collect());
+            }
+            Event::Eof => break,
+            _ => {},
+        }
+    }
+    Ok(result)
+}
+
+/// Select a qualified wrapper without rebinding a source prefix to another URI.
+/// The fragment remains byte-identical, including nested local declarations.
+pub(crate) fn owner(local: &str, raw: Option<&str>, context: Option<&[(String, String)]>)
+    -> Result<(String, Vec<(String, String)>), String>
+{
+    let Some(raw) = raw else { return Ok((format!("hh:{local}"), Vec::new())); };
+    let context = context.ok_or_else(|| "raw resource fragment has no namespace owner".to_string())?;
+    if context.len() > 256 || context.iter().map(|(k,v)| k.len()+v.len()).sum::<usize>() > MAX_CONTEXT_BYTES {
+        return Err("raw resource namespace ownership limit exceeded".into());
+    }
+    let mut bindings = BTreeMap::new();
+    for (k,v) in context {
+        if k == "xml" || k == "xmlns" || bindings.insert(k.clone(),v.clone()).is_some() {
+            return Err("reserved or duplicate raw resource namespace binding".into());
+        }
+    }
+    // Validate the original lexical scope before adding the generated wrapper's
+    // own head binding. An unbound source `hh:` is not a license to guess HEAD.
+    let validation_prefix = (0usize..).map(|n|format!("jueonyScope{n}"))
+        .find(|p|!bindings.contains_key(p)).unwrap();
+    let mut wrapper=format!("<{validation_prefix}:owner xmlns:{validation_prefix}=\"urn:jueony:scope-validation\"");
+    for (key,value) in &bindings {
+        let name=if key.is_empty(){"xmlns".into()}else{format!("xmlns:{key}")};
+        wrapper.push_str(&format!(" {name}=\"{}\"",quick_xml::escape::escape(value)));
+    }
+    wrapper.push('>');wrapper.push_str(raw);wrapper.push_str(&format!("</{validation_prefix}:owner>"));
+    validate(&wrapper)?;
+    let prefix = if bindings.get("hh").is_none_or(|v| v == HEAD) {
+        "hh".to_owned()
+    } else if let Some((prefix,_)) = bindings.iter().find(|(k,v)| !k.is_empty() && v.as_str() == HEAD) {
+        prefix.clone()
+    } else {
+        (0usize..).map(|n| format!("jueonyHead{n}")).find(|p| !bindings.contains_key(p)).unwrap()
+    };
+    bindings.insert(prefix.clone(),HEAD.to_owned());
+    let attrs: Vec<_> = bindings.into_iter().map(|(k,v)| (if k.is_empty(){"xmlns".into()}else{format!("xmlns:{k}")},v)).collect();
+    let name = format!("{prefix}:{local}");
+    Ok((name,attrs))
+}
+
+pub(crate) fn validate(xml: &str) -> Result<(), String> {
+    if xml.len()>32*1024*1024 || xml.chars().any(|c| !matches!(c,'\u{9}'|'\u{a}'|'\u{d}'|'\u{20}'..='\u{d7ff}'|'\u{e000}'..='\u{fffd}'|'\u{10000}'..='\u{10ffff}')) {
+        return Err("XML character or size limit violation".into());
+    }
+    let mut check = NsReader::from_str(xml);
+    check.resolver_mut().set_max_namespace_bindings(512);
+    let mut roots=0usize;let mut depth=0usize;
+    loop {
+        match check.read_event().map_err(|e| format!("raw resource fragment: {e}"))? {
+            event @ (Event::Start(_) | Event::Empty(_)) => {
+                let empty=matches!(event,Event::Empty(_));
+                let e=match event {Event::Start(e)|Event::Empty(e)=>e,_=>unreachable!()};
+                if depth==0 {roots+=1;if roots>1{return Err("multiple XML roots".into());}}
+                if !empty {depth+=1;if depth>256{return Err("XML depth limit exceeded".into());}}
+                if matches!(check.resolver().resolve_element(e.name()).0, ResolveResult::Unknown(_)) {
+                    return Err("unbound element prefix in raw resource fragment".into());
+                }
+                for attr in e.attributes() {
+                    let attr = attr.map_err(|e| format!("raw resource attribute: {e}"))?;
+                    attr.normalized_value(quick_xml::XmlVersion::Implicit1_0).map_err(|e|format!("XML attribute value: {e}"))?;
+                    if attr.key.as_namespace_binding().is_none()
+                        && matches!(check.resolver().resolve_attribute(attr.key).0, ResolveResult::Unknown(_)) {
+                        return Err("unbound attribute prefix in raw resource fragment".into());
+                    }
+                }
+            }
+            Event::End(_) => {depth=depth.checked_sub(1).ok_or("unbalanced XML root")?;}
+            Event::DocType(_) => return Err("DTD is not supported in generated HWPX XML".into()),
+            Event::Decl(_) if roots>0 || depth>0 => return Err("misplaced XML declaration".into()),
+            Event::Text(e) if depth==0 => {let s:&str=e.as_ref();if !s.trim().is_empty(){return Err("text outside XML root".into());}}
+            Event::CData(_) if depth==0 => return Err("CDATA outside XML root".into()),
+            Event::GeneralRef(e) => {let s:&str=e.as_ref();quick_xml::escape::unescape(&format!("&{s};")).map_err(|e|format!("XML entity: {e}"))?;}
+            Event::Eof => break,
+            _ => {},
+        }
+    }
+    if depth!=0 || roots!=1 {return Err("incomplete XML root".into());}Ok(())
+}
