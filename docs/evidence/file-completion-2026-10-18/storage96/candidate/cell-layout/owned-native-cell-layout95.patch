+fn owned_break_cell95_exact_fit_proof_rejects_unknown_glyph_compression_and_box_mismatch() {
+    let (para,styles,frame)=owned_break_cell95_fixture();
+    assert!(super::line_breaking::owned_break_cell_row_overflows(&para,&frame,&styles));
+    let mut p=para.clone();p.text.replace_range(..3,"∘");
+    assert!(!super::line_breaking::owned_break_cell_row_overflows(&p,&frame,&styles));
+    let mut compressed=styles.clone();compressed.para_styles[0].condense_min_space=20;
+    assert!(!super::line_breaking::owned_break_cell_row_overflows(&para,&frame,&compressed));
+    assert!(!super::line_breaking::owned_break_cell_row_overflows(&para,&ParagraphBox::content(0..30000),&styles));
+    let mut p=para.clone();p.char_offsets[1]=2;
+    assert!(!super::line_breaking::owned_break_cell_row_overflows(&p,&frame,&styles));
+    let mut p=para.clone();p.controls.push(crate::model::control::Control::ColumnDef(Default::default()));
+    assert!(!super::line_breaking::owned_break_cell_row_overflows(&p,&frame,&styles));
+}
