+        segment_width:29868, tag:LineSeg::TAG_SINGLE_SEGMENT_LINE, ..Default::default() };
+    let para = Paragraph { text:text.into(), char_count:len as u32 + 1,
+        char_offsets:(0..len as u32).collect(),char_shapes:vec![CharShapeRef { start_pos:0,char_shape_id:0 }],
+        line_segs:vec![row(0),row(31),row(63)], ..Default::default() };
+    (para,styles,ParagraphBox::content(0..29868))
