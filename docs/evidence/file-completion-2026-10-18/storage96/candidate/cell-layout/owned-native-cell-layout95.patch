+/// Exact overflow proof for a horizontal BREAK cell. Unlike estimated-width
+/// import heuristics, every scalar must have a positive owned integer advance.
+/// Written line breaks, unknown glyphs, authored compression and alternate
+/// wrap/fit policies cannot enter this lane. Trailing spaces do not prove an
+/// overflow: the normal breaker may leave them outside the physical interval.
+/// The caller supplies the current paragraph box, not a cached width guess.
+pub(crate) fn owned_break_cell_row_overflows(
+    para: &Paragraph,
+    paragraph_box: &ParagraphBox,
+    styles: &ResolvedStyleSet,
+) -> bool {
+    if !paragraph_box.is_usable() || para.line_segs.len() < 2
+        || para.hwpx_axis_shift != 0
+        || !para.range_tags.is_empty() || !para.field_ranges.is_empty()
+        || !para.orphan_field_ends.is_empty() || !para.tab_extended.is_empty()
+        || !paragraph_has_integral_gulimche_advances(para, styles, SpaceMetric::Stored)
+        || !styles.para_styles.get(para.para_shape_id as usize).is_some_and(|p|
+            p.cached_scalar_fit_supported && p.alignment == Alignment::Justify && p.korean_break_unit == 1
+                && p.margin_left == 0.0 && p.margin_right == 0.0)
+    { return false; }
+    let chars: Vec<_> = para.text.chars().collect();
+    // Manual clipped leaders have their own existing paint policy. Their
+    // repeated dots are not evidence that an ordinary source row is stale.
+    if !super::leader_fill_spans(&chars).is_empty() { return false; }
+    // This measurement contract owns BMP scalar intervals only. A malformed
+    // native/raw offset table must not be silently converted into another axis.
+    if para.char_offsets.len() != chars.len()
+        || para.char_offsets.iter().enumerate().any(|(i, &offset)| offset != i as u32)
+        || chars.iter().any(|c| c.is_control() || *c == '\u{fffc}')
+        || para.line_segs[0].text_start != 0
+        || para.line_segs.windows(2).any(|r| r[0].text_start >= r[1].text_start
+            || r[1].text_start as usize >= chars.len() || r[0].vertical_pos >= r[1].vertical_pos)
+        || para.line_segs.iter().any(|row|
+            row.segment_width != paragraph_box.width_hwp() || row.column_start != 0
+                || row.line_height <= 0 || row.text_height <= 0
+                || row.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+    { return false; }
+    let scope = ParagraphMetricScope::new(&chars, styles)
+        .with_reflow_slots(&chars).with_space_metric(SpaceMetric::Stored);
+    let mut lang = 0;
+    let mut widths = Vec::with_capacity(chars.len());
+    for (i, &ch) in chars.iter().enumerate() {
+        let id = find_active_char_shape(&para.char_shapes, i as u32);
+        let slot = char_lang_slot(ch, &mut lang, punct_latin_slot(styles, id));
+        let style = scope.style(styles, id, slot, i);
+        let Some(width) = crate::renderer::layout::trace_char_width_decisions(&ch.to_string(), &style)
+            .first().and_then(|d| d.integral_advance_hwp).filter(|&w| w > 0)
+        else { return false; };
+        widths.push(i64::from(width));
+    }
+    para.line_segs.windows(2).any(|pair| {
+        let start = pair[0].text_start as usize;
+        let end = pair[1].text_start as usize;
+        if start >= end || end > chars.len() { return false; }
+        let trimmed = (start..end).rev().find(|&i| chars[i] != ' ').map(|i| i + 1).unwrap_or(start);
+        // BREAK mode uses the ordinary token fit policy: closing punctuation
+        // is part of the fit token, not an unbounded hanging-glyph exception.
+        widths[start..trimmed].iter().sum::<i64>() > i64::from(pair[0].segment_width)
     })
 }
 
