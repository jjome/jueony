     /// 스트림 존재 여부 확인
     pub fn has_stream(&self, path: &str) -> bool {
+        self.compound.is_stream(path)
+    }
+
+    /// Query only the supplied path components, never enumerate unrelated trees.
+    /// `entry.path()` reflects the caller spelling; `entry.name()` is the actual
+    /// directory name. Check every component so case-insensitive CFB lookup is
+    /// not mistaken for an exact lexical owner.
+    pub fn has_exact_stream_path(&self, path: &str) -> bool {
+        if !path.starts_with('/') || path.len() > 512 { return false; }
+        let mut prefix = String::new();
+        for part in path[1..].split('/') {
+            if part.is_empty() || matches!(part, "." | "..") { return false; }
+            prefix.push('/'); prefix.push_str(part);
+            let Ok(entry) = self.compound.entry(&prefix) else { return false; };
+            if entry.name() != part { return false; }
+        }
         self.compound.is_stream(path)
     }
 
diff --git a/src/parser/xml_template.rs b/src/parser/xml_template.rs
new file mode 100644
--- /dev/null
+++ b/src/parser/xml_template.rs
@@ -0,0 +1,94 @@
+//! Read-only XMLTemplate stream extraction using the existing strict CFB reader.
+//! SchemaXPath is a schema address, not authority to edit an HWP field or body.
+use super::{cfb_reader::CfbReader, header::parse_file_header};
+use quick_xml::{events::Event, name::ResolveResult, reader::NsReader};
+use serde::Serialize;
+use sha2::{Digest,Sha256};
+
+
+pub const MAX_HWT_BYTES:usize=32*1024*1024;
+const MAX_STREAM:usize=2_000_000;
+const MAX_SCHEMA_NAME:usize=1024;
+const SCHEMA:&str="/XMLTemplate/Schema";
+const INSTANCE:&str="/XMLTemplate/Instance";
+const NAME:&str="/XMLTemplate/_SchemaName";
+
+#[derive(Debug,Serialize)]
+#[serde(rename_all="camelCase")]
+pub struct TemplateStreamEvidence {pub path:String,pub stored_bytes:usize,pub stored_sha256:String,pub utf16_bytes:usize}
+#[derive(Debug,Serialize)]
+#[serde(rename_all="camelCase")]
+pub struct HwtXmlTemplateRead {
+ pub version:u32,pub read_only:bool,pub schema_addresses_validated:bool,
+ pub source_sha256:String,pub schema:String,pub mapping:String,pub schema_name:String,
+ pub streams:Vec<TemplateStreamEvidence>,pub limitations:Vec<String>,
+}
+fn hash(data:&[u8])->String {Sha256::digest(data).iter().map(|b|format!("{b:02x}")).collect()}
+fn utf16(data:&[u8],limit:usize)->Result<String,String>{
+ if data.len()<4{return Err("HWT_XML_LENGTH_PREFIX".into());}
+ let bytes=u32::from_le_bytes(data[..4].try_into().unwrap()) as usize;
+ if bytes>limit||bytes%2!=0||bytes!=data.len()-4{return Err("HWT_XML_LENGTH_MISMATCH".into());}
+ let units:Vec<_>=data[4..].chunks_exact(2).map(|p|u16::from_le_bytes([p[0],p[1]])).collect();
+ String::from_utf16(&units).map_err(|_|"HWT_XML_INVALID_UTF16".into())
+}
+/// All 42 installed Schema/Instance streams use raw DEFLATE followed by the
+/// gzip trailer CRC32 and ISIZE, without a gzip header. Accept that exact
+/// observed representation, never arbitrary trailing bytes or bare DEFLATE.
+fn inflate_exact(data:&[u8])->Result<Vec<u8>,String>{
+ if data.len()<10{return Err("HWT_XML_DEFLATE_TRAILER".into());}
+ let split=data.len()-8;let (payload,tail)=data.split_at(split);
+ let crc=u32::from_le_bytes(tail[..4].try_into().unwrap());
+ let size=u32::from_le_bytes(tail[4..].try_into().unwrap()) as usize;
+ if size<4||size>MAX_STREAM+4{return Err("HWT_XML_DECOMPRESSION_BUDGET".into());}
+ let mut decoder=flate2::Decompress::new(false);let mut result=vec![0;size+1];
+ let status=decoder.decompress(payload,&mut result,flate2::FlushDecompress::Finish).map_err(|_|"HWT_XML_DEFLATE".to_string())?;
+ if status!=flate2::Status::StreamEnd||decoder.total_in()!=payload.len() as u64||decoder.total_out()!=size as u64{return Err("HWT_XML_DEFLATE_EXACT".into());}
+ result.truncate(size);if crc32fast::hash(&result)!=crc{return Err("HWT_XML_DEFLATE_CRC".into());}Ok(result)
+}
+
+fn xml_root(text:&str,local:&str,namespace:Option<&str>)->Result<(),String>{
+ // Reuse the engine's strict XML syntax/namespace/entity validator. No DTD or
+ // general entity resolution, external retrieval or transformation takes place.
+ super::hwpx::raw_namespace::validate(text).map_err(|_|"HWT_XML_SYNTAX".to_string())?;
+ let mut reader=NsReader::from_str(text);reader.resolver_mut().set_max_namespace_bindings(256);
+ let mut count=0usize;let mut first=true;
+ loop {match reader.read_event().map_err(|_|"HWT_XML_SYNTAX".to_string())? {
+  Event::Start(e)|Event::Empty(e)=>{
+   count+=1;if count>8192{return Err("HWT_XML_NODE_BUDGET".into());}
+   if first {first=false;let (ns,name)=reader.resolver().resolve_element(e.name());
+    let correct_ns=match (namespace,ns){(None,ResolveResult::Unbound)=>true,(Some(expected),ResolveResult::Bound(n))=>n.as_ref()==expected,_=>false};
+    if name.as_ref()!=local||!correct_ns{return Err("HWT_XML_ROOT".into());}
+   }
+  },Event::Eof=>break,_=>{}
+ }}
+ Ok(())
+}
+
+/// This function never constructs/reflows a Document, writes a stream or returns
+/// a file-save capability. Unrelated opaque streams remain in the source bytes.
+pub fn extract_hwt_xml_template(data:&[u8])->Result<HwtXmlTemplateRead,String>{
+ if data.len()>MAX_HWT_BYTES{return Err("HWT_SOURCE_BUDGET".into());}
+ let mut cfb=CfbReader::open(data).map_err(|_|"HWT_CFB_INVALID".to_string())?;
+ let header=cfb.read_stream_raw_limited("/FileHeader",256).map_err(|_|"HWT_HEADER_MISSING".to_string())?;
+ if header.len()!=256{return Err("HWT_HEADER_SIZE".into());}
+ let parsed=parse_file_header(&header).map_err(|_|"HWT_HEADER_INVALID".to_string())?;
+ if !parsed.version.is_supported()||!parsed.flags.xml_template{return Err("HWT_TEMPLATE_FLAG_REQUIRED".into());}
+ if parsed.flags.encrypted||parsed.flags.distribution||parsed.flags.drm||parsed.flags.public_key_encrypted{return Err("HWT_PROTECTED_UNSUPPORTED".into());}
+ // Fixed exact paths only: inspect three entries, no full-storage walk.
+ for wanted in [SCHEMA,INSTANCE,NAME] {
+  if !cfb.has_exact_stream_path(wanted){return Err("HWT_XML_STREAM_OWNERSHIP".into());}
+ }
+ let mut streams=Vec::new();let mut values=Vec::new();
+ for path in [SCHEMA,INSTANCE,NAME]{
+  let limit=if path==NAME {MAX_SCHEMA_NAME}else{MAX_STREAM};
+  let raw=cfb.read_stream_raw_limited(path,limit).map_err(|_|"HWT_XML_STREAM_BUDGET".to_string())?;
+  let expanded=if path==NAME {raw.clone()}else{inflate_exact(&raw)?};
+  let value=utf16(&expanded,limit)?;
+  if path==SCHEMA {xml_root(&value,"schema",Some("http://www.w3.org/2001/XMLSchema"))?;}
+  if path==INSTANCE {xml_root(&value,"XMLELEMENT",None)?;}
+  if path==NAME && (value.is_empty()||value.chars().any(char::is_control)){return Err("HWT_SCHEMA_NAME_INVALID".into());}
+  streams.push(TemplateStreamEvidence{path:path.into(),stored_bytes:raw.len(),stored_sha256:hash(&raw),utf16_bytes:expanded.len()-4});values.push(value);
+ }
+ let mut values=values.into_iter();
+ Ok(HwtXmlTemplateRead{version:1,read_only:true,schema_addresses_validated:false,source_sha256:hash(data),schema:values.next().unwrap(),mapping:values.next().unwrap(),schema_name:values.next().unwrap(),streams,limitations:vec!["SchemaXPath/Name binding requires separate validation; HWP body fields are not resolved.".into(),"No HWT editing, template creation, XML instance editing or XSL layout capability.".into()]})
+}
diff --git a/src/wasm_api/xml_template.rs b/src/wasm_api/xml_template.rs
new file mode 100644
--- /dev/null
+++ b/src/wasm_api/xml_template.rs
@@ -0,0 +1,8 @@
+use wasm_bindgen::prelude::*;
+
+/// Read only the fixed HWT XMLTemplate streams. No live document is constructed.
+#[wasm_bindgen(js_name = extractHwtXmlTemplate)]
+pub fn extract_hwt_xml_template(data:&[u8])->Result<String,JsValue>{
+ let value=crate::parser::xml_template::extract_hwt_xml_template(data).map_err(|e|JsValue::from_str(&e))?;
+ serde_json::to_string(&value).map_err(|_|JsValue::from_str("HWT_XML_RESULT_ENCODING"))
+}
