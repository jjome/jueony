new file mode 100644
--- /dev/null
+++ b/src/document_core/commands/document_insert.rs
@@ -0,0 +1,84 @@
+//! Bounded file insertion: text, tables and pictures; no HTML downgrade.
+use crate::document_core::DocumentCore;
+use crate::error::HwpError;
+use crate::model::control::Control;
+use crate::model::document::Document;
+use crate::model::paragraph::Paragraph;
+
+fn refused(message: &str) -> HwpError { HwpError::RenderError(message.into()) }
+
+fn validate_paragraphs(
+    paragraphs: &[Paragraph], document: &Document, depth: usize,
+    count: &mut usize, characters: &mut usize, cells: &mut usize,
+) -> Result<(), HwpError> {
+    if depth > 8 { return Err(refused("삽입 원본의 중첩 깊이가 한도를 넘습니다")); }
+    for paragraph in paragraphs {
+        *count += 1; *characters += paragraph.text.chars().count();
+        if *count > 5000 || *characters > 100000 {
+            return Err(refused("삽입 원본은 5,000문단 / 10만 문자 이내여야 합니다"));
+        }
+        if !paragraph.field_ranges.is_empty() {
+            return Err(refused("필드가 있는 문서 삽입은 아직 지원하지 않습니다"));
+        }
+        if paragraph.para_shape_id as usize >= document.doc_info.para_shapes.len()
+            || paragraph.style_id as usize >= document.doc_info.styles.len()
+            || paragraph.char_shapes.iter().any(|run| run.char_shape_id as usize >= document.doc_info.char_shapes.len()) {
+            return Err(refused("삽입 원본의 서식 참조가 유효하지 않습니다"));
+        }
+        for control in &paragraph.controls {
+            match control {
+                Control::SectionDef(_) | Control::ColumnDef(_) if depth == 0 => {},
+                Control::Table(table) => {
+                    *cells += table.cells.len();
+                    if *cells > 1000 { return Err(refused("삽입 원본의 표는 총 1,000셀 이내여야 합니다")); }
+                    for cell in &table.cells {
+                        validate_paragraphs(&cell.paragraphs, document, depth + 1, count, characters, cells)?;
+                    }
+                    if let Some(caption) = &table.caption {
+                        validate_paragraphs(&caption.paragraphs, document, depth + 1, count, characters, cells)?;
+                    }
+                },
+                Control::Picture(picture) => {
+                    if let Some(caption) = &picture.caption {
+                        validate_paragraphs(&caption.paragraphs, document, depth + 1, count, characters, cells)?;
+                    }
+                },
+                _ => return Err(refused("현재 문서 삽입은 본문·표·그림만 지원합니다. 머리말/각주/필드/도형 등은 제외됩니다")),
+            }
+        }
+    }
+    Ok(())
+}
+
+impl DocumentCore {
+    /// Parse and validate before touching destination IDs/content.
+    pub fn insert_document_bytes_native(
+        &mut self, section_idx: usize, para_idx: usize, char_offset: usize, data: &[u8],
+    ) -> Result<String, HwpError> {
+        if data.is_empty() || data.len() > 32 * 1024 * 1024 {
+            return Err(refused("삽입 파일은 비어 있지 않은 32MiB 이하 HWP/HWPX여야 합니다"));
+        }
+        let section = self.document.sections.get(section_idx)
+            .ok_or_else(|| refused("대상 구역이 없습니다"))?;
+        let paragraph = section.paragraphs.get(para_idx)
+            .ok_or_else(|| refused("대상 문단이 없습니다"))?;
+        if char_offset > paragraph.text.chars().count() {
+            return Err(refused("대상 문자 위치가 문단 범위를 벗어났습니다"));
+        }
+        let source = DocumentCore::from_bytes(data)?.document;
+        if source.sections.len() != 1 {
+            return Err(refused("현재는 단일 구역 원본만 삽입할 수 있습니다"));
+        }
+        if source.sections[0].paragraphs.is_empty() {
+            return Err(refused("삽입 원본에 문단이 없습니다"));
+        }
+        if self.document.doc_info.styles.len() + source.doc_info.styles.len() > 256
+            || self.document.doc_info.para_shapes.len() + source.doc_info.para_shapes.len() > 65535 {
+            return Err(refused("서식 참조 개수 한도를 넘어서 삽입하지 않았습니다"));
+        }
+        validate_paragraphs(&source.sections[0].paragraphs, &source, 0, &mut 0, &mut 0, &mut 0)?;
+        let result = self.paste_foreign_document_content_native(section_idx, para_idx, char_offset, source, false)?;
+        self.document.doc_info.raw_stream_dirty = true;
+        Ok(result)
+    }
+}
