+    // Only matched, paragraph-local click-here fields can move with their owning cell.
+    fn nested_axis_paragraph_supported(p: &crate::model::paragraph::Paragraph) -> bool {
+        use crate::model::control::FieldType;
+        if !p.orphan_field_ends.is_empty() || !p.range_tags.is_empty()
+            || p.controls.len() != p.field_ranges.len() || p.controls.len() > 200 { return false; }
+        if p.controls.is_empty() { return true; }
+        let length = p.text.chars().count();
+        let mut seen = vec![false; p.controls.len()];
+        let mut spans = Vec::with_capacity(p.controls.len());
+        for r in &p.field_ranges {
+            if r.start_char_idx > r.end_char_idx || r.end_char_idx > length || r.inner_slot_count != 0
+                || !matches!(p.controls.get(r.control_idx), Some(Control::Field(f)) if f.field_type == FieldType::ClickHere)
+                || std::mem::replace(&mut seen[r.control_idx], true) { return false; }
+            spans.push((r.start_char_idx, r.end_char_idx));
+        }
+        spans.sort_unstable();
+        spans.windows(2).all(|w| w[1].0 > w[0].1.saturating_add(1))
+    }
