+    fn simple_nested_axis_caption(caption: &crate::model::shape::Caption) -> bool {
+        use crate::model::shape::CaptionDirection;
+        let [p] = caption.paragraphs.as_slice() else { return false; };
+        if !matches!(caption.direction, CaptionDirection::Top | CaptionDirection::Bottom)
+            || p.text.is_empty() || p.text.len() > 16_000 || p.text.chars().any(char::is_control)
+            || !p.controls.is_empty() || !p.field_ranges.is_empty() || !p.orphan_field_ends.is_empty()
+            || !p.range_tags.is_empty() || !p.markpen_marks.is_empty() || !p.title_marks.is_empty()
+            || !p.tab_extended.is_empty() || p.numbering_restart.is_some() || p.raw_break_type != 0
+            || p.char_shapes.len() > 128 || p.char_shapes.first().map(|s| s.start_pos) != Some(0)
+        {
+            return false;
+        }
+        let len = p.text.encode_utf16().count() as u32;
+        p.char_shapes.iter().all(|s| s.start_pos < len && p.char_offsets.contains(&s.start_pos))
+            && p.char_shapes.windows(2).all(|w| w[0].start_pos < w[1].start_pos)
+    }
+
+    pub(crate) fn table_axis_caption_evidence(
+        &self, section: usize, para: usize, path: &[(usize, usize, usize)],
+    ) -> Result<String, HwpError> {
+        let table = self.resolve_table_by_path(section, para, path)?;
+        let Some(c) = &table.caption else { return Ok("null".into()); };
+        if !Self::simple_nested_axis_caption(c) {
+            // Bind an untouched complex sibling to its full model. It can never
+            // become the target of a nested axis edit under this proof.
+            return Ok(serde_json::json!({"kind":"complex",
+                "digest":crate::model::raw_provenance::record_digest(c)}).to_string());
+        }
+        let p = &c.paragraphs[0];
+        Ok(serde_json::json!({"kind":"plain","direction":c.direction,"align":c.vert_align,
+            "width":c.width,"maxWidth":c.max_width,"spacing":c.spacing,"includeMargin":c.include_margin,
+            "text":p.text,"paragraphShape":p.para_shape_id,"style":p.style_id,"runs":p.char_shapes,
+            "lines":p.serializable_line_segs()}).to_string())
+    }
