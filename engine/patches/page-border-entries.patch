+// Query geometry and drawing use the same slot and displayed page number.
+fn jueony_page_border_fill(section:&crate::model::document::SectionDef,page_number:u32)->&crate::model::page::PageBorderFill {
+    let slot=if page_number==0 {None} else if page_number.is_multiple_of(2) {Some(0)} else {Some(1)};
+    slot.and_then(|index|section.extra_page_border_fills.get(index)).unwrap_or(&section.page_border_fill)
