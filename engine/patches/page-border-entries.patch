+    pub fn set_page_border_fill_entry_native(&mut self, section_idx: usize, kind: &str, json: &str) -> Result<String, HwpError> {
+        use crate::model::style::{Fill, FillType, GradientFill};
+        let fail = |message: &str| HwpError::RenderError(message.into());
+        let slot = match kind { "both" => None, "even" => Some(0), "odd" => Some(1), _ => return Err(fail("Invalid page kind")) };
+        if section_idx >= self.document.sections.len() { return Err(fail("Invalid section")); }
+        if self.document.doc_info.border_fills.len()>=65534 {return Err(fail("Border fill resource limit"));}
+        let mut value: serde_json::Value = serde_json::from_str(json).map_err(|_|fail("Invalid page settings JSON"))?;
+        if !value.is_object() { return Err(fail("Invalid page settings")); }
+        let apply = value.get("applyPage").and_then(|v|v.as_str()).unwrap_or("all").to_owned();
+        if !["all","exceptFirst","firstOnly"].contains(&apply.as_str()) { return Err(fail("Invalid page application")); }
+        let fill_type=value.get("fillType").and_then(|v|v.as_str()).unwrap_or("none");
+        if !["none","solid","gradient"].contains(&fill_type) { return Err(fail("Image background editing is unsupported")); }
+        let gradient = if fill_type == "gradient" {
+            let g=value.get("gradient").ok_or_else(||fail("Missing gradient"))?;
+            let number=|key:&str,min:i64,max:i64|->Result<i16,HwpError>{let v=g.get(key).and_then(|v|v.as_i64()).ok_or_else(||fail("Invalid gradient value"))?;if v<min||v>max {return Err(fail("Gradient value out of range"));}Ok(v as i16)};
+            let colors=g.get("colors").and_then(|v|v.as_array()).ok_or_else(||fail("Invalid gradient colors"))?;
+            if colors.len()!=2 { return Err(fail("Only two-color gradients are supported")); }
+            let mut parsed=Vec::new();
+            for color in colors {
+                let text=color.as_str().ok_or_else(||fail("Invalid color"))?;
+                if text.len()!=7||!text.starts_with('#') {return Err(fail("Invalid color"));}
+                let rgb=u32::from_str_radix(&text[1..],16).map_err(|_|fail("Invalid color"))?;
+                parsed.push(((rgb>>16)&255)| (rgb&0x00ff00) | ((rgb&255)<<16));
+            }
+            if g.get("positions").and_then(|v|v.as_array()).is_some_and(|v|!v.is_empty()) {return Err(fail("Custom color stops are unsupported"));}
+            Some(GradientFill {gradient_type:number("type",1,4)?,angle:number("angle",0,360)?,center_x:number("centerX",0,100)?,center_y:number("centerY",0,100)?,blur:number("blur",0,100)?,step_center:number("stepCenter",0,100)? as u8,colors:parsed,positions:Vec::new()})
+        } else {None};
+        let original=self.document.sections[section_idx].section_def.page_border_fill.clone();
+        let selected=slot.and_then(|index|self.document.sections[section_idx].section_def.extra_page_border_fills.get(index)).cloned().unwrap_or_else(||original.clone());
+        value["borderFillId"]=serde_json::json!(selected.border_fill_id);
+        if gradient.is_some() {value["fillType"]=serde_json::json!("none");}
+        self.document.sections[section_idx].section_def.page_border_fill=selected;
+        self.set_page_border_fill_native(section_idx,&value.to_string())?;
+        let mut updated=self.document.sections[section_idx].section_def.page_border_fill.clone();
+        if let Some(gradient)=gradient {
+            let mut bf=self.document.doc_info.border_fills.get((updated.border_fill_id-1) as usize).cloned().ok_or_else(||fail("Missing fill"))?;
+            bf.raw_data=None;bf.fill=Fill {fill_type:FillType::Gradient,gradient:Some(gradient),..Default::default()};
+            self.document.doc_info.border_fills.push(bf);
+            updated.border_fill_id=self.document.doc_info.border_fills.len() as u16;
+            self.document.sections[section_idx].section_def.page_border_fill=updated.clone();
+            self.document.doc_info.raw_stream_dirty=true;
+        }
+        let section=&mut self.document.sections[section_idx];let sd=&mut section.section_def;
+        if let Some(slot)=slot {
+            sd.page_border_fill=original.clone();
+            while sd.extra_page_border_fills.len()<2 {sd.extra_page_border_fills.push(original.clone());}
+            sd.extra_page_border_fills[slot]=updated;
+        } else {for entry in &mut sd.extra_page_border_fills {*entry=updated.clone();}}
+        sd.first_page_border=value.get("firstPageBorder").and_then(|v|v.as_bool()).unwrap_or(apply=="firstOnly");
+        sd.first_page_fill=value.get("firstPageFill").and_then(|v|v.as_bool()).unwrap_or(apply=="firstOnly");
+        sd.hide_border=value.get("hideBorder").and_then(|v|v.as_bool()).unwrap_or(apply=="exceptFirst");
