+        let (width,height)=image::ImageReader::with_format(std::io::Cursor::new(data),format).into_dimensions().map_err(|_|fail())?;
+        if width==0||height==0||width>8192||height>8192||width as u64*height as u64>16_000_000{return Err(fail());}
