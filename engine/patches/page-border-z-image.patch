+    pub fn register_page_background_image_native(&mut self,data:&[u8],extension:&str)->Result<String,HwpError>{
+        let fail=||HwpError::RenderError("배경 그림은 10MiB 이하 PNG/JPEG, 8192px 이하·1600만 픽셀 이하만 지원합니다.".into());
