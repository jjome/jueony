+++ b/src/document_core/commands/section_ops.rs
@@ -0,0 +1,431 @@
+//! Actual body section splitting. The legacy HwpCtrl marker operation remains separate.
+//!
+//! Paragraph boundaries follow the recorded native BreakSection observations in
+//! mydocs/plans/archives/hwpctrl_ocx_full_compat.md section 4.45: a middle caret
+//! splits text, a start caret uses that paragraph, and an end caret uses the next.
+//! Independent Hancom save/print validation is required for layout parity.
+
+use crate::document_core::DocumentCore;
+use crate::error::HwpError;
+use crate::model::control::Control;
+use crate::model::document::{Section, SectionDef};
+use crate::model::page::ColumnDef;
+use crate::model::paragraph::{ColumnBreakType, Paragraph};
+
+fn invalid(reason: &str) -> HwpError {
+    HwpError::InvalidField(reason.to_string())
+}
+
+/// Publish SectionDef/ColumnDef and their stream slots at the same owner boundary.
+/// Control-data indices are shifted together; definitions already at the front
+/// are replaced, while following content and its relative control order survive.
+fn install_definitions(para: &mut Paragraph, definition: &SectionDef, columns: ColumnDef) {
+    let existing = para
+        .controls
+        .iter()
+        .take_while(|control| matches!(control, Control::SectionDef(_) | Control::ColumnDef(_)))
+        .count();
+    if existing > 0 {
+        para.controls.drain(..existing);
+        let removed = existing.min(para.ctrl_data_records.len());
+        para.ctrl_data_records.drain(..removed);
+    }
+    for range in &mut para.field_ranges {
+        range.control_idx = range.control_idx.saturating_sub(existing) + 2;
+    }
+    if existing > 2 {
+        para.release_leading_extended_control_slots(existing - 2);
+    } else {
+        for _ in existing..2 {
+            para.shift_for_control_slot_insert(0);
+        }
+        para.char_count = para.char_count.saturating_add(((2 - existing) * 8) as u32);
+    }
+    para.controls.insert(0, Control::ColumnDef(columns));
+    para.controls
+        .insert(0, Control::SectionDef(Box::new(definition.clone())));
+    para.ctrl_data_records.insert(0, None);
+    para.ctrl_data_records.insert(0, None);
+    para.control_mask |= 1 << 2;
+    para.has_para_text = true;
+    para.column_type = ColumnBreakType::Section;
+    para.raw_break_type = 0;
+    para.page_break_synthesized = false;
+    para.invalidate_layout_inputs();
+}
+
+impl DocumentCore {
+    /// Remove a body section boundary and retain the preceding section settings.
+    /// Boundary paragraph text is concatenated; the caller owns snapshot undo.
+    /// Unsupported field/object/definition scopes are rejected before publishing.
+    pub fn merge_section_boundary_native(
+        &mut self,
+        right_section_idx: usize,
+    ) -> Result<String, HwpError> {
+        if right_section_idx == 0 || right_section_idx >= self.document.sections.len() {
+            return Err(invalid("삭제할 구역 경계가 범위를 벗어났습니다"));
+        }
+        let left_idx = right_section_idx - 1;
+        let original_left = &self.document.sections[left_idx];
+        let original_right = &self.document.sections[right_section_idx];
+        let left_para_idx = original_left
+            .paragraphs
+            .len()
+            .checked_sub(1)
+            .ok_or_else(|| invalid("이전 구역에 본문 문단이 없습니다"))?;
+        let left_boundary = &original_left.paragraphs[left_para_idx];
+        let right_boundary = original_right
+            .paragraphs
+            .first()
+            .ok_or_else(|| invalid("다음 구역에 본문 문단이 없습니다"))?;
+        for paragraph in [left_boundary, right_boundary] {
+            if paragraph.char_offsets.len() != paragraph.text.chars().count()
+                || paragraph
+                    .char_offsets
+                    .last()
+                    .is_some_and(|pos| *pos >= paragraph.char_count)
+                || !paragraph.field_ranges.is_empty()
+                || !paragraph.range_tags.is_empty()
+                || !paragraph.title_marks.is_empty()
+                || paragraph.tab_extended.len()
+                    > paragraph.text.chars().filter(|ch| *ch == '\t').count()
+            {
+                return Err(invalid(
+                    "경계 문단의 필드·범위·문자 위치 정보는 병합을 지원하지 않습니다",
+                ));
+            }
+        }
+        // merge_from can preserve leading left definitions and HF controls, but
+        // a right object or HF would acquire a new paragraph/section owner.
+        if left_boundary.controls.iter().any(|control| {
+            !matches!(
+                control,
+                Control::SectionDef(_)
+                    | Control::ColumnDef(_)
+                    | Control::Header(_)
+                    | Control::Footer(_)
+            )
+        }) || right_boundary
+            .controls
+            .iter()
+            .any(|control| !matches!(control, Control::SectionDef(_) | Control::ColumnDef(_)))
+        {
+            return Err(invalid(
+                "개체·필드·머리말·꼬리말이 있는 경계 문단은 병합을 지원하지 않습니다",
+            ));
+        }
+        if [original_left, original_right].iter().any(|section| {
+            section
+                .paragraphs
+                .iter()
+                .any(|para| !para.orphan_field_ends.is_empty())
+        }) {
+            return Err(invalid(
+                "여러 문단에 걸친 필드가 있는 구역은 먼저 필드 범위를 정리해야 합니다",
+            ));
+        }
+        // Deleting a boundary keeps the preceding page/column/HF settings. An
+        // independent right HF or a later definition would silently replace
+        // those settings after a move, so leave that case untouched for now.
+        if original_right
+            .paragraphs
+            .iter()
+            .enumerate()
+            .any(|(index, para)| {
+                para.controls.iter().any(|control| {
+                    matches!(control, Control::Header(_) | Control::Footer(_))
+                        || (index > 0
+                            && matches!(control, Control::SectionDef(_) | Control::ColumnDef(_)))
+                })
+            })
+        {
+            return Err(invalid(
+                "다음 구역에 독립 머리말·꼬리말 또는 추가 구역·단 정의가 있어 병합할 수 없습니다",
+            ));
+        }
+        let definitions = right_boundary.controls.len();
+        if definitions > 2
+            || right_boundary
+                .controls
+                .iter()
+                .filter(|c| matches!(c, Control::SectionDef(_)))
+                .count()
+                > 1
+            || right_boundary
+                .controls
+                .iter()
+                .filter(|c| matches!(c, Control::ColumnDef(_)))
+                .count()
+                > 1
+            || right_boundary
+                .char_offsets
+                .first()
+                .is_some_and(|pos| *pos != (definitions * 8) as u32)
+        {
+            return Err(invalid(
+                "다음 구역의 시작 정의 위치는 병합을 지원하지 않습니다",
+            ));
+        }
+        if u64::from(left_boundary.char_count) + u64::from(right_boundary.char_count)
+            > u64::from(u32::MAX)
+        {
+            return Err(invalid("병합 문단의 저장 문자 수 제한을 초과합니다"));
+        }
+        // Staged mutation: section contents, caches and raw provenance remain
+        // byte-for-byte unchanged if any preflight above fails.
+        let mut left = original_left.clone();
+        let mut right = original_right.clone();
+        let mut tail = right.paragraphs.remove(0);
+        tail.controls.clear();
+        tail.ctrl_data_records.clear();
+        if tail.text.is_empty() {
+            // The generic release helper has no first text offset to inspect.
+            let released = (definitions * 8) as u32;
+            tail.char_count = tail.char_count.saturating_sub(released);
+            for run in &mut tail.char_shapes {
+                run.start_pos = run.start_pos.saturating_sub(released);
+            }
+        } else {
+            tail.release_leading_extended_control_slots(definitions);
+        }
+        tail.column_type = ColumnBreakType::None;
+        tail.raw_break_type = 0;
+        tail.page_break_synthesized = false;
+        let merged = &mut left.paragraphs[left_para_idx];
+        let caret_offset = merged.text.chars().count();
+        let left_tab_count = merged.text.chars().filter(|ch| *ch == '\t').count();
+        let right_tab_count = tail.text.chars().filter(|ch| *ch == '\t').count();
+        // merge_from omits TAB extended data; reserve missing entries so a
+        // right tab never receives an earlier left tab's width/leader metadata.
+        merged
+            .tab_extended
+            .resize(left_tab_count, [0, 0, 0, 0, 0, 0, 9]);
+        tail.tab_extended
+            .resize(right_tab_count, [0, 0, 0, 0, 0, 0, 9]);
+        let right_tabs = tail.tab_extended.clone();
+        merged.merge_from(&tail);
+        merged.tab_extended.extend(right_tabs);
+        merged.invalidate_layout_inputs();
+        left.paragraphs.extend(right.paragraphs);
+        left.raw_stream = None;
+        left.raw_provenance = None;
+        self.document.sections[left_idx] = left;
+        self.document.sections.remove(right_section_idx);
+        self.document.doc_properties.section_count = self.document.sections.len() as u16;
+        self.document.doc_properties.raw_data = None;
+        self.document.doc_info.raw_stream_dirty = true;
+        self.pending_pagination_job = None;
+        self.deferred_pagination_descriptor = None;
+        self.deferred_pagination_revision = self.deferred_pagination_revision.wrapping_add(1);
+        self.para_column_map.clear();
+        self.rebuild_resolved_styles();
+        // Moved text now uses the preceding section's paper/column/tab values.
+        // Earlier paragraphs and every later section retain their content.
+        self.reflow_paragraph(left_idx, left_para_idx);
+        for index in left_para_idx + 1..self.document.sections[left_idx].paragraphs.len() {
+            self.document.sections[left_idx].paragraphs[index]
+                .line_segs
+                .clear();
+            self.reflow_paragraph(left_idx, index);
+        }
+        let hwp3_layout = self.document.layout_profile().hwp3_layout();
+        let moved_end = self.document.sections[left_idx].paragraphs.len();
+        crate::renderer::composer::recalculate_section_vpos(
+            &mut self.document.sections[left_idx].paragraphs,
+            left_para_idx,
+            Some(left_para_idx + 1..moved_end),
+            None,
+            &self.styles,
+            self.dpi,
+            hwp3_layout,
+        );
+        self.rebuild_derived_state();
+        Ok(
+            serde_json::json!({"ok":true,"sectionIdx":left_idx,"paraIdx":left_para_idx,
+            "charOffset":caret_offset,"pageCount":self.page_count()})
+            .to_string(),
+        )
+    }
+
+    /// Split a root body section at a paragraph logical character offset.
+    ///
+    /// It returns a section-local caret, not HwpCtrl stream units. Table cells,
+    /// HF/note lists and object selections have no representation in this API.
+    /// The selected paragraph must be plain text (leading definitions and HF
+    /// definitions are allowed); objects in other paragraphs move intact. A
+    /// cross-paragraph field is rejected before changing any document state.
+    /// The caller owns one snapshot history operation around this structural edit.
+    pub fn insert_section_break_native(
+        &mut self,
+        section_idx: usize,
+        para_idx: usize,
+        char_offset: usize,
+    ) -> Result<String, HwpError> {
+        let original = self
+            .document
+            .sections
+            .get(section_idx)
+            .ok_or_else(|| invalid("구역 인덱스가 범위를 벗어났습니다"))?;
+        let paragraph = original
+            .paragraphs
+            .get(para_idx)
+            .ok_or_else(|| invalid("본문 문단 인덱스가 범위를 벗어났습니다"))?;
+        if self.document.sections.len() >= u16::MAX as usize {
+            return Err(invalid("구역 개수 제한을 초과합니다"));
+        }
+        let length = paragraph.text.chars().count();
+        if char_offset > length {
+            return Err(invalid("본문 글자 위치가 범위를 벗어났습니다"));
+        }
+        if paragraph.char_offsets.len() != length {
+            return Err(invalid("문단의 문자 위치 정보가 완전하지 않습니다"));
+        }
+        if !paragraph.field_ranges.is_empty()
+            || !paragraph.range_tags.is_empty()
+            || paragraph.controls.iter().any(|control| {
+                !matches!(
+                    control,
+                    Control::SectionDef(_)
+                        | Control::ColumnDef(_)
+                        | Control::Header(_)
+                        | Control::Footer(_)
+                )
+            })
+        {
+            return Err(invalid(
+                "개체·필드·범위 태그가 있는 문단에서는 구역을 나눌 수 없습니다",
+            ));
+        }
+        // A field begun in one body paragraph and ended in another cannot cross
+        // two BodyText streams. Do not silently detach its original endpoint.
+        if original
+            .paragraphs
+            .iter()
+            .any(|para| !para.orphan_field_ends.is_empty())
+        {
+            return Err(invalid(
+                "여러 문단에 걸친 필드가 있는 구역은 먼저 필드 범위를 정리해야 합니다",
+            ));
+        }
+        if original.paragraphs.iter().enumerate().any(|(index, para)| {
+            index > 0
+                && para
+                    .controls
+                    .iter()
+                    .any(|control| matches!(control, Control::SectionDef(_)))
+        }) {
+            return Err(invalid(
+                "구역 내부에 별도 구역 정의가 있는 문서는 먼저 구조 정리가 필요합니다",
+            ));
+        }
+        // Split a staged copy. Every fallible validation is above this point;
+        // neither rejected positions nor unsupported controls touch raw streams,
+        // rendered caches, or the snapshot journal.
+        let mut left = original.clone();
+        let boundary;
+        let at_end = char_offset == length && length > 0;
+        if at_end {
+            boundary = para_idx + 1;
+            if boundary == left.paragraphs.len() {
+                left.paragraphs.push(Paragraph::new_empty_like(paragraph));
+            }
+        } else if char_offset == 0 && para_idx > 0 {
+            boundary = para_idx;
+        } else {
+            // The initial paragraph has nowhere before it to keep a nonempty
+            // Section0. Keep its definitions on a left empty paragraph instead
+            // of emitting an invalid section containing no paragraphs.
+            let original_tabs = left.paragraphs[para_idx].tab_extended.clone();
+            let mut tail = left.paragraphs[para_idx].split_at(char_offset);
+            let before_tabs = left.paragraphs[para_idx]
+                .text
+                .chars()
+                .filter(|ch| *ch == '\t')
+                .count();
+            left.paragraphs[para_idx].tab_extended =
+                original_tabs[..before_tabs.min(original_tabs.len())].to_vec();
+            tail.tab_extended = original_tabs[before_tabs.min(original_tabs.len())..].to_vec();
+            boundary = para_idx + 1;
+            left.paragraphs.insert(boundary, tail);
+        }
+        let target_occupied = left.paragraphs[boundary].column_type != ColumnBreakType::None
+            || matches!(
+                left.paragraphs[boundary].controls.first(),
+                Some(Control::SectionDef(_) | Control::ColumnDef(_))
+            );
+        let mut caret_para = 0usize;
+        if target_occupied {
+            let blank = Paragraph::new_empty_like(&left.paragraphs[boundary]);
+            left.paragraphs.insert(boundary, blank);
+            if !at_end && char_offset == 0 {
+                caret_para = 1;
+            }
+        }
+        let inherited_columns = Self::find_column_def_for_paragraph(&left.paragraphs, boundary);
+        let mut right = Section {
+            section_def: left.section_def.clone(),
+            paragraphs: left.paragraphs.split_off(boundary),
+            raw_stream: None,
+            raw_provenance: None,
+        };
+        // Explicit start numbers belong to the old section. A new section
+        // continues the page/object counters instead of restarting them.
+        right.section_def.page_num = 0;
+        right.section_def.page_num_type = 0;
+        right.section_def.flags &= !(3 << 20);
+        right.section_def.picture_num = 0;
+        right.section_def.table_num = 0;
+        right.section_def.equation_num = 0;
+        install_definitions(
+            &mut right.paragraphs[0],
+            &right.section_def,
+            inherited_columns,
+        );
+        left.raw_stream = None;
+        left.raw_provenance = None;
+        // Source HF controls stay on the original paragraphs. The renderer's
+        // existing odd/even carry logic supplies inheritance to the new section;
+        // duplicating controls would create a second independent definition.
+        self.document.sections[section_idx] = left;
+        self.document.sections.insert(section_idx + 1, right);
+        self.document.doc_properties.section_count = self.document.sections.len() as u16;
+        self.document.doc_properties.raw_data = None;
+        self.document.doc_info.raw_stream_dirty = true;
+        self.pending_pagination_job = None;
+        self.deferred_pagination_descriptor = None;
+        self.deferred_pagination_revision = self.deferred_pagination_revision.wrapping_add(1);
+        self.para_column_map.clear();
+        // Inserting a section shifts every later section index. Refresh the
+        // document-owned style aggregate before any reflow so section-specific
+        // tab widths cannot be read through the previous index map.
+        self.rebuild_resolved_styles();
+        // Reflow only the split/inserted boundary in the old section. The new
+        // stream starts from zero; its existing page/column reset boundaries
+        // remain semantic input rather than being flattened into one page.
+        let left_boundary = para_idx.min(self.document.sections[section_idx].paragraphs.len() - 1);
+        self.reflow_paragraph(section_idx, left_boundary);
+        self.reflow_body_paragraph(section_idx + 1, 0);
+        let hwp3_layout = self.document.layout_profile().hwp3_layout();
+        for affected in [section_idx, section_idx + 1] {
+            // This helper consumes paragraph before/after spacing and existing
+            // line metrics only; it does not resolve or measure tab stops.
+            crate::renderer::composer::recalculate_section_vpos(
+                &mut self.document.sections[affected].paragraphs,
+                if affected == section_idx {
+                    left_boundary
+                } else {
+                    0
+                },
+                None,
+                None,
+                &self.styles,
+                self.dpi,
+                hwp3_layout,
+            );
+        }
+        self.rebuild_derived_state();
+        Ok(serde_json::json!({"ok":true,"sectionIdx":section_idx + 1,
+            "paraIdx":caret_para,"charOffset":0,"pageCount":self.page_count()})
+        .to_string())
+    }
+}
