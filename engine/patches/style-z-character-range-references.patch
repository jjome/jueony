--- /dev/null
+++ b/tests/character_style_range_reference.rs
@@ -0,0 +1,111 @@
+//! Character-style ranges keep a durable definition link through their owned
+//! CharShape ID. Direct formatting with equal visible properties stays separate.
+#![cfg(not(target_arch = "wasm32"))]
+
+use rhwp::wasm_api::HwpDocument;
+
+fn style_shape(doc: &HwpDocument, style: usize) -> u32 {
+    u32::from(doc.document().doc_info.styles[style].char_shape_id)
+}
+
+fn shape_at(doc: &HwpDocument, offset: usize) -> u32 {
+    doc.document().sections[0].paragraphs[0]
+        .char_shape_id_at(offset)
+        .expect("character shape at offset")
+}
+
+fn fixture() -> (HwpDocument, usize, u32) {
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document_native().expect("blank document");
+    doc.insert_text_native(0, 0, 0, "가나다라마바사")
+        .expect("body text");
+    let normal = style_shape(&doc, 0);
+    let style = doc.create_style(
+        &format!(
+            r#"{{"name":"범위 강조","englishName":"RangeEmphasis","type":1,"nextStyleId":0,"baseCharShapeId":{normal},"baseParaShapeId":0}}"#
+        ),
+    );
+    assert!(style > 0, "character definition created");
+    let style = style as usize;
+    let owned = style_shape(&doc, style);
+    assert_ne!(owned, normal, "character definition owns its initial shape");
+    assert!(doc.update_style_shapes(style as u32, r#"{"bold":true}"#, "{}"));
+    let linked = style_shape(&doc, style);
+    assert_ne!(linked, owned, "definition edit allocates a replacement shape");
+    doc.set_char_shape_id_native(0, 0, 1, 3, linked)
+        .expect("apply definition shape to exact range");
+    doc.apply_char_format_native(0, 0, 4, 5, r#"{"bold":true}"#)
+        .expect("equal-looking direct format");
+    let direct = shape_at(&doc, 4);
+    assert_ne!(direct, linked, "direct format is not a definition link");
+    (doc, style, direct)
+}
+
+fn assert_initial_reopen(doc: &HwpDocument, style: usize, direct: u32) {
+    let linked = style_shape(doc, style);
+    assert_eq!(shape_at(doc, 1), linked);
+    assert_eq!(shape_at(doc, 2), linked);
+    assert_eq!(shape_at(doc, 4), direct);
+    assert_ne!(shape_at(doc, 0), linked);
+    assert_ne!(direct, linked);
+}
+
+fn assert_updated(doc: &HwpDocument, style: usize, old_link: u32, direct: u32) {
+    let linked = style_shape(doc, style);
+    assert_ne!(linked, old_link, "definition receives a new CharShape ID");
+    assert_eq!(shape_at(doc, 1), linked, "linked range follows definition");
+    assert_eq!(shape_at(doc, 2), linked, "whole linked range follows definition");
+    assert_eq!(shape_at(doc, 4), direct, "equal-looking direct format stays direct");
+    assert_ne!(shape_at(doc, 0), linked, "outside text is unchanged");
+}
+
+fn verify_roundtrip(format: &str) {
+    let (doc, style, direct) = fixture();
+    let first = match format {
+        "hwp" => doc.export_hwp_native().expect("first HWP export"),
+        "hwpx" => doc.export_hwpx_native().expect("first HWPX export"),
+        _ => unreachable!(),
+    };
+    let mut reopened = HwpDocument::from_bytes(&first).expect("first reopen");
+    assert_initial_reopen(&reopened, style, direct);
+    let old_link = style_shape(&reopened, style);
+    assert!(reopened.update_style_shapes(
+        style as u32,
+        r##"{"italic":true,"textColor":"#224466"}"##,
+        "{}"
+    ));
+    assert_updated(&reopened, style, old_link, direct);
+    let second = match format {
+        "hwp" => reopened.export_hwp_native().expect("updated HWP export"),
+        "hwpx" => reopened.export_hwpx_native().expect("updated HWPX export"),
+        _ => unreachable!(),
+    };
+    let saved = HwpDocument::from_bytes(&second).expect("updated reopen");
+    assert_updated(&saved, style, old_link, direct);
+}
+
+#[test]
+fn character_style_range_link_survives_hwp_reopen_and_definition_edit() {
+    verify_roundtrip("hwp");
+}
+
+#[test]
+fn character_style_range_link_survives_hwpx_reopen_and_definition_edit() {
+    verify_roundtrip("hwpx");
+}
+
+#[test]
+fn ambiguous_shared_character_definition_refuses_before_mutation() {
+    let (mut doc, style, _) = fixture();
+    let duplicate = doc.create_style(
+        r#"{"name":"중복 정의","englishName":"Duplicate","type":1,"nextStyleId":0}"#,
+    );
+    assert!(duplicate > 0);
+    let linked = style_shape(&doc, style);
+    doc.document_mut().doc_info.styles[duplicate as usize].char_shape_id = linked as u16;
+    let before = doc.export_hwpx_native().expect("before bytes");
+    assert!(!doc.update_style_shapes(style as u32, r#"{"italic":true}"#, "{}"));
+    assert_eq!(doc.export_hwpx_native().expect("after bytes"), before);
+    assert_eq!(style_shape(&doc, style), linked);
+    assert_eq!(shape_at(&doc, 1), linked);
+}
