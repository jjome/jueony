 impl Paragraph {
+    /// Visible-text insertion positions for pictures backed by actual eight-unit
+    /// control slots. A missing offset or a trailing unresolved control has no
+    /// proven editable suffix. Display-only fallback positions are insufficient.
+    pub(crate) fn picture_text_anchors(&self) -> Option<Vec<u32>> {
+        if self.controls.is_empty() || self.controls.len() > 200
+            || !self.controls.iter().all(|c| matches!(c, Control::Picture(_)))
+            || !self.field_ranges.is_empty() || !self.orphan_field_ends.is_empty()
+            || !self.range_tags.is_empty() || !self.title_marks.is_empty()
+            || self.char_offsets.len() > 4000 || self.char_offsets.len() != self.text.chars().count()
+        {
+            return None;
+        }
+        let mut anchors = Vec::with_capacity(self.controls.len());
+        let mut end = 0;
+        for (i, (&offset, ch)) in self.char_offsets.iter().zip(self.text.chars()).enumerate() {
+            if ch.is_control() || ch == '\u{fffc}' { return None; }
+            let gap = offset.checked_sub(end)?;
+            let count = (gap / CTRL_CHAR_CODE_UNITS) as usize;
+            if gap % CTRL_CHAR_CODE_UNITS != 0 || count > self.controls.len() - anchors.len() {
+                return None;
+            }
+            anchors.extend(std::iter::repeat_n(i as u32, count));
+            end = offset.checked_add(ch.len_utf16() as u32)?;
+        }
+        if anchors.len() != self.controls.len()
+            || self.control_text_positions().iter().copied().ne(anchors.iter().map(|&a| a as usize))
+        {
+            return None;
+        }
+        Some(anchors)
+    }
+
