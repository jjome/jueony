+            if n.enabled&&valid(n)&&self.line_number_section_supported(section){
+                if previous.is_none()||n.restart_type==1||n.restart_type==2&&previous!=Some(section){next=n.start_number as u64;}
+                previous=Some(section);
+                if index==page_num{current=Some(n);break 'pages;}
+                next=next.saturating_add(self.prior_page_line_count(section,page));
+            }else if index==page_num{break 'pages;}
+            index+=1;
+        }}
+        let Some(n)=current else{return Vec::new();};let mut body=Vec::new();lines(&tree.root,false,&mut body);
+        body.into_iter().enumerate().filter_map(|(i,(x,y))|{let value=next+i as u64;if value%n.count_by as u64==0{Some((value,x-n.distance as f64*self.dpi/7200.0,y))}else{None}}).collect()
+    }
+    pub(crate) fn append_line_numbers(&self,tree:&mut PageRenderTree,page_num:u32){
+        for (value,right,baseline) in self.line_number_markers(tree,page_num){
+            let style=crate::renderer::TextStyle{font_family:"함초롬바탕".into(),font_size:self.dpi*8.0/72.0,..Default::default()};let text=value.to_string();let width=crate::renderer::layout::compute_char_positions(&text,&style).last().copied().unwrap_or(0.0);
+            let bbox=BoundingBox::new(right-width,baseline-style.font_size,width,style.font_size);let node=RenderNode::new(tree.next_id(),RenderNodeType::TextRun(TextRunNode{text,baseline:style.font_size,style,char_shape_id:None,para_shape_id:None,section_index:None,para_index:None,char_start:None,cell_context:None,is_para_end:false,is_line_break_end:false,rotation:0.0,is_vertical:false,char_overlap:None,border_fill_id:0,field_marker:FieldMarkerType::None,layout_positions:None,display_text:None}),bbox);tree.root.children.push(node);
+        }
+    }
+    pub fn get_page_line_numbers_native(&self,page:u32)->Result<String,HwpError>{let tree=self.build_page_tree(page)?;Ok(serde_json::json!({"ok":true,"markers":self.line_number_markers(&tree,page).iter().map(|(n,x,y)|serde_json::json!({"number":n,"right":x,"baseline":y})).collect::<Vec<_>>()}).to_string())}
+}
