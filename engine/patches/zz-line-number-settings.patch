+fn fail(s:&str)->HwpError{HwpError::RenderError(s.into())}
+fn valid(n:&LineNumberSettings)->bool{(1..=3).contains(&n.restart_type)&&(1..=65535).contains(&n.count_by)&&(1..=65535).contains(&n.start_number)&&(0..=14173).contains(&n.distance)}
+
+impl DocumentCore {
+    pub(crate) fn line_number_section_supported(&self,section:usize)->bool {
+        let Some(s)=self.document.sections.get(section) else{return false;};
+        if s.section_def.text_direction!=0||s.section_def.hide_empty_line{return false;}
+        s.paragraphs.iter().all(|p|!self.document.doc_info.para_shapes.get(p.para_shape_id as usize).is_some_and(|ps|ps.suppress_line_numbers)&&p.controls.iter().all(|c|match c {
+            Control::SectionDef(_)|Control::Header(_)|Control::Footer(_)|Control::PageNumCtrl(_)|Control::PageHide(_)|Control::NewNumber(_)=>true,
+            Control::ColumnDef(col)=>col.column_count==1,
+            _=>false
+        }))
+    }
+    pub fn get_line_number_settings_native(&self,section:usize)->Result<String,HwpError>{
+        let s=self.document.sections.get(section).ok_or_else(||fail("Invalid section"))?;let n=&s.section_def.line_numbers;
+        Ok(serde_json::json!({"ok":true,"enabled":n.enabled,"restartType":n.restart_type,"countBy":n.count_by,"distance":n.distance,"startNumber":n.start_number,"editable":self.line_number_section_supported(section)&&(!n.enabled||valid(n)),"formatSupport":"hwpx","suppressedStyles":self.document.doc_info.para_shapes.iter().enumerate().filter_map(|(i,ps)|if ps.suppress_line_numbers{Some(i)}else{None}).collect::<Vec<_>>()}).to_string())
+    }
+    pub fn set_line_number_settings_native(&mut self,section:usize,json:&str)->Result<String,HwpError>{
+        let v:serde_json::Value=serde_json::from_str(json).map_err(|_|fail("Invalid line number JSON"))?;
+        let n=LineNumberSettings{enabled:v.get("enabled").and_then(|v|v.as_bool()).ok_or_else(||fail("Invalid enabled"))?,restart_type:v.get("restartType").and_then(|v|v.as_u64()).filter(|v|*v<=u32::MAX as u64).ok_or_else(||fail("Invalid restart"))? as u32,count_by:v.get("countBy").and_then(|v|v.as_u64()).filter(|v|*v<=u32::MAX as u64).ok_or_else(||fail("Invalid count"))? as u32,distance:v.get("distance").and_then(|v|v.as_i64()).filter(|v|*v>=i32::MIN as i64&&*v<=i32::MAX as i64).ok_or_else(||fail("Invalid distance"))? as i32,start_number:v.get("startNumber").and_then(|v|v.as_u64()).filter(|v|*v<=u32::MAX as u64).ok_or_else(||fail("Invalid start"))? as u32};
+        if !valid(&n){return Err(fail("줄 번호 값 범위를 확인하세요."));}
+        let s=self.document.sections.get(section).ok_or_else(||fail("Invalid section"))?;
+        if n.enabled&&(!self.line_number_section_supported(section)||n.distance as u32>=s.section_def.page_def.margin_left){return Err(fail("기본 줄 번호는 가로쓰기·한 단·일반 본문과 왼쪽 여백 안의 간격만 지원합니다."));}
+        if n==s.section_def.line_numbers{return self.get_line_number_settings_native(section);}
+        let s=&mut self.document.sections[section];s.section_def.line_numbers=n;
+        for p in &mut s.paragraphs{for c in &mut p.controls{if let Control::SectionDef(sd)=c{sd.line_numbers=s.section_def.line_numbers.clone();}}}
+        s.raw_stream=None;self.mark_section_dirty(section);self.paginate_if_needed();self.get_line_number_settings_native(section)
+    }
+    fn prior_page_line_count(&self,section:usize,page:&crate::renderer::pagination::PageContent)->u64{
+        use crate::renderer::pagination::PageItem;
+        page.column_contents.iter().flat_map(|c|&c.items).map(|item|match item{
+            PageItem::FullParagraph{para_index}=>self.composed.get(section).and_then(|c|c.get(*para_index)).map(|c|c.lines.len() as u64).unwrap_or(0),
+            PageItem::PartialParagraph{start_line,end_line,..}=>end_line.saturating_sub(*start_line) as u64,
+            _=>0
+        }).sum()
+    }
+    pub(crate) fn line_number_markers(&self,tree:&PageRenderTree,page_num:u32)->Vec<(u64,f64,f64)> {
+        fn lines(node:&RenderNode,body:bool,out:&mut Vec<(f64,f64)>){
+            match &node.node_type{
+                RenderNodeType::Header|RenderNodeType::Footer|RenderNodeType::MasterPage|RenderNodeType::FootnoteArea|RenderNodeType::Table(_)|RenderNodeType::TextBox|RenderNodeType::Group(_)=>return,
