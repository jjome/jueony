+//! Bounded deletion of full body paragraphs on one physical page.
+//! A spanning paragraph is rejected; the diagnostic page extractor is not reused.
+use crate::document_core::DocumentCore;
+use crate::error::HwpError;
+use crate::model::{control::Control,paragraph::Paragraph};
+use crate::renderer::pagination::PageItem;
+fn fail(s:&str)->HwpError{HwpError::RenderError(s.into())}
+fn simple(p:&Paragraph)->bool{
+    p.field_ranges.is_empty()&&p.orphan_field_ends.is_empty()&&p.range_tags.is_empty()&&p.title_marks.is_empty()&&p.controls.iter().all(|c|matches!(c,Control::SectionDef(_)|Control::ColumnDef(_)))
+}
+impl DocumentCore {
+    pub fn get_page_body_deletion_plan_native(&self,page_num:u32)->Result<String,HwpError>{
+        let mut global=0;let mut found=None;
+        'outer:for (si,pages) in self.pagination.iter().enumerate(){for page in &pages.pages{if global==page_num{found=Some((si,page));break 'outer;}global+=1;}}
