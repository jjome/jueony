+use super::{DocumentCore, FieldLocation, NestedEntry};
+use crate::document_core::table_calc::{evaluate_stored_formula, TableContext};
+use crate::error::HwpError;
+use crate::model::control::{Control, Field, FieldType, Parameter};
+use crate::model::paragraph::Paragraph;
+use crate::model::table::Table;
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+
+fn err(msg: &str) -> HwpError {
+    HwpError::InvalidField(msg.to_owned())
+}
+
+fn plain_field(p: &Paragraph) -> Result<&Field, HwpError> {
+    let ([Control::Field(f)], [range]) = (p.controls.as_slice(), p.field_ranges.as_slice()) else {
+        return Err(err("셀 전체를 차지하는 계산식 필드 하나를 선택하세요."));
+    };
+    if f.field_type != FieldType::Formula
+        || range.control_idx != 0
+        || range.start_char_idx != 0
+        || range.end_char_idx != p.text.chars().count()
+        || !p.range_tags.is_empty()
+        || !p.orphan_field_ends.is_empty()
+        || !p.tab_extended.is_empty()
+        || !p.title_marks.is_empty()
+        || !p.markpen_marks.is_empty()
+        || p.char_shapes
+            .windows(2)
+            .any(|r| r[0].char_shape_id != r[1].char_shape_id)
+        || p.ctrl_data_records.iter().any(Option::is_some)
+    {
+        return Err(err(
+            "복합 셀 또는 혼합 서식 계산식 필드는 지원하지 않습니다.",
+        ));
+    }
+    let (formula, tail) = f
+        .command
+        .rsplit_once("??")
+        .ok_or_else(|| err("계산식 필드의 원문을 확인할 수 없습니다."))?;
+    let (format, value) = tail
+        .split_once(";;")
+        .ok_or_else(|| err("계산식 표시 형식이 없습니다."))?;
+    if !formula.starts_with('=') || value != p.text || !valid_format(format) {
+        return Err(err(
+            "저장된 계산식의 표시값 또는 형식을 확인할 수 없습니다.",
+        ));
+    }
+    if !f.parameters.is_empty() || f.raw_parameters_xml.is_some() {
+        if f.parameters.items.len() != 5
+            || f.parameters.name.as_deref() != Some("")
+            || f.raw_parameters_xml
+                .as_ref()
+                .is_some_and(|raw| raw != &f.parameters.render_xml("parameters"))
+        {
+            return Err(err(
+                "추가 XML 속성이 있는 계산식 필드는 보존을 위해 편집할 수 없습니다.",
+            ));
+        }
+        let matches = f
+            .parameters
+            .items
+            .iter()
+            .zip(["Prop", "Command", "Formula", "ResultFormat", "LastResult"])
+            .all(|(item, key)| match item {
+                Parameter::Integer { name, value } => {
+                    key == "Prop"
+                        && name.as_deref() == Some(key)
+                        && *value == i64::from(f.extra_properties)
+                }
+                Parameter::String {
+                    name,
+                    value: item_value,
+                    ..
+                } if name.as_deref() == Some(key) => match key {
+                    "Command" => item_value == &f.command,
+                    "Formula" => item_value == formula,
+                    "ResultFormat" => item_value == format,
+                    "LastResult" => item_value == value,
+                    _ => false,
+                },
+                _ => false,
+            });
+        if !matches {
+            return Err(err("계산식 필드의 속성 원문이 일치하지 않습니다."));
+        }
+    }
+    Ok(f)
+}
+
+fn valid_format(format: &str) -> bool {
+    matches!(
+        format.strip_suffix(',').unwrap_or(format),
+        "%g" | "%.0f" | "%.1f" | "%.2f"
+    )
+}
+
+fn display(n: f64, format: &str) -> Result<String, HwpError> {
+    let grouped = format.ends_with(',');
+    if !valid_format(format) || !n.is_finite() || n.abs() >= 1e15 {
+        return Err(err("지원하지 않는 계산값 또는 결과 형식입니다."));
+    }
+    let text = match format.trim_end_matches(',') {
+        "%g" => {
+            // Full precision plain numbers only. C %g otherwise rounds to six
+            // significant figures or uses exponential notation.
+            let text = n.to_string();
+            let digits: String = text.chars().filter(char::is_ascii_digit).collect();
+            let significant = digits.trim_start_matches('0').trim_end_matches('0').len();
+            if significant > 6 || n.abs() >= 1e6 || (n != 0. && n.abs() < 0.0001) {
+                return Err(err(
+                    "이 값은 기본 형식의 유효 자릿수를 넘습니다. 고정 소수 자릿수를 선택하세요.",
+                ));
+            }
+            text
+        }
+        "%.0f" => format!("{n:.0}"),
+        "%.1f" => format!("{n:.1}"),
+        "%.2f" => format!("{n:.2}"),
+        _ => unreachable!(),
+    };
+    if !grouped {
+        return Ok(text);
+    }
+    let mut parts = text.split('.');
+    let integer = parts.next().unwrap_or_default();
+    let digits = integer.trim_start_matches('-');
+    let mut result = String::new();
+    if integer.starts_with('-') {
+        result.push('-');
+    }
+    for (i, c) in digits.char_indices() {
+        if i > 0 && (digits.len() - i) % 3 == 0 {
+            result.push(',');
+        }
+        result.push(c);
+    }
+    if let Some(fraction) = parts.next() {
+        result.push('.');
+        result.push_str(fraction);
+    }
+    Ok(result)
+}
+
+fn numeric(text: &str) -> Result<Option<f64>, HwpError> {
+    let text = text.trim();
+    if text.is_empty() {
+        return Ok(None);
+    }
+    let unsigned = text
+        .strip_prefix('-')
+        .or_else(|| text.strip_prefix('+'))
+        .unwrap_or(text);
+    let (whole, fraction) = unsigned.split_once('.').unwrap_or((unsigned, ""));
+    let groups: Vec<_> = whole.split(',').collect();
+    if !fraction.bytes().all(|b| b.is_ascii_digit())
+        || groups
+            .iter()
+            .any(|s| !s.bytes().all(|b| b.is_ascii_digit()))
+        || (groups.len() > 1
+            && (!(1..=3).contains(&groups[0].len()) || groups[1..].iter().any(|s| s.len() != 3)))
+    {
+        return Err(err("참조 셀의 숫자 형식을 확인하세요."));
+    }
+    let n = text
+        .replace(',', "")
+        .parse::<f64>()
+        .map_err(|_| err("참조 셀에 숫자가 필요합니다."))?;
+    if !n.is_finite() {
+        return Err(err("유한한 숫자를 사용하세요."));
+    }
+    Ok(Some(n))
+}
+
+struct Calculation<'a> {
+    table: &'a Table,
+    root: usize,
+    formula: &'a str,
+    memo: RefCell<BTreeMap<usize, Option<f64>>>,
+    stack: RefCell<Vec<usize>>,
+}
+
+impl Calculation<'_> {
+    fn value(&self, index: usize) -> Result<Option<f64>, HwpError> {
+        if let Some(value) = self.memo.borrow().get(&index) {
+            return Ok(*value);
+        }
+        if self.stack.borrow().contains(&index) {
+            return Err(err("표 계산식에 순환 참조가 있습니다."));
+        }
+        if self.stack.borrow().len() >= 16 {
+            return Err(err("계산식 참조 깊이가 16단계를 넘습니다."));
+        }
+        let cell = &self.table.cells[index];
+        let [p] = cell.paragraphs.as_slice() else {
+            return Err(err("여러 문단의 셀을 참조할 수 없습니다."));
+        };
+        let expr = if index == self.root {
+            self.formula
+        } else if p.controls.is_empty() && p.field_ranges.is_empty() {
+            return numeric(&p.text);
+        } else {
+            plain_field(p)?.command.rsplit_once("??").unwrap().0
+        };
+        self.stack.borrow_mut().push(index);
+        let failure = RefCell::new(None);
+        let ctx = TableContext {
+            row_count: self.table.row_count as usize,
+            col_count: self.table.col_count as usize,
+            current_row: cell.row as usize,
+            current_col: cell.col as usize,
+        };
+        let result = evaluate_stored_formula(expr, &ctx, &|col, row| {
+            if failure.borrow().is_some() {
+                return None;
+            }
+            match self.value(row * ctx.col_count + col) {
+                Ok(v) => v,
+                Err(error) => {
+                    *failure.borrow_mut() = Some(error);
+                    None
+                }
+            }
+        });
+        self.stack.borrow_mut().pop();
+        if let Some(error) = failure.into_inner() {
+            return Err(error);
+        }
+        let value = Some(result.map_err(|s| err(&s))?);
+        self.memo.borrow_mut().insert(index, value);
+        Ok(value)
+    }
+}
+
+// A single-cell operation cannot leave a dependent's stored display stale.
+fn reject_dependents(table: &Table, target: usize) -> Result<(), HwpError> {
+    for (index, cell) in table.cells.iter().enumerate() {
+        if index == target {
+            continue;
+        }
+        for p in &cell.paragraphs {
+            if p.controls.is_empty() && p.field_ranges.is_empty() {
+                continue;
+            }
+            if cell.paragraphs.len() != 1 {
+                return Err(err("복합 셀의 역참조를 확인할 수 없습니다."));
+            }
+            let field = plain_field(p)?;
+            let ctx = TableContext {
+                row_count: table.row_count.into(),
+                col_count: table.col_count.into(),
+                current_row: cell.row.into(),
+                current_col: cell.col.into(),
+            };
+            let expression = field.command.rsplit_once("??").unwrap().0;
+            let refers = std::cell::Cell::new(false);
+            evaluate_stored_formula(expression, &ctx, &|c, r| {
+                if r * ctx.col_count + c == target {
+                    refers.set(true);
+                }
+                Some(1.0)
+            })
+            .map_err(|_| err("다른 계산식의 참조 범위를 확인할 수 없습니다."))?;
+            if refers.get() {
+                return Err(err(
+                    "이 셀을 참조하는 계산식이 있습니다. 연쇄 갱신이 필요한 편집입니다.",
+                ));
+            }
+        }
+    }
+    Ok(())
+}
