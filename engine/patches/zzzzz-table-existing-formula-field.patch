+struct Plan {
+    location: FieldLocation,
+    command: String,
+    value: String,
+    response: String,
+}
+
+impl DocumentCore {
+    fn plan_table_formula_field(
+        &self,
+        section: usize,
+        paragraph: usize,
+        control: usize,
+        index: usize,
+        field_id: u32,
+        expected: &str,
+        formula: &str,
+        format: &str,
+    ) -> Result<Plan, HwpError> {
+        if self.document.header.distribution
+            || self.document.header.encrypted
+            || self.document.provenance.hwp3_lineage
+        {
+            return Err(err(
+                "보호되었거나 변환된 문서의 계산식은 편집할 수 없습니다.",
+            ));
+        }
+        let Some(Control::Table(table)) = self
+            .document
+            .sections
+            .get(section)
+            .and_then(|s| s.paragraphs.get(paragraph))
+            .and_then(|p| p.controls.get(control))
+        else {
+            return Err(err("본문 표 위치가 변경되었습니다."));
+        };
+        let columns = usize::from(table.col_count);
+        if table.common.locked
+            || columns == 0
+            || table.cells.len() != columns * usize::from(table.row_count)
+            || table.cells.len() > 200
+            || table.cells.iter().enumerate().any(|(i, c)| {
+                c.row_span != 1
+                    || c.col_span != 1
+                    || usize::from(c.row) != i / columns
+                    || usize::from(c.col) != i % columns
+            })
+        {
+            return Err(err(
+                "잠금·병합 없는 본문 표 200셀 이하에서 계산식을 지원합니다.",
+            ));
+        }
+        let cell = table
+            .cells
+            .get(index)
+            .ok_or_else(|| err("셀 위치가 변경되었습니다."))?;
+        if cell.cell_protect() || cell.paragraphs.len() != 1 {
+            return Err(err("보호·복합 셀에 계산식을 쓸 수 없습니다."));
+        }
+        let f = plain_field(&cell.paragraphs[0])?;
+        if f.field_id != field_id
+            || f.command != expected
+            || self
+                .collect_all_fields()
+                .iter()
+                .filter(|v| v.field.field_id == field_id)
+                .count()
+                != 1
+        {
+            return Err(err("계산식 원문 또는 필드 ID가 변경되었거나 중복됩니다."));
+        }
+        reject_dependents(table, index)?;
+        let calc = Calculation {
+            table,
+            root: index,
+            formula,
+            memo: RefCell::default(),
+            stack: RefCell::default(),
+        };
+        let result = calc
+            .value(index)?
+            .ok_or_else(|| err("계산값이 없습니다."))?;
+        let value = display(result, format)?;
+        let command = format!("{formula}??{format};;{value}");
+        let response = serde_json::json!({"ok":true,"fieldId":field_id,"formula":formula,"command":command,"value":value,"result":result}).to_string();
+        Ok(Plan {
+            location: FieldLocation {
+                section_index: section,
+                para_index: paragraph,
+                nested_path: vec![NestedEntry::TableCell {
+                    control_index: control,
+                    cell_index: index,
+                    para_index: 0,
+                }],
+            },
+            command,
+            value,
+            response,
+        })
+    }
+
+    pub fn preview_table_formula_field(
+        &self,
+        s: usize,
+        p: usize,
+        t: usize,
+        i: usize,
+        id: u32,
+        expected: &str,
+        formula: &str,
+        format: &str,
+    ) -> Result<String, HwpError> {
+        Ok(self
+            .plan_table_formula_field(s, p, t, i, id, expected, formula, format)?
+            .response)
+    }
+
+    pub fn update_table_formula_field(
+        &mut self,
+        s: usize,
+        p: usize,
+        t: usize,
+        i: usize,
+        id: u32,
+        expected: &str,
+        formula: &str,
+        format: &str,
+    ) -> Result<String, HwpError> {
+        let plan = self.plan_table_formula_field(s, p, t, i, id, expected, formula, format)?;
+        if plan.command == expected {
+            return Ok(plan.response);
+        }
+        self.validate_field_reflow_location(&plan.location)?;
+        let saved_section = self.document.sections[s].clone();
+        let saved_paths = self.text_reflowed_table_paths_for_snapshot();
+        let stored_end = self.field_body_flow_end(&plan.location);
+        let result = (|| {
+            let para = self.get_para_mut_at_location(&plan.location)?;
+            let original_props = plain_field(para)?.properties;
+            Self::replace_field_text_model(para, 0, &plan.value)?;
+            let Control::Field(f) = &mut para.controls[0] else {
+                return Err(err("계산식 필드가 변경되었습니다."));
+            };
+            f.properties = original_props;
+            for item in &mut f.parameters.items {
+                if let Parameter::String { name, value, .. } = item {
+                    match name.as_deref() {
+                        Some("Command") => *value = plan.command.clone(),
+                        Some("Formula") => *value = formula.to_owned(),
+                        Some("ResultFormat") => *value = format.to_owned(),
+                        Some("LastResult") => *value = plan.value.clone(),
+                        _ => {}
+                    }
+                }
+            }
+            f.raw_parameters_xml = None;
+            f.command = plan.command.clone();
+            self.reflow_field_location_after_edit(&plan.location, stored_end)?;
+            self.document.sections[s].raw_stream = None;
+            self.recompose_section(s);
+            Ok(())
+        })();
+        if let Err(error) = result {
+            self.document.sections[s] = saved_section;
+            self.restore_text_reflowed_tables_from_snapshot(&saved_paths);
+            self.rebuild_derived_state();
+            return Err(error);
+        }
+        Ok(plan.response)
+    }
+}
