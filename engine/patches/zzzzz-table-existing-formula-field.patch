+/// Validate every reference before enumerating a range from untrusted input.
+pub(crate) fn evaluate_stored_formula(formula: &str, ctx: &TableContext, get_cell: CellValueFn) -> Result<f64, String> {
+    let ast = super::parser::parse_checked_formula(formula).ok_or("계산식 구문을 확인하세요.")?;
+    let mut pending = vec![&ast];
+    while let Some(node) = pending.pop() {
+        match node {
+            FormulaNode::CellRef { col, row } => {
+                let (c, r) = resolve_cell_ref(col, *row, ctx)?;
+                if c >= ctx.col_count || r >= ctx.row_count { return Err("표 밖을 참조하는 계산식입니다.".into()); }
+            }
+            FormulaNode::Range {start, end} | FormulaNode::BinOp {left: start, right: end, ..} => {
+                pending.push(start); pending.push(end);
+            }
+            FormulaNode::Negate(inner) => pending.push(inner),
+            FormulaNode::FuncCall { name, args } => {
+                if args.is_empty() || !matches!(name.as_str(), "SUM" | "AVG" | "AVERAGE" | "PRODUCT" | "COUNT" | "MIN" | "MAX") {
+                    return Err("지원하지 않는 계산식 함수 또는 빈 인수입니다.".into());
+                }
+                pending.extend(args);
+            }
+            FormulaNode::Number(n) if !n.is_finite() => return Err("유한한 숫자를 사용하세요.".into()),
+            _ => {}
+        }
+    }
+    let result = eval_node(&ast, ctx, get_cell)?;
+    if result.is_finite() { Ok(result) } else { Err("계산 결과가 유한한 숫자가 아닙니다.".into()) }
 }
 
