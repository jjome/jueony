+/// Extract addresses without evaluating with dummy values (a legal expression may divide by them).
+pub(crate) fn stored_formula_references(formula: &str, ctx: &TableContext) -> Result<std::collections::BTreeSet<usize>, String> {
+    let ast = checked_stored_expression(formula, ctx)?;
+    let mut nodes = vec![&ast];
+    let mut refs = std::collections::BTreeSet::new();
+    while let Some(node) = nodes.pop() {
+        match node {
+            FormulaNode::Range { .. } | FormulaNode::Direction(_) | FormulaNode::CellRef { .. } => {
+                for (col, row) in collect_cells(node, ctx)? {
+                    refs.insert(row * ctx.col_count + col);
+                }
+            }
+            FormulaNode::BinOp { left, right, .. } => { nodes.push(left); nodes.push(right); }
+            FormulaNode::Negate(inner) => nodes.push(inner),
+            FormulaNode::FuncCall { args, .. } => nodes.extend(args),
+            FormulaNode::Number(_) => {}
+        }
+    }
+    Ok(refs)
 }
 
