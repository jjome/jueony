+fn removal_token(core:&DocumentCore,si:usize)->String{
+    let mut hasher=blake3::Hasher::new();let mut props=core.document.doc_properties.clone();
+    hasher.update(&(si as u64).to_le_bytes());
+    props.caret_list_id=0;props.caret_para_id=0;props.caret_char_pos=0;
+    hasher.update(&crate::model::raw_provenance::doc_info_model_digest(&core.document.doc_info,&props));
+    for section in &core.document.sections{hasher.update(&crate::model::raw_provenance::section_model_digest(section));}
+    hasher.finalize().to_hex().to_string()
+}
+fn retained_section_value(section:&crate::model::document::Section)->serde_json::Value{
