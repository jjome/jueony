+// Check the physical owner of every logical slot before using the cached grid.
+fn validate_formula_grid(table: &Table) -> Result<(), HwpError> {
+    let rows = usize::from(table.row_count);
+    let columns = usize::from(table.col_count);
+    let slots = rows * columns;
+    let invalid = || err("계산식은 주 셀이 확인된 200칸 이하의 표에서 지원합니다.");
+    if !(1..=200).contains(&slots) || table.cell_grid.len() != slots
+        || table.cell_grid.iter().any(Option::is_none) {
+        return Err(invalid());
+    }
+    let mut covered = 0;
+    for (i, cell) in table.cells.iter().enumerate() {
+        let (row, col) = (usize::from(cell.row), usize::from(cell.col));
+        let (height, width) = (usize::from(cell.row_span), usize::from(cell.col_span));
+        if height == 0 || width == 0 || row + height > rows || col + width > columns {
+            return Err(invalid());
+        }
+        for r in row..row + height {
+            for c in col..col + width {
+                if table.cell_grid[r * columns + c] != Some(i) { return Err(invalid()); }
+            }
+        }
+        covered += width * height;
+    }
+    if covered != slots { return Err(invalid()); }
+    Ok(())
+}
