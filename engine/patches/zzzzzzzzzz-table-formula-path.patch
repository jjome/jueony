+fn formula_location(section: usize, paragraph: usize, path: &FormulaPath, cell: usize) -> FieldLocation {
+    let mut nested_path: Vec<_> = path.iter().map(|&(control_index, cell_index, para_index)| {
+        NestedEntry::TableCell { control_index, cell_index, para_index }
+    }).collect();
+    if let Some(NestedEntry::TableCell { cell_index, para_index, .. }) = nested_path.last_mut() {
+        *cell_index = cell;
+        *para_index = 0;
+    }
+    FieldLocation { section_index: section, para_index: paragraph, nested_path }
