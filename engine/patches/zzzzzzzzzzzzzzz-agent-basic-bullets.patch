+//! A fixed default character bullet, applied through a private source token.
+use crate::document_core::DocumentCore;
+use crate::error::HwpError;
+use crate::model::style::Bullet;
+fn fail(s:&str)->HwpError{HwpError::RenderError(s.into())}
+impl DocumentCore{
+    pub fn set_agent_basic_bullet_native(&mut self,s:usize,p:usize,json:&str)->Result<String,HwpError>{
+        let v:serde_json::Value=serde_json::from_str(json).map_err(|_|fail("Invalid basic bullet command"))?;
+        if !v.as_object().is_some_and(|o|o.len()==2&&o.keys().all(|k|["token","character"].contains(&k.as_str()))){return Err(fail("Invalid basic bullet fields"));}
+        let source:serde_json::Value=serde_json::from_str(&self.get_agent_paragraph_list_native(s,p)).map_err(|_|fail("Invalid paragraph list source"))?;
+        if source["editable"]!=true||v["token"].as_str()!=source["token"].as_str(){return Err(fail("본문 원문·서식·번호 정의가 바뀌었거나 읽기 전용입니다."));}
+        let character=v["character"].as_str().filter(|c|["●","○","■","□","◆","◇","▶","▷"].contains(c)).ok_or_else(||fail("지원하는 기본 문자 글머리표를 선택하세요."))?.chars().next().unwrap();
+        let info=&self.document.doc_info;if info.bullets.len()>=200||info.char_shapes.is_empty(){return Err(fail("글머리표 정의 한도 또는 글자 모양 원본을 확인하세요."));}
+        let ps=&info.para_shapes[self.document.sections[s].paragraphs[p].para_shape_id as usize];
+        if ps.head_type==crate::model::style::HeadType::Bullet&&info.bullets.get(ps.numbering_id as usize-1).is_some_and(|b|b.bullet_char==character){return Err(fail("글머리표의 변경 내용이 없습니다."));}
+        let before=self.document.clone();let events=self.event_log.len();let id=before.doc_info.bullets.len()+1;
+        let bullet=Bullet{bullet_char:character,attr:1<<3,text_distance:50,..Default::default()};
+        let result=(||{self.document.doc_info.bullets.push(bullet.clone());self.document.doc_info.raw_stream_dirty=true;
+            self.apply_para_format_native(s,p,&serde_json::json!({"headType":"Bullet","numberingId":id,"paraLevel":0}).to_string())?;
+            let mut expected=serde_json::to_value(&before.doc_info.bullets).map_err(|_|fail("Invalid source bullets"))?;expected.as_array_mut().unwrap().push(serde_json::to_value(&bullet).unwrap());
+            if serde_json::to_value(&self.document.doc_info.bullets).unwrap()!=expected||serde_json::to_value(&self.document.doc_info.numberings).unwrap()!=serde_json::to_value(&before.doc_info.numberings).unwrap(){return Err(fail("공유 번호 정의가 계획과 다릅니다."));}
+            let now=&self.document.doc_info.para_shapes[self.document.sections[s].paragraphs[p].para_shape_id as usize];
+            if now.head_type!=crate::model::style::HeadType::Bullet||now.numbering_id as usize!=id||now.para_level!=0{return Err(fail("기본 글머리표 적용 결과가 다릅니다."));}
+            Ok(serde_json::json!({"editable":true,"definitionId":id,"created":true}).to_string())})();
+        if result.is_err(){self.document=before;self.event_log.truncate(events);self.rebuild_derived_state();}result
+    }
+}
