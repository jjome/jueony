+//! Unsupported paragraph restart overrides must never produce a zero-loss report.
+use crate::model::{document::Document,paragraph::Paragraph,control::Control,shape::ShapeObject};
+use super::content_loss::{ContentLoss,ContentLossCode,ContentLossReason,ContentLossSubject,ContentLossReport};
+enum Node<'a>{Paragraph(&'a Paragraph,String),Shape(&'a ShapeObject,String)}
+fn paragraphs<'a>(stack:&mut Vec<Node<'a>>,items:&'a [Paragraph],path:&str){for(i,p)in items.iter().enumerate().rev(){stack.push(Node::Paragraph(p,format!("{path}/paragraph/{i}")));}}
+fn caption<'a>(stack:&mut Vec<Node<'a>>,value:Option<&'a crate::model::shape::Caption>,path:&str){if let Some(c)=value{paragraphs(stack,&c.paragraphs,&format!("{path}/caption"));}}
+fn drawing<'a>(stack:&mut Vec<Node<'a>>,value:&'a crate::model::shape::DrawingObjAttr,path:&str){caption(stack,value.caption.as_ref(),path);if let Some(t)=&value.text_box{paragraphs(stack,&t.paragraphs,&format!("{path}/textbox"));}}
+pub(super) fn record(doc:&Document,report:&mut ContentLossReport){
+    let mut stack=Vec::new();
+    for(i,s)in doc.sections.iter().enumerate().rev(){paragraphs(&mut stack,&s.paragraphs,&format!("section/{i}/body"));for(j,m)in s.section_def.master_pages.iter().enumerate().rev(){paragraphs(&mut stack,&m.paragraphs,&format!("section/{i}/master/{j}"));}}
+    while let Some(node)=stack.pop(){match node{
+        Node::Paragraph(p,path)=>{
+            if p.numbering_restart.is_some(){report.record(ContentLoss{code:ContentLossCode::MetadataReduced,subject:ContentLossSubject::ParagraphProperties,path:format!("{path}/numberingRestart"),reason:ContentLossReason::SerializerNotImplemented,resource_id:None});}
+            for(i,c)in p.controls.iter().enumerate().rev(){let key=format!("{path}/control/{i}");match c{
+                Control::Table(t)=>{caption(&mut stack,t.caption.as_ref(),&key);for(j,c)in t.cells.iter().enumerate().rev(){paragraphs(&mut stack,&c.paragraphs,&format!("{key}/cell/{j}"));}},
+                Control::Shape(s)=>stack.push(Node::Shape(s,key)),
+                Control::Picture(p)=>caption(&mut stack,p.caption.as_ref(),&key),
+                Control::Header(h)=>paragraphs(&mut stack,&h.paragraphs,&format!("{key}/header")),
+                Control::Footer(h)=>paragraphs(&mut stack,&h.paragraphs,&format!("{key}/footer")),
+                Control::Footnote(n)=>paragraphs(&mut stack,&n.paragraphs,&format!("{key}/footnote")),
+                Control::Endnote(n)=>paragraphs(&mut stack,&n.paragraphs,&format!("{key}/endnote")),
+                Control::HiddenComment(c)=>paragraphs(&mut stack,&c.paragraphs,&format!("{key}/comment")),
+                Control::Field(f)=>paragraphs(&mut stack,&f.memo_paragraphs,&format!("{key}/memo")),
+                Control::SectionDef(d)=>for(j,m)in d.master_pages.iter().enumerate().rev(){paragraphs(&mut stack,&m.paragraphs,&format!("{key}/master/{j}"));},_=>{}
+            }}
+        },
+        Node::Shape(s,path)=>match s{
+            ShapeObject::Group(g)=>{caption(&mut stack,g.caption.as_ref(),&path);for(i,s)in g.children.iter().enumerate().rev(){stack.push(Node::Shape(s,format!("{path}/shape/{i}")));}},
+            ShapeObject::Picture(p)=>caption(&mut stack,p.caption.as_ref(),&path),
+            ShapeObject::Chart(c)=>{caption(&mut stack,c.caption.as_ref(),&path);drawing(&mut stack,&c.drawing,&path);},
+            ShapeObject::Ole(o)=>{caption(&mut stack,o.caption.as_ref(),&path);drawing(&mut stack,&o.drawing,&path);},
+            _=>if let Some(d)=s.drawing(){drawing(&mut stack,d,&path);}
+        }
+    }}
+}
+
+#[cfg(test)]
+mod tests{
+    use super::*;
+    use crate::model::{document::Section,paragraph::NumberingRestart,header_footer::{Header,MasterPage},table::{Table,Cell}};
+    use crate::serializer::content_loss::SerializedFormat;
+    fn marked(n:u32)->Paragraph{Paragraph{numbering_restart:Some(NumberingRestart::NewStart(n)),..Default::default()}}
+    #[test]fn restart_loss_locations_cover_body_nested_cell_header_and_master(){
+        let mut root=marked(3);let cell=Cell{paragraphs:vec![marked(4)],..Default::default()};
+        root.controls.push(Control::Table(Box::new(Table{cells:vec![cell],..Default::default()})));
+        root.controls.push(Control::Header(Box::new(Header{paragraphs:vec![Paragraph{numbering_restart:Some(NumberingRestart::ContinuePrevious),..Default::default()}],..Default::default()})));
+        let mut section=Section{paragraphs:vec![root],..Default::default()};section.section_def.master_pages.push(MasterPage{paragraphs:vec![marked(9)],..Default::default()});
+        let mut doc=Document::default();doc.sections.push(section);
+        for format in [SerializedFormat::Hwp,SerializedFormat::Hwpx]{let mut report=ContentLossReport::new(format);record(&doc,&mut report);let mut paths=report.losses().iter().map(|l|l.path.as_str()).collect::<Vec<_>>();paths.sort();
+            assert_eq!(paths,vec!["section/0/body/paragraph/0/control/0/cell/0/paragraph/0/numberingRestart","section/0/body/paragraph/0/control/1/header/paragraph/0/numberingRestart","section/0/body/paragraph/0/numberingRestart","section/0/master/0/paragraph/0/numberingRestart"]);
+            assert!(report.losses().iter().all(|l|l.code==ContentLossCode::MetadataReduced&&l.subject==ContentLossSubject::ParagraphProperties&&l.reason==ContentLossReason::SerializerNotImplemented&&l.resource_id.is_none()));
+        }
+        assert_eq!(doc.sections[0].paragraphs[0].numbering_restart,Some(NumberingRestart::NewStart(3)));
+    }
+    #[test]fn ordinary_paragraphs_have_no_false_loss(){let mut doc=Document::default();doc.sections.push(Section{paragraphs:vec![Paragraph::default()],..Default::default()});let mut report=ContentLossReport::new(SerializedFormat::Hwp);record(&doc,&mut report);assert!(report.is_empty());}
+    #[test]fn nested_tree_walk_does_not_use_the_rust_call_stack(){let mut p=marked(1);for _ in 0..100{p=Paragraph{controls:vec![Control::Table(Box::new(Table{cells:vec![Cell{paragraphs:vec![p],..Default::default()}],..Default::default()}))],..Default::default()};}let mut doc=Document::default();doc.sections.push(Section{paragraphs:vec![p],..Default::default()});let mut report=ContentLossReport::new(SerializedFormat::Hwpx);record(&doc,&mut report);assert_eq!(report.len(),1);}
+}
