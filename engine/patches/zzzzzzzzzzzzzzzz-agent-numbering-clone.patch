+pub(crate) fn agent_numbering_raw_supported(n:&Numbering)->bool{
+    let Some(raw)=&n.raw_para_heads else{return true;};
+    let mut plain=n.clone();plain.raw_para_heads=None;
+    let mut w=Writer::new(Vec::new());if write_numbering(&mut w,0,&plain).is_err(){return false;}
+    let Ok(xml)=String::from_utf8(w.into_inner()) else{return false;};
+    xml.split_once('>').and_then(|(_,s)|s.strip_suffix("</hh:numbering>")).is_some_and(|inner|inner==raw)
+}
