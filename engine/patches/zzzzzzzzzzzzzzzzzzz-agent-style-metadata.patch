+
+    /// Read stored metadata and refuse lossy raw-record reconstruction in Agent rename.
+    #[wasm_bindgen(js_name = getAgentStyleMetadata)]
+    pub fn get_agent_style_metadata(&self, id: u32) -> String {
+        match self.core.document.doc_info.styles.get(id as usize) {
+            Some(style) => serde_json::json!({
+                "langId": style.lang_id,
+                "lockForm": style.lock_form,
+                "rawCanonical": style.raw_data.as_ref().map(|raw| *raw == crate::serializer::doc_info::serialize_style(style)).unwrap_or(true)
+            }).to_string(),
+            None => serde_json::json!({"ok": false}).to_string(),
+        }
     }
 
