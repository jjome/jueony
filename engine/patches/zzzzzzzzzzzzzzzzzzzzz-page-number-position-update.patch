+    fn update_preserves_the_existing_control_anchor_and_survives_both_formats() {
+        const NEXT: &str = r#"{"format":1,"position":8,"sideChar":"."}"#;
+        let mut document = blank();
+        document
+            .insert_page_number_position_native(0, 0, PROPS)
+            .expect("initial insert");
+        let original_count = document.document().sections[0].paragraphs[0].controls.len();
+        let before = document.export_hwp_native().expect("before update");
+        assert!(document.update_page_number_position_native(0, 0, NEXT, PROPS).is_err());
+        assert!(document.update_page_number_position_native(0, 0, PROPS, PROPS).is_err());
+        assert_eq!(document.export_hwp_native().expect("after refusal"), before);
+        let snapshot = document.save_snapshot_native();
+        document
+            .update_page_number_position_native(0, 0, PROPS, NEXT)
+            .expect("update page number position");
+        assert_eq!(document.document().sections[0].paragraphs[0].controls.len(), original_count);
+        let state_after = state(&document);
+        assert_eq!(state_after["paragraphIdx"], 0);
+        assert_eq!(state_after["format"], 1);
+        assert_eq!(state_after["position"], 8);
+        assert_eq!(state_after["sideChar"], ".");
+        for bytes in [
+            document.export_hwp_native().expect("updated HWP"),
+            document.export_hwpx_native().expect("updated HWPX"),
+        ] {
+            let reopened = HwpDocument::from_bytes(&bytes).expect("reopen update");
+            assert_eq!(state(&reopened), state_after);
+        }
+        document.restore_snapshot_native(snapshot).expect("undo update");
+        assert_eq!(document.export_hwp_native().expect("undo bytes"), before);
+    }
