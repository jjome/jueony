+    /// Updates one verified root page-number control without moving its anchor.
+    pub fn update_page_number_position_native(
+        &mut self,
+        section_idx: usize,
+        paragraph_idx: usize,
+        expected_json: &str,
+        props_json: &str,
+    ) -> Result<String, HwpError> {
+        let expected = parse_input(expected_json)?;
+        let requested = parse_input(props_json)?;
+        if self.document.sections.len() != 1 || section_idx != 0 {
+            return Err(invalid("다구역 쪽 번호 매기기는 아직 지원하지 않습니다"));
+        }
+        let (owner, previous) = self
+            .root_page_number_position(section_idx)?
+            .ok_or_else(|| invalid("기존 쪽 번호 위치를 찾지 못했습니다"))?;
+        if owner != paragraph_idx
+            || previous.format != expected.format
+            || previous.position != expected.position
+            || previous.dash_char != expected.dash_char
+        {
+            return Err(invalid("현재 구역의 쪽 번호 상태가 변경되었습니다"));
+        }
+        if previous.format == requested.format
+            && previous.position == requested.position
+            && previous.dash_char == requested.dash_char
+        {
+            return Err(invalid("현재 쪽 번호 위치와 모양이 같습니다"));
+        }
+        let section = &mut self.document.sections[section_idx];
+        let position = section.paragraphs[paragraph_idx]
+            .controls
+            .iter_mut()
+            .find_map(|control| match control {
+                Control::PageNumberPos(value) => Some(value),
+                _ => None,
+            })
+            .ok_or_else(|| invalid("기존 쪽 번호 위치를 찾지 못했습니다"))?;
+        position.format = requested.format;
+        position.position = requested.position;
+        position.dash_char = requested.dash_char;
+        section.raw_stream = None;
+        self.recompose_section(section_idx);
+        self.paginate_if_needed();
+
+        Ok(serde_json::json!({
+            "ok": true,
+            "updated": true,
+            "sectionIdx": section_idx,
+            "paragraphIdx": paragraph_idx,
+            "format": requested.format,
+            "position": requested.position,
+            "sideChar": requested.dash_char.to_string(),
+        })
+        .to_string())
+    }
