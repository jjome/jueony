+            cached.tables.retain(|table| table.para_index != paragraph || table.control_index != control);
+        }
+        if let Some(cached) = self.measured_tables.get_mut(section) {
+            cached.retain(|table| table.para_index != paragraph || table.control_index != control);
+        }
+    }
