+impl DocumentCore {
+    /// The loaded row allocation is a text-edit floor, not a constraint after
+    /// explicitly changing the table/cell content box. Retain model row sizes;
+    /// discard only this table's previous derived measurement before remeasure.
+    fn invalidate_table_geometry_measurement(&mut self, section: usize, paragraph: usize, control: usize) {
