+use serde_json::Value;
 fn fail(s:&str)->HwpError{HwpError::RenderError(s.into())}
 fn slot(kind:&str)->Result<Option<usize>,HwpError>{match kind{"both"=>Ok(None),"even"=>Ok(Some(0)),"odd"=>Ok(Some(1)),_=>Err(fail("Invalid page background kind"))}}
+
+fn read_color(value:&Value)->Result<u32,HwpError>{
+    let text=value.as_str().filter(|s|s.len()==7&&s.starts_with('#')&&s.as_bytes()[1..].iter().all(u8::is_ascii_hexdigit))
+        .ok_or_else(||fail("배경 색은 #RRGGBB입니다."))?;
+    let rgb=u32::from_str_radix(&text[1..],16).map_err(|_|fail("Invalid color"))?;
+    Ok(((rgb>>16)&255)|(rgb&0x00ff00)|((rgb&255)<<16))
+}
+
+fn plain_background(fill:&Fill)->bool{
+    fill.gradient.is_none()&&matches!((&fill.fill_type,fill.solid),
+        (FillType::None,None)|(FillType::Solid,Some(SolidFill{pattern_type:..=0,..})))
+}
+
+fn linear_gradient(fill:&Fill)->bool{
+    fill.fill_type==FillType::Gradient&&fill.solid.is_none()&&fill.gradient.as_ref().is_some_and(|gradient|{
+        gradient.gradient_type==1&&(0..=360).contains(&gradient.angle)
+            &&gradient.colors.len()==2&&gradient.positions.is_empty()
+    })
+}
