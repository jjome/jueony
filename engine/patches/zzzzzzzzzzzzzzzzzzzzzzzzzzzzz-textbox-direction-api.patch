+    #[test]
+    fn textbox_direction_is_queryable_and_roundtrips_supported_formats() {
+        let mut core = DocumentCore::from_bytes(include_bytes!(
+            "../../../../samples/hwpx/footnote-tbox-01.hwpx"
+        ))
+        .expect("load textbox fixture");
+        let (para, ctrl) = first_shape_ref(&core);
+
+        core.set_shape_properties_native(0, para, ctrl, r#"{"tbTextDirection":"Vertical"}"#)
+            .expect("set vertical");
+        let props = core
+            .get_shape_properties_native(0, para, ctrl)
+            .expect("query vertical");
+        assert!(props.contains(r#""tbTextDirection":"Vertical""#));
+
+        let hwp = core.export_hwp_with_adapter().expect("export HWP");
+        let mut hwp_reopened = DocumentCore::from_bytes(&hwp).expect("reopen HWP");
+        let (hwp_para, hwp_ctrl) = first_shape_ref(&hwp_reopened);
+        let hwp_props = hwp_reopened
+            .get_shape_properties_native(0, hwp_para, hwp_ctrl)
+            .expect("query reopened HWP");
+        assert!(hwp_props.contains(r#""tbTextDirection":"Vertical""#));
+
+        hwp_reopened
+            .set_shape_properties_native(
+                0,
+                hwp_para,
+                hwp_ctrl,
+                r#"{"tbTextDirection":"VerticalAll"}"#,
+            )
+            .expect("set vertical all");
+        let hwpx = hwp_reopened.export_hwpx_native().expect("export HWPX");
+        let hwpx_reopened = DocumentCore::from_bytes(&hwpx).expect("reopen HWPX");
+        let (hwpx_para, hwpx_ctrl) = first_shape_ref(&hwpx_reopened);
+        let hwpx_props = hwpx_reopened
+            .get_shape_properties_native(0, hwpx_para, hwpx_ctrl)
+            .expect("query reopened HWPX");
+        assert!(hwpx_props.contains(r#""tbTextDirection":"VerticalAll""#));
+
+        core.set_shape_properties_native(0, para, ctrl, r#"{"tbTextDirection":"Horizontal"}"#)
+            .expect("set horizontal");
+        let props = core
+            .get_shape_properties_native(0, para, ctrl)
+            .expect("query horizontal");
+        assert!(props.contains(r#""tbTextDirection":"Horizontal""#));
+    }
+
