+use super::{DocumentCore, DocumentEvent, HwpError};
+use crate::model::table::{Cell, Table};
+
+fn invalid() -> HwpError {
+    HwpError::RenderError("분할할 셀의 원본 격자·문단·보호 상태를 확인하지 못했습니다.".into())
+}
+
+struct DivisionAxis {
+    old: Vec<u32>,
+    grid: Vec<u32>,
+    cuts: Vec<u32>,
+}
+
+impl DivisionAxis {
+    fn new(table: &Table, row: bool, start: u16, span: u16, parts: u16) -> Result<Self, HwpError> {
+        let old = table.witnessed_track_edges(row).ok_or_else(invalid)?;
+        let footprint = old.get(usize::from(start)..=usize::from(start.checked_add(span).ok_or_else(invalid)?))
+            .filter(|v| v.len() > 1).ok_or_else(invalid)?;
+        let length = footprint[footprint.len() - 1] - footprint[0];
+        let cuts = if span == parts {
+            footprint.to_vec()
+        } else {
+            let step = length / u32::from(parts);
+            let remainder = length % u32::from(parts);
+            (0..=u32::from(parts)).map(|i| footprint[0] + i * step + if i == 0 { 0 } else { remainder }).collect()
+        };
+        if cuts.windows(2).any(|w| w[1] - w[0] < 200) { return Err(invalid()); }
+        let mut grid = old.clone();
+        grid.extend_from_slice(&cuts);
+        grid.sort_unstable();
+        grid.dedup();
+        Ok(Self { old, grid, cuts })
+    }
+
+    fn map(&self, lo: u32, hi: u32) -> Result<(u16,u16), HwpError> {
+        let a = self.grid.binary_search(&lo).map_err(|_| invalid())?;
+        let b = self.grid.binary_search(&hi).map_err(|_| invalid())?;
+        Ok((a as u16, (b - a) as u16))
+    }
+
+    fn remap(&self, start: u16, span: u16) -> Result<(u16,u16), HwpError> {
+        let end = start.checked_add(span).ok_or_else(invalid)?;
+        self.map(*self.old.get(usize::from(start)).ok_or_else(invalid)?,
+                 *self.old.get(usize::from(end)).ok_or_else(invalid)?)
+    }
+}
+
+impl DocumentCore {
+    pub fn split_cell_on_grid_native(&mut self, section: usize, para: usize, ctrl: usize,
+        row: u16, col: u16, rows: u16, cols: u16, distribute: bool) -> Result<String, HwpError> {
+        if !(1..=8).contains(&rows) || !(1..=8).contains(&cols) || rows * cols < 2 { return Err(invalid()); }
+        let table = self.get_table_mut(section, para, ctrl)?;
+        if table.common.locked || table.common.size_protect || table.attr & (1 << 30) != 0
+            || !table.zones.is_empty() || table.repeat_header || table.caption.is_some()
+            || table.cells.iter().any(|c| c.cell_protect() || c.is_header || c.field_name.is_some()
+                || c.text_direction != 0 || c.paragraphs.is_empty() || c.paragraphs.len() > 50
+                || c.paragraphs.iter().any(|p| !p.controls.is_empty() || !p.field_ranges.is_empty()
+                    || !p.orphan_field_ends.is_empty() || !p.range_tags.is_empty() || !p.title_marks.is_empty()
+                    || !p.markpen_marks.is_empty() || p.text.chars().count() > 4000)) { return Err(invalid()); }
+        let source = table.cells.iter().find(|c| (c.row, c.col) == (row, col)).ok_or_else(invalid)?;
+        if distribute && !(2..=usize::from(rows * cols)).contains(&source.paragraphs.len()) { return Err(invalid()); }
+        let vertical = DivisionAxis::new(table, true, row, source.row_span, rows)?;
+        let horizontal = DivisionAxis::new(table, false, col, source.col_span, cols)?;
+        let nr = vertical.grid.len() - 1;
+        let nc = horizontal.grid.len() - 1;
+        if nr * nc > 200 { return Err(invalid()); }
+        let mut cells = Vec::with_capacity(table.cells.len() + usize::from(rows * cols) - 1);
+        for original in &table.cells {
+            if (original.row, original.col) == (row, col) { continue; }
+            let mut cell = original.clone();
+            (cell.row, cell.row_span) = vertical.remap(cell.row, cell.row_span)?;
+            (cell.col, cell.col_span) = horizontal.remap(cell.col, cell.col_span)?;
+            cells.push(cell);
+        }
+        let mut targets = Vec::new();
+        for y in vertical.cuts.windows(2) {
+            for x in horizontal.cuts.windows(2) {
+                let (r, rs) = vertical.map(y[0], y[1])?;
+                let (c, cs) = horizontal.map(x[0], x[1])?;
+                let (width, height) = (x[1] - x[0], y[1] - y[0]);
+                let mut cell = if targets.is_empty() { source.clone() }
+                    else { Cell::new_from_template(c, r, width, height, source) };
+                if distribute {
+                    if let Some(p) = source.paragraphs.get(targets.len()) { cell.paragraphs = vec![p.clone()]; }
+                }
+                if cell.raw_list_extra.get(..4) == Some(source.width.to_le_bytes().as_slice()) {
+                    cell.raw_list_extra[..4].copy_from_slice(&width.to_le_bytes());
+                }
+                (cell.row, cell.row_span, cell.col, cell.col_span) = (r, rs, c, cs);
+                (cell.width, cell.height) = (width, height);
+                cells.push(cell);
+                targets.push((r,c));
+            }
+        }
+        let mut covered = vec![false; nr * nc];
+        for cell in &cells {
+            for r in cell.row..cell.row + cell.row_span {
+                for c in cell.col..cell.col + cell.col_span {
+                    if std::mem::replace(&mut covered[usize::from(r) * nc + usize::from(c)], true) { return Err(invalid()); }
+                }
+            }
+        }
+        if covered.contains(&false) { return Err(invalid()); }
+        cells.sort_by_key(|c| (c.row, c.col));
+        let affected: Vec<_> = cells.iter().enumerate().filter(|(_, c)| targets.contains(&(c.row, c.col)))
+            .map(|(i,c)| (i, c.paragraphs.len())).collect();
+        table.cells = cells;
+        table.row_count = nr as u16;
+        table.col_count = nc as u16;
+        table.rebuild_row_sizes();
+        table.rebuild_grid();
+        let metrics = Self::table_cell_reflow_metrics(table);
+        self.reflow_table_cell_paragraphs_after_split(section, para, ctrl, &affected, &metrics);
+        for &(i, _) in &affected { self.rebuild_table_cell_vpos_ladder_native(section, para, ctrl, i); }
+        self.document.sections[section].raw_stream = None;
+        self.recompose_section(section);
+        self.paginate_if_needed();
+        self.event_log.push(DocumentEvent::CellSplit { section, para, ctrl });
+        Ok(r#"{"ok":true}"#.into())
+    }
+}
