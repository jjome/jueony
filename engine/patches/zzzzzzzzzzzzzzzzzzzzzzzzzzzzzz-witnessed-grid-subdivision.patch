+use super::Table;
+
+impl Table {
+    /// Each stored cell constrains the distance between two logical grid lines.
+    /// In a staggered merge, a track can be pinned by overlapping intervals even
+    /// when no cell spans that track alone. Never interpolate a hidden line.
+    pub(crate) fn witnessed_track_edges(&self, rows: bool) -> Option<Vec<u32>> {
+        let count = usize::from(if rows { self.row_count } else { self.col_count });
+        if count == 0 || usize::from(self.row_count) * usize::from(self.col_count) > 200
+            || self.cells.len() > 200 { return None; }
+        let mut graph = vec![Vec::new(); count + 1];
+        for cell in &self.cells {
+            let (start, span, length) = if rows {
+                (cell.row, cell.row_span, cell.height)
+            } else {
+                (cell.col, cell.col_span, cell.width)
+            };
+            let end = usize::from(start.checked_add(span)?);
+            let start = usize::from(start);
+            if span == 0 || end > count || length == 0 { return None; }
+            graph[start].push((end, i64::from(length)));
+            graph[end].push((start, -i64::from(length)));
+        }
+        let mut edges = vec![None; count + 1];
+        edges[0] = Some(0_i64);
+        let mut stack = vec![0];
+        while let Some(from) = stack.pop() {
+            for &(to, delta) in &graph[from] {
+                let value = edges[from]? + delta;
+                if let Some(previous) = edges[to] {
+                    if previous != value { return None; }
+                } else {
+                    edges[to] = Some(value);
+                    stack.push(to);
+                }
+            }
+        }
+        let edges: Vec<u32> = edges.into_iter().map(|v| u32::try_from(v?).ok()).collect::<Option<_>>()?;
+        edges.windows(2).all(|p| p[0] < p[1]).then_some(edges)
+    }
+}
