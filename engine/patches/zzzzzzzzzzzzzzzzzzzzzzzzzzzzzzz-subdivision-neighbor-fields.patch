 use super::{DocumentCore, DocumentEvent, HwpError};
 use crate::model::table::{Cell, Table};
+use crate::model::control::{Control, FieldType};
+use crate::model::paragraph::Paragraph;
 
 fn invalid() -> HwpError {
     HwpError::RenderError("분할할 셀의 원본 격자·문단·보호 상태를 확인하지 못했습니다.".into())
+}
+
+// Neighbor cells are cloned in full. Only admit locally paired, disjoint
+// ClickHere ranges; a target cell's controls can never be cloned into new slots.
+fn subdivision_paragraph_allowed(p: &Paragraph, allow_fields: bool) -> bool {
+    let length = p.text.chars().count();
+    if length > 4000 || !p.orphan_field_ends.is_empty() || !p.range_tags.is_empty()
+        || !p.title_marks.is_empty() || !p.markpen_marks.is_empty() { return false; }
+    if p.controls.is_empty() { return p.field_ranges.is_empty(); }
+    if !allow_fields || p.controls.len() > 50 || p.controls.len() != p.field_ranges.len() { return false; }
+    let mut seen = std::collections::BTreeSet::new();
+    let mut previous_end = None;
+    for range in &p.field_ranges {
+        if !matches!(p.controls.get(range.control_idx), Some(Control::Field(f))
+            if f.field_type == FieldType::ClickHere && f.memo_paragraphs.is_empty())
+            || !seen.insert(range.control_idx) || range.inner_slot_count != 0
+            || range.start_char_idx > range.end_char_idx || range.end_char_idx > length
+            || previous_end.is_some_and(|end| end >= range.start_char_idx) { return false; }
+        previous_end = Some(range.end_char_idx);
+    }
+    true
 }
 
