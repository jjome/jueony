+/// The exact emitted native single-column stack, not bare source vpos, owns
+/// the following ordinary paragraph's flow start. No partial/absolute/unknown
+/// frame may use this contract, and the real first-column source row is required.
+pub(crate) fn native_whole_stack_owns_successor(
+    native: bool, single_column: bool,
+    items: &[crate::renderer::pagination::PageItem],
+    para_index: usize, paragraphs: &[Paragraph],
+) -> bool {
+    use crate::renderer::pagination::PageItem;
+    if !native || !single_column || items.len() < 3
+        || !paragraphs.get(para_index).is_some_and(|p| p.controls.is_empty())
+        || !matches!(items.first(), Some(PageItem::FullParagraph { para_index })
+            if paragraphs.get(*para_index).and_then(|p| p.line_segs.first())
+                .is_some_and(|l| l.vertical_pos == 0 && l.tag & 0x8000_0000 == 0))
+        || items.iter().any(|i| matches!(i, PageItem::PartialTable { .. } | PageItem::Shape { .. })) {
+        return false;
+    }
+    items[items.len()-2..].iter().enumerate().all(|(index, item)| {
+        let PageItem::Table { para_index: owner, control_index: 0 } = item else { return false; };
+        if owner.checked_add(2-index) != Some(para_index) { return false; }
+        let Some(host) = paragraphs.get(*owner) else { return false; };
+        let [crate::model::control::Control::Table(table)] = host.controls.as_slice() else { return false; };
+        table.page_break == TablePageBreak::None && object_only_saved_table_anchor(host, table)
+            && table.common.vert_rel_to == VertRelTo::Para
+            && table.common.vert_align == crate::model::shape::VertAlign::Top
+            && signed_hwpunit(table.common.vertical_offset) >= 0
+    })
+}
