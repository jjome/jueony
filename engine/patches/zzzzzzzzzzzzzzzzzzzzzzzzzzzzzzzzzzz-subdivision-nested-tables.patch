+// All original paragraphs stay in the first piece. Each inline table needs
+// its own otherwise empty paragraph. Its stored size is a lower bound;
+// the caller also checks the exact rendered frames and text after subdivision.
+fn retained_nested_size(c: &Cell) -> Option<(u32, u32)> {
+    if c.field_name.is_some() || c.paragraphs.len() > 50 { return None; }
+    let (mut width, mut height) = (0, 0u32);
+    for p in &c.paragraphs {
+        if p.controls.is_empty() {
+            if !subdivision_paragraph_allowed(p, false) { return None; }
+            continue;
+        }
+        let inner = retained_inline_table(p)?;
+        width = width.max(inner.common.width);
+        height = height.checked_add(inner.common.height)?;
     }
+    (height > 0).then_some((width, height))
+}
