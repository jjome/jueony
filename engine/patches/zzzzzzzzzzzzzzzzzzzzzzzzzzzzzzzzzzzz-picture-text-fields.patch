+    /// Pictures mixed with filled ClickHere fields need both stored field
+    /// markers accounted for. Never infer a marker at the paragraph end or
+    /// accept a picture touching/inside a field's visible range.
+    fn picture_field_text_anchors(&self) -> Option<Vec<u32>> {
+        let length = self.text.chars().count();
+        if self.controls.is_empty() || self.controls.len() > 200
+            || length > 4000 || self.char_offsets.len() != length
+            || !self.orphan_field_ends.is_empty() || !self.range_tags.is_empty()
+            || !self.title_marks.is_empty()
+            || !self.controls.iter().all(|c| matches!(c, Control::Picture(_))
+                || matches!(c, Control::Field(f) if f.field_type == FieldType::ClickHere))
+        { return None; }
+        let mut ranges = self.field_ranges.iter().collect::<Vec<_>>();
+        ranges.sort_by_key(|r| r.start_char_idx);
+        if ranges.is_empty() || ranges.len() != self.controls.iter().filter(|c| matches!(c, Control::Field(_))).count()
+            || ranges.iter().enumerate().any(|(i, r)| r.start_char_idx >= r.end_char_idx
+                || r.end_char_idx >= length || r.inner_slot_count != 0
+                || !matches!(self.controls.get(r.control_idx), Some(Control::Field(_)))
+                || ranges[..i].iter().any(|p| p.control_idx == r.control_idx)
+                || i > 0 && r.start_char_idx <= ranges[i - 1].end_char_idx)
+        { return None; }
+        let mut positions = Vec::with_capacity(self.controls.len());
+        let mut end = 0;
+        for (i, (&offset, ch)) in self.char_offsets.iter().zip(self.text.chars()).enumerate() {
+            if ch.is_control() || ch == '\u{fffc}' { return None; }
+            let gap = offset.checked_sub(end)?;
+            if gap % CTRL_CHAR_CODE_UNITS != 0 { return None; }
+            let hidden = ranges.iter().filter(|r| r.end_char_idx == i).count();
+            let count = ((gap / CTRL_CHAR_CODE_UNITS) as usize).checked_sub(hidden)?;
+            if count > self.controls.len() - positions.len() { return None; }
+            positions.extend(std::iter::repeat_n(i, count));
+            end = offset.checked_add(ch.len_utf16() as u32)?;
+        }
+        if positions.len() != self.controls.len() || self.char_count != end.checked_add(1)?
+            || self.control_text_positions() != positions
+            || ranges.iter().any(|r| positions[r.control_idx] != r.start_char_idx)
+        { return None; }
+        let mut anchors = Vec::new();
+        for (c, &at) in self.controls.iter().zip(&positions) {
+            if matches!(c, Control::Picture(_)) {
+                if ranges.iter().any(|r| r.start_char_idx <= at && at <= r.end_char_idx) { return None; }
+                anchors.push(at as u32);
+            }
+        }
+        (!anchors.is_empty()).then_some(anchors)
     }
 
