+#[cfg(test)]
+mod jueony_tab_placeholder_tests {
+    use super::*;
+    use crate::model::paragraph::TAB_EXT_PLACEHOLDER;
+
+    #[test]
+    fn placeholder_width_uses_default_stops_like_character_positions() {
+        let plain = TextStyle { default_tab_width: 40.0, ..Default::default() };
+        let with_placeholders = TextStyle {
+            inline_tabs: vec![TAB_EXT_PLACEHOLDER; 3],
+            ..plain.clone()
+        };
+        let text = "A\tB\t123\tXYZ ";
+        let expected = estimate_text_width_exact(text, &plain);
+        assert_eq!(estimate_text_width_exact(text, &with_placeholders), expected);
+        assert_eq!(compute_char_positions(text, &with_placeholders), compute_char_positions(text, &plain));
+        assert!((expected - compute_char_positions(text, &plain).last().unwrap()).abs() < 1e-8);
+    }
+
+    #[test]
+    fn placeholder_consumes_ordinal_before_following_saved_tab() {
+        let style = TextStyle {
+            default_tab_width: 40.0,
+            tab_stops: vec![TabStop { position: 48.0, tab_type: 0, fill_type: 0 }],
+            inline_tabs: vec![TAB_EXT_PLACEHOLDER, [1500, 0, 0x0100, 0, 0, 0, 9]],
+            ..Default::default()
+        };
+        let positions = compute_char_positions("A\tB\tC", &style);
+        assert!((positions[2] - 48.0).abs() < 1e-8);
+        assert!((positions[4] - positions[3] - 20.0).abs() < 1e-8);
+        assert!((estimate_text_width_exact("A\tB\tC", &style) - positions[5]).abs() < 1e-8);
+    }
+
+    #[test]
+    fn saved_nonzero_or_unknown_zero_tab_is_not_reinterpreted() {
+        for ext in [[1500, 0, 0x0100, 0, 0, 0, 9], [0, 0, 0x0500, 0, 0, 0, 9]] {
+            assert!(!crate::model::paragraph::tab_ext_is_placeholder(&ext));
+            let style = TextStyle { default_tab_width: 40.0, inline_tabs: vec![ext], ..Default::default() };
+            let expected = estimate_text_width_exact("AB", &style) + ext[0] as f64 / 75.0;
+            assert!((estimate_text_width_exact("A\tB", &style) - expected).abs() < 1e-8);
+        }
+    }
+}
