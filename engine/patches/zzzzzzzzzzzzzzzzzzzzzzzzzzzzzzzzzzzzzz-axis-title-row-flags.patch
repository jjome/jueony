+        // Only a fully marked leading header band gives an unambiguous title
+        // insertion. A single-column template can otherwise come from the body
+        // when the original title spans multiple columns.
+        let header_rows = self.leading_header_rows().len() as u16;
+        let new_row_is_header = self.repeat_header && target_row < header_rows
+            && header_rows < self.row_count
+            && self.cells.iter().all(|cell| {
+                if cell.row < header_rows {
+                    cell.is_header && cell.row.saturating_add(cell.row_span) <= header_rows
+                } else {
+                    !cell.is_header
+                }
+            });
+
