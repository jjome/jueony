+/// A non-flow paper ellipse and a TAC table can share a duplicated outer-band
+/// carrier in generated HWPX/HWP. Hancom removes the font-only prefix row when
+/// re-saving it. Accept only its exact two-control/two-row ownership proof;
+/// neither source LINE_SEG values nor declared table dimensions are rewritten.
+fn duplicated_nonflow_prefix_band_origin(
+    para: &Paragraph,
+    control_index: usize,
+    table: &crate::model::table::Table,
+) -> Option<i32> {
+    use crate::model::paragraph::{ColumnBreakType, LineSeg};
+    let [Control::Shape(shape), Control::Table(owned)] = para.controls.as_slice() else {
+        return None;
+    };
+    let ShapeObject::Ellipse(ellipse) = shape.as_ref() else { return None; };
+    let decoration = &ellipse.common;
+    if control_index != 1 || !std::ptr::eq(owned.as_ref(), table)
+        || para.stored_text_partition_dirty
+        || !matches!(para.column_type, ColumnBreakType::None)
+        || !para.range_tags.is_empty() || !para.markpen_marks.is_empty()
+        || decoration.treat_as_char || decoration.flow_with_text
+        || decoration.affect_line_spacing
+        || !matches!(decoration.text_wrap, TextWrap::InFrontOfText)
+        || !matches!(decoration.vert_rel_to, VertRelTo::Paper)
+        || !matches!(decoration.horz_rel_to, HorzRelTo::Paper)
+        || !table.common.treat_as_char || !table.common.flow_with_text
+        || table.common.allow_overlap
+        || table.caption.is_some() || !matches!(table.page_break, TablePageBreak::RowBreak)
+        || !matches!(table.common.text_wrap, TextWrap::TopAndBottom)
+        || !matches!(table.common.vert_rel_to, VertRelTo::Para)
+        || !matches!(table.common.vert_align, VertAlign::Top)
+        || !matches!(table.common.horz_rel_to, HorzRelTo::Para)
+        || table.common.vertical_offset != 0 || table.common.horizontal_offset != 0
+        || table.outer_margin_top < 0 || table.outer_margin_bottom < 0
+        || para.empty_control_stream_position(0)? != 0
+        || para.empty_control_stream_position(1)? != 8
+    { return None; }
+    let [prefix, carrier] = para.line_segs.as_slice() else { return None; };
+    let band = i64::from(table.common.height) + i64::from(table.outer_margin_top)
+        + i64::from(table.outer_margin_bottom);
+    if band <= 0 || prefix.tag != carrier.tag
+        || prefix.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        || para.line_seg_text_start(0) != 0 || para.line_seg_text_start(1) != 8
+        || prefix.vertical_pos < 0 || prefix.text_height <= 0
+        || prefix.line_spacing < 0 || prefix.line_spacing != carrier.line_spacing
+        || prefix.column_start != 0 || carrier.column_start != 0
+        || prefix.segment_width <= 0 || prefix.segment_width != carrier.segment_width
+        || i64::from(prefix.line_height) != band || i64::from(carrier.line_height) != band
+        || i64::from(carrier.text_height) != band
+        || i64::from(prefix.text_height) * 2 >= band
+        || prefix.baseline_distance < 0 || prefix.baseline_distance > prefix.text_height
+        || carrier.baseline_distance < 0 || i64::from(carrier.baseline_distance) > band
+        || i64::from(carrier.vertical_pos) - i64::from(prefix.vertical_pos)
+            != i64::from(prefix.text_height) + i64::from(prefix.line_spacing)
+    { return None; }
+    Some(prefix.vertical_pos)
+}
