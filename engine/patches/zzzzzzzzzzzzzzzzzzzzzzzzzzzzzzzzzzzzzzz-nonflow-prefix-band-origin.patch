+#[cfg(test)]
+mod jueony_duplicated_nonflow_prefix_band_tests {
+    use super::*;
+    use crate::model::paragraph::LineSeg;
+    use crate::model::shape::EllipseShape;
+    fn fixture() -> Paragraph {
+        let mut p = Paragraph { char_count: 17, ..Paragraph::default() };
+        let mut ellipse = EllipseShape::default();
+        ellipse.common.text_wrap = TextWrap::InFrontOfText;
+        ellipse.common.allow_overlap = true;
+        let mut table = crate::model::table::Table::default();
+        table.common.treat_as_char = true;
+        table.common.flow_with_text = true;
+        table.common.text_wrap = TextWrap::TopAndBottom;
+        table.common.vert_rel_to = VertRelTo::Para;
+        table.common.horz_rel_to = HorzRelTo::Para;
+        table.common.height = 64199;
+        table.page_break = TablePageBreak::RowBreak;
+        table.outer_margin_top = 283;
+        table.outer_margin_bottom = 283;
+        p.controls = vec![Control::Shape(Box::new(ShapeObject::Ellipse(ellipse))), Control::Table(Box::new(table))];
+        p.line_segs = vec![
+            LineSeg { text_start: 0, vertical_pos: 2720, line_height: 64765,
+                text_height: 1000, baseline_distance: 850, line_spacing: 600,
+                column_start: 0, segment_width: 48188, tag: 393216 },
+            LineSeg { text_start: 8, vertical_pos: 4320, line_height: 64765,
+                text_height: 64765, baseline_distance: 55050, line_spacing: 600,
+                column_start: 0, segment_width: 48188, tag: 393216 },
+        ]; p
+    }
+    fn probe(p: &Paragraph) -> Option<i32> {
+        let Control::Table(t) = &p.controls[1] else { return None; };
+        duplicated_nonflow_prefix_band_origin(p, 1, t)
+    }
+    #[test]
+    fn exact_prefix_uses_first_band_without_mutation() {
+        let p = fixture();
+        let before = serde_json::to_value(&p).unwrap();
+        assert_eq!(probe(&p), Some(2720));
+        assert_eq!(serde_json::to_value(&p).unwrap(), before);
+        let Control::Table(t) = &p.controls[1] else { panic!(); };
+        let area = LayoutRect { x: 0.0, y: 94.5, width: 650.0, height: 1000.0 };
+        let top = stored_empty_full_band_tac_table_top(&p, 1, t, &area, 96.0).unwrap();
+        assert!((top - (94.5 + 3003.0 / 75.0)).abs() < 1e-9);
+    }
+    #[test]
+    fn ambiguous_or_real_prefix_lines_keep_original_owner() {
+        let changes: Vec<fn(&mut Paragraph)> = vec![
+            |p| p.text = "visible".into(),
+            |p| if let Control::Table(t) = &mut p.controls[1] { t.page_break = TablePageBreak::CellBreak; },
+            |p| if let Control::Table(t) = &mut p.controls[1] { t.caption = Some(Caption::default()); },
+            |p| p.char_count += 1,
+            |p| p.line_segs[0].line_height = 1000,
+            |p| p.line_segs[1].vertical_pos += 1,
+            |p| p.line_segs[1].text_start = 0,
+            |p| p.line_segs[0].tag |= LineSeg::TAG_IMPLEMENTATION_PROPERTY,
+            |p| p.line_segs[0].column_start = 1,
+            |p| p.line_segs[1].segment_width -= 1,
+            |p| p.line_segs.push(p.line_segs[1].clone()),
+            |p| p.stored_text_partition_dirty = true,
+            |p| if let Control::Shape(s) = &mut p.controls[0] { if let ShapeObject::Ellipse(e) = s.as_mut() { e.common.affect_line_spacing = true; } },
+            |p| if let Control::Shape(s) = &mut p.controls[0] { if let ShapeObject::Ellipse(e) = s.as_mut() { e.common.vert_rel_to = VertRelTo::Para; } },
+            |p| if let Control::Table(t) = &mut p.controls[1] { t.common.vertical_offset = 1; },
+        ];
+        for (i, change) in changes.into_iter().enumerate() {
+            let mut p = fixture(); change(&mut p);
+            assert_eq!(probe(&p), None, "negative {i}");
+        }
+    }
