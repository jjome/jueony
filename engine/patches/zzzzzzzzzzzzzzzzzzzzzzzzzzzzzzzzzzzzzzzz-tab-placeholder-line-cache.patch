     use crate::model::paragraph::LineSeg;
 
+    fn g069_tab_cache_fixture(text: &str, tabs: Vec<[u16; 7]>) -> Paragraph {
+        Paragraph {
+            text: text.to_string(),
+            tab_extended: tabs,
+            line_segs: vec![LineSeg {
+                text_start: 0,
+                vertical_pos: 1600,
+                line_height: 1000,
+                text_height: 1000,
+                baseline_distance: 850,
+                line_spacing: 600,
+                column_start: 0,
+                segment_width: 42520,
+                tag: 393216,
+            }],
+            ..Default::default()
+        }
+    }
+
+    fn g069_render_tab_cache_fixture(para: Paragraph) -> String {
+        let (doc, section) = make_doc_with_paragraph(para);
+        let mut ctx = SerializeContext::collect_from_document(&doc);
+        String::from_utf8(write_section(&section, &doc, 0, &mut ctx).unwrap()).unwrap()
+    }
+
+    #[test]
+    fn g069_placeholder_and_implicit_tabs_omit_only_unresolved_cache() {
+        use crate::model::paragraph::TAB_EXT_PLACEHOLDER;
+        for tabs in [vec![], vec![TAB_EXT_PLACEHOLDER; 2], vec![[0, 0, 0x0100, 0, 0, 0, 9]; 2]] {
+            let para = g069_tab_cache_fixture("A\tB\tC", tabs);
+            let cached_before = para.line_segs.clone();
+            let xml = g069_render_tab_cache_fixture(para.clone());
+            assert!(!xml.contains("<hp:linesegarray"));
+            assert_eq!(xml.matches(r#"<hp:tab width="0" leader="0" type="1"/>"#).count(), 2);
+            assert_eq!(para.line_segs, cached_before, "serialization must not mutate live cache");
+            let reparsed = crate::parser::hwpx::section::parse_hwpx_section(&xml).unwrap();
+            assert_eq!(reparsed.paragraphs[0].text, "A\tB\tC");
+        }
+    }
+
+    #[test]
+    fn g069_resolved_and_unknown_zero_tab_records_keep_cache() {
+        for ext in [[3000, 0, 0x0100, 0, 0, 0, 9], [0, 0, 0x0500, 0, 0, 0, 9], [0, 0, 0x0101, 0, 0, 0, 9], [0, 0, 0x0100, 1, 0, 0, 9]] {
+            assert!(!crate::model::paragraph::tab_ext_is_placeholder(&ext));
+            let xml = g069_render_tab_cache_fixture(g069_tab_cache_fixture("A\tB", vec![ext]));
+            assert!(xml.contains("<hp:linesegarray>"));
+            assert!(xml.contains(r#"vertpos="1600""#));
+        }
+        // Unused tab metadata must not invalidate a paragraph without tabs.
+        let xml = g069_render_tab_cache_fixture(g069_tab_cache_fixture("AB", vec![crate::model::paragraph::TAB_EXT_PLACEHOLDER]));
+        assert!(xml.contains("<hp:linesegarray>"));
+    }
+
+    #[test]
+    fn g069_mixed_tabs_keep_saved_width_and_ordinal() {
+        let xml = g069_render_tab_cache_fixture(g069_tab_cache_fixture("A\tB\tC", vec![crate::model::paragraph::TAB_EXT_PLACEHOLDER, [3000, 0, 0x0100, 0, 0, 0, 9]]));
+        assert!(!xml.contains("<hp:linesegarray"));
+        assert!(xml.contains(r#"<hp:tab width="0" leader="0" type="1"/>"#));
+        assert!(xml.contains(r#"<hp:tab width="3000" leader="0" type="1"/>"#));
+        let reparsed = crate::parser::hwpx::section::parse_hwpx_section(&xml).unwrap();
+        assert!(crate::model::paragraph::tab_ext_is_placeholder(&reparsed.paragraphs[0].tab_extended[0]));
+        assert_eq!(reparsed.paragraphs[0].tab_extended[1][0], 3000);
