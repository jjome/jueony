+    #[test]
+    fn g069_three_section_intervals_survive_repeated_serialization() {
+        let mut doc = Document::default();
+        for spacing in [2000, 4000, 6000] {
+            let mut section = Section::default();
+            section.section_def.default_tab_spacing = spacing;
+            section.paragraphs.push(g069_tab_cache_fixture("A\tB\tC", vec![]));
+            doc.sections.push(section);
+        }
+        for (index, spacing) in [2000, 4000, 6000].iter().enumerate() {
+            let section = &doc.sections[index];
+            let mut ctx = SerializeContext::collect_from_document(&doc);
+            let xml = String::from_utf8(write_section(section, &doc, index, &mut ctx).unwrap()).unwrap();
+            assert!(!xml.contains("<hp:linesegarray"));
+            let reparsed = crate::parser::hwpx::section::parse_hwpx_section(&xml).unwrap();
+            assert_eq!(reparsed.section_def.default_tab_spacing, *spacing);
+            assert_eq!(reparsed.paragraphs[0].text, "A\tB\tC");
+            let mut next_doc = Document::default();
+            next_doc.sections.push(reparsed.clone());
+            let mut next_ctx = SerializeContext::collect_from_document(&next_doc);
+            let next_xml = String::from_utf8(write_section(&reparsed, &next_doc, 0, &mut next_ctx).unwrap()).unwrap();
+            assert!(!next_xml.contains("<hp:linesegarray"));
+            let second = crate::parser::hwpx::section::parse_hwpx_section(&next_xml).unwrap();
+            assert_eq!(second.section_def.default_tab_spacing, *spacing);
+            assert_eq!(second.paragraphs[0].text, "A\tB\tC");
+        }
+    }
