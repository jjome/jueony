+/// A complete generated single-lane body partition, with no stored-row, inline,
+/// field, forced-break, table-cell or exclusion-lane ownership to reinterpret.
+fn generated_uncached_plain_rows(para: &Paragraph, composed: &ComposedParagraph) -> bool {
+    if !para.line_segs.is_empty() || !para.controls.is_empty()
+        || !para.field_ranges.is_empty() || !para.orphan_field_ends.is_empty()
+        || !para.range_tags.is_empty() || !para.title_marks.is_empty()
+        || !para.markpen_marks.is_empty()
+        || para.text.contains(['\t', '\n', '\r']) || composed.lines.len() < 2
+        || !composed.inline_controls.is_empty() || !composed.tac_controls.is_empty()
+        || !composed.footnote_positions.is_empty() || composed.numbering_text.is_some()
+    { return false; }
+    let width = composed.lines[0].segment_width;
+    let mut next_start = 0;
+    let mut text = String::new();
+    for line in &composed.lines {
+        if width <= 0 || line.segment_width != width || line.column_start != 0
+            || line.has_line_break || line.char_start != next_start
+            || line.runs.iter().any(|run| run.inserted_control_text
+                || run.footnote_marker.is_some() || run.char_overlap.is_some())
+        { return false; }
+        for run in &line.runs { text.push_str(&run.text); next_start += run.text.chars().count(); }
+    }
+    text == para.text
+}
