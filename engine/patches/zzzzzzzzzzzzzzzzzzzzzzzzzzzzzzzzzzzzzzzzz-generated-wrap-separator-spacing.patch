+#[cfg(test)]
+mod jueony_generated_trailing_space_tests {
+    use super::*;
+    use crate::renderer::composer::ComposedTextRun;
+    fn fixture() -> (Paragraph, ComposedParagraph) {
+        let p = Paragraph { text: "A B C D ".into(), ..Paragraph::default() };
+        let line = |text: &str, start| ComposedLine {
+            runs: vec![ComposedTextRun {text: text.into(), ..ComposedTextRun::default()}],
+            line_height: 1000, baseline_distance: 850, segment_width: 2000,
+            column_start: 0, line_spacing: 600, has_line_break: false, char_start: start,
+        };
+        let c = ComposedParagraph {lines: vec![line("A B ",0),line("C D ",4)],
+            para_style_id: 0, inline_controls: vec![], numbering_text: None,
+            tac_controls: vec![], footnote_positions: vec![], tab_extended: vec![], horizontal_shaping: None};
+        (p,c)
+    }
+    #[test]
+    fn uncached_body_has_complete_unambiguous_generated_partition() {
+        let (p,c) = fixture(); assert!(generated_uncached_plain_rows(&p,&c));
+        let changes: Vec<fn(&mut ComposedParagraph)> = vec![
+            |c| c.lines[1].column_start = 1,
+            |c| c.lines[1].segment_width -= 1,
+            |c| c.lines[1].char_start = 3,
+            |c| c.lines[1].has_line_break = true,
+            |c| c.lines[1].runs[0].inserted_control_text = true,
+            |c| c.lines[1].runs[0].footnote_marker = Some(1),
+            |c| c.lines[1].runs[0].text.push('X'),
+            |c| c.lines.pop().map(|_| ()).unwrap(),
+        ];
+        for (i, change) in changes.into_iter().enumerate() {
+            let mut cc = c.clone(); change(&mut cc);
+            assert!(!generated_uncached_plain_rows(&p,&cc), "negative {i}");
+        }
+        let mut stored = p.clone(); stored.line_segs.push(LineSeg::default());
+        assert!(!generated_uncached_plain_rows(&stored,&c));
+    }
+}
