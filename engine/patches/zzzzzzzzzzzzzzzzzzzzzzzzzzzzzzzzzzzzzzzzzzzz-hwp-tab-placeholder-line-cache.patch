+            for _ in 0..2 {
+                let bytes = serialize_section(&section);
+                assert_eq!(g069_hwp_header_count(&bytes), 0);
+                let parsed = parse_body_text_section(&bytes).unwrap();
+                assert_eq!(parsed.section_def.default_tab_spacing, spacing);
+                assert_eq!(parsed.paragraphs[0].text, "A\tB\tC");
+                assert!(crate::model::paragraph::tab_ext_is_placeholder(&parsed.paragraphs[0].tab_extended[0]));
+                assert_eq!(parsed.paragraphs[0].tab_extended[1][0], 3000);
+                section = parsed;
+                // Explicit regenerated model path; unchanged native raw reuse remains separate.
+                section.raw_stream = None;
+                section.raw_provenance = None;
+            }
+        }
+    }
