+    #[test]
+    fn g069_hwp_sealed_unchanged_raw_is_preserved_but_text_edit_rebuilds() {
+        let mut section = g069_hwp_tab_fixture("A\tB\tC", vec![crate::model::paragraph::TAB_EXT_PLACEHOLDER; 2]);
+        let bytes = serialize_section(&section);
+        let mut records = Record::read_all(&bytes).unwrap();
+        let header = records.iter_mut().find(|r| r.tag_id == tags::HWPTAG_PARA_HEADER && r.level == 0).unwrap();
+        header.data[16..18].copy_from_slice(&1u16.to_le_bytes());
+        let at = records.iter().position(|r| r.tag_id == tags::HWPTAG_PARA_CHAR_SHAPE).unwrap() + 1;
+        let data = serialize_para_line_seg(&section.paragraphs[0].line_segs);
+        records.insert(at, Record { tag_id: tags::HWPTAG_PARA_LINE_SEG, level: 1, size: data.len() as u32, data });
+        let legacy = write_records(&records);
+        section.raw_stream = Some(legacy.clone());
+        section.seal_raw_provenance();
+        assert!(section.raw_provenance_permits_reuse());
+        assert_eq!(serialize_section(&section), legacy, "do not rewrite unchanged native authority");
+        section.paragraphs[0].insert_text_at(0, "X");
+        assert!(!section.raw_provenance_permits_reuse());
+        let edited = serialize_section(&section);
+        assert_eq!(g069_hwp_header_count(&edited), 0);
+        let reparsed = parse_body_text_section(&edited).unwrap();
+        assert_eq!(reparsed.paragraphs[0].text, "XA\tB\tC");
+        assert!(reparsed.paragraphs[0].line_segs.is_empty());
+    }
