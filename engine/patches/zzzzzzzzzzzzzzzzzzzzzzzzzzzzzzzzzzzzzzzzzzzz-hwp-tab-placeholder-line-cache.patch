+    fn g069_hwp_tab_fixture(text: &str, tabs: Vec<[u16; 7]>) -> Section {
+        Section {
+            paragraphs: vec![Paragraph {
+                text: text.to_string(),
+                tab_extended: tabs,
+                line_segs: vec![LineSeg {
+                    text_start: 0, vertical_pos: 1600, line_height: 1000,
+                    text_height: 1000, baseline_distance: 850, line_spacing: 600,
+                    column_start: 0, segment_width: 42520, tag: 393216,
+                }],
+                ..Default::default()
+            }],
+            ..Default::default()
+        }
+    }
+
+    fn g069_hwp_header_count(bytes: &[u8]) -> u16 {
+        let records = Record::read_all(bytes).unwrap();
+        let header = records.iter().find(|r| r.tag_id == tags::HWPTAG_PARA_HEADER && r.level == 0).unwrap();
+        u16::from_le_bytes(header.data[16..18].try_into().unwrap())
+    }
+
+    #[test]
+    fn g069_hwp_unresolved_tabs_omit_line_record_and_header_count_together() {
+        for tabs in [vec![], vec![crate::model::paragraph::TAB_EXT_PLACEHOLDER; 2], vec![[0, 0, 0x0100, 0, 0, 0, 9]; 2]] {
+            let section = g069_hwp_tab_fixture("A\tB\tC", tabs);
+            let old_rows = section.paragraphs[0].line_segs.clone();
+            let bytes = serialize_section(&section);
+            assert_eq!(g069_hwp_header_count(&bytes), 0);
+            assert!(!Record::read_all(&bytes).unwrap().iter().any(|r| r.tag_id == tags::HWPTAG_PARA_LINE_SEG));
+            let parsed = parse_body_text_section(&bytes).unwrap();
+            assert_eq!(parsed.paragraphs[0].text, "A\tB\tC");
+            assert!(parsed.paragraphs[0].line_segs.is_empty());
+            assert_eq!(section.paragraphs[0].line_segs, old_rows, "export does not mutate live model");
+        }
+    }
+
+    #[test]
+    fn g069_hwp_resolved_unknown_zero_and_unused_tabs_preserve_rows() {
+        for ext in [[3000, 0, 0x0100, 0, 0, 0, 9], [0, 0, 0x0500, 0, 0, 0, 9], [0, 0, 0x0101, 0, 0, 0, 9], [0, 0, 0x0100, 1, 0, 0, 9]] {
+            let section = g069_hwp_tab_fixture("A\tB", vec![ext]);
+            let bytes = serialize_section(&section);
+            assert_eq!(g069_hwp_header_count(&bytes), 1);
+            let parsed = parse_body_text_section(&bytes).unwrap();
+            assert_eq!(parsed.paragraphs[0].line_segs.len(), 1);
+            assert_eq!(parsed.paragraphs[0].tab_extended[0], ext);
