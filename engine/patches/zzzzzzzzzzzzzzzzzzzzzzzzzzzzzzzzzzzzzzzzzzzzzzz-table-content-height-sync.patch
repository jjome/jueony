+    /// Read-only plan for an explicit plain-table aggregate-height synchronization.
+    /// The application must bind this plan to its document revision/snapshot.
+    pub fn get_table_content_height_plan_native(&self, section_idx: usize, para_idx: usize, control_idx: usize) -> Result<String, HwpError> {
+        self.plain_table_content_height_plan(section_idx, para_idx, control_idx).map(|plan| plan.to_string())
