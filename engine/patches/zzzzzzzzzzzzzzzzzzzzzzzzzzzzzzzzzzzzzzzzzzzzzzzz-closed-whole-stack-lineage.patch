+/// A markerless HWPX whole-table source stack closes exactly at the declared
+/// physical frames. Hancom SaveAs removes the HWP5 lineage marker but retains
+/// this integer source proof; its empty host spacing is not another blank row.
+/// Dense, gapped, dirty, protected, absolute or ambiguous ladders do not qualify.
+pub(crate) fn stored_closed_whole_table_stack(paragraphs: &[Paragraph], at: usize) -> bool {
+    fn owner(p: &Paragraph) -> Option<&Table> {
+        let [Control::Table(t)] = p.controls.as_slice() else { return None; };
+        if !object_only_saved_table_anchor(p, t) || p.stored_text_partition_is_dirty()
+            || p.cell_format_vpos_dirty || t.page_break != TablePageBreak::None
+            || t.common.vert_rel_to != VertRelTo::Para || t.common.vert_align != VertAlign::Top
+            || signed_hwpunit(t.common.vertical_offset) != 0 || t.common.size_protect
+            || t.common.locked || t.attr & (1 << 30) != 0 || t.raw_table_record_attr & 8 != 0
+            || t.common.height_criterion != crate::model::shape::SizeCriterion::Absolute
+            || t.common.height == 0 || t.common.height >= 0x8000_0000
+            || t.caption.is_some() || !t.zones.is_empty() || t.cells.is_empty() || t.cells.len() > 4096
+            || t.cells.iter().any(|cell| cell.row_span != 1 || cell.col_span != 1
+                || cell.cell_protect() || cell.field_name.is_some() || cell.text_direction != 0
+                || cell.paragraphs.is_empty() || cell.paragraphs.iter().any(|p|
+                    !p.controls.is_empty() || !p.field_ranges.is_empty() || !p.orphan_field_ends.is_empty()
+                    || !p.range_tags.is_empty() || !p.title_marks.is_empty()
+                    || p.ctrl_data_records.iter().any(Option::is_some)))
+            || !matches!(p.line_segs.as_slice(), [line] if line.vertical_pos >= 0
+                && line.line_height > 0 && line.tag & 0x8000_0000 == 0) { return None; }
+        Some(t)
+    }
+    if paragraphs.get(at).and_then(owner).is_none() { return false; }
+    let has_table=|p: &Paragraph| p.controls.iter().any(|c| matches!(c, Control::Table(_)));
+    let mut start=at; while start>0 && has_table(&paragraphs[start-1]) { start-=1; }
+    let mut end=at+1; while end<paragraphs.len() && has_table(&paragraphs[end]) { end+=1; }
+    if end-start<2 || end-start>64 || !paragraphs[start..end].iter().all(|p| owner(p).is_some()) { return false; }
