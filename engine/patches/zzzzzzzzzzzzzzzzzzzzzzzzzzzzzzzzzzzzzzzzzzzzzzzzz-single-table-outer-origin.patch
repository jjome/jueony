+/// A single empty host with an unresolved zero-width text-line template must not
+/// turn its outer top into a second paint inset. Its final empty paragraph row
+/// still advances by one template line, not by the table's outer box. This is
+/// deliberately not a general stored-anchor interpretation or a cache rewrite.
+fn unresolved_single_table_placeholder_origin_hu(
+    native_profile: bool,
+    column_count: usize,
+    paragraphs: &[Paragraph],
+    index: usize,
+    table: &crate::model::table::Table,
+    measured_height: Option<f64>,
+    dpi: f64,
+) -> Option<i32> {
+    use crate::model::paragraph::ColumnBreakType;
+    let para = paragraphs.get(index)?;
+    let prev = paragraphs.get(index.checked_sub(1)?)?;
+    let next = paragraphs.get(index.checked_add(1)?)?;
+    let plain_metadata = |p: &Paragraph| p.field_ranges.is_empty()
+        && p.orphan_field_ends.is_empty() && p.range_tags.is_empty()
+        && p.title_marks.is_empty() && p.markpen_marks.is_empty()
+        && p.ctrl_data_records.iter().all(Option::is_none)
+        && p.tab_extended.is_empty() && p.numbering_restart.is_none()
+        && p.layout_only_fill_lines == 0 && !p.stored_text_partition_is_dirty()
+        && !p.cell_format_vpos_dirty;
+    if !native_profile || column_count != 1 || !para.text.is_empty()
+        || !plain_metadata(para) || !plain_metadata(prev) || !plain_metadata(next)
+        || !matches!(para.column_type, ColumnBreakType::None)
+        || !matches!(next.column_type, ColumnBreakType::None)
+        || !matches!(para.controls.as_slice(), [Control::Table(_)])
+        || !prev.controls.iter().all(|c| matches!(c, Control::SectionDef(_) | Control::ColumnDef(_)))
+        || !next.controls.is_empty() || !para_has_visible_text(prev) || !next.text.is_empty()
+        || index.checked_add(2) != Some(paragraphs.len())
+        || paragraphs.iter().flat_map(|p| &p.controls).filter(|c| matches!(c, Control::Table(_))).take(2).count() != 1
+        || !is_para_topbottom_float(&table.common)
+        || !matches!(table.common.vert_align, VertAlign::Top)
+        || !matches!(table.common.horz_rel_to, HorzRelTo::Para)
+        || !matches!(table.common.horz_align, HorzAlign::Left)
+        || table.common.vertical_offset != 0 || table.common.horizontal_offset != 0
+        || table.common.locked || table.common.size_protect || table.caption.is_some()
+        || table.common.attr & (1 << 30) != 0 || table.attr & (1 << 30) != 0
+        // Known TABLE bit26 materializes nonzero HWPX inMargin. No other
+        // record flags (including noAdjust0x08) belong to this plain scope.
+        || table.raw_table_record_attr & !0x0400_0000 != 0
+        || !matches!(table.common.height_criterion, crate::model::shape::SizeCriterion::Absolute)
+        || !matches!(table.common.width_criterion, crate::model::shape::SizeCriterion::Absolute)
+        || table.common.width == 0 || table.common.width > i32::MAX as u32
+        || table.page_break != TablePageBreak::None || table.repeat_header || !table.zones.is_empty()
+        || table.cell_spacing != 0
+        || table.outer_margin_top <= 0 || table.outer_margin_left < 0
+        || table.outer_margin_right < 0 || table.outer_margin_bottom < 0
+        || (table.outer_margin_top == table.outer_margin_bottom
+            && table.outer_margin_top == table.outer_margin_left
+            && table.outer_margin_top == table.outer_margin_right)
+        || table.row_count == 0 || table.col_count == 0
+        || table.cells.len() != usize::from(table.row_count) * usize::from(table.col_count)
+        || table.cells.iter().enumerate().any(|(i, c)|
+            usize::from(c.row) != i / usize::from(table.col_count)
+            || usize::from(c.col) != i % usize::from(table.col_count)
+            || c.paragraphs.len() != 1 || c.cell_protect() || c.field_name.is_some()
+            || c.row_span != 1 || c.col_span != 1 || c.width == 0 || c.height == 0
+            || c.width > i32::MAX as u32 || c.height > i32::MAX as u32
+            || c.text_direction != 0 || c.line_wrap != 0
+            || c.paragraphs.iter().any(|p| !p.controls.is_empty() || !plain_metadata(p)))
+        || table.common.height == 0 || table.common.height > i32::MAX as u32
+        || !measured_height.is_some_and(|h| (h - hwpunit_to_px(table.common.height as i32, dpi)).abs() <= 0.2)
+    { return None; }
+    let [before] = prev.line_segs.as_slice() else { return None; };
+    let [host] = para.line_segs.as_slice() else { return None; };
+    let [following] = next.line_segs.as_slice() else { return None; };
+    let template = |line: &crate::model::paragraph::LineSeg| {
+        line.tag == 0x0006_0000 && line.line_height > 0 && line.text_height == line.line_height
+            && line.baseline_distance > 0 && line.baseline_distance <= line.text_height
+            && line.line_spacing >= 0 && line.column_start == 0
+    };
+    if !template(before) || !template(host) || !template(following)
+        || host.segment_width != 0 || before.segment_width <= 0
+        || following.segment_width != before.segment_width
+        || host.vertical_pos <= 0 || before.vertical_pos < 0
+        || host.line_height != before.line_height || host.line_height != following.line_height
+        || host.line_spacing != before.line_spacing || host.line_spacing != following.line_spacing
+        || host.text_height != before.text_height || host.text_height != following.text_height
+        || host.baseline_distance != before.baseline_distance || host.baseline_distance != following.baseline_distance
+        || i64::from(host.vertical_pos) - i64::from(before.vertical_pos)
+            != i64::from(before.line_height) + i64::from(before.line_spacing)
+        || i64::from(following.vertical_pos) - i64::from(host.vertical_pos)
+            != i64::from(host.line_height) + i64::from(host.line_spacing)
+        || i64::from(table.common.height) + i64::from(table.outer_margin_top)
+            + i64::from(table.outer_margin_bottom)
+            <= i64::from(host.line_height) + i64::from(host.line_spacing)
+    { return None; }
+    Some(host.vertical_pos)
+}
