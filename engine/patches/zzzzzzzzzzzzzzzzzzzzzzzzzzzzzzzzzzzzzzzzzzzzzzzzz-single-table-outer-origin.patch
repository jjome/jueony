+        if !matches!(self.source_format, crate::parser::FileFormat::Hwpx)
+            || self.document.provenance.hwp3_lineage
+            || self.effective_layout_profile().session_edited()
+            || self.document.hwpx_aux_entry(HWP5_ORIGIN_HWPX_MARKER_PATH)
+                != Some(HWP5_ORIGIN_HWPX_PARAGRAPH_AXIS)
+            || self.document.extra_streams.iter().any(|(p,_)|p==HWPX_ORIGIN_STREAM_PATH) {
+            return false;
+        }
+        let ([section],[pagination],[measurements]) = (self.document.sections.as_slice(),
+            self.pagination.as_slice(),self.measured_tables.as_slice()) else { return false; };
+        let [page]=pagination.pages.as_slice() else { return false; };
+        let [column]=page.column_contents.as_slice() else { return false; };
+        if column.zone_layout.is_some() || column.zone_y_offset!=0.0
+            || column.start_height!=0.0 || column.endnote_flow
+            || !matches!(column.items.as_slice(),[PageItem::FullParagraph{para_index:0},
+                PageItem::Table{para_index:1,control_index:0},PageItem::FullParagraph{para_index:2}]) {
+            return false;
+        }
+        let Some(host)=section.paragraphs.get(1) else { return false; };
+        let [Control::Table(table)]=host.controls.as_slice() else { return false; };
+        let [measured]=measurements.as_slice() else { return false; };
+        if measured.para_index!=1 || measured.control_index!=0 { return false; }
+        crate::renderer::layout::unresolved_single_table_placeholder_paint_origin_hu(
+            self.effective_layout_profile().hwp5_stored_pagination_layout(),1,
+            &section.paragraphs,1,table,Some(measured.total_height),self.dpi,
+            column.paragraph_float_placements.get(&(1,0))).is_some()
+    }
