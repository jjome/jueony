+/// The unresolved template is meaningful only when the existing flow plan
+/// already reserves its complete outer band. Share this exact paint proof with
+/// marker-HWPX lowering; do not reinterpret general HWPX-derived binaries.
+pub(crate) fn unresolved_single_table_placeholder_paint_origin_hu(
+    native_profile: bool,
+    column_count: usize,
+    paragraphs: &[Paragraph],
+    index: usize,
+    table: &crate::model::table::Table,
+    measured_height: Option<f64>,
+    dpi: f64,
+    placement: Option<&crate::renderer::float_placement::ParagraphFloatPlacement>,
+) -> Option<i32> {
+    let origin = unresolved_single_table_placeholder_origin_hu(
+        native_profile, column_count, paragraphs, index, table, measured_height, dpi)?;
+    let p = placement?;
+    let host = hwpunit_to_px(origin, dpi);
+    let equal = |a: f64, b: f64| (a - b).abs() <= 0.000_001;
+    (matches!(p.flow, crate::renderer::float_placement::ParagraphFloatFlow::Exclusion)
+        && p.table_left.is_none()
+        && p.stored_successor_line_origin.is_none()
+        && p.stored_host_origin.is_some_and(|v| equal(v, host))
+        && equal(p.anchor_y, host)
+        && equal(p.table_top, host + hwpunit_to_px(table.outer_margin_top as i32, dpi))
+        && equal(p.occupied_bottom, p.table_top
+            + hwpunit_to_px(table.common.height as i32, dpi)
+            + hwpunit_to_px(table.outer_margin_bottom as i32, dpi)))
+        .then_some(origin)
 }
 
