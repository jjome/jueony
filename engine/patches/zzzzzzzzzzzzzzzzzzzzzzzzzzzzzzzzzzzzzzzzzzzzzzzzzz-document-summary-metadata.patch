+/// Export-only format lowering. Never changes live IR or unparseable storage.
+pub(crate) fn sync_hwp_export(doc: &mut Document, source: FileFormat) {
+    if !matches!(source, FileFormat::Hwpx) {
+        return;
+    }
+    let Ok(fields) = read(doc) else {
+        return;
+    };
+    let Ok((streams, _)) = replacements(doc, &fields) else {
+        return;
+    };
+    doc.extra_streams = streams;
