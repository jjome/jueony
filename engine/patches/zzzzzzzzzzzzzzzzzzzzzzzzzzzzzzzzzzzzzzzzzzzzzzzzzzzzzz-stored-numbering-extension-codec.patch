+//! Private interchange codec for stored numbering levels8..10; no Agent level API.
+use crate::model::style::{Numbering, NumberingHead};
+use crate::parser::hwpx::utils::{attr_str, local_name};
+use quick_xml::{events::Event, Reader};
+#[derive(Clone, Debug)]
+pub(crate) struct Extension {
+    pub heads: [NumberingHead; 3],
+    pub formats: [String; 3],
+    pub starts: [u32; 3],
+    pub checked: [bool; 3],
+}
+impl Extension {
+    /// No independent HWP5 checkable bit was present in actual single-attribute A/B.
+    /// Hancom disk reload normalizes circled heads from checkable=0 to1. Do not
+    /// claim either direction preserves that XML value without a native codec.
+    pub(crate) fn has_unrepresentable_checkable(&self) -> bool {
+        self.checked.iter().any(|checked| *checked)
+            || self
+                .heads
+                .iter()
+                .any(|head| matches!(head.number_format, 1 | 6 | 7 | 9 | 11 | 14))
+    }
+}
+
+impl Default for Extension {
+    fn default() -> Self {
+        Self {
+            heads: [NumberingHead::default(); 3],
+            formats: Default::default(),
+            starts: [1; 3],
+            checked: [false; 3],
+        }
+    }
+}
+fn text(reader: &mut Reader<&[u8]>) -> Result<String, String> {
+    let mut result = String::new();
+    let mut buf = Vec::new();
+    loop {
+        match reader
+            .read_event_into(&mut buf)
+            .map_err(|e| e.to_string())?
+        {
+            Event::Text(t) => result
+                .push_str(&quick_xml::escape::unescape(t.as_ref()).map_err(|e| e.to_string())?),
+            Event::CData(t) => result.push_str(t.as_ref()),
+            Event::GeneralRef(t) => result.push_str(
+                &quick_xml::escape::unescape(&format!("&{};", t.as_ref()))
+                    .map_err(|e| e.to_string())?,
+            ),
+            Event::Comment(_) => {}
+            Event::End(e) if local_name(e.name().as_ref()) == b"paraHead" => return Ok(result),
+            _ => return Err("nested or incomplete numbering head".into()),
+        }
+        buf.clear();
+    }
+}
+fn xml_chars(s: &str) -> bool {
+    s.chars().all(|c| {
+        matches!(c, '\t' | '\n' | '\r')
+            || matches!(c,'\u{20}'..='\u{d7ff}'|'\u{e000}'..='\u{fffd}'|'\u{10000}'..='\u{10ffff}')
+    })
+}
+fn boolean(s: &str) -> bool {
+    matches!(s, "1" | "true")
+}
+pub(crate) fn from_xml(raw: &str) -> Result<Option<Extension>, String> {
+    if raw.len() > 512 * 1024 {
+        return Err("numbering XML exceeds bounded codec limit".into());
+    }
+    let mut reader = Reader::from_str(raw);
+    let mut buf = Vec::new();
+    let mut out = Extension::default();
+    let mut seen = [false; 3];
+    loop {
+        let event = reader
+            .read_event_into(&mut buf)
+            .map_err(|e| e.to_string())?;
+        match event {
+            Event::Start(ref e) | Event::Empty(ref e)
+                if local_name(e.name().as_ref()) == b"paraHead" =>
+            {
+                let empty = matches!(&event, Event::Empty(_));
+                let attrs = e
+                    .attributes()
+                    .collect::<Result<Vec<_>, _>>()
+                    .map_err(|e| e.to_string())?;
+                let level = attr_str(
+                    attrs
+                        .iter()
+                        .find(|a| a.key.as_ref().as_bytes() == b"level")
+                        .ok_or("missing level")?,
+                )
+                .parse::<usize>()
+                .map_err(|e| e.to_string())?;
+                if !(1..=10).contains(&level) {
+                    return Err("numbering level outside stored1..10".into());
+                }
+                if level < 8 {
+                    if !empty {
+                        let _ = text(&mut reader)?;
+                    }
+                    buf.clear();
+                    continue;
+                }
+                let index = level - 8;
+                if seen[index] {
+                    return Err("duplicate extended level".into());
+                }
+                seen[index] = true;
+                for a in &attrs {
+                    let key = a.key.as_ref();
+                    let value = attr_str(a);
+                    let good = match key.as_bytes() {
+                        b"level" => true,
+                        b"start" | b"charPrIDRef" => value.parse::<u32>().is_ok(),
+                        b"widthAdjust" | b"textOffset" => value.parse::<i16>().is_ok(),
+                        b"align" => matches!(value.as_str(), "LEFT" | "CENTER" | "RIGHT"),
+                        b"textOffsetType" => matches!(value.as_str(), "PERCENT" | "HWPUNIT"),
+                        b"useInstWidth" | b"autoIndent" | b"checkable" => {
+                            matches!(value.as_str(), "0" | "1" | "false" | "true")
+                        }
+                        b"numFormat" => {
+                            super::hwpx::header::numbering_format_code_strict(&value).is_some()
+                        }
+                        b"text" => true,
+                        _ => false,
+                    };
+                    if !good {
+                        return Err(format!("unsupported extended numbering attribute {key}"));
+                    }
+                }
+                let (_, head, start, mut format) =
+                    super::hwpx::header::parse_numbering_para_head_attrs(e);
+                if !empty {
+                    format.push_str(&text(&mut reader)?);
+                }
+                if !xml_chars(&format) || format.encode_utf16().count() > u16::MAX as usize {
+                    return Err("extended numbering format exceeds UINT16 length".into());
+                }
+                out.heads[index] = head;
+                out.starts[index] = start.unwrap_or(1);
+                out.formats[index] = format;
+                out.checked[index] = attrs
+                    .iter()
+                    .find(|a| a.key.as_ref().as_bytes() == b"checkable")
+                    .is_some_and(|a| boolean(&attr_str(a)));
+            }
+            Event::Text(t) if t.as_ref().trim().is_empty() => {}
+            Event::Comment(_) => {}
+            Event::Eof => break,
+            _ => return Err("unsupported numbering XML content".into()),
+        }
+        buf.clear();
+    }
+    if seen.iter().all(|x| !*x) {
+        Ok(None)
+    } else if seen.iter().all(|x| *x) {
+        Ok(Some(out))
+    } else {
+        Err("partial extended numbering definition".into())
+    }
+}
+fn take<'a>(b: &'a [u8], p: &mut usize, n: usize) -> Result<&'a [u8], String> {
+    let end = p.checked_add(n).ok_or("offset overflow")?;
+    let v = b.get(*p..end).ok_or("truncated numbering extension")?;
+    *p = end;
+    Ok(v)
+}
+fn u16_at(b: &[u8], p: &mut usize) -> Result<u16, String> {
+    Ok(u16::from_le_bytes(take(b, p, 2)?.try_into().unwrap()))
+}
+fn u32_at(b: &[u8], p: &mut usize) -> Result<u32, String> {
+    Ok(u32::from_le_bytes(take(b, p, 4)?.try_into().unwrap()))
+}
+fn string(b: &[u8], p: &mut usize) -> Result<String, String> {
+    let n = u16_at(b, p)? as usize;
+    let units = take(b, p, n * 2)?
+        .chunks_exact(2)
+        .map(|v| u16::from_le_bytes(v.try_into().unwrap()))
+        .collect::<Vec<_>>();
+    String::from_utf16(&units).map_err(|e| e.to_string())
+}
+/// Exact modern extended-head payload observed in Hancom files. Unknown tails fail closed.
+pub(crate) fn from_binary_record(raw: &[u8]) -> Result<Option<Extension>, String> {
+    let mut p = 0;
+    for _ in 0..7 {
+        take(raw, &mut p, 12)?;
+        let _ = string(raw, &mut p)?;
+    }
+    take(raw, &mut p, 2)?;
+    if p == raw.len() {
+        return Ok(None);
+    }
+    take(raw, &mut p, 28)?;
+    if p == raw.len() {
+        return Ok(None);
+    }
+    let mut ext = Extension::default();
+    for i in 0..3 {
+        let attr = u32_at(raw, &mut p)?;
+        if attr & !0x1ff != 0 || attr & 3 == 3 {
+            return Err("unknown extended head attribute bits".into());
+        }
+        let width = i16::from_le_bytes(take(raw, &mut p, 2)?.try_into().unwrap());
+        let distance = i16::from_le_bytes(take(raw, &mut p, 2)?.try_into().unwrap());
+        let id = u32_at(raw, &mut p)?;
+        ext.heads[i] = NumberingHead {
+            attr,
+            width_adjust: width,
+            text_distance: distance,
+            char_shape_id: id,
+            number_format: ((attr >> 5) & 15) as u8,
+        };
+        if ext.heads[i].number_format > 14 {
+            return Err("unsupported extended numbering format".into());
+        }
+        ext.formats[i] = string(raw, &mut p)?;
+        if !xml_chars(&ext.formats[i]) {
+            return Err("extended numbering contains non-XML characters".into());
+        }
+    }
+    for i in 0..3 {
+        ext.starts[i] = u32_at(raw, &mut p)?;
+    }
+    if p != raw.len() {
+        return Err("unknown bytes after extended numbering starts".into());
+    }
+    Ok(Some(ext))
+}
+fn format_name(code: u8) -> &'static str {
+    [
+        "DIGIT",
+        "CIRCLED_DIGIT",
+        "ROMAN_CAPITAL",
+        "ROMAN_SMALL",
+        "LATIN_CAPITAL",
+        "LATIN_SMALL",
+        "CIRCLED_LATIN_CAPITAL",
+        "CIRCLED_LATIN_SMALL",
+        "HANGUL_SYLLABLE",
+        "CIRCLED_HANGUL_SYLLABLE",
+        "HANGUL_JAMO",
+        "CIRCLED_HANGUL_JAMO",
+        "HANGUL_PHONETIC",
+        "IDEOGRAPH",
+        "CIRCLED_IDEOGRAPH",
+    ]
+    .get(code as usize)
+    .copied()
+    .unwrap_or("DIGIT")
+}
+/// Reconstruct a value-preserving XML view from HWP metadata; not original XML provenance.
+pub(crate) fn xml_view(n: &Numbering, ext: &Extension) -> String {
+    let mut out = String::new();
+    for i in 0..10 {
+        let (h, start, format, checked) = if i < 7 {
+            (
+                &n.heads[i],
+                n.level_start_numbers[i],
+                &n.level_formats[i],
+                false,
+            )
+        } else {
+            (
+                &ext.heads[i - 7],
+                ext.starts[i - 7],
+                &ext.formats[i - 7],
+                ext.checked[i - 7],
+            )
+        };
+        let align = match h.attr & 3 {
+            1 => "CENTER",
+            2 => "RIGHT",
+            _ => "LEFT",
+        };
+        let level = i + 1;
+        let use_inst_width = (h.attr >> 2) & 1;
+        let auto_indent = (h.attr >> 3) & 1;
+        let width_adjust = h.width_adjust;
+        let offset_type = if h.attr & 16 != 0 {
+            "HWPUNIT"
+        } else {
+            "PERCENT"
+        };
+        let text_offset = h.text_distance;
+        let number_format = format_name(h.number_format);
+        let char_ref = h.char_shape_id;
+        let checkable = if checked { 1 } else { 0 };
+        let escaped_format = quick_xml::escape::escape(format);
+        out.push_str(&format!(
+            "<hh:paraHead start=\"{start}\" level=\"{level}\" align=\"{align}\" \
+             useInstWidth=\"{use_inst_width}\" autoIndent=\"{auto_indent}\" \
+             widthAdjust=\"{width_adjust}\" textOffsetType=\"{offset_type}\" \
+             textOffset=\"{text_offset}\" numFormat=\"{number_format}\" \
+             charPrIDRef=\"{char_ref}\" checkable=\"{checkable}\">{escaped_format}</hh:paraHead>"
+        ));
+    }
+    out
+}
