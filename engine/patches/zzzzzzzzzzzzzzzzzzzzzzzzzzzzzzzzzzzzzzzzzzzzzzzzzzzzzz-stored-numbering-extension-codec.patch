@@ -0,0 +1,71 @@
+//! Stored numbering extension export must never silently replace unsupported values.
+use super::content_loss::{
+    ContentLoss, ContentLossCode, ContentLossReason, ContentLossReport, ContentLossSubject,
+    SerializedFormat,
+};
+use crate::model::document::Document;
+pub(super) fn record(doc: &Document, report: &mut ContentLossReport) {
+    for (i, n) in doc.doc_info.numberings.iter().enumerate() {
+        let native_raw = n.raw_data.as_ref().filter(|_| {
+            crate::model::raw_provenance::record_raw_permitted(
+                doc.doc_info
+                    .raw_provenance
+                    .as_ref()
+                    .map(|s| &s.record_seals.numberings[..]),
+                i,
+                n,
+            )
+        });
+        let lost = match report.output_format() {
+            SerializedFormat::Hwp => {
+                if native_raw.is_some() {
+                    false
+                } else if let Some(raw) = &n.raw_para_heads {
+                    match crate::parser::numbering_extension::from_xml(raw) {
+                        Ok(Some(ext)) => {
+                            ext.has_unrepresentable_checkable()
+                                || (
+                                    doc.header.version.major,
+                                    doc.header.version.minor,
+                                    doc.header.version.build,
+                                    doc.header.version.revision,
+                                ) < (5, 1, 0, 0)
+                        }
+                        Ok(None) => false,
+                        Err(_) => true,
+                    }
+                } else {
+                    false
+                }
+            }
+            SerializedFormat::Hwpx => n.raw_data.as_ref().is_some_and(|raw| {
+                match crate::parser::numbering_extension::from_binary_record(raw) {
+                    Ok(Some(ext)) => ext.has_unrepresentable_checkable(),
+                    Ok(None) => false,
+                    Err(_) => n.raw_para_heads.is_none(),
+                }
+            }),
+        };
+        let reason = if report.output_format() == SerializedFormat::Hwp
+            && (
+                doc.header.version.major,
+                doc.header.version.minor,
+                doc.header.version.build,
+                doc.header.version.revision,
+            ) < (5, 1, 0, 0)
+        {
+            ContentLossReason::UnsupportedByOutputFormat
+        } else {
+            ContentLossReason::SerializerNotImplemented
+        };
+        if lost {
+            report.record(ContentLoss {
+                code: ContentLossCode::MetadataReduced,
+                subject: ContentLossSubject::ParagraphProperties,
+                path: format!("docInfo/numbering/{i}/extendedLevels8To10"),
+                reason,
+                resource_id: None,
+            });
+        }
+    }
+}
