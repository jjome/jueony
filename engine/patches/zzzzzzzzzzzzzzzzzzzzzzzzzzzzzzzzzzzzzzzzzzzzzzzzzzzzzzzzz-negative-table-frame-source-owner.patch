+/// Two independently recorded native sources: empty-row cache or exactly
+/// closed predecessor outer frame. Arbitrary source gaps remain unowned.
+pub(crate) fn negative_pair_has_frame_anchor(paragraphs:&[Paragraph])->bool {
+    if !plain_negative_offset_pair(paragraphs) { return false; }
+    let [Control::Table(previous)]=paragraphs[1].controls.as_slice() else { return false; };
+    let [Control::Table(target)]=paragraphs[2].controls.as_slice() else { return false; };
+    if previous.common.width!=target.common.width || previous.common.horizontal_offset!=0 || target.common.horizontal_offset!=0
+        || previous.common.width_criterion!=crate::model::shape::SizeCriterion::Absolute
+        || target.common.width_criterion!=crate::model::shape::SizeCriterion::Absolute { return false; }
+    let before=&paragraphs[1].line_segs[0];let after=&paragraphs[2].line_segs[0];
+    negative_pair_has_cached_empty_anchor(paragraphs) ||
+        i64::from(after.vertical_pos)-i64::from(before.vertical_pos)==i64::from(previous.common.height)
+            +i64::from(previous.outer_margin_top)+i64::from(previous.outer_margin_bottom)
+}
