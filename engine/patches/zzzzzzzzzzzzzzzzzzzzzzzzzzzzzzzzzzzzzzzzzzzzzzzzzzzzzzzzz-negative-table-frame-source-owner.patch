+/// Only the exact empty-row ladder is a cached anchor, not a physical table edge.
+pub(crate) fn negative_pair_has_cached_empty_anchor(paragraphs: &[Paragraph]) -> bool {
+    if !plain_negative_offset_pair(paragraphs) { return false; }
+    let before=&paragraphs[1].line_segs[0];
+    let after=&paragraphs[2].line_segs[0];
+    before.line_spacing>0 && before.line_height==after.line_height
+        && before.line_spacing==after.line_spacing
+        && i64::from(after.vertical_pos)==i64::from(before.vertical_pos)+i64::from(before.line_height)+i64::from(before.line_spacing)
+}
