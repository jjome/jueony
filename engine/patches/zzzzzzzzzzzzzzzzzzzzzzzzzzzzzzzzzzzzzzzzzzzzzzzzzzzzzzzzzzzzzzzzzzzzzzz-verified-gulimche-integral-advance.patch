+/// Integer TTF advances may be consumed without the estimated-font allowance.
+/// This is a measurement proof for every scalar, not a font-name shortcut.
+/// Controls, authored condense, markers and any unproved scalar keep their
+/// established fill owner and conversion rules.
+fn paragraph_has_integral_gulimche_advances(
+    para: &Paragraph,
+    styles: &ResolvedStyleSet,
+    space_metric: SpaceMetric,
+) -> bool {
+    if para.text.is_empty() || !para.controls.is_empty()
+        || !styles.para_styles.get(para.para_shape_id as usize).is_some_and(|p|
+            p.condense_min_space == 0 && p.head_type == HeadType::None
+                && p.numbering_id == 0 && p.indent == 0.0)
+    {
+        return false;
+    }
+    let chars: Vec<_> = para.text.chars().collect();
+    let metric_scope = ParagraphMetricScope::new(&chars, styles)
+        .with_reflow_slots(&chars).with_space_metric(space_metric);
+    let mut lang = 0;
+    chars.iter().enumerate().all(|(index, &ch)| {
+        let offset = para.char_offsets.get(index).copied().unwrap_or(index as u32);
+        let id = find_active_char_shape(&para.char_shapes, offset);
+        let slot = char_lang_slot(ch, &mut lang, punct_latin_slot(styles, id));
+        let style = metric_scope.style(styles, id, slot, index);
+        crate::renderer::layout::trace_char_width_decisions(&ch.to_string(), &style)
+            .first().is_some_and(|d| d.integral_advance_hwp.is_some())
+    })
+}
