+/// Native Hancom fresh-row controls distinguish GulimChe's four-HWPUNIT
+/// natural advances: Hangul and ordinary blank truncate; nonblank ASCII rounds.
+/// Source TTF ownership and the actual selected metric must agree. This does
+/// not enlarge a physical interval or change authored spacing/row boundaries.
+fn regular_gulimche_natural_advance_hwp(
+    character: char,
+    style: &TextStyle,
+    font_size: f64,
+    ratio: f64,
+    letter_spacing: f64,
+    trusted: bool,
+    metric: Option<font_metrics_data::MetricLookupDecision<'_>>,
+) -> Option<i32> {
+    let selected = metric?;
+    if !trusted
+        || selected.metric.name != "GulimChe"
+        || selected.bold_fallback
+        || selected.match_kind != font_metrics_data::MetricMatchKind::Exact
+        || style.font_size <= 0.0
+        || style.ratio <= 0.0
+        || style.bold
+        || style.italic
+        || style.kerning
+        || style.superscript
+        || style.subscript
+        || style.hft_hangul_face
+        || style.hft_fullwidth_dot
+        || style.font_space_em.is_some()
+        || style.supplemental_metrics.is_some()
+        || letter_spacing != 0.0
+        || !font_size.is_finite()
+        || font_size <= 0.0
+        || !ratio.is_finite()
+        || ratio <= 0.0
+    {
+        return None;
+    }
+    let full = matches!(character, '\u{AC00}'..='\u{D7A3}');
+    let blank = character == ' ';
+    if !full && !blank && !character.is_ascii_graphic() {
+        return None;
+    }
+    let glyph_units = selected.metric.get_width(character)?;
+    let expected_units = if full {
+        selected.metric.em_size
+    } else {
+        selected.metric.em_size / 2
+    };
+    if glyph_units != expected_units {
+        return None;
+    }
+    // Font height and ratio originate in integer HWPUNIT / percentage fields.
+    // Recover those units before evaluating their rational glyph advance;
+    // do not introduce a per-token epsilon or an available-width allowance.
+    let height_hwp = (font_size * 75.0).round();
+    let percent = (ratio * 100.0).round();
+    if height_hwp <= 0.0 || height_hwp > u32::MAX as f64
+        || font_size != height_hwp / 75.0
+        || !(1.0..=255.0).contains(&percent) || ratio != percent / 100.0
+    {
+        return None;
+    }
+    let quarter_units = height_hwp * percent * f64::from(glyph_units)
+        / (400.0 * f64::from(selected.metric.em_size));
+    let advance_hwp = if full || blank {
+        quarter_units.floor() * 4.0
+    } else {
+        quarter_units.round() * 4.0
+    };
+    (advance_hwp > 0.0 && advance_hwp <= i32::MAX as f64).then_some(advance_hwp as i32)
+}
