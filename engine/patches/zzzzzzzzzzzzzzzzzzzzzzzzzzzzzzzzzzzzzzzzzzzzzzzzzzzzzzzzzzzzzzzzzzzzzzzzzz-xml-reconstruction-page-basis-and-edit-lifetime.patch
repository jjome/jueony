+        || table.raw_table_record_attr & (1 << 30) != 0
+        || table.common.vertical_offset != 0 || table.common.horizontal_offset != 0
+        || !matches!(table.common.text_wrap, TextWrap::TopAndBottom)
+        || !matches!(table.common.vert_rel_to, VertRelTo::Para)
+        || !matches!(table.common.vert_align, VertAlign::Top)
+        || table.caption.is_some() || table.row_count != 1 || table.col_count != 1
+        || table.cells.len() != 1 || !table.zones.is_empty()
