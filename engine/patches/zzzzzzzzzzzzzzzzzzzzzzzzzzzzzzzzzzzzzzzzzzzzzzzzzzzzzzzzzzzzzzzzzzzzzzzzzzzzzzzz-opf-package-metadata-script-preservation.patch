+/// Package attributes can carry the dc:identifier binding and vendor metadata.
+/// Preserve their expanded names; refuse an ambiguous prefix collision instead
+/// of rebinding generated OPF elements or silently dropping the attribute.
+fn package_attributes(original: Option<&str>) -> Result<Vec<(String, String)>, SerializeError> {
+    use quick_xml::{events::Event, name::ResolveResult, reader::NsReader};
+    let mut attrs: Vec<_> = PACKAGE_ATTRIBUTES
+        .iter()
+        .map(|(k, v)| (k.to_string(), v.to_string()))
+        .collect();
+    let Some(source) = original else {
+        return Ok(attrs);
+    };
+    crate::parser::hwpx::raw_namespace::validate(source).map_err(SerializeError::XmlError)?;
+    let mut reader = NsReader::from_str(source);
+    reader.resolver_mut().set_max_namespace_bindings(256);
+    loop {
+        match reader
+            .read_event()
+            .map_err(|e| SerializeError::XmlError(e.to_string()))?
+        {
+            Event::Start(e) | Event::Empty(e) => {
+                let qualified = e.name();
+                let (namespace, local) = reader.resolver().resolve_element(qualified);
+                if local.as_ref() != "package"
+                    || !matches!(namespace,ResolveResult::Bound(uri) if uri.as_ref()==OPF_NAMESPACE)
+                {
+                    return Err(SerializeError::XmlError(
+                        "Original OPF package namespace is unsupported".into(),
+                    ));
+                }
+                for attribute in e.attributes() {
+                    let attribute =
+                        attribute.map_err(|e| SerializeError::XmlError(e.to_string()))?;
+                    if attribute.key.as_namespace_binding().is_some() {
+                        continue;
+                    }
+                    let name = attribute.key.as_ref().to_string();
+                    let value = attribute
+                        .normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                        .map_err(|e| SerializeError::XmlError(e.to_string()))?
+                        .into_owned();
+                    if let Some((prefix, _)) = name.split_once(':').filter(|(p, _)| *p != "xml") {
+                        let (namespace, _) = reader.resolver().resolve_attribute(attribute.key);
+                        let ResolveResult::Bound(uri) = namespace else {
+                            return Err(SerializeError::XmlError(
+                                "Unbound OPF package attribute".into(),
+                            ));
+                        };
+                        let uri = quick_xml::escape::unescape(uri.into_inner())
+                            .map_err(|e| SerializeError::XmlError(e.to_string()))?
+                            .into_owned();
+                        let declaration = format!("xmlns:{prefix}");
+                        if let Some((_, existing)) = attrs.iter().find(|(k, _)| k == &declaration) {
+                            if existing != &uri {
+                                return Err(SerializeError::XmlError(
+                                    "Conflicting OPF package attribute namespace".into(),
+                                ));
+                            }
+                        } else {
+                            attrs.push((declaration, uri));
+                        }
+                    }
+                    if let Some((_, existing)) = attrs.iter_mut().find(|(k, _)| k == &name) {
+                        *existing = value;
+                    } else {
+                        attrs.push((name, value));
+                    }
+                }
+                return Ok(attrs);
+            }
+            Event::Eof => {
+                return Err(SerializeError::XmlError(
+                    "Missing original OPF package".into(),
+                ))
+            }
+            _ => {}
+        }
+    }
 }
 
