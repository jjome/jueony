+
+fn extract_metadata_block(original: &str) -> Result<Option<String>, SerializeError> {
+    let mut parts = original_parts(original, "package", "metadata")?;
+    if parts.len() > 1 {
+        return Err(SerializeError::XmlError(
+            "Ambiguous duplicate OPF metadata".into(),
+        ));
+    }
+    Ok(parts.pop().map(|v| v.xml))
+}
+
+fn extract_script_items(original: &str) -> Result<Vec<(String, String)>, SerializeError> {
+    original_parts(original, "manifest", "item")?
+        .into_iter()
+        .filter(|p| {
+            p.attrs
+                .get("href")
+                .is_some_and(|v| v.starts_with("Scripts/"))
+        })
+        .map(|p| {
+            let id = p
+                .attrs
+                .get("id")
+                .filter(|id| !id.is_empty())
+                .cloned()
+                .ok_or_else(|| SerializeError::XmlError("Script manifest item has no id".into()))?;
+            Ok((id, p.xml))
+        })
+        .collect()
+}
+
+fn extract_script_refs(
+    original: &str,
+    items: &[(String, String)],
+) -> Result<Vec<String>, SerializeError> {
+    Ok(original_parts(original, "spine", "itemref")?
+        .into_iter()
+        .filter(|p| {
+            p.attrs
+                .get("idref")
+                .is_some_and(|id| items.iter().any(|(script, _)| id == script))
+        })
+        .map(|p| p.xml)
+        .collect())
+}
