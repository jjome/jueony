+/// Retain a source subtree together with its lexical namespace owner. The
+/// generated package uses canonical prefixes, but unknown metadata and Scripts
+/// may inherit aliases/default namespaces from the original package.
+#[derive(Debug)]
+struct PreservedPart {
+    xml: String,
+    attrs: std::collections::BTreeMap<String, String>,
+}
+
+fn original_parts(
+    original: &str,
+    parent: &str,
+    local: &str,
+) -> Result<Vec<PreservedPart>, SerializeError> {
+    use quick_xml::{
+        events::Event,
+        name::{PrefixDeclaration, ResolveResult},
+        reader::NsReader,
+    };
+    use std::collections::BTreeMap;
+    let error =
+        |message: String| SerializeError::XmlError(format!("content.hpf preservation: {message}"));
+    crate::parser::hwpx::raw_namespace::validate(original).map_err(error)?;
+    let mut reader = NsReader::from_str(original);
+    reader.resolver_mut().set_max_namespace_bindings(256);
+    let mut stack: Vec<(bool, String)> = Vec::new();
+    let mut parts = Vec::new();
+    // (start, opening-end, depth, namespace attributes, source attributes)
+    let mut active: Option<(usize, usize, usize, String, BTreeMap<String, String>)> = None;
+    loop {
+        let before = reader.buffer_position() as usize;
+        let event = reader.read_event().map_err(|e| error(e.to_string()))?;
+        let after = reader.buffer_position() as usize;
+        match event {
+            event @ (Event::Start(_) | Event::Empty(_)) => {
+                let empty = matches!(event, Event::Empty(_));
+                let e = match event {
+                    Event::Start(e) | Event::Empty(e) => e,
+                    _ => unreachable!(),
+                };
+                let qualified = e.name();
+                let (namespace, name) = reader.resolver().resolve_element(qualified);
+                let is_opf =
+                    matches!(namespace,ResolveResult::Bound(uri) if uri.as_ref()==OPF_NAMESPACE);
+                let expected_depth = if parent == "package" { 1 } else { 2 };
+                let capture = active.is_none()
+                    && stack.len() == expected_depth
+                    && stack
+                        .first()
+                        .is_some_and(|(opf, name)| *opf && name == "package")
+                    && is_opf
+                    && name.as_ref() == local
+                    && stack
+                        .last()
+                        .is_some_and(|(opf, name)| *opf && name == parent);
+                if capture {
+                    let mut attrs = BTreeMap::new();
+                    let mut declared = std::collections::BTreeSet::new();
+                    for attr in e.attributes() {
+                        let attr = attr.map_err(|e| error(e.to_string()))?;
+                        if let Some(prefix) = attr.key.as_namespace_binding() {
+                            declared.insert(match prefix {
+                                PrefixDeclaration::Default => "".to_string(),
+                                PrefixDeclaration::Named(p) => p.to_string(),
+                            });
+                        }
+                        let key = attr.key.as_ref().to_string();
+                        let value = attr
+                            .normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                            .map_err(|e| error(e.to_string()))?
+                            .into_owned();
+                        attrs.insert(key, value);
+                    }
+                    let mut bindings = String::new();
+                    for (prefix, uri) in reader.resolver().bindings() {
+                        let prefix = match prefix {
+                            PrefixDeclaration::Default => "",
+                            PrefixDeclaration::Named(p) => p,
+                        };
+                        if declared.contains(prefix) || prefix == "xml" {
+                            continue;
+                        }
+                        let value = quick_xml::escape::unescape(uri.into_inner())
+                            .map_err(|e| error(e.to_string()))?;
+                        let key = if prefix.is_empty() {
+                            "xmlns".to_owned()
+                        } else {
+                            format!("xmlns:{prefix}")
+                        };
+                        if PACKAGE_ATTRIBUTES
+                            .iter()
+                            .any(|(k, v)| *k == key && *v == value)
+                        {
+                            continue;
+                        }
+                        bindings.push_str(&format!(
+                            " {key}=\"{}\"",
+                            quick_xml::escape::escape(value.as_ref())
+                        ));
+                    }
+                    if empty {
+                        let split = after - 2;
+                        parts.push(PreservedPart {
+                            xml: format!(
+                                "{}{}{}",
+                                &original[before..split],
+                                bindings,
+                                &original[split..after]
+                            ),
+                            attrs,
+                        });
+                    } else {
+                        active = Some((before, after, stack.len(), bindings, attrs));
+                    }
+                }
+                if !empty {
+                    stack.push((is_opf, name.as_ref().to_string()));
+                }
+            }
+            Event::End(_) => {
+                stack.pop();
+                if active.as_ref().is_some_and(|v| v.2 == stack.len()) {
+                    let (start, opening_end, _, bindings, attrs) = active.take().unwrap();
+                    let split = opening_end - 1;
+                    parts.push(PreservedPart {
+                        xml: format!(
+                            "{}{}{}",
+                            &original[start..split],
+                            bindings,
+                            &original[split..after]
+                        ),
+                        attrs,
+                    });
+                }
+            }
+            Event::Eof => break,
+            _ => {}
         }
-        rest = &tail[end + 2..];
