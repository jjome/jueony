+const PRESERVED_CONTEXT_BYTES: usize = 4 * 1024 * 1024;
+const PRESERVED_PARTS_BYTES: usize = 32 * 1024 * 1024;
+
+fn preserved_xml(
+    before: &str,
+    bindings: &str,
+    after: &str,
+    allocated: &mut usize,
+) -> Result<String, SerializeError> {
+    let size = before
+        .len()
+        .checked_add(bindings.len())
+        .and_then(|n| n.checked_add(after.len()))
+        .ok_or_else(|| SerializeError::XmlError("OPF fragment size overflow".into()))?;
+    *allocated = allocated
+        .checked_add(size)
+        .filter(|n| *n <= PRESERVED_PARTS_BYTES)
+        .ok_or_else(|| SerializeError::XmlError("OPF preserved fragments exceed 32 MiB".into()))?;
+    Ok(format!("{before}{bindings}{after}"))
+}
