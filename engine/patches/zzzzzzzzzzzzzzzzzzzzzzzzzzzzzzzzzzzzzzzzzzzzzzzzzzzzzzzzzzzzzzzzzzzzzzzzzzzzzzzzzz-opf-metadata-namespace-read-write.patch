+#[cfg(test)]
+mod namespace_preservation90_tests {
+    use super::*;
+    fn values(title: &str) -> Fields {
+        Fields {
+            title: title.into(),
+            ..Fields::default()
+        }
+    }
+    fn check(source: &str, title: &str) -> Xml {
+        let xml = Xml::parse(source.as_bytes()).unwrap();
+        assert_eq!(xml.values().unwrap().title, title);
+        xml
+    }
+    fn rewrite(source: &str, title: &str) -> String {
+        let xml = Xml::parse(source.as_bytes()).unwrap();
+        let result = String::from_utf8(xml.write(&values(title)).unwrap()).unwrap();
+        crate::parser::hwpx::raw_namespace::validate(&result).unwrap();
+        check(&result, title);
+        result
+    }
+    #[test]
+    fn metadata_namespace90_attributes_and_unknown_payload_keep_raw_spans() {
+        let opaque = "<!--keep--><v:opaque v:x='a&amp;b'><![CDATA[raw<xml>]]></v:opaque>";
+        let source=format!("<opf:package xmlns:opf='{OPF}' xmlns:v='urn:vendor'><opf:metadata xml:lang='ko' id='summary' xmlns:x='urn:other'>{opaque}<opf:title>before</opf:title></opf:metadata></opf:package>");
+        let out = rewrite(&source, "after & 변경");
+        assert!(out.contains(opaque));
+        assert!(out.contains("xml:lang='ko' id='summary' xmlns:x='urn:other'"));
+    }
+    #[test]
+    fn metadata_namespace90_alias_fields_and_empty_field_closing_qname() {
+        let source=format!("<p:package xmlns:p='{OPF}'><p:metadata><p:title id='t'/><p:meta name='subject' content='text'>kept</p:meta></p:metadata></p:package>");
+        let xml = check(&source, "");
+        let mut fields = xml.values().unwrap();
+        fields.title = "new".into();
+        let out = String::from_utf8(xml.write(&fields).unwrap()).unwrap();
+        check(&out, "new");
+        assert!(out.contains("<p:title id='t'>new</p:title>"));
+        assert!(out.contains("<p:meta name='subject' content='text'>kept</p:meta>"));
+        assert!(!out.contains("opf:"));
+    }
+    #[test]
+    fn metadata_namespace90_default_namespace_fields_and_inserted_values() {
+        let source =
+            format!("<package xmlns='{OPF}'><metadata><title>default</title></metadata></package>");
+        let out = rewrite(&source, "new");
+        assert!(out.contains("<title>new</title>"));
+        assert!(out.contains("<meta name=\"creator\""));
+        assert!(!out.contains("opf:"));
+    }
+    #[test]
+    fn metadata_namespace90_empty_alias_metadata_expands_same_qname() {
+        let source = format!(
+            "<p:package xmlns:p='{OPF}'><p:metadata id='empty' xmlns:v='urn:v'/></p:package>"
+        );
+        let out = rewrite(&source, "new");
+        assert!(out.contains("<p:metadata id='empty' xmlns:v='urn:v'>"));
+        assert!(out.contains("</p:metadata>"));
+        assert!(!out.contains("opf:"));
+    }
+    #[test]
+    fn metadata_namespace90_empty_default_metadata_expands_same_qname() {
+        let source = format!("<package xmlns='{OPF}'><metadata id='empty'/></package>");
+        let out = rewrite(&source, "new");
+        assert!(out.contains("<metadata id='empty'>"));
+        assert!(out.contains("</metadata>"));
+        assert!(!out.contains("opf:"));
+    }
+    #[test]
+    fn metadata_namespace90_field_local_alias_preserves_declaration_and_qname() {
+        let source=format!("<opf:package xmlns:opf='{OPF}'><opf:metadata><a:title xmlns:a='{OPF}' id='t'/></opf:metadata></opf:package>");
+        let out = rewrite(&source, "new");
+        assert!(out.contains(&format!("<a:title xmlns:a='{OPF}' id='t'>new</a:title>")));
+    }
+    #[test]
+    fn metadata_namespace90_foreign_same_lexical_prefix_is_not_a_field() {
+        let unknown="<opf:title xmlns:opf='urn:foreign'>foreign</opf:title><v:meta name='creator'>vendor</v:meta>";
+        let source=format!("<opf:package xmlns:opf='{OPF}' xmlns:v='urn:foreign'><opf:metadata>{unknown}</opf:metadata></opf:package>");
+        let xml = check(&source, "");
+        assert_eq!(xml.values().unwrap().author, "");
+        let out = rewrite(&source, "new");
+        assert!(out.contains(unknown));
+    }
+    #[test]
+    fn metadata_namespace90_nested_known_tags_are_not_direct_metadata_fields() {
+        let unknown="<v:opaque><opf:title>nested</opf:title><opf:meta name='creator'>nested author</opf:meta><opf:metadata/></v:opaque>";
+        let source=format!("<opf:package xmlns:opf='{OPF}' xmlns:v='urn:foreign'><opf:metadata>{unknown}<opf:title>real</opf:title></opf:metadata></opf:package>");
+        let out = rewrite(&source, "new");
+        assert!(out.contains(unknown));
+    }
+    #[test]
+    fn metadata_namespace90_duplicate_expanded_fields_are_refused() {
+        let source=format!("<opf:package xmlns:opf='{OPF}' xmlns:p='{OPF}'><opf:metadata><opf:title/><p:title/></opf:metadata></opf:package>");
+        assert!(Xml::parse(source.as_bytes()).is_err());
+    }
+    #[test]
+    fn metadata_namespace90_mixed_markup_comments_pi_inside_known_field_refused() {
+        for payload in ["a<opf:title/>b", "a<!--keep-->b", "a<?keep x?>b"] {
+            let source=format!("<opf:package xmlns:opf='{OPF}'><opf:metadata><opf:title>{payload}</opf:title></opf:metadata></opf:package>");
+            assert!(Xml::parse(source.as_bytes()).is_err());
+        }
+    }
+    #[test]
+    fn metadata_namespace90_entities_and_cdata_unchanged_value_keep_original_bytes() {
+        let raw = "<p:title>A&amp;B<![CDATA[<C>]]>&#x1F600;</p:title>";
+        let source =
+            format!("<p:package xmlns:p='{OPF}'><p:metadata>{raw}</p:metadata></p:package>");
+        let xml = check(&source, "A&B<C>😀");
+        let mut values = xml.values().unwrap();
+        values.author = "author".into();
+        let out = String::from_utf8(xml.write(&values).unwrap()).unwrap();
+        assert!(out.contains(raw));
+        check(&out, "A&B<C>😀");
+    }
+    #[test]
+    fn metadata_namespace90_wrong_root_or_missing_bound_metadata_refused() {
+        for source in ["<opf:package xmlns:opf='urn:foreign'><opf:metadata/></opf:package>","<package><metadata/></package>","<p:package xmlns:p='http://www.idpf.org/2007/opf/'><p:metadata xmlns:p='urn:foreign'/></p:package>"] {assert!(Xml::parse(source.as_bytes()).is_err());}
+    }
+    #[test]
+    fn metadata_namespace90_empty_metadata_expansion_respects_total_limit() {
+        let wrapper =
+            format!("<opf:package xmlns:opf='{OPF}'><!-- --><opf:metadata/></opf:package>");
+        let source = wrapper.replacen(
+            "<!-- -->",
+            &format!("<!--{}-->", "x".repeat(LIMIT - wrapper.len())),
+            1,
+        );
+        assert!(source.len() < LIMIT);
+        let xml = Xml::parse(source.as_bytes()).unwrap();
+        assert!(xml.write(&values("new")).is_err());
+    }
+}
