 impl crate::model::document::Document {
+    /// Shared font definitions, section geometry, whole content/order and every
+    /// nested object frame participate. A cloned paragraph cannot import this
+    /// authority into a different document/frame or after a shared style edit.
+    pub(crate) fn native_source_synthetic_context_digest(&self) -> [u8; 32] {
+        #[derive(Serialize)]
+        struct ParagraphFrame<'a> {
+            identity: Option<[u8; 4]>,
+            para_shape: u16,
+            style: u8,
+            break_type: crate::model::paragraph::ColumnBreakType,
+            raw_break_type: u8,
+            shape_ids: Vec<u32>,
+            controls: &'a [crate::model::control::Control],
+        }
+        #[derive(Serialize)]
+        struct SectionFrame<'a> {
+            section: &'a crate::model::document::SectionDef,
+            paragraphs: Vec<ParagraphFrame<'a>>,
+        }
+        let sections: Vec<_> = self.sections.iter().map(|s| SectionFrame {
+            section: &s.section_def,
+            paragraphs: s.paragraphs.iter().map(|p| {
+                let mut shape_ids: Vec<_> = p.char_shapes.iter().map(|r| r.char_shape_id).collect();
+                shape_ids.sort_unstable(); shape_ids.dedup();
+                ParagraphFrame {
+                    identity: p.raw_header_extra.get(6..10).and_then(|id| id.try_into().ok()),
+                    para_shape: p.para_shape_id, style: p.style_id, break_type: p.column_type,
+                    raw_break_type: p.raw_break_type, shape_ids, controls: &p.controls,
+                }
+            }).collect(),
+        }).collect();
+        // Plain body text and derived LINE_SEGs are checked by each local seal,
+        // not a global source revocation: typing in a later plain paragraph
+        // cannot erase a preceding table's frame authority. All object trees,
+        // cell content, paragraph order/identity, page/column declarations and
+        // referenced font/style definitions remain part of this owner context.
+        // A stored caret is session state, not a page/frame input. The
+        // DOCUMENT_PROPERTIES parser/writer puts exactly three u32 caret
+        // fields after seven u16 values (payload 14..26). Keep every other
+        // raw byte, raw length and unknown extension bound to this owner.
+        let mut frame_properties = self.doc_properties.clone();
+        if let Some(raw) = &mut frame_properties.raw_data {
+            if let Some(caret) = raw.get_mut(14..26) { caret.fill(0); }
+        }
+        frame_properties.caret_list_id = 0;
+        frame_properties.caret_para_id = 0;
+        frame_properties.caret_char_pos = 0;
+        record_digest(&(doc_info_model_digest(&self.doc_info, &frame_properties), sections))
+    }
+
+    /// Called once after initial load materialization; never by edit or export.
+    pub(crate) fn bind_native_source_synthetic_context(&mut self) {
+        let context = self.native_source_synthetic_context_digest();
+        for section in &mut self.sections {
+            seal_raw_bearing_controls_with_source_owner(&mut section.paragraphs, Some(context));
+            for page in &mut section.section_def.master_pages {
+                seal_raw_bearing_controls_with_source_owner(&mut page.paragraphs, Some(context));
+            }
+        }
+    }
