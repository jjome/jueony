+#[cfg(test)]
+mod proportional_column_persistence_tests {
+    use super::*;
+    fn xml(columns:&ColumnDef, extent:Option<i32>)->String {
+        render_col_pr_ctrl(columns,extent,&mut SerializeContext::default())
+    }
+    fn columns() -> ColumnDef { ColumnDef {
+        column_count: 2, same_width: false, proportional_widths: true,
+        widths: vec![12000, 20768], gaps: vec![1000], ..ColumnDef::default()
+    } }
+    #[test]
+    fn binary_weights_are_xml_absolute_units() {
+        let xml = xml(&columns(), Some(42520));
+        assert!(xml.contains(r#"<hp:colSz width="15110" gap="1259"/>"#));
+        assert!(xml.contains(r#"<hp:colSz width="26150" gap="0"/>"#));
+        assert!(!xml.contains(r#"width="12000""#));
+    }
+    #[test]
+    fn existing_absolute_columns_are_not_scaled_again() {
+        let mut columns = columns(); columns.proportional_widths = false;
+        assert_eq!(xml(&columns,Some(42520)), xml(&columns,None));
+        assert!(xml(&columns,Some(42520)).contains(r#"width="12000" gap="1000""#));
+    }
+    #[test]
+    fn unknown_nested_body_extent_is_not_invented() {
+        assert!(xml(&columns(),None).contains(r#"width="12000" gap="1000""#));
+    }
+    #[test]
+    fn page_frame_landscape_gutter_and_direction_share_native_resolver() {
+        use crate::model::page::{PageDef,PageAreas,ColumnDirection};
+        use crate::renderer::{hwpunit_to_px,px_to_hwpunit,DEFAULT_DPI};
+        for landscape in [false,true] {
+            for direction in [ColumnDirection::LeftToRight,ColumnDirection::RightToLeft,ColumnDirection::Mirror] {
+                let page=PageDef {width:59528,height:84186,margin_left:8504,margin_right:6504,
+                    margin_gutter:2000,landscape,..PageDef::default()};
+                let extent=PageAreas::from_page_def(&page).body_area.width();
+                let mut columns=columns(); columns.direction=direction;
+                let lengths=columns.proportional_dimensions(extent as f64).unwrap();
+                let layout=crate::renderer::page_layout::PageLayoutInfo::from_page_def(&page,&columns,DEFAULT_DPI);
+                let xml=xml(&columns,Some(extent));
+                for (i,(width,gap)) in lengths.iter().enumerate() {
+                    let source_index=if direction==ColumnDirection::RightToLeft {1-i}else{i};
+                    let native=layout.column_areas[source_index].width;
+                    assert!((native-hwpunit_to_px(*width as i32,DEFAULT_DPI)).abs()<0.02);
+                    assert_eq!(*width as i32,px_to_hwpunit(native,DEFAULT_DPI));
+                    assert!(xml.contains(&format!(r#"<hp:colSz width="{}" gap="{}"/>"#,*width as i64,*gap as i64)));
+                }
+            }
+        }
+    }
+    #[test]
+    fn unsigned_native_words_and_source_model_are_preserved() {
+        let mut columns=columns(); columns.widths=vec![-32768,16384];
+        let original=columns.widths.clone();
+        let dimensions=columns.proportional_dimensions(48000.0).unwrap();
+        assert!(dimensions[0].0>dimensions[1].0);
+        let xml=xml(&columns,Some(48000));
+        assert!(!xml.contains(r#"width="-32768""#)); assert_eq!(columns.widths,original);
+    }
+    #[test]
