+impl ColumnDef {
+    /// Resolve HWP5 unsigned proportional words in the caller's actual frame
+    /// units. Paint and HWPX persistence use this one formula; direction only
+    /// changes placement order and must not reverse the stored width list.
+    pub(crate) fn proportional_dimensions(&self, extent: f64) -> Option<Vec<(f64, f64)>> {
+        let count = self.column_count.max(1) as usize;
+        if count <= 1 || self.same_width || !self.proportional_widths || self.widths.len() < count {
+            return None;
+        }
+        let total: f64 = self.widths.iter().chain(self.gaps.iter())
+            .map(|&v| (v as u16) as f64).sum();
+        let scale = if total > 0.0 { extent / total } else { 1.0 };
+        Some((0..count).map(|i| (
+            (self.widths[i] as u16) as f64 * scale,
+            self.gaps.get(i).map(|&g| (g as u16) as f64 * scale).unwrap_or(0.0),
+        )).collect())
+    }
+}
