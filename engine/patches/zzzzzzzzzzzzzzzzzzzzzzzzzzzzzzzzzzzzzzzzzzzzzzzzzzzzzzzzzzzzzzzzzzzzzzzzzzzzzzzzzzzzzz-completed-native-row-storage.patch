+//! A completed native text-edit row partition, distinct from an imported source cache.
+//! The package contract contains row coordinate bases and space-metric choices only.
+//! It never restores fonts, tables, paragraph text, styles or document geometry.
+use serde::{Deserialize, Serialize};
