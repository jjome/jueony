+impl super::DocumentCore {
+    pub(crate) fn authorize_completed_native_hwp_lowering(&self,before:&crate::model::document::Document,target:&mut crate::model::document::Document) {
+        use crate::document_core::converters::hwpx_to_hwp::convert_if_hwpx_source;
+        if !matches!(self.source_format,crate::parser::FileFormat::Hwpx) || !self.computed_row_resources_supported() {return;}
+        let frame=contract::context(&self.document);
+        if contract::context(before)!=frame || before.sections.len()!=target.sections.len() {return;}
+        let mut expected=before.clone();convert_if_hwpx_source(&mut expected,self.source_format);
+        let mut projected=target.clone();
+        for ((a,b),e) in before.sections.iter().zip(&mut projected.sections).zip(&expected.sections) {
+            let values=serde_json::to_value(&a.section_def).ok().zip(serde_json::to_value(&b.section_def).ok()).zip(serde_json::to_value(&e.section_def).ok());
+            let Some(((a_value,b_value),e_value))=values else{return;};
+            let Some(value)=inverse_known_hwp_storage(&a_value,&b_value,&e_value,"sectionDef") else{return;};
+            if value!=a_value || !a.section_def.master_pages.is_empty() || !b.section_def.master_pages.is_empty() {return;}
+            b.section_def.raw_ctrl_extra=a.section_def.raw_ctrl_extra.clone();
+            if a.paragraphs.len()!=b.paragraphs.len() || a.paragraphs.len()!=e.paragraphs.len() {return;}
+            for ((a,b),e) in a.paragraphs.iter().zip(&mut b.paragraphs).zip(&e.paragraphs) {
+                let values=serde_json::to_value(a).ok().zip(serde_json::to_value(&*b).ok()).zip(serde_json::to_value(e).ok());
+                let Some(((a_value,b_value),e_value))=values else{return;};
+                let Some(value)=inverse_known_hwp_storage(&a_value,&b_value,&e_value,"paragraph") else{return;};
+                if value!=a_value || !reverse_known_hwp_paragraph_storage(a,b) {return;}
+            }
+        }
+        if contract::context(&projected)!=frame {return;}
+        for (source,output) in self.document.sections.iter().zip(&mut target.sections) {
+            for (source,output) in source.paragraphs.iter().zip(&mut output.paragraphs) {
+                // The global inverse projection is proved above. The local rows,
+                // plan, metric choices and resource must remain the original lease.
+                let ok=source.owns_completed_native_rows(frame) && output.owns_completed_native_rows(frame);
+                if let Some(owner)=&mut output.completed_native_rows {owner.export_authorized=ok;}
+            }
+        }
+    }
+}
