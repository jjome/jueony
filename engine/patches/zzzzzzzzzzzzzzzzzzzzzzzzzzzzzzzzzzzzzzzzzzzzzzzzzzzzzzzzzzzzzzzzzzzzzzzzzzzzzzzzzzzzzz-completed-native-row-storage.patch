+//! Bind a completed row contract to the actual uncompressed HWP streams.
+//! No paragraph/body/font/IR shadow is written. All standard LINE_SEG records
+//! remain the serializer's native actual rows, with no XML lowering offset.
+use crate::model::{document::Document, native_computed_rows as contract};
+use crate::parser::native_computed_rows::{self as adapter, STREAM};
+use super::content_loss::{ContentLoss, ContentLossCode, ContentLossReason,
+    ContentLossReport, ContentLossSubject};
+
+fn lost(report: &mut ContentLossReport) {
+    report.record(ContentLoss { code: ContentLossCode::MetadataReduced,
+        subject: ContentLossSubject::ParagraphProperties, path: STREAM.into(),
+        reason: ContentLossReason::SerializerNotImplemented, resource_id: None });
+}
+
+/// A producer must not attach a current model seal to old raw rows or to a
+/// section split/reindexing that its completed owner did not observe.
+fn emitted_rows_match(doc: &Document, sections: &[Vec<u8>]) -> bool {
+    if sections.len() != doc.sections.len() { return false; }
+    for (source, bytes) in doc.sections.iter().zip(sections) {
+        if !source.paragraphs.iter().any(|p| p.exports_completed_native_rows()) { continue; }
+        let Ok(parsed) = crate::parser::body_text::parse_body_text_section(bytes) else { return false; };
+        if parsed.paragraphs.len() != source.paragraphs.len() { return false; }
+        for (expected, actual) in source.paragraphs.iter().zip(&parsed.paragraphs) {
+            if !expected.exports_completed_native_rows() { continue; }
+            if actual.line_segs != expected.line_segs || actual.text != expected.text
+                || actual.para_shape_id != expected.para_shape_id || actual.style_id != expected.style_id
+                || actual.char_shapes.iter().map(|r|(r.start_pos,r.char_shape_id))
+                    .ne(expected.char_shapes.iter().map(|r|(r.start_pos,r.char_shape_id))) { return false; }
+        }
+    }
+    true
+}
+
+pub(crate) fn append(doc: &Document, header: &[u8], doc_info: &[u8],
+    sections: &[Vec<u8>], password: bool, extra: &mut Vec<(String, Vec<u8>)>,
+    report: &mut ContentLossReport) {
+    let needed = doc.sections.iter().any(|s|
+        s.paragraphs.iter().any(|p|p.exports_completed_native_rows()));
+    if !needed { return; } // Absent/revoked authority can never mint a stream.
+    if password || !adapter::eligible(doc)
+        || extra.iter().any(|(path,_)|adapter::conflicting_path(path))
+        || !emitted_rows_match(doc, sections) {
+        lost(report); return;
+    }
+    let binding = adapter::binding_header(header, doc_info);
+    let hashes = sections.iter().map(|bytes|contract::sha(bytes)).collect::<Vec<_>>();
+    match contract::encode_representation(doc, &binding, &hashes, false) {
+        Some(bytes) => extra.push((STREAM.into(), bytes)),
+        None => lost(report),
+    }
+}
