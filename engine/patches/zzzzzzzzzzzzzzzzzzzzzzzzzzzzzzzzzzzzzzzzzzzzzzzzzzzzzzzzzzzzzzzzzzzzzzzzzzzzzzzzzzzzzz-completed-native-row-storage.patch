+pub(crate) fn sha(bytes: &[u8]) -> [u8;32] { Sha256::digest(bytes).into() }
+pub(crate) fn plan(bases:&[RowBasis],frame:Option<NativeParagraphFrame>)->[u8;32] {
+    sha(&serde_json::to_vec(&(PIPELINE,RESOURCE,bases,frame)).unwrap_or_default())
+}
+pub(crate) fn local(p: &Paragraph) -> [u8;32] {
+    sha(&serde_json::to_vec(&(&p.text,p.char_count,&p.char_offsets,&p.char_shapes,
+        &p.line_segs,p.para_shape_id,p.style_id,p.column_type as u8,p.raw_break_type,
+        &p.tab_extended,p.hwpx_axis_shift,p.layout_only_fill_lines,&p.layout_space_metrics.iter()
+            .map(|(start,metric)|(*start,metric_id(*metric))).collect::<Vec<_>>())).unwrap_or_default())
+}
+pub(crate) fn context(doc: &Document) -> [u8;32] {
+    let mut h=Sha256::new();
+    h.update(doc.native_source_synthetic_context_digest());
+    for section in &doc.sections {
+        h.update((section.paragraphs.len() as u64).to_le_bytes());
+        for p in &section.paragraphs { h.update(local(p)); }
+    }
+    h.finalize().into()
+}
+fn metric_id(m: SpaceMetric) -> u8 { match m { SpaceMetric::Stored=>0,SpaceMetric::HancomRegenerated=>1,
+    SpaceMetric::HalfCell=>2,SpaceMetric::KoPubJustified=>3 } }
+fn metric(id: u8) -> Option<SpaceMetric> { Some(match id {0=>SpaceMetric::Stored,1=>SpaceMetric::HancomRegenerated,
+    2=>SpaceMetric::HalfCell,3=>SpaceMetric::KoPubJustified,_=>return None}) }
+
+impl Paragraph {
+    pub(crate) fn owns_completed_native_rows(&self, frame: [u8;32]) -> bool {
+        !self.stored_text_partition_is_dirty() && !self.cell_format_vpos_dirty
+            && self.layout_only_fill_lines==0 && self.completed_native_rows.as_ref().is_some_and(|o|
+                o.local==local(self) && o.frame==frame && o.resource==RESOURCE
+                && o.plan==plan(&o.bases,o.native_frame)
+                && o.bases.len()==self.line_segs.len())
+    }
+    pub(crate) fn exports_completed_native_rows(&self) -> bool {
+        self.completed_native_rows.as_ref().is_some_and(|o|o.export_authorized
+            && o.local==local(self) && o.resource==RESOURCE && o.plan==plan(&o.bases,o.native_frame))
+    }
+    pub(crate) fn owns_completed_native_frame_at(&self,context:[u8;32],page:u32,column:u16,control:usize,current_flow:f64,unit:f64)->bool {
+        if !self.owns_completed_native_rows(context) || !current_flow.is_finite() || !unit.is_finite() || unit<=0.0 {return false;}
+        let Some(f)=self.completed_native_rows.as_ref().and_then(|o|o.native_frame) else{return false;};
+        f.control==control && f.page==page && f.column==column
+            && f.source_row_vpos==self.line_segs[0].vertical_pos && f.selected_inset_hu==0
+            && (f.raw_top-current_flow).abs()<=unit
+            && [f.before,f.body_height,f.after].iter().all(|v|v.is_finite() && *v>=0.0)
+            && (f.reserved_bottom-f.raw_top-f.body_height-f.after).abs()<=unit
+            && valid_native_empty_host(self,control,f.outer_top)
+    }
+    pub(crate) fn completed_xml_vpos(&self) -> Option<Vec<i32>> {
+        if !self.exports_completed_native_rows() {return None;}
+        let owner=self.completed_native_rows.as_ref()?;
+        self.line_segs.iter().zip(&owner.bases).map(|(r,b)|r.vertical_pos.checked_sub(b.offset)).collect()
