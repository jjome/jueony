+#[derive(Debug,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Entry { section:usize, paragraph:usize, bases:Vec<RowBasis>, plan:[u8;32],
+    spaces:Vec<(u32,u8)>, native_frame:Option<NativeParagraphFrame> }
+#[derive(Debug,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Package { version:u8, representation:String, pipeline:String, resource:[u8;32], header:[u8;32], sections:Vec<[u8;32]>, entries:Vec<Entry> }
+
+pub(crate) fn encode(doc:&Document,header:&[u8],sections:&[[u8;32]]) -> Option<Vec<u8>> {
+    encode_representation(doc,header,sections,true)
+}
+pub(crate) fn encode_representation(doc:&Document,header:&[u8],sections:&[[u8;32]],lowered_xml:bool) -> Option<Vec<u8>> {
+    let mut entries=Vec::new();let mut rows=0usize;
+    for (si,s) in doc.sections.iter().enumerate() {for (pi,p) in s.paragraphs.iter().enumerate() {
+        if !p.exports_completed_native_rows() {continue;}
+        let o=p.completed_native_rows.as_ref()?;rows=rows.checked_add(o.bases.len())?;
+        if rows>MAX_ROWS || entries.len()>=4096 {return None;}
+        entries.push(Entry {section:si,paragraph:pi,bases:o.bases.clone(),plan:o.plan,
+            spaces:p.layout_space_metrics.iter().map(|(x,m)|(*x,metric_id(*m))).collect(),native_frame:o.native_frame});
+    }}
+    if entries.is_empty() {return None;}
+    let bytes=serde_json::to_vec(&Package {version:1,representation:if lowered_xml{"hwpx-relative-v1"}else{"hwp-flow-v1"}.into(),pipeline:PIPELINE.into(),resource:RESOURCE,
+        header:sha(header),sections:sections.to_vec(),entries}).ok()?;
+    (bytes.len()<=MAX_BYTES).then_some(bytes)
+}
+
+/// The reader calls this only after hashing the *actual* header/section entry bytes.
+/// Invalid metadata restores no rows or origin permissions (including valid prefixes).
+pub(crate) fn decode(doc:&mut Document,bytes:&[u8],header:&[u8],sections:&[[u8;32]]) -> bool {
+    decode_representation(doc,bytes,header,sections,true)
+}
+pub(crate) fn decode_representation(doc:&mut Document,bytes:&[u8],header:&[u8],sections:&[[u8;32]],lowered_xml:bool)->bool {
+    if bytes.len()>MAX_BYTES {return false;}
+    let Ok(p)=serde_json::from_slice::<Package>(bytes) else{return false;};
+    if p.representation!=if lowered_xml{"hwpx-relative-v1"}else{"hwp-flow-v1"} || p.version!=1 || p.pipeline!=PIPELINE || p.resource!=RESOURCE || p.header!=sha(header)
+        || p.sections!=sections || p.entries.is_empty() || p.entries.len()>4096 {return false;}
+    let mut rows=0usize;let mut seen=std::collections::HashSet::new();
+    for e in &p.entries {
+        let Some(para)=doc.sections.get(e.section).and_then(|s|s.paragraphs.get(e.paragraph)) else{return false;};
+        if e.plan!=plan(&e.bases,e.native_frame) || !seen.insert((e.section,e.paragraph)) || e.bases.len()!=para.line_segs.len()
+            || e.bases.is_empty() || para.stored_text_partition_is_dirty() || para.layout_only_fill_lines!=0 {return false;}
+        rows=match rows.checked_add(e.bases.len()) {Some(n) if n<=MAX_ROWS=>n,_=>return false};
+        if e.spaces.len()>e.bases.len() || e.spaces.iter().enumerate().any(|(i,(start,id))|
+            para.line_segs.get(i).is_none_or(|r|r.text_start!=*start) || metric(*id).is_none()) {return false;}
+        if para.line_segs.iter().zip(&e.bases).any(|(r,b)| b.page>100000 || b.column>255
+            || r.vertical_pos<0 || (lowered_xml && r.vertical_pos.checked_add(b.offset).is_none()) || b.offset<0
+            || r.line_height<=0 || r.text_height<=0 || r.line_spacing<0
+            || r.tag!=0x80060000) {return false;}
+        if let Some(f)=e.native_frame {
+            if !f.raw_top.is_finite() || f.raw_top<0.0 || f.raw_top>1000000.0
+                || !f.reserved_bottom.is_finite() || f.reserved_bottom<f.raw_top || f.selected_inset_hu!=0
+                || ![f.before,f.body_height,f.after].iter().all(|v|v.is_finite() && *v>=0.0)
+                || (f.reserved_bottom-f.raw_top-f.body_height-f.after).abs()>1.0/75.0
+                || e.bases.len()!=1 || f.source_row_vpos!=if lowered_xml{para.line_segs[0].vertical_pos.checked_add(e.bases[0].offset).unwrap()}else{para.line_segs[0].vertical_pos}
