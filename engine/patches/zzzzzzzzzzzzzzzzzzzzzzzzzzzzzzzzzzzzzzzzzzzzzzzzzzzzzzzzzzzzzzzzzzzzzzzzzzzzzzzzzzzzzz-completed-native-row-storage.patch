+//! Raw central-directory authority gate. This is not a replacement ZIP parser.
+//! ZipArchive's name index can collapse duplicate directory entries before by_index.
+//! Unknown/ZIP64/name-remapping layouts grant no private cache permission.
+fn u16_at(b:&[u8],p:usize)->Option<usize>{Some(u16::from_le_bytes(b.get(p..p.checked_add(2)?)?.try_into().ok()?) as usize)}
+fn u32_at(b:&[u8],p:usize)->Option<usize>{Some(u32::from_le_bytes(b.get(p..p.checked_add(4)?)?.try_into().ok()?) as usize)}
+fn alias(name:&[u8],expected:&str)->bool{
+    let Ok(name)=std::str::from_utf8(name) else{return false;};
+    let slash=name.replace('\\',"/");let mut segments=Vec::new();
+    for part in slash.split('/') {match part {""|"."=>{},".."=>{segments.pop();},part=>segments.push(part)}}
+    segments.join("/").eq_ignore_ascii_case(expected)
+}
+fn unique_inner(bytes:&[u8],expected:&str)->Option<bool>{
+    if bytes.len()<22{return None;}
+    let eocd=(bytes.len().saturating_sub(65557)..=bytes.len()-22).rev().find(|p|
+        bytes.get(*p..*p+4)==Some(&[0x50,0x4b,0x05,0x06])
+            && u16_at(bytes,*p+20).and_then(|n|p.checked_add(22+n))==Some(bytes.len()))?;
+    if u16_at(bytes,eocd+4)?!=0 || u16_at(bytes,eocd+6)?!=0{return None;}
+    let count=u16_at(bytes,eocd+10)?;
+    if count==0xffff || count!=u16_at(bytes,eocd+8)?{return None;}
+    let mut p=u32_at(bytes,eocd+16)?;let size=u32_at(bytes,eocd+12)?;
+    if size>64*1024*1024 || p.checked_add(size)?!=eocd{return None;}
+    let mut found=0usize;
+    for _ in 0..count{
+        let fixed=bytes.get(p..p.checked_add(46)?)?;
+        if fixed.get(..4)!=Some(&[0x50,0x4b,0x01,0x02]){return None;}
+        let name_len=u16_at(fixed,28)?;let extra_len=u16_at(fixed,30)?;let comment_len=u16_at(fixed,32)?;
+        let start=p.checked_add(46)?;let extra=start.checked_add(name_len)?;let comment=extra.checked_add(extra_len)?;let end=comment.checked_add(comment_len)?;
+        if end>eocd{return None;}
+        let name=bytes.get(start..extra)?;if name.contains(&0){return None;}
+        // Unicode-path extras can replace the index key; ZIP64 changes offsets.
+        let mut q=extra;while q<comment{
+            let id=u16_at(bytes,q)?;let length=u16_at(bytes,q.checked_add(2)?)?;q=q.checked_add(4)?.checked_add(length)?;
+            if q>comment || id==0x7075 || id==0x0001{return None;}
+        }
+        if alias(name,expected){
+            found+=1;if found>1 || name!=expected.as_bytes(){return Some(false);}
+        }
+        p=end;
+    }
+    Some(p==eocd && found==1)
+}
+pub(crate) fn unique_private_entry(bytes:&[u8],expected:&str)->bool{unique_inner(bytes,expected)==Some(true)}
+
