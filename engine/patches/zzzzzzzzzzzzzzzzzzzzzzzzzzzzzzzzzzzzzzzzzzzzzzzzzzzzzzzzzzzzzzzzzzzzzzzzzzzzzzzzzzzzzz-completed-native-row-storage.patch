+#[derive(Debug,Clone)]
+pub(crate) struct CompletedRows {
+    pub local: [u8;32],
+    pub plan: [u8;32],
+    pub frame: [u8;32],
+    pub resource: [u8;32],
+    pub bases: Vec<RowBasis>,
+    pub native_frame: Option<NativeParagraphFrame>,
+    pub export_authorized: bool,
