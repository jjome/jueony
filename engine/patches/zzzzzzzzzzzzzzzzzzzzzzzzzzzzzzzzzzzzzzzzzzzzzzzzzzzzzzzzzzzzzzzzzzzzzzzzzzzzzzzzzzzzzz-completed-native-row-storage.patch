+                || !valid_native_empty_host(para,f.control,f.outer_top) {return false;}
+        }
+    }
+    for e in p.entries {
+        let para=&mut doc.sections[e.section].paragraphs[e.paragraph];
+        if lowered_xml {for (r,b) in para.line_segs.iter_mut().zip(&e.bases) {r.vertical_pos+=b.offset;}}
+        para.source_line_seg_vertical_pos=None;
+        para.layout_space_metrics=e.spaces.iter().map(|(x,id)|(*x,metric(*id).unwrap())).collect();
+        para.completed_native_rows=Some(CompletedRows {local:local(para),plan:e.plan,frame:[0;32],resource:RESOURCE,
+            bases:e.bases,native_frame:e.native_frame,export_authorized:false});
+    }
+    let frame=context(doc);
+    for s in &mut doc.sections {for para in &mut s.paragraphs {
+        if let Some(o)=&mut para.completed_native_rows {o.frame=frame;}
+    }}
+    true
+}
