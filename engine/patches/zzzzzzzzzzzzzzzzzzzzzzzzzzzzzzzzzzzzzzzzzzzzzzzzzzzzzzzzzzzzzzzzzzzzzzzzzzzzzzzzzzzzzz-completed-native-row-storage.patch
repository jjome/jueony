+//! CFB adapter for a completed native row partition. The binary LINE_SEG rows
+//! already use native flow coordinates: this reader never adds XML offsets.
+use super::cfb_reader::{CfbError, CfbReader};
+use crate::model::{document::Document, native_computed_rows as contract};
+
+pub(crate) const STREAM: &str = "/RhwpComputedNativeRowsV1";
+
+pub(crate) fn conflicting_path(path: &str) -> bool {
+    // CFB stream identity is case-insensitive. Noncanonical spellings are opaque
+    // collisions, not permission to replace or reinterpret the original bytes.
+    let actual=path.to_uppercase();let target=STREAM.to_uppercase();
+    actual==target || actual.strip_prefix(&target).is_some_and(|suffix|suffix.starts_with('/'))
+}
+
+/// Frame-header binding for the exact actual binary output. Length prefixes and
+/// individual hashes bind both streams without another DocInfo-sized allocation.
+pub(crate) fn binding_header(header: &[u8], doc_info: &[u8]) -> Vec<u8> {
+    let mut out = b"rhwp-computed-native-rows:hwp-flow-v1\0".to_vec();
+    out.extend_from_slice(&(header.len() as u64).to_le_bytes());
+    out.extend_from_slice(&contract::sha(header));
+    out.extend_from_slice(&(doc_info.len() as u64).to_le_bytes());
+    out.extend_from_slice(&contract::sha(doc_info));
+    out
+}
+
+/// Reject an oversized colliding stream before generic opaque-stream loading.
+/// Do not silently drop its bytes, and do not grant authority from a prefix.
+pub(crate) fn check_stream_budget(cfb: &mut CfbReader) -> Result<(), CfbError> {
+    for path in cfb.list_streams().into_iter().filter(|p|p.to_uppercase()==STREAM.to_uppercase()) {
+        cfb.read_stream_raw_limited(&path, contract::MAX_BYTES)?;
+    }
+    Ok(())
+}
+
+pub(crate) fn eligible(doc: &Document) -> bool {
+    !doc.header.encrypted && !doc.header.distribution && !doc.is_hwp3_variant
+        && !doc.provenance.hwp3_lineage
+        && !doc.extra_streams.iter().any(|(path, _)|
+            path.to_uppercase() == crate::model::document::HWP3_ORIGIN_STREAM_PATH.to_uppercase())
+}
+
+/// Only a unique exact stream with a fully validated binding becomes modeled
+/// completed rows. Invalid/unknown/stale streams remain opaque and unchanged.
+/// Consuming an owned stream avoids treating its later legitimate regeneration
+/// as permission to overwrite an unrelated raw-stream collision.
+pub(crate) fn restore(doc: &mut Document) -> bool {
+    if !eligible(doc) { return false; }
+    let matches = doc.extra_streams.iter().enumerate()
+        .filter(|(_, (path, _))| conflicting_path(path)).collect::<Vec<_>>();
+    if matches.len() != 1 || matches[0].1.0 != STREAM { return false; }
+    let index = matches[0].0;
+    let bytes = matches[0].1.1.clone();
+    if bytes.len() > contract::MAX_BYTES { return false; }
+    let Some(header) = doc.header.raw_data.as_deref() else { return false; };
+    let Some(info) = doc.doc_info.raw_stream.as_deref() else { return false; };
+    let binding = binding_header(header, info);
+    let Some(sections) = doc.sections.iter().map(|section|
+        section.raw_stream.as_deref().map(contract::sha)).collect::<Option<Vec<_>>>()
+        else { return false; };
+    if !contract::decode_representation(doc, &bytes, &binding, &sections, false) { return false; }
+    doc.extra_streams.remove(index);
+    true
+}
