+pub(crate) struct NativeParagraphFrame {
+    pub control: usize,
+    pub page: u32,
+    pub column: u16,
+    pub raw_top: f64,
+    pub reserved_bottom: f64,
+    pub before: f64,
+    pub body_height: f64,
+    pub after: f64,
+    pub selected_inset_hu: i32,
+    pub outer_top: i16,
+    pub source_row_vpos: i32,
+}
