+#[derive(Debug,Default)]
+pub(crate) struct FrameObservation(std::sync::Mutex<Option<NativeParagraphFrame>>);
+impl Clone for FrameObservation {fn clone(&self)->Self {Self(std::sync::Mutex::new(self.get()))}}
+impl FrameObservation {
+    pub fn get(&self)->Option<NativeParagraphFrame> {self.0.lock().ok().and_then(|v|*v)}
+    pub fn set(&self,value:Option<NativeParagraphFrame>) {if let Ok(mut v)=self.0.lock(){*v=value;}}
+}
