+/// Preserve an authored positive paragraph-before gap through a visible,
+/// single floating table host. This is a source-axis fact, not a new float
+/// placement or permission to reuse computed rows after edits.
+fn stored_visible_float_source_gap(
+    para: &Paragraph, original: Option<(i32, i32)>, previous: Option<(i32, i32)>,
+    anchor: Option<(i32, i32)>, before: i32, body_height: i32, reflowed: bool,
+) -> bool {
+    use crate::model::paragraph::ColumnBreakType;
+    use crate::model::shape::{TextWrap, VertRelTo, VertAlign};
+    if reflowed || para.stored_text_partition_dirty || para.cell_format_vpos_dirty
+        || para.hwpx_axis_shift != 0 || para.column_type != ColumnBreakType::None
+        || before <= 0 || body_height <= 0 || para.controls.len() != 1
+        || !para.range_tags.is_empty() || !para.field_ranges.is_empty()
+        || !para.orphan_field_ends.is_empty()
+        || !para.text.chars().any(|c| !c.is_whitespace() && !c.is_control() && c != '\u{FFFC}')
+    { return false; }
+    let Control::Table(table) = &para.controls[0] else { return false; };
+    if table.common.treat_as_char || table.common.text_wrap != TextWrap::TopAndBottom
+        || table.common.vert_rel_to != VertRelTo::Para || table.common.vert_align != VertAlign::Top
+        || table.common.allow_overlap || table.caption.is_some()
+        || table.row_count != 1 || table.col_count != 1 || table.cells.len() != 1
+    { return false; }
+    // flow_with_text is the object's page-area restriction, not paragraph
+    // spacing ownership. Both values leave this exact authored text gap intact.
+    let (Some((first, end)), Some((_, previous_end)), Some((anchor_end, rebuilt_end))) =
+        (original, previous, anchor) else { return false; };
+    if previous_end <= 0 || anchor_end != previous_end || rebuilt_end < 0
+        || first <= 0 || first > body_height || end < first || end > body_height
+        || previous_end.checked_add(before) != Some(first)
+    { return false; }
+    if para.line_segs.is_empty() || para.line_segs.iter().any(|line|
+        line.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0 || line.line_height <= 0
+            || line.line_spacing < 0 || line.vertical_pos < first || line.vertical_pos > end)
+        || para.line_segs.windows(2).any(|pair| pair[0].vertical_pos > pair[1].vertical_pos)
+        || para.line_segs.first().map(|line| line.vertical_pos) != Some(first)
+        || para.line_segs.last().and_then(|line| line.vertical_pos.checked_add(line.line_height)
+            .and_then(|value| value.checked_add(line.line_spacing))) != Some(end)
+    { return false; }
+    para.source_line_seg_vertical_pos.as_ref().is_none_or(|source|
+        source.len() == para.line_segs.len()
+            && source.iter().zip(&para.line_segs).all(|(value,line)| *value == line.vertical_pos))
+}
 
