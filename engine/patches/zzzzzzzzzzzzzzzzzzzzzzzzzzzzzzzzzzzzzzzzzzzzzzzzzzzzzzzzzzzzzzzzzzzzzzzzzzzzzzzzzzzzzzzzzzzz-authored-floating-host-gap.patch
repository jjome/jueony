+#[cfg(test)]
+mod authored_visible_float_gap97_tests {
+    use super::*;
+    fn fixture() -> Paragraph {
+        let mut table = crate::model::table::Table::default();
+        table.row_count=1;table.col_count=1;
+        table.cells.push(crate::model::table::Cell::default());
+        table.common.flow_with_text=true;
+        table.common.text_wrap=crate::model::shape::TextWrap::TopAndBottom;
+        table.common.vert_rel_to=crate::model::shape::VertRelTo::Para;
+        table.common.vert_align=crate::model::shape::VertAlign::Top;
+        let mut para=Paragraph::default();para.text="가나".into();
+        para.controls.push(Control::Table(Box::new(table)));
+        para.line_segs.push(LineSeg{vertical_pos:110,line_height:40,line_spacing:10,..Default::default()});
+        para
+    }
+    fn eligible(para:&Paragraph)->bool {
+        stored_visible_float_source_gap(para,Some((110,160)),Some((50,100)),Some((100,150)),10,1000,false)
+    }
+    #[test] fn authored_visible_float_gap97_owns_only_exact_source_gap() {
+        let mut p=fixture();assert!(eligible(&p));
+        if let Control::Table(t)=&mut p.controls[0]{t.common.flow_with_text=false;}
+        assert!(eligible(&p),"page-area restriction does not erase authored paragraph-before gap");
+        p.source_line_seg_vertical_pos=Some(vec![110]);assert!(eligible(&p));
+        assert!(!stored_visible_float_source_gap(&p,Some((110,160)),Some((50,100)),Some((100,150)),9,1000,false));
+        assert!(!stored_visible_float_source_gap(&p,Some((110,160)),Some((50,100)),Some((99,150)),10,1000,false));
+        assert!(!stored_visible_float_source_gap(&p,Some((110,160)),Some((50,100)),None,10,1000,false));
+        assert!(!stored_visible_float_source_gap(&p,Some((110,160)),Some((50,100)),Some((100,150)),10,150,false));
+        assert!(!stored_visible_float_source_gap(&p,Some((110,160)),Some((50,100)),Some((100,150)),10,1000,true));
+    }
+    #[test] fn authored_visible_float_gap97_rejects_changed_unknown_or_separate_frames() {
+        for which in 0..13 {let mut p=fixture();match which {
+            0=>p.stored_text_partition_dirty=true,
+            1=>p.cell_format_vpos_dirty=true,
+            2=>p.hwpx_axis_shift=1,
+            3=>p.column_type=crate::model::paragraph::ColumnBreakType::Page,
+            4=>p.column_type=crate::model::paragraph::ColumnBreakType::Column,
+            5=>p.column_type=crate::model::paragraph::ColumnBreakType::Section,
+            6=>p.line_segs[0].tag=LineSeg::TAG_IMPLEMENTATION_PROPERTY,
+            7=>p.source_line_seg_vertical_pos=Some(vec![]),
+            8=>p.source_line_seg_vertical_pos=Some(vec![111]),
+            9=>p.text=" ".into(),
+            10=>p.controls.push(p.controls[0].clone()),
+            11=>if let Control::Table(t)=&mut p.controls[0]{t.common.treat_as_char=true;},
+            12=>if let Control::Table(t)=&mut p.controls[0]{t.common.text_wrap=crate::model::shape::TextWrap::Square;},
+            _=>unreachable!(),
+        }assert!(!eligible(&p),"case {which}");}
+    }
