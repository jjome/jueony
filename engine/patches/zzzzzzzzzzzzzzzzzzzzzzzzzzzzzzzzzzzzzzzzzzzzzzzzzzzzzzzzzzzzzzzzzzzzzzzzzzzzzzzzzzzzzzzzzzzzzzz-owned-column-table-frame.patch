+/// A column-top floating row-break box and a later, separately owned inline
+/// row have distinct flow extents. The stored inline row cannot absorb the
+/// floating box's explicit outer-bottom margin.
+fn stored_column_top_coanchored_float_box(
+    para: &Paragraph, control_index: usize, paint_top: f64, column_top: f64,
+    visual_height: f64, dpi: f64,
+) -> bool {
+    if !dpi.is_finite() || dpi<=0.0 || !paint_top.is_finite() || !column_top.is_finite()
+        || !visual_height.is_finite() || (paint_top-column_top).abs()>dpi/7200.0
+        || para.cell_format_vpos_dirty || para.line_segs.len()!=1
+    {return false;}
+    let Some(line)=crate::renderer::composer::stored_first_tac_line(para) else{return false;};
+    if line.line_height<=0 || line.line_spacing<0 || line.vertical_pos<0
+        || line.vertical_pos.checked_add(line.line_height)
+            .and_then(|end|end.checked_add(line.line_spacing)).is_none()
+    {return false;}
+    // Page-band definitions have their own frame; their known table descendants
+    // do not become body boxes. Field memo text remains in the body context.
+    // Unknown controls, notes and body nested objects retain the general path.
+    fn known_paragraphs(paragraphs:&[Paragraph], page_band:bool, depth:usize,
+        budget:&mut usize)->bool {
+        if depth>32{return false;}
+        for p in paragraphs {
+            let Some(left)=budget.checked_sub(1) else{return false;};*budget=left;
+            for control in &p.controls {
+                let Some(left)=budget.checked_sub(1) else{return false;};*budget=left;
+                let known=match control {
+                    Control::AutoNumber(_)=>true,
+                    Control::Field(field)=>known_paragraphs(&field.memo_paragraphs,false,depth+1,budget),
+                    Control::Header(header)=>known_paragraphs(&header.paragraphs,true,depth+1,budget),
+                    Control::Footer(footer)=>known_paragraphs(&footer.paragraphs,true,depth+1,budget),
+                    Control::Table(table) if page_band=>table.cells.iter().all(|cell|
+                        known_paragraphs(&cell.paragraphs,true,depth+1,budget)),
+                    _=>false,
+                };
+                if !known{return false;}
+            }
+        }
+        true
+    }
+    let known_cell_controls = |table:&crate::model::table::Table| {
+        // This is an optimization eligibility budget, never a parser limit.
+        let mut budget=4096;
+        table.cells.iter().all(|cell|known_paragraphs(&cell.paragraphs,false,0,&mut budget))
+    };
+    let Some(Control::Table(table))=para.controls.get(control_index) else{return false;};
+    if !is_para_topbottom_float(&table.common) || table.common.allow_overlap
+        || table.common.vertical_offset!=0 || table.common.height>i32::MAX as u32
+        || table.common.height==0 || table.caption.is_some()
+        || !matches!(table.page_break,TablePageBreak::RowBreak)
+        || table.row_count!=1 || table.col_count!=1 || table.cells.len()!=1
+        || table.outer_margin_top!=0 || table.outer_margin_bottom<=0
+        || (visual_height-hwpunit_to_px(table.common.height as i32,dpi)).abs()>dpi/7200.0
+        || !known_cell_controls(table)
+    {return false;}
+    let mut inline_owner=None;
+    for (index,control) in para.controls.iter().enumerate() {
+        if index==control_index {continue;}
+        match control {
+            Control::SectionDef(_) | Control::ColumnDef(_) => {},
+            Control::Table(sibling) if index>control_index && sibling.common.treat_as_char
+                && sibling.caption.is_none() && !sibling.common.allow_overlap
+                && sibling.outer_margin_top>=0 && sibling.outer_margin_bottom>=0
+                && crate::renderer::layout::control_line_seg_index(para,index)==Some(0)
+                && i64::from(line.line_height)==i64::from(sibling.common.height)
+                    +i64::from(sibling.outer_margin_top)+i64::from(sibling.outer_margin_bottom)
+                && known_cell_controls(sibling) => {
+                    if inline_owner.replace(index).is_some(){return false;}
+                },
+            Control::Table(sibling) if index<control_index && !sibling.common.treat_as_char
+                && sibling.common.text_wrap==TextWrap::Square
+                && sibling.common.vert_rel_to==VertRelTo::Paper
+                && sibling.common.horz_rel_to==HorzRelTo::Paper
+                && !sibling.common.allow_overlap => {},
+            _=>return false,
+        }
+    }
+    inline_owner.is_some()
+}
 
