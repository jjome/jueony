+/// The first table page item may be a floating sibling, not the table
+/// owning the host's first saved row. Only the actual inline control whose
+/// entire physical box owns that row can supply its stored frame basis.
+pub(crate) fn stored_table_column_line_vpos(para: &Paragraph, control_index: usize) -> Option<i32> {
+    let Control::Table(table)=para.controls.get(control_index)? else {return None;};
+    if !table.common.treat_as_char || table.caption.is_some()
+        || para.cell_format_vpos_dirty
+        || control_line_seg_index(para,control_index)!=Some(0)
+    {return None;}
+    let first=stored_first_tac_line(para)?;
+    if first.line_height<=0 || first.line_spacing<0 || first.vertical_pos<0
+        || i64::from(first.line_height)!=i64::from(table.common.height)
+            +i64::from(table.outer_margin_top)+i64::from(table.outer_margin_bottom)
+    {return None;}
+    first.vertical_pos.checked_add(first.line_height)?
+        .checked_add(first.line_spacing)?;
+    Some(first.vertical_pos)
 }
 
