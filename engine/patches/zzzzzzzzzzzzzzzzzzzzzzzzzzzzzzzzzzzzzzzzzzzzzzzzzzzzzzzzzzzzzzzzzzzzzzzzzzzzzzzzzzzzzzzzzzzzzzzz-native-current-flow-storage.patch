+/// Unchanged ordinary native rows have no control/story/formatting owner outside
+/// this paragraph. A runtime recomposition, stale source projection or local edit
+/// cannot use this saved partition as a pagination witness.
+pub(super) fn unchanged_native_plain_rows(para: &Paragraph) -> bool {
+    use crate::model::paragraph::ColumnBreakType;
+    if para.char_offsets.len()!=para.text.chars().count(){return false;}
+    let mut utf16=0u32;
+    for(i,c)in para.text.chars().enumerate(){
+        if para.char_offsets.get(i)!=Some(&utf16){return false;}
+        let Some(next)=utf16.checked_add(c.len_utf16() as u32)else{return false;};utf16=next;
+    }
+    if para.char_count!=utf16 && utf16.checked_add(1)!=Some(para.char_count){return false;}
+    !para.stored_text_partition_is_dirty() && !para.cell_format_vpos_dirty
+        && para.controls.is_empty() && para.field_ranges.is_empty()
+        && para.orphan_field_ends.is_empty() && para.range_tags.is_empty()
+        && para.ctrl_data_records.iter().all(Option::is_none)
+        && para.tab_extended.is_empty() && para.title_marks.is_empty() && para.markpen_marks.is_empty()
+        && para.numbering_restart.is_none()
+        && para.column_type == ColumnBreakType::None && para.hwpx_axis_shift == 0
+        && para.layout_only_fill_lines == 0 && !para.line_segs.is_empty()
+        && para_has_visible_text(para) && !para.text.chars().any(|c| c < ' ' || c == '\u{fffc}')
+        && para.line_segs.first().is_some_and(|s| s.text_start == 0)
+        && para.line_segs.iter().all(|r| !is_synthetic_line_seg(r)
+            && r.vertical_pos >= 0 && r.line_height > 0 && r.text_height > 0
+            && r.baseline_distance >= 0 && r.baseline_distance <= r.line_height
+            && r.line_spacing >= 0 && r.column_start >= 0 && r.segment_width > 0
+            && r.column_start.checked_add(r.segment_width).is_some()
+            && r.vertical_pos.checked_add(r.line_height).and_then(|v| v.checked_add(r.line_spacing)).is_some()
+            && (r.text_start == 0 || para.char_offsets.binary_search(&r.text_start).is_ok()))
+        && para.line_segs.windows(2).all(|w| w[0].text_start < w[1].text_start)
+        && para.source_line_seg_vertical_pos.as_ref().is_none_or(|v|
+            v.len() == para.line_segs.len() && v.iter().zip(&para.line_segs).all(|(a,b)| *a == b.vertical_pos))
+}
+/// Issued by the format owner after it has selected the actual current
+/// composition. Equal row heights alone do not prove the saved partition.
+pub(super) fn actual_composition_matches_saved(para:&Paragraph, composed:Option<&crate::renderer::composer::ComposedParagraph>)->bool {
+    if !unchanged_native_plain_rows(para){return false;}
+    let Some(comp)=composed else{return false;};
+    if comp.para_style_id!=para.para_shape_id || comp.lines.len()!=para.line_segs.len()
+        || !comp.inline_controls.is_empty() || comp.numbering_text.is_some()
+        || !comp.tac_controls.is_empty() || !comp.footnote_positions.is_empty()
+        || !comp.tab_extended.is_empty() || comp.horizontal_shaping.is_some()
+        || para.char_shapes.windows(2).any(|w|w[0].start_pos>=w[1].start_pos)
+    {return false;}
+    let chars:Vec<char>=para.text.chars().collect();
+    for(i,(line,row))in comp.lines.iter().zip(&para.line_segs).enumerate(){
+        let Ok(start)=para.char_offsets.binary_search(&row.text_start)else{return false;};
+        let end=if let Some(next)=para.line_segs.get(i+1){let Ok(end)=para.char_offsets.binary_search(&next.text_start)else{return false;};end}else{chars.len()};
+        if line.char_start!=start || line.line_height!=row.line_height || line.line_spacing!=row.line_spacing
+            || line.baseline_distance!=row.baseline_distance || line.column_start!=row.column_start
+            || line.segment_width!=row.segment_width || line.has_line_break || start>=end
+        {return false;}
+        let mut at=start;
+        for run in &line.runs {
+            if run.char_overlap.is_some() || run.footnote_marker.is_some() || run.inserted_control_text || run.display_text.is_some(){return false;}
+            for c in run.text.chars(){
+                if at>=end || chars[at]!=c {return false;}
+                let index=para.char_shapes.partition_point(|s|s.start_pos<=para.char_offsets[at]);
+                let expected=index.checked_sub(1).map_or(0,|i|para.char_shapes[i].char_shape_id);
+                if run.char_style_id!=expected{return false;}at+=1;
+            }
+        }
+        if at!=end{return false;}
+    }
+    true
+}
+pub(super) fn composed_rows_equal_saved(para: &Paragraph, fmt: &metrics::FormattedParagraph, dpi:f64) -> bool {
+    fmt.source_rows_match_current_format && dpi.is_finite() && dpi > 0.0 && fmt.line_count() == para.line_segs.len()
+        && para.line_segs.iter().enumerate().all(|(i,r)|
+            fmt.line_heights[i] == crate::renderer::hwpunit_to_px(r.line_height,dpi)
+            && fmt.line_spacings[i] == crate::renderer::hwpunit_to_px(r.line_spacing,dpi))
+}
+/// A saved prefix only owns visible rows inside this actual available frame.
+/// Trailing line spacing is not ink, so its page-tail trimming remains separate.
+pub(super) fn native_reset_prefix_fits(para:&Paragraph, break_line:usize, base:i32, available:f64, dpi:f64)->bool {
+    if !available.is_finite() || available<=0.0 || !dpi.is_finite() || dpi<=0.0
+        || break_line==0 || break_line>=para.line_segs.len(){return false;}
+    para.line_segs[..break_line].iter().all(|r| {
+        if r.line_height<=0 || r.text_height<=0 || r.text_height>r.line_height {return false;}
+        let Some(top)=r.vertical_pos.checked_sub(base).filter(|v|*v>=0)else{return false;};
+        let Some(end)=top.checked_add(r.line_height)else{return false;};
+        crate::renderer::hwpunit_to_px(end,dpi)<=available
+    })
+}
+fn native_edited_reset_witness(st:&TypesetState, para:&Paragraph, fmt:&metrics::FormattedParagraph, base:Option<i32>, available:f64, dpi:f64)->bool {
