+//! Binds a current, fully formatted mixed host to one exact stored inline row.
+//! This is a row-owner proof; it does not grant source-coordinate or height trust.
+use crate::model::{control::Control,paragraph::{Paragraph,LineSeg,ColumnBreakType}};
+use crate::renderer::{composer::ComposedParagraph,hwpunit_to_px};
+pub(in crate::renderer::typeset) fn actual_row(p:&Paragraph,comp:Option<&ComposedParagraph>,heights:&[f64],spaces:&[f64],dpi:f64)->Option<usize>{
+    let clean=|p:&Paragraph| !p.stored_text_partition_is_dirty()&&!p.cell_format_vpos_dirty
+        &&p.field_ranges.is_empty()&&p.orphan_field_ends.is_empty()&&p.range_tags.is_empty()
+        &&p.title_marks.is_empty()&&p.markpen_marks.is_empty()&&p.ctrl_data_records.iter().all(Option::is_none)
+        &&p.tab_extended.is_empty()&&p.numbering_restart.is_none()&&p.layout_only_fill_lines==0
+        &&p.column_type==ColumnBreakType::None&&p.hwpx_axis_shift==0
+        &&p.text.chars().all(|c|c>'\u{001f}'&&c!='\u{fffc}');
+    if !clean(p)||!dpi.is_finite()||dpi<=0.0||p.line_segs.len()<2||p.line_segs.len()>4096||p.text.len()>1_000_000
+        ||p.char_shapes.windows(2).any(|w|w[0].start_pos>=w[1].start_pos){return None;}
+    let [Control::Table(t)]=p.controls.as_slice()else{return None;};
+    if !t.common.treat_as_char||t.common.locked||t.common.size_protect||t.common.allow_overlap
+        ||t.caption.is_some()||t.row_count!=1||t.col_count!=1||t.cells.len()!=1||!t.zones.is_empty()
+        ||t.raw_table_record_attr&(1<<30)!=0||t.common.height==0
+        ||t.outer_margin_top<0||t.outer_margin_bottom<0
+        ||t.page_break!=crate::model::table::TablePageBreak::RowBreak{return None;}
+    let c=&t.cells[0];
+    if c.dirty_flag||c.cell_protect()||c.field_name.is_some()||c.row_span!=1||c.col_span!=1
+        ||c.text_direction!=0||c.line_wrap!=0||c.paragraphs.is_empty()||c.paragraphs.len()>4096
+        ||c.paragraphs.iter().any(|q|!clean(q)||!q.controls.is_empty()){return None;}
+    let chars:Vec<char>=p.text.chars().collect();
+    if !chars.iter().any(|c|!c.is_whitespace())||p.char_offsets.len()!=chars.len(){return None;}
+    let positions=p.control_text_positions();let [at]=positions.as_slice()else{return None;};
+    if *at>chars.len(){return None;}
+    let mut offset=0u32;
+    for(i,c)in chars.iter().enumerate(){if i==*at{offset=offset.checked_add(8)?;}
+        if p.char_offsets[i]!=offset{return None;}offset=offset.checked_add(c.len_utf16()as u32)?;}
+    if *at==chars.len(){offset=offset.checked_add(8)?;}
+    if offset.checked_add(1)!=Some(p.char_count){return None;}
+    let row=crate::renderer::layout::control_line_seg_index(p,0)?;
+    let owned=p.line_segs.get(row)?;
+    let outer=i64::from(t.common.height)+i64::from(t.outer_margin_top)+i64::from(t.outer_margin_bottom);
+    if p.line_segs.iter().filter(|line|i64::from(line.line_height)==outer).count()!=1{return None;}
+    if i64::from(owned.line_height)!=i64::from(t.common.height)+i64::from(t.outer_margin_top)+i64::from(t.outer_margin_bottom){return None;}
+    // Wide block-like TACs are deliberately absent from composed.tac_controls.
+    // inline_controls.line_index is a legacy placeholder (always zero), not row authority.
+    // The exact eight-unit source slot, unique table-height row and actual full
+    // composition below own this cap; in-line width-reflow tables remain excluded.
+    if crate::renderer::height_measurer::is_tac_table_inline_in_para(t,p.line_segs[0].segment_width,p){return None;}
+    let comp=comp?;
+    if comp.para_style_id!=p.para_shape_id||comp.lines.len()!=p.line_segs.len()||heights.len()!=comp.lines.len()||spaces.len()!=comp.lines.len()
+        ||comp.numbering_text.is_some()||!comp.footnote_positions.is_empty()||!comp.tab_extended.is_empty()||comp.horizontal_shaping.is_some()
+        ||!comp.tac_controls.is_empty()||comp.inline_controls.len()!=1
+        ||comp.inline_controls.iter().any(|c|c.control_index!=0||c.control_type!=crate::renderer::composer::InlineControlType::Table){return None;}
+    for(i,(l,s))in comp.lines.iter().zip(&p.line_segs).enumerate(){
+        if s.line_height<=0||s.text_height<=0||s.text_height>s.line_height||s.line_spacing<0||s.segment_width<=0
+            ||s.tag&LineSeg::TAG_IMPLEMENTATION_PROPERTY!=0||s.vertical_pos<0
+            ||s.vertical_pos.checked_add(s.line_height).and_then(|v|v.checked_add(s.line_spacing)).is_none()
+            ||s.column_start<0||s.column_start.checked_add(s.segment_width).is_none()
+            ||p.source_line_seg_vertical_pos.as_ref().is_some_and(|v|v.len()!=p.line_segs.len()||v[i]!=s.vertical_pos)
+            ||heights[i]!=hwpunit_to_px(s.line_height,dpi)||spaces[i]!=hwpunit_to_px(s.line_spacing,dpi){return None;}
+        let start=p.char_offsets.binary_search(&s.text_start).ok()?;
+        let end=if let Some(next)=p.line_segs.get(i+1){p.char_offsets.binary_search(&next.text_start).ok()?}else{chars.len()};
+        if start>=end||l.char_start!=start||l.line_height!=s.line_height||l.line_spacing!=s.line_spacing
+            ||l.baseline_distance!=s.baseline_distance||l.column_start!=s.column_start||l.segment_width!=s.segment_width||l.has_line_break{return None;}
+        let mut k=start;
+        for run in &l.runs{if run.char_overlap.is_some()||run.footnote_marker.is_some()||run.inserted_control_text||run.display_text.is_some(){return None;}
+            for c in run.text.chars(){if k>=end||chars[k]!=c{return None;}
+                let x=p.char_shapes.partition_point(|v|v.start_pos<=p.char_offsets[k]);
+                let expected=x.checked_sub(1).map_or(0,|j|p.char_shapes[j].char_shape_id);
+                if run.char_style_id!=expected{return None;}k+=1;}}
+        if k!=end{return None;}
+    }
+    Some(row)
+}
