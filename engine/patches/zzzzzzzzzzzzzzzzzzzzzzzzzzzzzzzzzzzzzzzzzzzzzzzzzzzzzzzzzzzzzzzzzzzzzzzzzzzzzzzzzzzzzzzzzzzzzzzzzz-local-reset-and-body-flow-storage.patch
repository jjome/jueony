+/// An observation of input equality, not permission to reuse raw bytes or rows.
+/// Never serialized. Only the actual read/load boundary records it, and only
+/// the stale-reset override consumes it. In particular raw_ctrl_seal is unchanged.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct ResetFlowObservation {
+    input: [u8; 32],
+    context: [u8; 32],
+}
+
+const RESET_INPUT_MAX_BYTES: usize = 2 * 1024 * 1024;
+const RESET_INPUT_PASS_BYTES: usize = 16 * 1024 * 1024;
+const RESET_INPUT_MAX_DEPTH: usize = 64;
+
+/// Streaming and bounded: no whole JSON allocation or recursive Value walk.
+/// JSON delimiters inside quoted/escaped text do not count toward the depth.
+struct ResetInputDigest {
+    hash: blake3::Hasher,
+    remaining: usize,
+    bytes: usize,
+    depth: usize,
+    quoted: bool,
+    escaped: bool,
+}
+impl std::io::Write for ResetInputDigest {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        if bytes.len() > self.remaining {
+            return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "reset observation byte budget"));
+        }
+        for &byte in bytes {
+            if self.quoted {
+                if self.escaped { self.escaped = false; }
+                else if byte == b'\\' { self.escaped = true; }
+                else if byte == b'"' { self.quoted = false; }
+            } else {
+                match byte {
+                    b'"' => self.quoted = true,
+                    b'{' | b'[' => {
+                        self.depth += 1;
+                        if self.depth > RESET_INPUT_MAX_DEPTH {
+                            return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "reset observation depth budget"));
+                        }
+                    }
+                    b'}' | b']' => self.depth = self.depth.checked_sub(1).ok_or_else(||
+                        std::io::Error::new(std::io::ErrorKind::InvalidData, "reset observation delimiter"))?,
+                    _ => {}
+                }
+            }
+        }
+        self.remaining -= bytes.len(); self.bytes += bytes.len();
+        self.hash.update(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+}
+fn bounded_reset_digest<T: Serialize>(value: &T, budget: &mut usize) -> Option<[u8; 32]> {
+    let mut writer = ResetInputDigest { hash: blake3::Hasher::new(),
+        remaining: (*budget).min(RESET_INPUT_MAX_BYTES), bytes: 0,
+        depth: 0, quoted: false, escaped: false };
+    let success = serde_json::to_writer(&mut writer, value).is_ok();
+    *budget = budget.saturating_sub(writer.bytes);
+    (success && writer.depth == 0 && !writer.quoted)
+        .then(|| *writer.hash.finalize().as_bytes())
+}
+
+impl crate::model::document::Document {
+    /// One current context calculation per pass. No body/cell text participates:
+    /// editing a later paragraph is not evidence that a preceding reset is stale.
+    /// Bind actual definitions (not just IDs), unknown DocInfo records, the whole
+    /// SectionDef and the positions/definitions of structural ColumnDef controls.
+    /// A newly appended unused definition conservatively invalidates equality.
+    pub(crate) fn reset_flow_contexts(&self) -> Vec<Option<[u8; 32]>> {
+        // This projection intentionally excludes body content, raw stream
+        // caches, seals and the derived print_method. Unknown definition bytes
+        // remain bound. Exhaustive destructuring makes additions reviewable.
+        let DocInfo { bin_data_list, font_faces, border_fills, char_shapes,
+            tab_defs, numberings, bullets, para_shapes, styles, extra_records,
+            print_method: _, raw_stream: _, bullet_count, memo_shape_count,
+            memo_properties_xml, distribute_doc_data_removed: _, raw_stream_dirty: _,
+            hwpx_head_tail, hwpml_version, raw_provenance: _ } = &self.doc_info;
+        let mut budget = RESET_INPUT_PASS_BYTES;
+        let Some(definitions) = bounded_reset_digest(&(
+            bin_data_list, font_faces, border_fills, char_shapes, tab_defs,
+            numberings, bullets, para_shapes, styles, extra_records, bullet_count,
+            memo_shape_count, memo_properties_xml, hwpx_head_tail, hwpml_version,
+        ), &mut budget) else { return vec![None; self.sections.len()]; };
+        self.sections.iter().enumerate().map(|(section_index, section)| {
+            let mut columns = Vec::new();
+            for (pi, paragraph) in section.paragraphs.iter().enumerate() {
+                for (ci, control) in paragraph.controls.iter().enumerate() {
+                    if let crate::model::control::Control::ColumnDef(column) = control {
+                        if columns.len() >= 4096 { return None; }
+                        columns.push((pi, ci, column));
+                    }
+                }
+            }
+            bounded_reset_digest(&(
+                "rhwp-reset-input-observation-1", super::native_computed_resource::RESOURCE,
+                definitions, section_index, &section.section_def, columns,
+            ), &mut budget)
+        }).collect()
+    }
+}
+
+fn observe_loaded_reset_inputs(paragraphs: &mut [crate::model::paragraph::Paragraph], context: Option<[u8; 32]>) {
+    let mut budget = RESET_INPUT_PASS_BYTES;
+    for (index, paragraph) in paragraphs.iter_mut().enumerate() {
+        paragraph.reset_flow_observation = context.and_then(|context|
+            bounded_reset_digest(&(index, &*paragraph), &mut budget)
+                .map(|input| ResetFlowObservation { input, context }));
+    }
+}
+
+/// Compute once at section entry, not once per reset or nested paragraph. The
+/// existing dirty/raw/physical checks remain separate requirements. Dynamically
+/// supplied measurement resources are outside this portable observation scope.
+pub(crate) fn unchanged_reset_inputs(
+    paragraphs: &[crate::model::paragraph::Paragraph], context: Option<[u8; 32]>,
+    portable_resources: bool,
+) -> Vec<bool> {
+    let mut budget = RESET_INPUT_PASS_BYTES;
+    paragraphs.iter().enumerate().map(|(index, paragraph)| {
+        if !portable_resources { return false; }
+        let (Some(context), Some(observed)) = (context, paragraph.reset_flow_observation) else { return false; };
+        observed.context == context && bounded_reset_digest(&(index, paragraph), &mut budget) == Some(observed.input)
+    }).collect()
+}
