+/// A global edit flag is not evidence that an unchanged whole TAC's stored
+/// column boundary became stale. Keep that existing boundary when its empty
+/// carrier, adjacent empty rows, actual measured box and preceding local flow
+/// are still closed. This only vetoes the stale-reset *override*: it neither
+/// invents a boundary nor authenticates a new coordinate axis or source row.
+fn native_closed_tac_reset_is_current(
+    native:bool, columns:u16, index:usize, paragraphs:&[Paragraph],
+    items:&[crate::renderer::pagination::PageItem], measured:&[MeasuredTable],
+    styles:&ResolvedStyleSet, body_height:f64, dpi:f64, reset_inputs:&[bool],
+)->bool {
+    use crate::model::paragraph::{LineSeg,ColumnBreakType};
+    use crate::renderer::pagination::PageItem;
+    if !native || columns<2 || index==0 || !dpi.is_finite() || dpi<=0.0
+        || !body_height.is_finite() || body_height<=0.0 || items.is_empty() {return false;}
+    let (Some(prev),Some(current),Some(next))=(paragraphs.get(index-1),paragraphs.get(index),paragraphs.get(index+1)) else{return false;};
+    if ![index-1,index,index+1].iter().all(|i|reset_inputs.get(*i)==Some(&true)) {return false;}
+    let clean=|p:&Paragraph|!p.stored_text_partition_is_dirty() && !p.cell_format_vpos_dirty
+        && p.layout_only_fill_lines==0 && p.source_line_seg_vertical_pos.is_none()
+        && p.hwpx_axis_shift==0
+        && p.line_segs.iter().all(|s|s.tag&LineSeg::TAG_IMPLEMENTATION_PROPERTY==0);
+    let table_clean=|t:&crate::model::table::Table|t.raw_ctrl_seal
+        ==Some(crate::model::raw_provenance::record_digest(&t.common))
+        && t.cells.iter().all(|c|!c.dirty_flag && c.paragraphs.iter().all(|p|clean(p)&&p.controls.is_empty()));
+    // Read actual current-vs-initial measurement evidence. This is a reason
+    // to invalidate the existing reset, not an authorization of child layout.
+    fn changed(p:&Paragraph, depth:usize, budget:&mut usize)->bool {
+        if depth>32 || *budget==0 {return true;} *budget-=1;
+        if p.stored_text_partition_is_dirty() || p.cell_format_vpos_dirty
+            || p.layout_only_fill_lines!=0 || p.hwpx_axis_shift!=0
+            || p.source_line_seg_vertical_pos.is_some()
+            || p.line_segs.iter().any(|s|s.tag&LineSeg::TAG_IMPLEMENTATION_PROPERTY!=0) {return true;}
+        for control in &p.controls {
+            if *budget==0{return true;}*budget-=1;
+            let is_changed=match control {
+                Control::Table(t)=>t.raw_ctrl_seal!=Some(crate::model::raw_provenance::record_digest(&t.common))
+                    || t.cells.iter().any(|c|c.dirty_flag||c.paragraphs.iter().any(|p|changed(p,depth+1,budget)))
+                    || t.caption.as_ref().is_some_and(|c|c.paragraphs.iter().any(|p|changed(p,depth+1,budget))),
+                Control::Field(f)=>f.memo_paragraphs.iter().any(|p|changed(p,depth+1,budget)),
+                Control::Header(h)=>h.paragraphs.iter().any(|p|changed(p,depth+1,budget)),
+                Control::Footer(f)=>f.paragraphs.iter().any(|p|changed(p,depth+1,budget)),
+                // Current enclosing-table measurements below own the flow box.
+                // A picture is still painted by its ordinary object path; no
+                // original row, position or new source lease is granted here.
+                Control::Picture(p)=>p.caption.as_ref().is_some_and(|c|c.paragraphs.iter().any(|p|changed(p,depth+1,budget))),
+                Control::AutoNumber(_)|Control::SectionDef(_)|Control::ColumnDef(_)=>false,
+                _=>true,
+            };
+            if is_changed{return true;}
+        }
+        false
+    }
+    let mut budget=4096;
+    let mut visited=std::collections::BTreeSet::new();
+    for item in items {
+        let (pi,table_index)=match item {
+            PageItem::FullParagraph{para_index}=>(*para_index,None),
+            PageItem::Table{para_index,control_index}=>(*para_index,Some(*control_index)),
+            _=>return false,
+        };
+        let Some(p)=paragraphs.get(pi) else{return false;};
+        if pi>=index || reset_inputs.get(pi)!=Some(&true)
+            || (visited.insert(pi)&&changed(p,0,&mut budget)) {return false;}
+        if let Some(ci)=table_index {
+            let Some(m)=measured.iter().find(|m|m.para_index==pi&&m.control_index==ci) else{return false;};
+            if let Some(baseline)=m.baseline_row_heights.as_ref() {
+                if m.row_heights.len()!=baseline.len() || m.row_heights.is_empty()
+                    || m.row_heights.iter().zip(baseline).any(|(a,b)|!a.is_finite()||!b.is_finite()||(a-b).abs()>dpi/7200.0)
+                {return false;}
+            } else {
+                // None is the original, clean measurement's self-baseline.
+                // Selective measurement keeps it for untouched table owners.
+                // Still require that current measured whole box exactly closes
+                // the source common object's declared body height.
+                let Some(Control::Table(t))=p.controls.get(ci) else{return false;};
+                if t.caption.is_some() || t.common.height==0 || t.common.height>i32::MAX as u32
+                    || m.caption_height!=0.0 || !m.total_height.is_finite()
+                    || (m.total_height-hwpunit_to_px(t.common.height as i32,dpi)).abs()>dpi/7200.0
+                    || m.row_heights.is_empty() || m.row_heights.iter().any(|h|!h.is_finite()||*h<=0.0)
+                {return false;}
+            }
+        }
+    }
+    if ![prev,current,next].iter().all(|p|clean(p) && p.column_type==ColumnBreakType::None && p.text.is_empty()
+        && p.line_segs.len()==1 && p.range_tags.is_empty() && p.field_ranges.is_empty()
+        && p.orphan_field_ends.is_empty() && p.tab_extended.is_empty()
+        && p.ctrl_data_records.iter().all(Option::is_none)
+        && styles.para_styles.get(p.para_shape_id as usize).is_some_and(|s|
+            s.spacing_before==0.0 && s.spacing_after==0.0 && !s.page_break_before))
+        || !prev.controls.is_empty() || !next.controls.is_empty() {return false;}
+    let [Control::Table(table)]=current.controls.as_slice() else{return false;};
+    if !table_clean(table) || !table.common.treat_as_char || table.caption.is_some()
+        || table.outer_margin_top<0 || table.outer_margin_bottom<0
+        || table.common.height==0 || table.common.height>i32::MAX as u32 {return false;}
+    let (a,b,c)=(&prev.line_segs[0],&current.line_segs[0],&next.line_segs[0]);
+    let valid=|s:&LineSeg|s.text_start==0 && s.vertical_pos>=0 && s.line_height>0
+        && s.text_height==s.line_height && s.line_spacing>=0
+        && s.column_start==0 && s.segment_width>0;
+    if ![a,b,c].iter().all(|s|valid(s)) || a.segment_width!=b.segment_width
+        || b.segment_width!=c.segment_width || b.vertical_pos>=a.vertical_pos {return false;}
+    let Some(prev_end)=a.vertical_pos.checked_add(a.line_height) else{return false;};
+    let Some(box_end)=b.vertical_pos.checked_add(b.line_height)
+        .and_then(|v|v.checked_add(b.line_spacing)) else{return false;};
+    let Some(next_end)=c.vertical_pos.checked_add(c.line_height) else{return false;};
+    let Some(height)=(table.common.height as i32).checked_add(i32::from(table.outer_margin_top))
+        .and_then(|v|v.checked_add(i32::from(table.outer_margin_bottom))) else{return false;};
+    if box_end!=c.vertical_pos || b.line_height!=height
+        || hwpunit_to_px(prev_end,dpi)>body_height || hwpunit_to_px(next_end,dpi)>body_height {return false;}
+    measured.iter().filter(|m|m.para_index==index&&m.control_index==0).count()==1
+        && measured.iter().find(|m|m.para_index==index&&m.control_index==0).is_some_and(|m|
+            m.total_height.is_finite() && m.caption_height==0.0
+                && (m.total_height-hwpunit_to_px(table.common.height as i32,dpi)).abs()<=dpi/7200.0)
+}
