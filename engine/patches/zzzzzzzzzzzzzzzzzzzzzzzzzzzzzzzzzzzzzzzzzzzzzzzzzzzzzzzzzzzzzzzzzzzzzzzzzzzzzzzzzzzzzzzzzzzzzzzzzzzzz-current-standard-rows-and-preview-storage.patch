+  assert!(digest(&"\"[{}]\\").is_some());
+  assert!(digest(&"a".repeat(16*1024*1024)).is_none());
+  let mut v=serde_json::Value::Null;for _ in 0..65{v=serde_json::json!([v]);}assert!(digest(&v).is_none());
+ }
