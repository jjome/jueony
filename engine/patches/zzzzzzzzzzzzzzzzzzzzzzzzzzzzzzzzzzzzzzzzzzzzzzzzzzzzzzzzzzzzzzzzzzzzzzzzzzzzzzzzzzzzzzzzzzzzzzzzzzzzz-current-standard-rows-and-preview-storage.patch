+ use super::*;
+ fn sample()->(Document,CurrentStandardRowsProjection){
+  let mut d=Document::default();d.sections.push(Default::default());
+  d.sections[0].paragraphs=(0..3).map(|index|{let mut p=Paragraph::default();p.text=format!("paragraph {index}");p}).collect();
+  let p=CurrentStandardRowsProjection{definitions:definitions(&d).unwrap(),
+   inputs:d.sections[0].paragraphs.iter().enumerate().map(|(i,p)|digest(&(i,p)).unwrap()).collect(),
+   rows:vec![vec![LineSeg::default()];3]};(d,p)
+ }
+ #[test] fn fresh_standard_rows_bind_only_exact_export_input_and_top_level_pointers(){
+  let(d,p)=sample();let clone=d.clone();let map=p.bind_for_export(&clone).unwrap();
+  assert_eq!(map.len(),3);
+  for row in &clone.sections[0].paragraphs{assert!(map.contains_key(&(row as *const Paragraph as usize)));}
+  for row in &d.sections[0].paragraphs{assert!(!map.contains_key(&(row as *const Paragraph as usize)));}
+  let mut changed=d.clone();changed.sections[0].paragraphs.swap(0,1);assert!(p.bind_for_export(&changed).is_none());
+  let mut changed=d.clone();changed.sections[0].paragraphs[1].raw_header_extra.push(0x51);assert!(p.bind_for_export(&changed).is_none());
+  let mut changed=d.clone();changed.doc_info.font_faces.push(Default::default());assert!(p.bind_for_export(&changed).is_none());
+ }
