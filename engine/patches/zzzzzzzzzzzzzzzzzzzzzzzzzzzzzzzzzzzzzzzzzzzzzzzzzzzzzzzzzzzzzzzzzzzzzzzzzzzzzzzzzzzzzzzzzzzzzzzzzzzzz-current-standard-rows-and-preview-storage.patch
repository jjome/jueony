+pub(super) fn current_table_top(ctx:&ColumnItemCtx<'_>, index:usize, control:usize,
+    current_flow:f64,dpi:f64)->Option<CurrentTableTop> {
+    let plan=current_whole_stack(ctx,dpi)?;
+    let host=plan.hosts.iter().find(|p|p.para_index==index && p.control_index==control)?;
+    if hu(current_flow-ctx.col_area.y,dpi)?!=host.physical_top_hu {return None;}
+    Some(CurrentTableTop{table_top:current_flow})
+}
