+impl CurrentWholeStackPlan {
+    /// Full current row/run identity, including the selected space policy.
+    /// This comparison does not authorize a source flag or imported lease.
+    pub(crate) fn matches_fresh_prefix(&self,candidate:&ComposedParagraph)->bool {
+        same_composition(&self.fresh_prefix,candidate)
+    }
+}
