+  let paragraphs=&doc.sections[0].paragraphs;
+  let mut inputs=Vec::with_capacity(3);let mut rows=Vec::with_capacity(3);
+  for index in 0..3 {
+   let p=paragraphs.get(index)?;let input=digest(&(index,p))?;let mut fresh=p.clone();
+   fresh.line_segs.clear();fresh.layout_space_metrics.clear();
+   fresh.source_line_seg_vertical_pos=None;fresh.layout_only_fill_lines=0;fresh.hwpx_axis_shift=0;
+   fresh.native_source_synthetic_seal=None;fresh.native_source_synthetic_context=None;
+   fresh.completed_native_rows=None;fresh.native_frame_observation.set(None);
+   let shape=usize::from(fresh.para_shape_id);
+   let frame=ParagraphBox::content_for_style(width,styles.para_styles.get(shape),dpi);
+   reflow_line_segs(&mut fresh,frame,styles,dpi);
+   if fresh.line_segs.is_empty() || fresh.line_segs.len()>256{return None;}
+   let mut end=0i32;
+   for row in &fresh.line_segs {
+    if row.vertical_pos!=end || row.line_height<=0 || row.text_height!=row.line_height
+      || row.line_spacing<0 || row.column_start!=0 || row.segment_width!=plan.column_width_hu
+      || row.baseline_distance<0 || row.baseline_distance>row.line_height{return None;}
+    end=end.checked_add(row.line_height)?.checked_add(row.line_spacing)?;
+    if end>plan.body_height_hu{return None;}
+   }
+   if index==0 {
+    if end!=plan.prefix_end_hu || !plan.matches_fresh_prefix(&compose_paragraph_in_context(&fresh,styles)){return None;}
+   } else {
+    let host=plan.hosts.get(index-1)?;
+    if host.para_index!=index || host.control_index!=0 || fresh.line_segs.len()!=1
+      || host.logical_anchor_hu!=plan.prefix_end_hu || host.physical_top_hu<0
+      || host.reserved_bottom_hu>plan.body_height_hu
+      || host.after_hu!=if index==1 {fresh.line_segs[0].line_spacing} else {0}{return None;}
+    // Logical generated-row anchor and physical object reservation are distinct
+    // quantities in this proven current stack. No imported row supplies either.
+    let row=fresh.line_segs.first_mut()?;
+    row.vertical_pos=row.vertical_pos.checked_add(host.logical_anchor_hu)?;
+    if row.vertical_pos.checked_add(end)?>plan.body_height_hu{return None;}
+   }
+   inputs.push(input);rows.push(fresh.line_segs);
+  }
+  Some(Self{definitions,inputs,rows})
+ }
+ // Rebind only an unchanged export clone. Byte packages cannot construct this
+ // ephemeral projection or acquire a new CompletedRows lease.
+ pub(crate) fn bind_for_export(&self,doc:&Document)->Option<HashMap<usize,Vec<LineSeg>>>{
+  if doc.sections.len()!=1 || self.inputs.len()!=3 || self.rows.len()!=3
+    || definitions(doc)?!=self.definitions{return None;}
+  let paragraphs=&doc.sections[0].paragraphs;
+  let mut bound=HashMap::new();
+  for index in 0..3 {let p=paragraphs.get(index)?;
+   if p.stored_text_partition_is_dirty() || p.cell_format_vpos_dirty || p.source_line_seg_vertical_pos.is_some(){return None;}
+   if digest(&(index,p))?!=self.inputs[index]{return None;}
+   bound.insert(p as *const Paragraph as usize,self.rows[index].clone());
+  }
+  Some(bound)
+ }
+}
