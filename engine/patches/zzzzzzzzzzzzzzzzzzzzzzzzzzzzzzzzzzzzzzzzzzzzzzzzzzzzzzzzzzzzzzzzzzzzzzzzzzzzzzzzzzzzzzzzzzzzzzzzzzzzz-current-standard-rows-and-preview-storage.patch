+//! Ephemeral fresh composition rows for one readonly export, never an imported
+//! row/cache lease. The producer must own a current independently closed stack.
+//! Nothing here is persisted in Document or the computed-row descriptor.
+use crate::model::{document::Document,paragraph::{Paragraph,LineSeg}};
+use serde::Serialize;
+use std::collections::HashMap;
+
+#[derive(Debug)]
+pub(crate) struct CurrentStandardRowsProjection {
+    definitions:[u8;32],
+    inputs:Vec<[u8;32]>,
+    rows:Vec<Vec<LineSeg>>,
+}
+
+// A serialization byte/depth bound, not a claim of a total CPU-time bound.
+struct Digest { hash:blake3::Hasher, bytes:usize, depth:usize, quoted:bool, escaped:bool }
+impl std::io::Write for Digest {
+ fn write(&mut self,b:&[u8])->std::io::Result<usize>{
+  if b.len()>16*1024*1024-self.bytes{return Err(std::io::ErrorKind::InvalidData.into());}
+  for &c in b {if self.quoted {if self.escaped{self.escaped=false;}else if c==b'\\'{self.escaped=true;}else if c==b'"'{self.quoted=false;}}
+   else {match c {b'"'=>self.quoted=true,b'{'|b'['=>{self.depth+=1;if self.depth>64{return Err(std::io::ErrorKind::InvalidData.into());}},b'}'|b']'=>self.depth=self.depth.checked_sub(1).ok_or(std::io::ErrorKind::InvalidData)?,_=>{}}}}
+  self.bytes+=b.len();self.hash.update(b);Ok(b.len())
+ }
+ fn flush(&mut self)->std::io::Result<()>{Ok(())}
+}
+fn digest<T:Serialize>(v:&T)->Option<[u8;32]>{let mut w=Digest{hash:blake3::Hasher::new(),bytes:0,depth:0,quoted:false,escaped:false};
+ serde_json::to_writer(&mut w,v).ok()?;(w.depth==0&&!w.quoted).then(||*w.hash.finalize().as_bytes())}
+fn definitions(doc:&Document)->Option<[u8;32]>{
+ use crate::model::document::DocInfo;
+ let DocInfo{bin_data_list,font_faces,border_fills,char_shapes,tab_defs,numberings,bullets,
+  para_shapes,styles,extra_records,print_method,raw_stream,bullet_count,memo_shape_count,
+  memo_properties_xml,distribute_doc_data_removed,raw_stream_dirty:_,hwpx_head_tail,hwpml_version,
+  raw_provenance:_}=&doc.doc_info;
+ // Exhaustive definition binding, including unknown input bytes. Only derived
+ // cache-validity/seal fields are excluded; this does not mint either seal.
+ digest(&((bin_data_list,font_faces,border_fills,char_shapes,tab_defs,numberings,bullets,
+  para_shapes,styles,extra_records),(print_method,raw_stream,bullet_count,memo_shape_count,
+  memo_properties_xml,distribute_doc_data_removed,hwpx_head_tail,hwpml_version,&doc.doc_properties,&doc.sections.first()?.section_def)))
+}
