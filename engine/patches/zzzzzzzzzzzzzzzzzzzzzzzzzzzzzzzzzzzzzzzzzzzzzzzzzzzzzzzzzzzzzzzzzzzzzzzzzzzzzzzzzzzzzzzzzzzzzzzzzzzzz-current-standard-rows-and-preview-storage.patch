+/// Current composition and physical allocation only; this is not an imported
+/// row owner, a descriptor permission, or a request to change document rows.
+pub(crate) struct CurrentWholeStackPlan {
+    pub fresh_prefix: ComposedParagraph,
+    pub prefix_end_hu: i32,
+    pub column_width_hu: i32,
+    pub body_height_hu: i32,
+    pub hosts: [CurrentStackHost; 2],
+}
