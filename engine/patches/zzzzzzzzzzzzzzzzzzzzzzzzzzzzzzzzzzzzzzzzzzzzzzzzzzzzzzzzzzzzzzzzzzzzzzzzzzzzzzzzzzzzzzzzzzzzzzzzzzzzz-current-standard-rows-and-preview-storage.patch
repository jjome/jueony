+fn plain(p:&Paragraph)->bool {
+    p.text.len()<=64*1024 && p.line_segs.len()<=4096 && p.char_shapes.len()<=128
+        && p.ctrl_data_records.len()<=2 && p.raw_header_extra.len()<=128
+        && !p.stored_text_partition_is_dirty() && !p.cell_format_vpos_dirty
+        && p.hwpx_axis_shift==0 && p.source_line_seg_vertical_pos.is_none()
+        && p.layout_only_fill_lines==0 && p.field_ranges.is_empty()
+        && p.orphan_field_ends.is_empty() && p.range_tags.is_empty()
+        && p.title_marks.is_empty() && p.markpen_marks.is_empty()
+        && p.tab_extended.is_empty() && p.numbering_restart.is_none()
+        && p.ctrl_data_records.iter().all(Option::is_none)
+}
+
+// This is a typed HU comparison, never a rounding of published coordinates.
+// All operands below originate in integer source metrics or integer table
+// declarations. Reject a fractional metric rather than fitting it to the source.
+fn hu(px:f64,dpi:f64)->Option<i32> {
+    if !px.is_finite() || px<0.0 || !dpi.is_finite() || dpi<=0.0{return None;}
+    let value=px*7200.0/dpi;
+    if value>i32::MAX as f64{return None;}
+    let integer=value.round();
+    // Bound only floating-point arithmetic roundoff (far less than one HU).
+    ((value-integer).abs()<=f64::EPSILON*value.abs().max(1.0)*8.0).then_some(integer as i32)
+}
+
+fn same_composition(a:&ComposedParagraph,b:&ComposedParagraph)->bool {
+    a.para_style_id==b.para_style_id && a.lines.len()==b.lines.len()
+        && a.numbering_text.is_none() && b.numbering_text.is_none()
+        && a.inline_controls.len()==2 && b.inline_controls.len()==2
+        && a.inline_controls.iter().zip(&b.inline_controls).enumerate().all(|(i,(a,b))|
+            a.control_index==i && b.control_index==i
+                && a.control_type==crate::renderer::composer::InlineControlType::Other
+                && a.control_type==b.control_type && a.line_index==b.line_index)
+        && a.tac_controls.is_empty() && b.tac_controls.is_empty()
+        && a.footnote_positions.is_empty() && b.footnote_positions.is_empty()
+        && a.tab_extended.is_empty() && b.tab_extended.is_empty()
+        && a.horizontal_shaping.is_none() && b.horizontal_shaping.is_none()
+        && a.lines.iter().zip(&b.lines).all(|(a,b)|
+            a.char_start==b.char_start && a.line_height==b.line_height
+                && a.baseline_distance==b.baseline_distance && a.line_spacing==b.line_spacing
+                && a.column_start==b.column_start && a.segment_width==b.segment_width
+                && !a.has_line_break && !b.has_line_break && a.runs.len()==b.runs.len()
+                && a.runs.iter().zip(&b.runs).all(|(a,b)| a.text==b.text
+                    && a.char_style_id==b.char_style_id && a.lang_index==b.lang_index
+                    && a.supplemental_metrics_blocked==b.supplemental_metrics_blocked
+                    && a.space_metric==b.space_metric && a.char_overlap.is_none() && b.char_overlap.is_none()
+                    && a.footnote_marker.is_none() && b.footnote_marker.is_none()
+                    && !a.inserted_control_text && !b.inserted_control_text
+                    && a.display_text.is_none() && b.display_text.is_none()))
+}
