+//! Never-swap stamped exports. An intent borrows the exact immutable source;
+//! only a literal source clone receives the validated metadata replacements.
+//! Ordinary physical preparation and serializer guards retain their ownership.
+use super::*;
+
+pub(crate) struct StoredTimeExportIntent<'a> {
+    source: &'a Document,
+    original_fingerprint: String,
+    prepared: Prepared,
+    requested_values: Value,
+    before: Value,
+}
+
+impl StoredTimeExportIntent<'_> {
+    pub(crate) fn stamped_source_document(&self, source: &Document) -> Result<Document, String> {
+        if !std::ptr::eq(source, self.source) || token(source)? != self.original_fingerprint {
+            return Err("Stored-time export intent belongs to another source document".into());
+        }
+        let mut document = source.clone();
+        document.extra_streams = self.prepared.streams.clone();
+        document.hwpx_aux_entries = self.prepared.aux.clone();
+        // No body, styles, provenance, geometry, cached rows or lease is edited.
+        if token(&document)? != self.prepared.fingerprint {
+            return Err("Stamped metadata owner differs from the validated preview".into());
+        }
+        Ok(document)
+    }
+    fn receipt(&self) -> String {
+        json!({"schemaVersion":1,"originalFingerprint":self.original_fingerprint,
+            "stampedFingerprint":self.prepared.fingerprint,"changed":self.prepared.changed,
+            "requestedValues":self.requested_values,"before":self.before,
+            "after":self.prepared.information}).to_string()
+    }
+}
+
+impl DocumentCore {
+    /// Explicit metadata intent only: no clock, live mutation, history event,
+    /// successful-save acknowledgement, or new file permission is produced.
+    pub fn export_stamped_stored_information_native(
+        &self, format: &str, expected: &str, source: &str, password: Option<&[u8]>,
+    ) -> Result<(crate::serializer::SerializedDocument, String), HwpError> {
+        let prepared = self.prepare_stored_information(expected, source)?;
+        let requested = request(source).map_err(HwpError::RenderError)?;
+        let requested_values = Value::Object(requested.into_iter().map(|(index, ticks)|
+            (TIME_KEYS[index].into(), Value::String(ticks.to_string()))).collect());
+        let before = serde_json::from_str(&self.get_document_stored_information_native())
+            .map_err(|_| HwpError::RenderError("Unreadable original stored information".into()))?;
+        let intent = StoredTimeExportIntent { source: &self.document,
+            original_fingerprint: expected.into(), prepared, requested_values, before };
+        let output = self.export_with_stored_time_intent(format, password, &intent)?;
+        Ok((output, intent.receipt()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn stored_time_export_intent_rejects_distinct_byte_identical_document() {
+        let source = Document::default();
+        let changes = request(r#"{"schemaVersion":1,"values":{"modified":"133536420007654321"}}"#).unwrap();
+        let prepared = prepare(&source, &changes).unwrap();
+        let intent = StoredTimeExportIntent { source: &source,
+            original_fingerprint: token(&source).unwrap(), prepared,
+            requested_values: json!({"modified":"133536420007654321"}),
+            before: json!({}) };
+        let foreign = source.clone();
+        assert_eq!(token(&foreign).unwrap(), token(&source).unwrap());
+        assert!(intent.stamped_source_document(&foreign).is_err());
+        assert!(intent.stamped_source_document(&source).is_ok());
+    }
+}
