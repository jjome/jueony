+#[cfg(test)]mod native_common_optional_absent121_tests{
+ use super::*;
+ fn table(len:usize)->crate::model::table::Table{
+  let mut t=crate::model::table::Table::default();
+  t.common.ctrl_id=0;t.common.z_order=0;t.common.prevent_page_break=0;
+  t.common.numbering_type=crate::model::shape::ObjectNumberingType::None;
+  t.common.drop_cap_style=crate::model::shape::DropCapStyle::None;
+  t.outer_margin_left=t.common.margin.left;t.outer_margin_right=t.common.margin.right;
+  t.outer_margin_top=t.common.margin.top;t.outer_margin_bottom=t.common.margin.bottom;
+  t.common.attr=crate::serializer::control::pack_common_attr_bits(&t.common);
+  let c=&t.common;let mut bytes=Vec::new();
+  for v in [c.attr,c.vertical_offset,c.horizontal_offset,c.width,c.height]{bytes.extend(v.to_le_bytes());}
+  bytes.extend(c.z_order.to_le_bytes());for v in [c.margin.left,c.margin.right,c.margin.top,c.margin.bottom]{bytes.extend(v.to_le_bytes());}
+  bytes.extend(c.instance_id.to_le_bytes());if len==42{bytes.extend(0i32.to_le_bytes());}bytes.extend(0u16.to_le_bytes());t.raw_ctrl_data=bytes;t
+ }
+ #[test]fn exact38_and42_common_match_but_optional_absent_never_admits_unknown_bytes(){
+  for len in [38,42]{let t=table(len);assert!(native_common_matches(&t));
+   for off in [0,4,8,12,16,20,24,26,28,30,32,35,36,37]{let mut c=t.clone();c.raw_ctrl_data[off]^=1;assert!(!native_common_matches(&c),"len{len} byte{off}");}
+   let mut c=t.clone();c.common.prevent_page_break=1;assert!(!native_common_matches(&c));
+   let mut c=t.clone();c.common.description="X".into();assert!(!native_common_matches(&c));
+   let mut c=t.clone();c.common.raw_extra=vec![0];assert!(!native_common_matches(&c));
+   let mut c=t.clone();c.common.attr|=1u32<<31;c.raw_ctrl_data[0..4].copy_from_slice(&c.common.attr.to_le_bytes());assert!(!native_common_matches(&c));
+   let mut c=t.clone();c.common.locked=!c.common.locked;assert!(!native_common_matches(&c));
+  }
+  for len in [0,36,37,39,40,41,43,44]{let mut t=table(42);t.raw_ctrl_data.resize(len,0);assert!(!native_common_matches(&t),"unexpected length {len}");}
+ }
