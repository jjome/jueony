+ #[test]fn passive_archive122_codec_rejects_tamper_versions_and_preserves_arbitrary_inner_cipher(){
+  for raw in [vec![],vec![0,255,0,127],b"secret opaque cipher never decode me".to_vec()]{let e=envelope(&raw).unwrap();assert_eq!(decode(&e).unwrap(),raw);for i in [0,16,20,28,59]{let mut b=e.clone();b[i]^=1;assert!(decode(&b).is_err());}let mut b=e.clone();b.push(0);assert!(decode(&b).is_err());}
+  assert!(envelope(&vec![0;LIMIT+1]).is_err());assert!(decode(&vec![0;ENVELOPE_LIMIT+1]).is_err());
+ }
+ #[test]fn passive_archive122_owner_merge_requires_exact_payload_and_fixed_paths(){
+  let mut d=Document::default();d.extra_streams.push((ACTIVE.into(),b"raw".to_vec()));d.hwpx_aux_entries.push((ZIP.into(),b"raw".to_vec()));assert_eq!(payload(&d).unwrap(),Some(b"raw".to_vec()));
+  d.extra_streams.push((ARCHIVE.into(),envelope(b"raw").unwrap()));assert_eq!(payload(&d).unwrap(),Some(b"raw".to_vec()));
+  d.hwpx_aux_entries[0].1=b"other".to_vec();assert!(payload(&d).is_err());
+  for path in ["/rhwpcomputednativerowsv1","/RhwpComputedNativeRowsV1/child","/./RhwpComputedNativeRowsV1"]{let mut q=Document::default();q.extra_streams.push((path.into(),b"raw".to_vec()));assert!(payload(&q).is_err());}
+ }
+}
