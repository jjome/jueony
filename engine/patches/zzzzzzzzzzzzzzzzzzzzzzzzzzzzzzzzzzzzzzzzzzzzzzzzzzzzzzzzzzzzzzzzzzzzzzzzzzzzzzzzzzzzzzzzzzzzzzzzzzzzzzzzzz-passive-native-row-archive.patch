+//! Passive transport for one unconsumed native row-cache stream.
+//! The inner bytes are never parsed as rows, fonts, text, geometry or a lease.
+//! Imported valid Native envelopes normalize to the existing private AUX part;
+//! exports encode a new envelope and encrypt only that newly generated packet.
+use super::document::Document;
+use sha2::{Digest,Sha256};
+pub(crate) const ACTIVE: &str="/RhwpComputedNativeRowsV1";
+pub(crate) const ARCHIVE: &str="/RhwpArchivedNativeRowsV1";
+pub(crate) const ZIP: &str="META-INF/rhwp-opaque-native-row-stream-v1.bin";
+pub(crate) const LIMIT: usize=2*1024*1024;
+pub(crate) const ENVELOPE_LIMIT:usize=LIMIT+60;
+const MAGIC:&[u8;16]=b"RHWP-OPAQUE-ROW\0";
+const MAX_OWNERS:usize=4;
+fn error()->String{"Ambiguous, unsupported or oversized passive native-row archive".into()}
+fn key(path:&str)->String{
+ let slash=path.replace('\\',"/");let mut parts=Vec::new();
+ for p in slash.split('/') {match p {""|"."=>{},".."=>{parts.pop();},_=>parts.push(p)}}
+ parts.join("/").to_ascii_uppercase()
+}
+pub(crate) fn related(path:&str,target:&str)->bool{let p=key(path);let t=key(target);p==t||p.strip_prefix(&t).is_some_and(|v|v.starts_with('/'))}
+fn merge(out:&mut Option<Vec<u8>>,raw:&[u8],count:&mut usize)->Result<(),String>{
+ *count=count.checked_add(1).ok_or_else(error)?;
+ if *count>MAX_OWNERS||raw.len()>LIMIT{return Err(error());}
+ if out.as_ref().is_some_and(|old|old.as_slice()!=raw){return Err(error());}
+ if out.is_none(){*out=Some(raw.to_vec());}Ok(())
+}
+pub(crate) fn envelope(raw:&[u8])->Result<Vec<u8>,String>{
+ if raw.len()>LIMIT{return Err(error());}let mut out=Vec::with_capacity(60+raw.len());
+ out.extend(MAGIC);out.extend(1u32.to_le_bytes());out.extend((raw.len()as u64).to_le_bytes());out.extend(Sha256::digest(raw));out.extend(raw);Ok(out)
+}
+pub(crate) fn decode(bytes:&[u8])->Result<&[u8],String>{
+ if bytes.len()<60||bytes.len()>ENVELOPE_LIMIT||&bytes[..16]!=MAGIC||bytes[16..20]!=1u32.to_le_bytes(){return Err(error());}
+ let n=u64::from_le_bytes(bytes[20..28].try_into().map_err(|_|error())?);
+ if n>LIMIT as u64||bytes.len()!=60+n as usize{return Err(error());}
+ let raw=&bytes[60..];if bytes[28..60]!=Sha256::digest(raw)[..]{return Err(error());}Ok(raw)
+}
+/// Only exact bounded private owners may be combined. Equality is byte exact;
+/// a duplicate, alternate spelling or child cannot overwrite another payload.
+pub(crate) fn payload(doc:&Document)->Result<Option<Vec<u8>>,String>{
+ let mut out=None;let mut count=0;
+ for(path,raw)in &doc.extra_streams{
+  if related(path,ACTIVE){if path!=ACTIVE{return Err(error());}merge(&mut out,raw,&mut count)?;}
+  else if related(path,ARCHIVE){if path!=ARCHIVE{return Err(error());}merge(&mut out,decode(raw)?,&mut count)?;}
+ }
+ for(path,raw)in &doc.hwpx_aux_entries{if related(path,ZIP){if path!=ZIP{return Err(error());}merge(&mut out,raw,&mut count)?;}}
+ Ok(out)
+}
+/// A strict Native parser calls this only after the supported password/header
+/// and actual DocInfo/body parse succeeded. Invalid cipher/envelopes are an
+/// explicit refusal; they never become a normalized owner or enter a row decoder.
+pub(crate) fn restore_native(doc:&mut Document,password:Option<&[u8]>)->Result<(),String>{
+ let mut out=None;let mut count=0;
+ for(path,raw)in &doc.extra_streams{if related(path,ARCHIVE){
+  if path!=ARCHIVE||raw.len()>ENVELOPE_LIMIT{return Err(error());}
+  let plain=if doc.header.encrypted{let pwd=password.ok_or_else(error)?;crate::password_crypto::decrypt_hwp5_stream(raw,pwd)}else{raw.clone()};
+  merge(&mut out,decode(&plain)?,&mut count)?;
+ }}
+ if let Some(raw)=out{
+  for(path,value)in &doc.hwpx_aux_entries{if related(path,ZIP){if path!=ZIP{return Err(error());}merge(&mut Some(raw.clone()),value,&mut count)?;}}
+  // Validate coexistence with the original unconsumed active owner before
+  // changing this local parsed document. No old descriptor is interpreted.
+  for(path,value)in &doc.extra_streams{if related(path,ACTIVE){if path!=ACTIVE||value.as_slice()!=raw{return Err(error());}}}
+  doc.extra_streams.retain(|(path,_)|path!=ARCHIVE);
+  doc.hwpx_aux_entries.retain(|(path,_)|path!=ZIP);
+  doc.hwpx_aux_entries.push((ZIP.into(),raw));
+ }Ok(())
+}
+/// Work only on the serializer's extra-stream copy. Original model owners and
+/// every current physical/cache authorization remain untouched.
+pub(crate) fn prepare_native(doc:&Document,password:Option<&[u8]>,extra:&mut Vec<(String,Vec<u8>)>)->Result<(),String>{
+ let Some(raw)=payload(doc)? else{return Ok(());};
+ // An unconsumed original active stream remains exact opaque data. Do not
+ // relocate it merely to free the name for a new current descriptor. Any new
+ // current-row collision must continue to report a safe serialization loss.
+ if doc.extra_streams.iter().any(|(path,_)|path==ACTIVE){
+  extra.retain(|(path,_)|path!=ARCHIVE);return Ok(());
+ }
+ let plain=envelope(&raw)?;
+ let encoded=match password{Some(p)=>crate::password_crypto::encrypt_hwp5_stream(&plain,p),None=>plain};
+ extra.retain(|(path,_)|path!=ARCHIVE);extra.push((ARCHIVE.into(),encoded));Ok(())
+}
