+fn dependent_export_digest(paragraphs:&[Paragraph],projected_count:usize,
+    representation:TailExportRepresentation)->Option<[u8;32]> {
+ if projected_count==0 || projected_count>paragraphs.len(){return None;}
+ if matches!(representation,TailExportRepresentation::Original){return digest(&paragraphs);}
+ // Exactly the existing HWP5->HWPX absent-LINE_SEG marker materialization.
+ // A whole-stack plan admits only control-free plain tail paragraphs. Do not
+ // recurse into an unknown graph or normalize any authored/nonempty row.
+ let mut expected=paragraphs.to_vec();
+ for paragraph in expected.iter_mut().skip(projected_count) {
+  if !paragraph.controls.is_empty(){return None;}
+  if paragraph.line_segs.is_empty(){paragraph.line_segs.push(LineSeg::missing_lineseg_placeholder());}
+ }
+ digest(&expected)
+}
