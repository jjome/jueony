+/// Serde intentionally skips current layout inputs. Bind those explicitly.
+/// This narrowly supports body/table-cell stories; other nested story owners
+/// require their own complete input traversal and are refused, never guessed.
+fn source_layout_supplement(paragraphs:&[Paragraph],h:&mut BoundedHash)->Option<()>{
+ use crate::model::{control::Control,paragraph::{NumberingMarker,MarkerHead}};
+ use std::fmt::Write;
+ let mut pending:Vec<&Paragraph>=paragraphs.iter().rev().collect();let mut count=0usize;
+ while let Some(p)=pending.pop(){count=count.checked_add(1)?;if count>4096{return None;}
+  // Exhaustive binding ensures new Paragraph fields require an explicit decision.
+  let Paragraph{char_count:_,control_mask:_,para_shape_id:_,style_id:_,column_type:_,raw_break_type:_,page_break_synthesized:_,
+   text:_,char_offsets:_,char_shapes:_,line_segs:_,layout_space_metrics,hwpx_axis_shift:_,layout_only_fill_lines:_,
+   source_line_seg_vertical_pos,native_source_synthetic_seal,native_source_synthetic_context,completed_native_rows,
+   native_frame_observation:_,reset_flow_observation,range_tags:_,field_ranges:_,orphan_field_ends:_,controls,
+   ctrl_data_records:_,char_count_msb:_,raw_header_extra:_,has_para_text:_,tab_extended:_,title_marks:_,markpen_marks:_,
+   numbering_restart:_,stored_text_partition_dirty,cell_format_vpos_dirty,cell_vpos_reset,numbering_marker}=p;
+  // native_frame_observation is an allocator OUTPUT, not a formatting input.
+  // It is changed by the very pass being observed. It confers no authority here.
+  write!(h,"supplement-paragraph:{count}:{layout_space_metrics:?}:{source_line_seg_vertical_pos:?}:{native_source_synthetic_seal:?}:{native_source_synthetic_context:?}:{completed_native_rows:?}:{reset_flow_observation:?}:{stored_text_partition_dirty:?}:{cell_format_vpos_dirty:?}:{cell_vpos_reset:?}").ok()?;
+  match numbering_marker{
+   NumberingMarker::Unresolved=>write!(h,"marker-unresolved;").ok()?,
+   NumberingMarker::Absent=>write!(h,"marker-absent;").ok()?,
+   NumberingMarker::Text(text,head)=>{let MarkerHead{attr,width_adjust,text_distance,char_shape_id}=head;
+    serde_json::to_writer(&mut *h,&("marker-text",text,attr,width_adjust,text_distance,char_shape_id)).ok()?;}
+  }
+  if controls.len()>4096{return None;}
+  for c in controls.iter().rev(){match c{
+   Control::Table(t)=>{
+    write!(h,"table-raw-seal:{:?};",t.raw_ctrl_seal).ok()?;
+    if t.caption.as_ref().is_some_and(|c|!c.paragraphs.is_empty()){return None;}
+    for cell in t.cells.iter().rev(){if cell.paragraphs.len()>4096usize.saturating_sub(pending.len()){return None;}
+     pending.extend(cell.paragraphs.iter().rev());}
+   },
+   Control::SectionDef(d)=>if !d.master_pages.is_empty(){return None;},
+   Control::Shape(_)|Control::Picture(_)|Control::Header(_)|Control::Footer(_)|Control::Footnote(_)|Control::Endnote(_)|Control::HiddenComment(_)=>return None,
+   Control::Field(f)=>{if !f.memo_paragraphs.is_empty(){return None;}write!(h,"field-layout:{f:?}").ok()?;},
+   // These variants contain no nested Paragraph. Debug is derived and retains
+   // their Serde-skipped raw seals. NumberingMarker's custom Debug is never used.
+   Control::ColumnDef(_)|Control::AutoNumber(_)|Control::NewNumber(_)|Control::PageNumberPos(_)|Control::Bookmark(_)|Control::IndexMark(_)
+   |Control::PageNumCtrl(_)|Control::Hyperlink(_)|Control::Ruby(_)|Control::CharOverlap(_)|Control::PageHide(_)|Control::Equation(_)|Control::Form(_)|Control::Unknown(_)=>write!(h,"leaf-control:{c:?}").ok()?,
+  }}
+ }
+ Some(())
+}
