+#[derive(Debug,Clone,Serialize)]
+pub struct SelectedCompositionReport {
+ pub cookie:[u8;32],pub formats:Vec<SelectedFormatFact>,pub commits:Vec<CommitFact>,
+ pub tables:Vec<TableAcceptedFact>,pub whole_tables:Vec<WholeTableAcceptedFact>,
+ pub finalizations:Vec<FinalizationFact>,pub encoded_bytes:usize,
+ pub overflowed:bool,pub unsupported_observed:bool,pub nested_rejected:bool,
+ pub not_an_export_permission:bool,
+}
+struct Active {scope:u64,report:SelectedCompositionReport}
+thread_local! {
+ static ACTIVE:RefCell<Option<Active>>=const {RefCell::new(None)};
+ static NEXT_SCOPE:Cell<u64>=const {Cell::new(0)};
+ static NEXT_PASS:Cell<u64>=const {Cell::new(0)};
+ static RUNTIME_DEPTH:Cell<usize>=const {Cell::new(0)};
+}
+struct Scope;
+impl Drop for Scope {fn drop(&mut self){ACTIVE.with(|a|{if let Ok(mut a)=a.try_borrow_mut(){*a=None;}})}}
+pub fn capture_diagnostic_only<T>(cookie:[u8;32],run:impl FnOnce()->T)->Result<(T,SelectedCompositionReport),&'static str>{
+ let scope=NEXT_SCOPE.with(|n|n.get().checked_add(1).map(|v|{n.set(v);v})).ok_or("scope sequence exhausted")?;
+ let started=ACTIVE.with(|a|{let Ok(mut a)=a.try_borrow_mut()else{return false;};
+  if let Some(a)=a.as_mut(){a.report.nested_rejected=true;return false;}
+  *a=Some(Active{scope,report:SelectedCompositionReport{cookie,formats:vec![],commits:vec![],tables:vec![],whole_tables:vec![],finalizations:vec![],encoded_bytes:0,
+   overflowed:false,unsupported_observed:false,nested_rejected:false,not_an_export_permission:true}});true});
+ if !started{return Err("nested or reentrant observation");}
+ let guard=Scope;let result=run();
+ let report=ACTIVE.with(|a|a.try_borrow_mut().ok().and_then(|mut a|a.take())).ok_or("observation scope lost")?.report;
+ drop(guard);Ok((result,report))
+}
+fn charge<T:Serialize>(r:&mut SelectedCompositionReport,value:&T)->bool{
+ let Ok(bytes)=serde_json::to_vec(value)else{r.unsupported_observed=true;return false;};
+ if bytes.len()>MAX_BYTES.saturating_sub(r.encoded_bytes){r.overflowed=true;return false;}
+ r.encoded_bytes+=bytes.len();true
+}
+fn run_fact(run:&ComposedTextRun)->RunFact{
+ let ComposedTextRun{text,char_style_id,lang_index,char_overlap,footnote_marker,display_text,
+  supplemental_metrics_blocked,inserted_control_text,space_metric}=run;
+ RunFact{text:text.clone(),display_text:display_text.clone(),char_style_id:*char_style_id,language:*lang_index,
+  overlap:char_overlap.as_ref().map(|v|(v.border_type,v.inner_char_size)),footnote_marker:*footnote_marker,
+  supplemental_metrics_blocked:*supplemental_metrics_blocked,inserted_control_text:*inserted_control_text,
+  space_metric:match space_metric{super::composer::SpaceMetric::Stored=>"Stored",super::composer::SpaceMetric::HancomRegenerated=>"HancomRegenerated",
+   super::composer::SpaceMetric::HalfCell=>"HalfCell",super::composer::SpaceMetric::KoPubJustified=>"KoPubJustified"},
+  scalars:text.chars().count(),utf16_units:text.encode_utf16().count()}
+}
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn selected(para:&Paragraph,composition:Option<&ComposedParagraph>,width:Option<f64>,dpi:f64,
+ recomposed:bool,context:Option<[u8;32]>,profile:LayoutCompatibilityProfile,heights:&[f64],spacings:&[f64],
+ before:f64,after:f64,total:f64,fit:f64,square:bool)->Option<SelectedObservationHandle>{
+ if RUNTIME_DEPTH.with(|d|d.get())!=1{return None;}
+ ACTIVE.with(|a|{let Ok(mut a)=a.try_borrow_mut()else{return None;};let active=a.as_mut()?;let r=&mut active.report;
+  if r.overflowed||r.unsupported_observed{return None;}if r.formats.len()>=MAX_FORMATS{r.overflowed=true;return None;}
+  let composition=composition?;
+  if para.text.len()>MAX_TEXT || para.char_offsets.len()>MAX_TEXT || composition.lines.len()>4096 || heights.len()>4096 || spacings.len()>4096
+   || composition.inline_controls.len()>4096 || composition.tac_controls.len()>4096 || composition.footnote_positions.len()>4096 || composition.tab_extended.len()>4096
+   || !dpi.is_finite() || width.is_some_and(|w|!w.is_finite()) || [before,after,total,fit].iter().chain(heights).chain(spacings).any(|v|!v.is_finite()){
+   r.unsupported_observed=true;return None;}
+  let mut text_budget=MAX_TEXT;let mut run_budget=16384usize;
+  for line in &composition.lines {let Some(left)=run_budget.checked_sub(line.runs.len())else{r.overflowed=true;return None;};run_budget=left;if line.runs.len()>256{r.unsupported_observed=true;return None;}
+   for run in &line.runs {for text in [Some(&run.text),run.display_text.as_ref()].into_iter().flatten(){
+    let Some(next)=text_budget.checked_sub(text.len())else{r.overflowed=true;return None;};text_budget=next;}}}
+  let source_chars=para.text.chars().collect::<Vec<_>>();let mut utf16=Vec::with_capacity(source_chars.len()+1);utf16.push(0u32);
+  for c in &source_chars {utf16.push(utf16.last().copied()?.checked_add(c.len_utf16() as u32)?);}
+  let mut lines=vec![];
+  for line in &composition.lines {
+   let runs=line.runs.iter().map(run_fact).collect::<Vec<_>>();let count=runs.iter().try_fold(0usize,|n,r|n.checked_add(r.scalars));
+   let end=count.and_then(|n|line.char_start.checked_add(n));
+   let source_match=end.is_some_and(|end|end<=source_chars.len() && line.runs.iter().all(|r|!r.inserted_control_text)
+    && line.runs.iter().flat_map(|r|r.text.chars()).eq(source_chars.get(line.char_start..end).unwrap_or(&[]).iter().copied()));
+   lines.push(LineFact{scalar_start:line.char_start,scalar_end:end,unicode_utf16_start:utf16.get(line.char_start).copied(),
+    unicode_utf16_end:end.and_then(|i|utf16.get(i).copied()),original_hwp_char_offset:para.char_offsets.get(line.char_start).copied(),
+    exact_source_text_span:source_match,height_hu:line.line_height,baseline_hu:line.baseline_distance,width_hu:line.segment_width,
+    column_start_hu:line.column_start,spacing_hu:line.line_spacing,has_line_break:line.has_line_break,runs});
+  }
+  let id=r.formats.len();let fact=SelectedFormatFact{observation_id:id,paragraph_token:para as *const Paragraph as usize,actual_input_width_px:width,dpi,
+   selected_recomposition:recomposed,definition_context:context,profile:format!("{profile:?}"),source_text:para.text.clone(),source_char_offsets:para.char_offsets.clone(),
+   source_row_count:para.line_segs.len(),paragraph_style:composition.para_style_id,lines,actual_heights:heights.to_vec(),actual_spacings:spacings.to_vec(),
+   before,after,total,fit_height:fit,inline_controls:composition.inline_controls.iter().map(|c|(c.line_index,c.control_index,format!("{:?}",c.control_type))).collect(),
+   tac_controls:composition.tac_controls.clone(),footnote_positions:composition.footnote_positions.clone(),tab_extended:composition.tab_extended.clone(),
+   has_numbering:composition.numbering_text.is_some(),has_horizontal_shaping:composition.horizontal_shaping.is_some(),known_square_band:square,
+   observed_not_fresh_or_authorized:true};
+  if !charge(r,&fact){return None;}r.formats.push(fact);Some(SelectedObservationHandle{scope:active.scope,index:id})
+ })
+}
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn commit(handle:Option<SelectedObservationHandle>,para:&Paragraph,section:usize,page:Option<u32>,column:u16,index:usize,
+ start:usize,end:usize,flow_before:f64,flow_after:f64,advance:f64,available:Option<f64>,cumulative:Option<f64>,trimmed:f64,
+ width:f64,multicol:bool,heights:&[f64],spacings:&[f64],before:f64,after:f64,total:f64,fit:f64,items:&[PageItem]){
+ if RUNTIME_DEPTH.with(|d|d.get())!=1{return;}
+ let Some(handle)=handle else{return;};ACTIVE.with(|a|{let Ok(mut a)=a.try_borrow_mut()else{return;};let Some(a)=a.as_mut()else{return;};
+  if a.scope!=handle.scope{return;}let r=&mut a.report;if r.overflowed{return;}
+  if r.commits.len()>=MAX_COMMITS{r.overflowed=true;return;}
+  let Some(format)=r.formats.get(handle.index)else{r.unsupported_observed=true;return;};
+  let indices=items.iter().enumerate().filter_map(|(i,item)|match item{
+   PageItem::FullParagraph{para_index}if *para_index==index&&start==0=>Some(i),
+   PageItem::PartialParagraph{para_index,start_line,end_line}if *para_index==index&&*start_line==start&&*end_line==end=>Some(i),_=>None}).collect::<Vec<_>>();
+  let fact=CommitFact{format_id:handle.index,section,page,column,paragraph:index,paragraph_token_matches:format.paragraph_token==para as *const Paragraph as usize,
+   row_start:start,row_end:end,flow_before,flow_after,advance,available_for_rows:available,cumulative_fit:cumulative,trimmed_before:trimmed,
+   actual_column_width_px:width,reused_multicolumn_format:multicol,
+   same_format_reused_after_slot_change:r.commits.iter().any(|c|c.format_id==handle.index&&(c.page!=page||c.column!=column)),
+   metrics_still_match_selected_format:format.actual_heights==heights&&format.actual_spacings==spacings
+    &&format.before==before&&format.after==after&&format.total==total&&format.fit_height==fit,
+   range_inside_selected_composition:start<end&&end<=format.lines.len(),committed_item_index:(indices.len()==1).then(||indices[0]),
+   final_membership:None,finalization_index:None,not_physical_y:true};
+  if [flow_before,flow_after,advance,trimmed,width].iter().any(|x|!x.is_finite()) || available.is_some_and(|x|!x.is_finite()) || cumulative.is_some_and(|x|!x.is_finite()){
+   r.unsupported_observed=true;return;}
+  if charge(r,&fact){r.commits.push(fact);}
+ });
+}
+pub(crate) fn finalize(section:usize,result:&PaginationResult){ACTIVE.with(|a|{
+ let Ok(mut a)=a.try_borrow_mut()else{return;};let Some(a)=a.as_mut()else{return;};let r=&mut a.report;if r.overflowed{return;}
+ if r.finalizations.len()>=4096{r.overflowed=true;return;}
+ let finalization=r.finalizations.len();let mut checked=0usize;let mut exact=true;
+ for c in r.commits.iter_mut().filter(|c|c.section==section&&c.finalization_index.is_none()){
+  let item=c.page.and_then(|p|result.pages.iter().find(|page|page.page_index==p)).and_then(|page|page.column_contents.iter().find(|cc|cc.column_index==c.column))
+   .and_then(|cc|c.committed_item_index.and_then(|i|cc.items.get(i)));
+  let matched=item.is_some_and(|item|match item{
+   PageItem::FullParagraph{para_index}=>*para_index==c.paragraph&&c.row_start==0,
+   PageItem::PartialParagraph{para_index,start_line,end_line}=>*para_index==c.paragraph&&*start_line==c.row_start&&*end_line==c.row_end,_=>false});
+  c.final_membership=Some(matched);c.finalization_index=Some(finalization);checked+=1;exact&=matched;
+ }
+ for c in r.tables.iter_mut().filter(|c|c.section==section&&c.finalization_index.is_none()){
+  let item=c.page.and_then(|p|result.pages.iter().find(|page|page.page_index==p)).and_then(|page|page.column_contents.iter().find(|cc|cc.column_index==c.column))
+   .and_then(|cc|c.committed_item_index.and_then(|i|cc.items.get(i)));
+  let matched=matches!(item,Some(PageItem::Table{para_index,control_index})if *para_index==c.paragraph&&*control_index==c.control);
+  c.final_membership=Some(matched);c.finalization_index=Some(finalization);checked+=1;exact&=matched;
+ }
+ for c in r.whole_tables.iter_mut().filter(|c|c.section==section&&c.finalization_index.is_none()){
+  let item=c.page.and_then(|p|result.pages.iter().find(|page|page.page_index==p)).and_then(|page|page.column_contents.iter().find(|cc|cc.column_index==c.column))
+   .and_then(|cc|cc.items.get(c.committed_item_index));
+  let matched=matches!(item,Some(PageItem::Table{para_index,control_index})if *para_index==c.paragraph&&*control_index==c.control);
+  c.final_membership=Some(matched);c.finalization_index=Some(finalization);checked+=1;exact&=matched;
+ }
+ let fact=FinalizationFact{section,pages:result.pages.len(),commits_checked:checked,all_membership_exact:exact};
+ if charge(r,&fact){r.finalizations.push(fact);}
+ });}
