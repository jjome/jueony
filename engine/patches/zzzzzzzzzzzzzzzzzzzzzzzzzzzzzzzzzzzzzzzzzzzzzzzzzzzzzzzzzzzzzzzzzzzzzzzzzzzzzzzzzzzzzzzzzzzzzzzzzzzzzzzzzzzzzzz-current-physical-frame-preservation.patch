+//! Private general current-frame export plan. Construction is owned by this
+//! module's current fresh-composition/allocation/physical-frame proof, never by
+//! a file descriptor, external JSON, old row lease, or arbitrary caller rows.
+//! The producer is limited to exact current single-column whole body/table frames.
+use crate::model::{document::Document,paragraph::LineSeg};
+pub(crate) struct CurrentFrameRowsPlan<'doc>{
+ source:&'doc Document,
+ resource:[u8;32],
+ allocation_generation:[u8;32],
+ paragraphs:Vec<CurrentFrameParagraphRows>,
+}
+pub(crate) struct CurrentFrameParagraphRows{
+ section:usize,
+ paragraph:usize,
+ rows:Vec<LineSeg>,
+}
+impl CurrentFrameRowsPlan<'_>{
+ pub(crate) fn owns_document(&self,source:&Document)->bool{std::ptr::eq(self.source,source)}
+ pub(crate) fn resource(&self)->[u8;32]{self.resource}
+ pub(crate) fn allocation_generation(&self)->[u8;32]{self.allocation_generation}
+ pub(crate) fn paragraph_rows(&self)->&[CurrentFrameParagraphRows]{&self.paragraphs}
+}
+impl CurrentFrameParagraphRows{
+ pub(crate) fn section_index(&self)->usize{self.section}
+ pub(crate) fn paragraph_index(&self)->usize{self.paragraph}
+ pub(crate) fn rows(&self)->&[LineSeg]{&self.rows}
+}
+
+
+/// Generic fresh standard rows for one actual body frame. This helper is not a
+/// plan constructor: accepted allocator and complete physical closure remain
+/// mandatory at the caller. It never reads a source row as output geometry.
+struct FreshBodyRows { rows:Vec<LineSeg>, composition:super::composer::ComposedParagraph }
+fn fresh_body_rows(p:&crate::model::paragraph::Paragraph,styles:&super::style_resolver::ResolvedStyleSet,
+ width:f64,dpi:f64)->Option<FreshBodyRows>{
+ use crate::model::control::Control;
+ use super::composer::{compose_paragraph_in_context,reflow_line_segs,ParagraphBox};
+ if p.text.len()>64*1024 || p.char_shapes.is_empty() || p.char_shapes.len()>128
+  || p.char_shapes.windows(2).any(|s|s[0].start_pos>=s[1].start_pos)
+  || p.char_shapes.iter().any(|s|s.char_shape_id as usize>=styles.char_styles.len()) || p.char_offsets.len()>64*1024
+  || p.text.contains(['\t','\n','\r','\u{fffc}']) || !width.is_finite() || width<=0.0
+  || dpi!=super::DEFAULT_DPI || !p.field_ranges.is_empty() || !p.range_tags.is_empty()
+  || !p.orphan_field_ends.is_empty() || !p.tab_extended.is_empty() || p.numbering_restart.is_some()
+  || p.layout_only_fill_lines!=0 || p.cell_format_vpos_dirty
+  || !p.markpen_marks.is_empty() || !p.title_marks.is_empty()
+  || p.controls.iter().any(|c|!matches!(c,Control::SectionDef(_)|Control::ColumnDef(_)))
+  || p.ctrl_data_records.iter().any(Option::is_some) {return None;}
+ let start=match p.controls.as_slice(){[]=>0u32,[Control::SectionDef(_),Control::ColumnDef(_)]=>16u32,_=>return None};
+ let mut offset=start;
+ if p.char_offsets.len()!=p.text.chars().count(){return None;}
+ for (ch,at) in p.text.chars().zip(&p.char_offsets){if *at!=offset{return None;}offset=offset.checked_add(ch.len_utf16() as u32)?;}
+ if p.char_count!=offset.checked_add(1)? {return None;}
+ let style=styles.para_styles.get(usize::from(p.para_shape_id))?;
+ if style.margin_left!=0.0 || style.margin_right!=0.0 || style.indent!=0.0 || style.spacing_before!=0.0
+  || style.spacing_after!=0.0 || style.keep_lines || style.keep_with_next || style.page_break_before
+  || !matches!(style.head_type,crate::model::style::HeadType::None)
+  || style.border_connect || style.border_spacing.iter().any(|v|*v!=0.0) {return None;}
+ if style.border_fill_id!=0 {let border=styles.border_styles.get(usize::from(style.border_fill_id.checked_sub(1)?))?;
+  if border.borders.iter().any(|b|!matches!(b.line_type,crate::model::style::BorderLineType::None))
+   || border.fill_color.is_some() || border.pattern.is_some() || border.gradient.is_some() || border.image_fill.is_some()
+   || border.diagonal_attr!=0 || !matches!(border.center_line,crate::model::style::CenterLine::None){return None;}}
+ if styles.supplemental_metrics.is_some() || styles.kerning_measurement_context.is_some()
+  || styles.horizontal_shaping_context.is_some(){return None;}
+ // Prove the existing generic breaker's i32 metric arithmetic cannot overflow
+ // before invoking it; this is not a layout tolerance or a font substitution.
+ if !style.line_spacing.is_finite()||style.line_spacing<0.0{return None;}
+ for shape in &p.char_shapes {let cs=styles.char_styles.get(shape.char_shape_id as usize)?;
+  let hu=cs.font_size*7200.0/dpi;
+  let upper=hu*(2.0+style.line_spacing.abs())+style.line_spacing.abs()*7200.0/dpi;
+  if !hu.is_finite()||hu<=0.0||!upper.is_finite()||upper>f64::from(i32::MAX)/8.0{return None;}}
+ let mut fresh=p.clone();fresh.line_segs.clear();fresh.layout_space_metrics.clear();
+ fresh.source_line_seg_vertical_pos=None;fresh.hwpx_axis_shift=0;
+ fresh.native_source_synthetic_seal=None;fresh.native_source_synthetic_context=None;
+ fresh.completed_native_rows=None;fresh.native_frame_observation.set(None);
+ let frame=ParagraphBox::content_for_style(width,Some(style),dpi);
+ reflow_line_segs(&mut fresh,frame,styles,dpi);
+ if fresh.line_segs.is_empty() || fresh.line_segs.len()>4096{return None;}
+ let mut end=0i32;
+ for row in &fresh.line_segs {if row.vertical_pos!=end || row.line_height<=0 || row.text_height!=row.line_height
+  || row.line_spacing<0 || row.baseline_distance<0 || row.baseline_distance>row.line_height
+  || row.column_start!=0 || row.tag!=(LineSeg::TAG_SINGLE_SEGMENT_LINE|LineSeg::TAG_IMPLEMENTATION_PROPERTY) {return None;}
+  end=end.checked_add(row.line_height)?.checked_add(row.line_spacing)?;}
+ let composition=compose_paragraph_in_context(&fresh,styles);
+ if composition.numbering_text.is_some() || !composition.tac_controls.is_empty() || !composition.footnote_positions.is_empty()
+  || !composition.tab_extended.is_empty() || composition.horizontal_shaping.is_some(){return None;}
+ Some(FreshBodyRows{rows:fresh.line_segs,composition})
+}
+fn same_selected_line(a:&super::composer::ComposedLine,b:&super::composer::ComposedLine)->bool{
+ a.char_start==b.char_start && a.line_height==b.line_height && a.baseline_distance==b.baseline_distance
+ && a.segment_width==b.segment_width && a.column_start==b.column_start && a.line_spacing==b.line_spacing
+ && !a.has_line_break && !b.has_line_break && a.runs.len()==b.runs.len()
+ && a.runs.iter().zip(&b.runs).all(|(a,b)|a.text==b.text && a.char_style_id==b.char_style_id
+  && a.lang_index==b.lang_index && a.char_overlap.is_none() && b.char_overlap.is_none()
+  && a.footnote_marker.is_none() && b.footnote_marker.is_none() && a.display_text.is_none() && b.display_text.is_none()
+  && a.supplemental_metrics_blocked==b.supplemental_metrics_blocked && !a.inserted_control_text && !b.inserted_control_text
+  && a.space_metric==b.space_metric)
+}
+
+/// Candidate from this completed allocator pass, before any paint receipt.
+/// Neither this type nor its paint facade is a serialized cache/row authority.
+struct CandidateBody { paragraph:usize,physical_y:f64,fresh:FreshBodyRows,allow_empty_unused_width:bool }
+#[derive(Debug,Clone)]struct CandidateTable {paragraph:usize,control:usize,top:f64,before:f64,body:f64,after:f64}
+#[derive(Debug,Clone)]pub(crate) struct CurrentFramePaintPlan { source_paragraphs:usize,generation:[u8;32],section:usize,page:u32,column:u16,
+ rect:super::page_layout::LayoutRect,tables:Vec<CandidateTable> }
+impl CurrentFramePaintPlan {
+ pub(crate) fn receipt_binding(&self)->(usize,[u8;32]){(self.source_paragraphs,self.generation)}
+ pub(crate) fn table_top(&self,paragraphs:&[crate::model::paragraph::Paragraph],section:usize,page:u32,column:u16,
+ rect:&super::page_layout::LayoutRect,paragraph:usize,control:usize,flow:f64)->Option<f64>{
+  if paragraphs.as_ptr() as usize!=self.source_paragraphs || section!=self.section || page!=self.page || column!=self.column
+   || self.rect.x!=rect.x || self.rect.y!=rect.y || self.rect.width!=rect.width || self.rect.height!=rect.height {return None;}
+  let host=self.tables.iter().find(|h|h.paragraph==paragraph&&h.control==control)?;
+  arithmetic_equal(flow,host.top).then_some(host.top)
+ }
+}
+pub(crate) struct CurrentFrameCandidate<'doc> {source:&'doc Document,paint:CurrentFramePaintPlan,
+ bodies:Vec<CandidateBody>,tables:Vec<CandidateTable>,rows:Vec<CurrentFrameParagraphRows>,generation:[u8;32]}
+fn arithmetic_equal(a:f64,b:f64)->bool{a.is_finite()&&b.is_finite()&&(a-b).abs()<=f64::EPSILON*a.abs().max(b.abs()).max(1.0)*16.0}
+fn integer_hu(px:f64,dpi:f64)->Option<i32>{if !px.is_finite()||!dpi.is_finite()||dpi<=0.0{return None;}let v=px*7200.0/dpi;
+ let n=v.round();if n<i32::MIN as f64||n>i32::MAX as f64||!arithmetic_equal(v,n){return None;}Some(n as i32)}
+fn same_empty_line_ignoring_unused_width(a:&super::composer::ComposedLine,b:&super::composer::ComposedLine)->bool{
+ a.runs.iter().all(|r|r.text.is_empty()&&r.display_text.is_none()&&!r.inserted_control_text)
+ && b.runs.iter().all(|r|r.text.is_empty()&&r.display_text.is_none()&&!r.inserted_control_text)
+ && a.char_start==b.char_start && a.line_height==b.line_height && a.baseline_distance==b.baseline_distance
+ && a.column_start==b.column_start && a.line_spacing==b.line_spacing && !a.has_line_break && !b.has_line_break
+ && a.runs.len()==b.runs.len() && a.runs.iter().zip(&b.runs).all(|(a,b)|a.char_style_id==b.char_style_id&&a.lang_index==b.lang_index
+ &&a.space_metric==b.space_metric&&a.supplemental_metrics_blocked==b.supplemental_metrics_blocked
+ &&a.char_overlap.is_none()&&b.char_overlap.is_none()&&a.footnote_marker.is_none()&&b.footnote_marker.is_none())
+}
+fn fact_line_matches(f:&super::selected_composition_observer127::LineFact,l:&super::composer::ComposedLine,empty_width:bool)->bool{
+ use super::composer::SpaceMetric;
+ f.exact_source_text_span && f.scalar_start==l.char_start && f.height_hu==l.line_height && f.baseline_hu==l.baseline_distance
+ && (f.width_hu==l.segment_width||empty_width) && f.column_start_hu==l.column_start && f.spacing_hu==l.line_spacing
+ && !f.has_line_break && !l.has_line_break && f.runs.len()==l.runs.len()
+ && f.runs.iter().zip(&l.runs).all(|(a,b)|a.text==b.text&&a.display_text.is_none()&&b.display_text.is_none()
+  &&a.char_style_id==b.char_style_id&&a.language==b.lang_index&&a.overlap.is_none()&&b.char_overlap.is_none()
+  &&a.footnote_marker.is_none()&&b.footnote_marker.is_none()&&a.supplemental_metrics_blocked==b.supplemental_metrics_blocked
+  &&!a.inserted_control_text&&!b.inserted_control_text&&a.space_metric==match b.space_metric{SpaceMetric::Stored=>"Stored",
