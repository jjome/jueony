+pub(crate) fn table_commit(mut fact:TableAcceptedFact,items:&[PageItem]){
+ if RUNTIME_DEPTH.with(|d|d.get())!=1{return;}
+ ACTIVE.with(|a|{let Ok(mut a)=a.try_borrow_mut()else{return;};let Some(a)=a.as_mut()else{return;};let r=&mut a.report;
+  if r.overflowed{return;}if r.tables.len()>=MAX_COMMITS{r.overflowed=true;return;}
+  let finite=[fact.before,fact.body_height,fact.after_for_fit,fact.raw_top,fact.reserved_height,fact.x_start,fact.x_end,
+   fact.lane_pushed_top,fact.paragraph_start,fact.flow_before,fact.flow_after].iter().all(|v|v.is_finite())
+   &&fact.actually_queried_available.is_none_or(|v|v.is_finite())
+   &&fact.resolved.as_ref().is_none_or(|p|[p.anchor_y,p.table_top,p.occupied_bottom].iter().all(|v|v.is_finite())
+    &&[p.next_flow_y,p.stored_host_origin,p.stored_successor_origin,p.table_left].iter().all(|v|v.is_none_or(|v|v.is_finite())));
+  if !finite{r.unsupported_observed=true;return;}
+  let indices=items.iter().enumerate().filter_map(|(i,item)|matches!(item,PageItem::Table{para_index,control_index}
+   if *para_index==fact.paragraph&&*control_index==fact.control).then_some(i)).collect::<Vec<_>>();
+  fact.committed_item_index=(indices.len()==1).then(||indices[0]);
+  if charge(r,&fact){r.tables.push(fact);}
+ });
+}
