+/// Immutable facts produced by one actual allocator pass. No deserializer or
+/// public constructor exists. This is not a row lease or export permission:
+/// consumers must still prove actual paint, UTF16, metrics and physical frames.
+#[derive(Debug)]
+pub(crate) struct FinalizedSelectedCompositionTrace {
+ generation:u64,section:usize,resource:[u8;32],source:[u8;32],final_frame:[u8;32],
+ formats:Vec<SelectedFormatFact>,commits:Vec<CommitFact>,
+ tables:Vec<TableAcceptedFact>,whole_tables:Vec<WholeTableAcceptedFact>,
+}
+impl FinalizedSelectedCompositionTrace {
+ pub(crate) fn generation(&self)->u64{self.generation}
