+ pub(crate) available_width:f64,pub(crate) margin_left:f64,pub(crate) margin_right:f64,
+ pub(crate) inline_offset:f64,pub(crate) numbering_offset:f64,pub(crate) physical_text_y:f64,
+ pub(crate) final_line_box_height:f64,pub(crate) baseline:f64,pub(crate) physical_frame_rows:bool,
+ pub(crate) stored_horizontal_span_used:bool,pub(crate) has_wrap_anchor:bool,pub(crate) equation_adjusted:bool,
+}
+#[derive(Debug,Clone)]
+pub(crate) struct BodyRowSelection {pub(crate) frame:BodyRowFrame,pub(crate) selected:ComposedLine}
+#[derive(Debug,Clone)]
+pub(crate) struct WholeTableSelection {
+ pub(crate) node:NodeId,pub(crate) paragraph:usize,pub(crate) control:usize,
+ pub(crate) incoming_y:f64,pub(crate) paragraph_y:f64,pub(crate) selected_y:f64,
+ pub(crate) selected_outer_inset:f64,pub(crate) visual_height:f64,pub(crate) visual_end:f64,
+ pub(crate) flow_end:f64,pub(crate) lane_input:Option<[f64;6]>,pub(crate) typed_float:bool,
+ pub(crate) inline:bool,pub(crate) treat_as_char:bool,
+}
+#[derive(Debug,Clone,Default)]
+pub(crate) struct CurrentPhysicalSelections {
+ frames:Vec<BodyFrameSelection>,rows:Vec<BodyRowSelection>,tables:Vec<WholeTableSelection>,
+ text_bytes:usize,item_count:usize,invalid:bool,enabled:bool,
+ source_frame_binding:Option<(usize,[u8;32])>,
+}
+impl CurrentPhysicalSelections {
+ pub(crate) fn enable_new_page_capture(&mut self){if self.frames.is_empty() && self.rows.is_empty() && self.tables.is_empty() && !self.invalid {self.enabled=true;}}
+ pub(crate) fn bind_current_plan(&mut self,plan:&super::current_frame_rows_plan::CurrentFramePaintPlan){
+  if !self.enabled || self.invalid || self.source_frame_binding.is_some() || !self.frames.is_empty() {self.invalid=true;return;}
+  self.source_frame_binding=Some(plan.receipt_binding());
+ }
+ pub(crate) fn matches_current_plan(&self,plan:&super::current_frame_rows_plan::CurrentFramePaintPlan)->bool{
+  self.enabled && !self.invalid && self.source_frame_binding==Some(plan.receipt_binding())
+ }
+ pub(crate) fn frames(&self)->Option<&[BodyFrameSelection]>{(self.enabled && !self.invalid && self.frames.iter().all(|f|f.complete)).then_some(&self.frames)}
+ pub(crate) fn rows(&self)->Option<&[BodyRowSelection]>{self.frames()?;Some(&self.rows)}
+ pub(crate) fn tables(&self)->Option<&[WholeTableSelection]>{self.frames()?;Some(&self.tables)}
+ pub(crate) fn register_frame(&mut self,node:NodeId,page:&PageContent,column:&ColumnContent,rect:&LayoutRect){
+  if !self.enabled || self.invalid{return;}let Some(ordinal)=page.column_contents.iter().position(|c|std::ptr::eq(c,column))else{self.invalid=true;return;};
+  if self.frames.len()>=128 || column.items.len()>4096-self.item_count || self.frames.iter().any(|f|f.node==node)
+   || [rect.x,rect.y,rect.width,rect.height,column.zone_y_offset].iter().any(|v|!v.is_finite())
+   || rect.width<=0.0 || rect.height<=0.0 || column.items.iter().any(|i|matches!(i,PageItem::PartialTable{start_cut,end_cut,..} if start_cut.len()>64 || end_cut.len()>64)){
+   self.invalid=true;return;
+  }
+  self.item_count+=column.items.len();
+  self.frames.push(BodyFrameSelection{node,section:page.section_index,page:page.page_index,column_ordinal:ordinal,column:column.column_index,
+   rect:*rect,zone_y:column.zone_y_offset,has_zone:column.zone_layout.is_some(),items:column.items.clone(),complete:false});
+ }
+ pub(crate) fn finish_frame(&mut self,node:NodeId){if let Some(frame)=self.frames.iter_mut().find(|f|f.node==node){frame.complete=true;}}
+ pub(crate) fn record_row(&mut self,row:BodyRowFrame,selected:&ComposedLine){
+  if !self.enabled || self.invalid || !self.frames.iter().any(|f|f.node==row.node){return;}
+  let Some(bytes)=selected.runs.iter().try_fold(0usize,|sum,r|sum.checked_add(r.text.len())?.checked_add(r.display_text.as_ref().map_or(0,String::len)))else{self.invalid=true;return;};
+  if self.rows.len()>=4096 || selected.runs.len()>256 || bytes>2*1024*1024-self.text_bytes
+   || [row.effective_column_x,row.effective_column_width,row.available_width,row.margin_left,row.margin_right,row.inline_offset,row.numbering_offset,row.physical_text_y,row.final_line_box_height,row.baseline].iter().any(|v|!v.is_finite()){
+   self.invalid=true;return;
+  }
+  self.text_bytes+=bytes;self.rows.push(BodyRowSelection{frame:row,selected:selected.clone()});
+ }
+ pub(crate) fn record_table(&mut self,table:WholeTableSelection){
+  if !self.enabled || self.invalid || !self.frames.iter().any(|f|f.node==table.node){return;}
+  if self.tables.len()>=1024 || [table.incoming_y,table.paragraph_y,table.selected_y,table.selected_outer_inset,table.visual_height,table.visual_end,table.flow_end].iter().any(|v|!v.is_finite())
+   || table.lane_input.as_ref().is_some_and(|v|v.iter().any(|v|!v.is_finite())){self.invalid=true;return;}
+  self.tables.push(table);
+ }
+}
