+pub(crate) fn whole_table_commit(handle:Option<SelectedObservationHandle>,mut fact:WholeTableAcceptedFact){
+ if RUNTIME_DEPTH.with(|d|d.get())!=1{return;}
+ ACTIVE.with(|a|{let Ok(mut a)=a.try_borrow_mut()else{return;};let Some(active)=a.as_mut()else{return;};let r=&mut active.report;
+  if r.overflowed{return;}if r.whole_tables.len()>=MAX_COMMITS{r.overflowed=true;return;}
+  if [fact.table_total_height,fact.before,fact.body_height,fact.after_for_fit,fact.paragraph_start,fact.flow_before,fact.flow_after,fact.pre_text_height].iter().any(|v|!v.is_finite())
+   ||fact.resolved.as_ref().is_some_and(|p|[p.anchor_y,p.table_top,p.occupied_bottom].iter().any(|v|!v.is_finite())
+    ||[p.next_flow_y,p.stored_host_origin,p.stored_successor_origin,p.table_left].iter().any(|v|v.is_some_and(|v|!v.is_finite()))){
+   r.unsupported_observed=true;return;}
+  fact.selected_format_id=handle.filter(|h|h.scope==active.scope).and_then(|h|r.formats.get(h.index).filter(|f|f.paragraph_token==fact.paragraph_token).map(|_|h.index));
+  if charge(r,&fact){r.whole_tables.push(fact);}
+ });
+}
