+struct BoundedHash {hash:blake3::Hasher,remaining:usize,depth:usize,quoted:bool,escaped:bool}
+impl BoundedHash {fn new()->Self{Self{hash:blake3::Hasher::new(),remaining:MAX_BYTES,depth:0,quoted:false,escaped:false}}}
+impl std::io::Write for BoundedHash {
+ fn write(&mut self,bytes:&[u8])->std::io::Result<usize>{
+  if bytes.len()>self.remaining{return Err(std::io::ErrorKind::InvalidData.into());}
+  for &b in bytes {if self.quoted{if self.escaped{self.escaped=false;}else if b==b'\\'{self.escaped=true;}else if b==b'"'{self.quoted=false;}}
+   else{match b{b'"'=>self.quoted=true,b'{'|b'['=>{self.depth+=1;if self.depth>64{return Err(std::io::ErrorKind::InvalidData.into());}},b'}'|b']'=>self.depth=self.depth.checked_sub(1).ok_or(std::io::ErrorKind::InvalidData)?,_=>{}}}}
+  self.remaining-=bytes.len();self.hash.update(bytes);Ok(bytes.len())
+ }
+ fn flush(&mut self)->std::io::Result<()>{Ok(())}
+}
+impl std::fmt::Write for BoundedHash {
+ fn write_str(&mut self,s:&str)->std::fmt::Result{
+  if s.len()>self.remaining{return Err(std::fmt::Error);}self.remaining-=s.len();self.hash.update(s.as_bytes());Ok(())
+ }
+}
+fn source_key(section:usize,paragraphs:&[Paragraph],context:Option<[u8;32]>,profile:LayoutCompatibilityProfile,dpi:f64)->Option<[u8;32]>{
