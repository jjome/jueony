+   for mut fact in src.commits{fact.format_id+=format_base;fact.finalization_index=fact.finalization_index.map(|i|i+final_base);if charge(dst,&fact){dst.commits.push(fact);}}
+   for mut fact in src.tables{fact.finalization_index=fact.finalization_index.map(|i|i+final_base);if charge(dst,&fact){dst.tables.push(fact);}}
+   for mut fact in src.whole_tables{fact.selected_format_id=fact.selected_format_id.map(|i|i+format_base);fact.finalization_index=fact.finalization_index.map(|i|i+final_base);if charge(dst,&fact){dst.whole_tables.push(fact);}}
