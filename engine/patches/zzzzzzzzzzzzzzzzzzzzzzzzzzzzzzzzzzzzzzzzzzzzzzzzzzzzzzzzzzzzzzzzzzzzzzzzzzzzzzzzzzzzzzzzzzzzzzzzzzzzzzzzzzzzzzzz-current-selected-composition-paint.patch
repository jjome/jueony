+//! Consume the exact plain-body composition accepted by the current allocator.
+//! No source/cache rows are reconstructed and no lease/export authority is issued.
+use std::sync::Arc;
+use crate::model::{paragraph::Paragraph,provenance::LayoutCompatibilityProfile,control::Control};
+use super::{composer::ComposedParagraph,pagination::PaginationResult,selected_composition_observer127::FinalizedSelectedCompositionTrace,
+ style_resolver::ResolvedStyleSet};
+#[derive(Debug,Clone)]
+pub(crate) struct CurrentAcceptedCompositionView {trace:Arc<FinalizedSelectedCompositionTrace>}
+pub(crate) struct AcceptedPlainPaint {pub composition:Arc<ComposedParagraph>,pub line_box_width:f64}
+impl CurrentAcceptedCompositionView {
+ pub(crate) fn from_current(result:&PaginationResult,paras:&[Paragraph],styles:&ResolvedStyleSet,profile:LayoutCompatibilityProfile,dpi:f64)->Option<Self>{
+  if dpi!=super::DEFAULT_DPI||styles.supplemental_metrics.is_some()||styles.kerning_measurement_context.is_some()||styles.horizontal_shaping_context.is_some(){return None;}
+  let trace=result.selected_composition_trace.as_ref()?;
+  if !trace.matches_source(paras,styles.reset_flow_context,profile,dpi)||!trace.matches_finalized_result(result){return None;}
+  Some(Self{trace:Arc::clone(trace)})
+ }
+ pub(crate) fn plain_paint(&self,para:&Paragraph,section:usize,page:u32,column:u16,start:usize,end:usize,physical_width:f64,styles:&ResolvedStyleSet,dpi:f64)->Option<AcceptedPlainPaint>{
+  if section!=self.trace.section()||!physical_width.is_finite()||physical_width<=0.0||dpi!=super::DEFAULT_DPI
+   ||!para.field_ranges.is_empty()||!para.range_tags.is_empty()||!para.orphan_field_ends.is_empty()||!para.tab_extended.is_empty()
+   ||para.numbering_restart.is_some()||!para.title_marks.is_empty()||!para.markpen_marks.is_empty()
+   ||para.text.contains(['\t','\n','\r','\u{fffc}'])||para.controls.iter().any(|c|!matches!(c,Control::SectionDef(_)|Control::ColumnDef(_))){return None;}
+  // Source char_offsets are HWP UTF16 units, while ComposedLine.char_start and
+  // published charStart are Unicode scalar indices. Structural controls occupy
+  // their own 16-unit prefix and must never be counted as source characters.
+  let mut source_offset=match para.controls.as_slice(){[]=>0u32,[Control::SectionDef(_),Control::ColumnDef(_)]=>16u32,_=>return None};
+  if para.char_offsets.len()!=para.text.chars().count(){return None;}
+  for (ch,at) in para.text.chars().zip(&para.char_offsets){if *at!=source_offset{return None;}source_offset=source_offset.checked_add(ch.len_utf16() as u32)?;}
+  if para.char_count!=source_offset.checked_add(1)?{return None;}
+  let token=para as *const Paragraph as usize;
+  let mut candidates=self.trace.commits().iter().filter(|c|c.section==section&&c.page==Some(page)&&c.column==column&&c.row_start==start&&c.row_end==end&&c.paragraph_token_matches);
+  let commit=candidates.find(|c|self.trace.format(c.format_id).is_some_and(|f|f.paragraph_token==token))?;
+  if candidates.any(|c|self.trace.format(c.format_id).is_some_and(|f|f.paragraph_token==token)){return None;}
+  let format=self.trace.format(commit.format_id)?;
+  if format.source_text!=para.text||format.source_char_offsets!=para.char_offsets{return None;}
+  if format.has_numbering||format.has_horizontal_shaping||format.known_square_band
+   ||format.before!=0.0||format.after!=0.0||format.lines.is_empty()||format.lines.len()>4096
+   ||start>=end||end>format.lines.len(){return None;}
+  let style=styles.para_styles.get(usize::from(para.para_shape_id))?;
+  if style.margin_left!=0.0||style.margin_right!=0.0||style.indent!=0.0||style.spacing_before!=0.0||style.spacing_after!=0.0
+   ||!matches!(style.head_type,crate::model::style::HeadType::None){return None;}
+  let input_width=format.actual_input_width_px?;if !input_width.is_finite()||input_width<=0.0{return None;}
+  // Both global-current reuse and local recomposition are actual formatter
+  // selections. This does not relabel either selection as freshly recomposed.
+  // This corrects only actual reuse across different physical column widths.
+  // A narrow row remains the exact accepted row in a wider frame. It is NOT a
+  // claim that this composition was recomputed at that later physical width.
+  let commits=self.trace.commits().iter().filter(|c|c.paragraph==commit.paragraph).collect::<Vec<_>>();
+  if commits.len()<2||!commits.iter().any(|c|c.actual_column_width_px!=input_width){return None;}
+  let mut next=0usize;
+  for c in &commits{
+   if c.format_id!=commit.format_id||c.row_start!=next||c.row_end<=next||c.final_membership!=Some(true)
+    ||!c.metrics_still_match_selected_format||!c.range_inside_selected_composition{return None;}
+   next=c.row_end;
+  }
+  if next!=format.lines.len(){return None;}
+  if format.actual_heights.len()!=format.lines.len()||format.actual_spacings.len()!=format.lines.len()
+   ||format.lines.iter().enumerate().any(|(i,l)|format.actual_heights[i]!=super::hwpunit_to_px(l.height_hu,dpi)
+    ||format.actual_spacings[i]!=super::hwpunit_to_px(l.spacing_hu,dpi)){return None;}
+  let mut scalar=0usize;let mut utf16=0u32;
+  for line in &format.lines{
+   if line.scalar_start!=scalar||line.unicode_utf16_start!=Some(utf16)||!line.exact_source_text_span||line.has_line_break||line.height_hu<=0||line.spacing_hu<0
+    ||line.baseline_hu<0||line.baseline_hu>line.height_hu||line.column_start_hu!=0{return None;}
+   let next=line.scalar_end?;
+   for run in &line.runs{utf16=utf16.checked_add(u32::try_from(run.utf16_units).ok()?)?;}
+   if line.unicode_utf16_end!=Some(utf16)||line.original_hwp_char_offset!=para.char_offsets.get(scalar).copied(){return None;}
+   scalar=next;
+  }
+  if scalar!=para.text.chars().count(){return None;}
+  let line_box_width=input_width.min(physical_width);let bound=super::px_to_hwpunit(line_box_width,dpi);
+  if bound<=0||format.lines[start..end].iter().any(|l|l.width_hu<=0||l.width_hu>bound){return None;}
+  let composition=self.trace.selected_composition(commit.format_id)?;
+  Some(AcceptedPlainPaint{composition,line_box_width})
+ }
