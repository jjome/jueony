+//! Additive explicit-page whole-frame proof. No existing single-frame guard is changed.
+use super::*;
+pub(crate) struct CurrentPageFramesCandidate<'doc>{frames:Vec<CurrentFrameCandidate<'doc>>}
+impl<'doc> CurrentPageFramesCandidate<'doc>{
+ pub(crate) fn from_current(source:&'doc Document,format:crate::parser::FileFormat,result:&super::super::pagination::PaginationResult,
+ styles:&super::super::style_resolver::ResolvedStyleSet,measured:&[super::super::height_measurer::MeasuredTable],
+ profile:crate::model::provenance::LayoutCompatibilityProfile,dpi:f64)->Option<Self>{
+  if source.sections.len()!=1{return None;}
+  let definition_context=source.reset_flow_contexts().first().copied().flatten()?;
+  Self::from_section(source,format,result,styles,measured,profile,dpi,0,0,definition_context)
+ }
+ fn from_section(source:&'doc Document,format:crate::parser::FileFormat,result:&super::super::pagination::PaginationResult,
+ styles:&super::super::style_resolver::ResolvedStyleSet,measured:&[super::super::height_measurer::MeasuredTable],
+ profile:crate::model::provenance::LayoutCompatibilityProfile,dpi:f64,section:usize,number_carry:u32,definition_context:[u8;32])->Option<Self>{
+  if source.sections.is_empty()||source.sections.len()>16||result.pages.is_empty()||result.pages.len()>16
+   ||(source.sections.len()==1&&result.pages.len()==1){return None;}
+  let mut frames=vec![];let mut start=0usize;
+  for page in 0..result.pages.len(){let frame=match Self::frame(source,format,result,styles,measured,profile,dpi,page,start,section,number_carry,definition_context){Some(f)=>f,None=>return None};
+   let items=result.pages[page].column_contents.first()?.items.len();start=start.checked_add(items)?;frames.push(frame);}
+  if start!=source.sections.get(section)?.paragraphs.len(){return None;}
+  Some(Self{frames})
+ }
+ pub(crate) fn paint_plan(&self,page:usize)->Option<CurrentFramePaintPlan>{Some(self.frames.get(page)?.paint_plan())}
