+ for case in 0..9{let mut bad=f;match case{0=>bad[0].page=1,1=>bad[0].column=1,2=>bad[1].start=1,3=>bad[1].end=5,4=>bad[2].end=3,5=>bad[1].column=2,6=>bad[2].page=2,7=>bad[2].column=1,_=>bad[2].end=3}assert!(encode_current_plain_frame_rows(&r,&bad).is_none(),"partition {case}");}
