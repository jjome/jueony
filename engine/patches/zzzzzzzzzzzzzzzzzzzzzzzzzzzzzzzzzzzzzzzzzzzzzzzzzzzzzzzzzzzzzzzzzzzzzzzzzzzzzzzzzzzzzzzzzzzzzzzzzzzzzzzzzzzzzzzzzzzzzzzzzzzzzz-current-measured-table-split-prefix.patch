+//! Standard frame-local row encoding for a current ordinary plain paragraph.
+//! Pure output representation, not row freshness or a source/lease authority.
+use crate::model::paragraph::LineSeg;
+#[derive(Clone,Copy,Debug)]
+pub(crate) struct PlainFramePartition{pub(crate) page:u32,pub(crate) column:u16,pub(crate) start:usize,pub(crate) end:usize}
+pub(crate) fn encode_current_plain_frame_rows(canonical:&[LineSeg],frames:&[PlainFramePartition])->Option<Vec<LineSeg>>{
+ if canonical.len()<2||canonical.len()>4096||frames.len()<2||frames.len()>48{return None;}
+ let mut pen=0i32;let mut prior_text=0;
+ for (i,row)in canonical.iter().enumerate(){
+  if row.tag!=(LineSeg::TAG_SINGLE_SEGMENT_LINE|LineSeg::TAG_IMPLEMENTATION_PROPERTY)||row.vertical_pos!=pen||row.line_height<=0
+   ||row.text_height!=row.line_height||row.line_spacing<0||row.segment_width<=0||row.column_start!=0
+   ||row.baseline_distance<0||row.baseline_distance>row.line_height||(i>0&&row.text_start<=prior_text)||(i==0&&row.text_start!=0){return None;}
+  pen=pen.checked_add(row.line_height)?.checked_add(row.line_spacing)?;prior_text=row.text_start;
+ }
+ let mut output=canonical.to_vec();let mut consumed=0usize;let mut previous:Option<(u32,u16)>=None;
+ for frame in frames {
+  if frame.start!=consumed||frame.end<=frame.start||frame.end>canonical.len(){return None;}
+  if let Some((page,column))=previous{
+   if !((frame.page==page&&Some(frame.column)==column.checked_add(1))||(Some(frame.page)==page.checked_add(1)&&frame.column==0)){return None;}
+  }else if frame.page!=0||frame.column!=0{return None;}
+  let base=canonical[frame.start].vertical_pos;
+  for row in &mut output[frame.start..frame.end]{row.vertical_pos=row.vertical_pos.checked_sub(base)?;}
+  if let Some((page,_))=previous{let first=&mut output[frame.start];first.tag|=LineSeg::TAG_FIRST_LINE_OF_COLUMN;if frame.page!=page{first.tag|=LineSeg::TAG_FIRST_LINE_OF_PAGE;}}
+  consumed=frame.end;previous=Some((frame.page,frame.column));
+ }
+ (consumed==canonical.len()).then_some(output)
+}
