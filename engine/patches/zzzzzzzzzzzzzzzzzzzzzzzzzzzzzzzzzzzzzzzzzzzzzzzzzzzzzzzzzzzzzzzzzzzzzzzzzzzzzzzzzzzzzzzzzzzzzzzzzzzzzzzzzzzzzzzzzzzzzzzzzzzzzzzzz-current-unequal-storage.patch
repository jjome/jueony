+//! Immediate spacing-only policy for exact current substring formatting.
+//! Neither variant grants source-row, frame, allocation, cache or export rights.
+use crate::model::paragraph::Paragraph;
+use super::{composer::ComposedParagraph,selected_composition_observer127::ActualPlainSuffix148,style_resolver::ResolvedStyleSet};
+#[derive(Clone,Copy)]
+pub(crate) enum CurrentPlainWrap148{Whole(super::current_fresh_wrap148::CurrentFreshWrapPolicy),Suffix(CurrentSuffixWrap148)}
+#[derive(Clone,Copy)]
+pub(crate) struct CurrentSuffixWrap148{paragraph:usize,composition:usize,first:usize}
+impl CurrentPlainWrap148{
+ pub(crate) fn actual_suffix(p:&Paragraph,c:&ComposedParagraph,m:&ActualPlainSuffix148,width:f64,styles:&ResolvedStyleSet,dpi:f64)->Option<Self>{
+  if width!=m.actual_width||m.first_line==0||m.first_line>=c.lines.len(){return None;}
+  let fresh=super::current_plain_suffix148::compose_plain_suffix148(p,m.scalar_start,width,styles,dpi)?;
+  if fresh.utf16_start!=m.utf16_start||m.first_line.checked_add(fresh.composition.lines.len())?!=c.lines.len()
+   ||!c.lines[m.first_line..].iter().zip(&fresh.composition.lines).all(|(a,b)|super::current_plain_suffix148::same_suffix_line148(a,b)){return None;}
+  Some(Self::Suffix(CurrentSuffixWrap148{paragraph:p as *const _ as usize,composition:c as *const _ as usize,first:m.first_line}))
+ }
+ pub(crate) fn matches(self,p:Option<&Paragraph>,c:&ComposedParagraph,line:usize)->bool{match self{
+  Self::Whole(policy)=>policy.matches(p,c),Self::Suffix(policy)=>line>=policy.first&&p.is_some_and(|p|p as *const _ as usize==policy.paragraph)&&c as *const _ as usize==policy.composition
+ }}
