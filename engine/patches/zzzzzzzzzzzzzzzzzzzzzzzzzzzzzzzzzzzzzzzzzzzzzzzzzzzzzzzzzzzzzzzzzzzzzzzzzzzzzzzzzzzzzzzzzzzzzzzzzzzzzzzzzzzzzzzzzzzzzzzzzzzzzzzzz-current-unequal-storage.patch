+/// A known plain continuation requires a new physical formatter. If preparation
+/// cannot establish it, leave a present invalid paint requirement rather than
+/// silently rendering the old wide rows. No composition/row authority is issued.
+pub(crate) fn refuse_plain_continuation148(old:SelectedObservationHandle,p:&Paragraph){
+ if RUNTIME_DEPTH.with(|d|d.get())!=1{return;}
+ ACTIVE.with(|a|{let Ok(mut a)=a.try_borrow_mut()else{return;};let Some(a)=a.as_mut()else{return;};if old.scope!=a.scope{return;}
+  let token=p as *const Paragraph as usize;let Some(f)=a.report.formats.get(old.index)else{return;};if f.paragraph_token!=token{return;}
+  if let Some(b)=a.required.iter_mut().find(|b|b.token==token){b.failed=true;return;}
+  let Some(c)=a.report.commits.iter().find(|c|c.format_id==old.index&&c.paragraph_token_matches)else{return;};let paragraph=c.paragraph;
+  if a.required.len()>=MAX_FORMATS{if let Some(b)=a.required.first_mut(){b.failed=true;}return;}
+  let size=std::mem::size_of::<RequiredBuilder>();let within=size<=MAX_REQUIRED_BYTES.saturating_sub(a.required_bytes);
+  if within{a.required_bytes+=size;}else if let Some(b)=a.required.first_mut(){b.failed=true;return;}
+  a.required.push(RequiredBuilder{full_empty:false,token,paragraph,formats:vec![],commits:vec![],failed:true});
+ });
