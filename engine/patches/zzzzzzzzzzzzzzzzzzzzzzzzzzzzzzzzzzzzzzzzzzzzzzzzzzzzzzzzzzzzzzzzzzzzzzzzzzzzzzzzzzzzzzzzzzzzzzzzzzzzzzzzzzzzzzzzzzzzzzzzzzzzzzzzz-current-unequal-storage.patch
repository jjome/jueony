+use crate::model::{table::{Table,TablePageBreak},paragraph::Paragraph,shape::{VertRelTo,VertAlign,HorzRelTo,HorzAlign,SizeCriterion}};
+pub(super) struct CurrentPrefixOffsetStep148{offset:i32,horizontal:i32,left:i16,width:i32}
+impl CurrentPrefixOffsetStep148{
+ pub(super) fn from_current(t:&Table,plain:impl Fn(&Paragraph)->bool)->Option<Self>{
+  let offset=t.common.vertical_offset as i32;let horizontal=t.common.horizontal_offset as i32;
+  if offset<=0||horizontal<0||t.common.allow_overlap||!known_prefix_offset_shape148(t,plain){return None;}
+  Some(Self{offset,horizontal,left:t.outer_margin_left,width:i32::try_from(t.common.width).ok()?})
+ }
+ pub(super) fn border(&self,column_x:f64,incoming:f64,paper_width:f64,body:f64,dpi:f64)->Option<[f64;4]>{
+  if dpi!=crate::renderer::DEFAULT_DPI||[column_x,incoming,paper_width,body].iter().any(|v|!v.is_finite())||paper_width<=0.0||body<=0.0{return None;}
+  let x=column_x+crate::renderer::hwpunit_to_px(self.horizontal,dpi)+crate::renderer::hwpunit_to_px(i32::from(self.left),dpi);
+  let y=crate::renderer::layout::empty_host_float_raw_top(incoming,crate::renderer::hwpunit_to_px(self.offset,dpi),0.0);
+  let width=crate::renderer::hwpunit_to_px(self.width,dpi);
+  if !x.is_finite()||!y.is_finite()||!width.is_finite()||x<0.0||x+width>paper_width{return None;}
+  Some([x,y,width,body])
+ }
+}
+fn known_prefix_offset_shape148(t: &Table, plain: impl Fn(&Paragraph) -> bool) -> bool {
+    if t.common.treat_as_char
+        || !crate::renderer::float_placement::is_para_topbottom_float(&t.common)
+        || t.common.vert_rel_to != VertRelTo::Para
+        || t.common.vert_align != VertAlign::Top
+        || t.common.horz_rel_to != HorzRelTo::Para
+        || t.common.horz_align != HorzAlign::Left
+        || (t.common.horizontal_offset as i32) < 0
+        || t.common.locked
+        || t.common.size_protect
+        || t.attr & (1 << 30) != 0
+        || t.raw_table_record_attr & 8 != 0
+        || t.common.height_criterion != SizeCriterion::Absolute
+        || t.common.width_criterion != SizeCriterion::Absolute
+        || !t.common.description.is_empty()
+        || t.common.raw_extra.iter().any(|b| *b != 0)
+        || t.common.width == 0
+        || t.common.width >= 0x8000_0000
+        || t.common.height == 0
+        || t.common.height >= 0x8000_0000
+        || t.page_break != TablePageBreak::None
+        || t.repeat_header
+        || t.caption.is_some()
+        || !t.zones.is_empty()
+        || t.cell_spacing != 0
+        || t.outer_margin_top <= 0
+        || [
+            t.outer_margin_left,
+            t.outer_margin_right,
+            t.outer_margin_bottom,
+        ]
+        .iter()
+        .any(|v| *v != t.outer_margin_top)
+        || t.row_count == 0
+        || t.row_count > 128
+        || t.col_count > 64
+        || t.cells.len() > 4096
+        || i64::from(t.common.height) + 2 * i64::from(t.outer_margin_top) > i64::from(i32::MAX)
+        || t.col_count == 0
+        || t.cells.len() != usize::from(t.row_count) * usize::from(t.col_count)
+    {
+        return false;
+    }
+    t.cells.iter().enumerate().all(|(i, c)| {
+        c.row_span == 1
+            && c.col_span == 1
+            && usize::from(c.row) == i / usize::from(t.col_count)
+            && usize::from(c.col) == i % usize::from(t.col_count)
+            && c.width > 0
+            && c.width < 0x8000_0000
+            && c.height > 0
+            && c.height < 0x8000_0000
+            && !c.cell_protect()
+            && c.field_name.is_none()
+            && c.text_direction == 0
+            && c.line_wrap == 0
+            && !c.paragraphs.is_empty()
+            && c.paragraphs.iter().all(|p| {
+                p.controls.is_empty()
+                    && plain(p)
+                    && p.column_type == crate::model::paragraph::ColumnBreakType::None
+            })
+    })
+}
