+/// The legacy absolute band and an independently accepted paragraph-relative
+/// column are different origins. An absent reservation never defaults to zero.
+#[derive(Clone,Copy)]
+enum ExplicitColumnOrigin158{AbsoluteReservation(f64),Independent(IndependentParaColumns158)}
+#[derive(Clone,Copy)]
+struct IndependentParaColumns158;
+impl IndependentParaColumns158{
+ fn from_current(source:&Document,result:&super::super::pagination::PaginationResult)->Option<Self>{
+  use crate::model::{control::Control,paragraph::ColumnBreakType,shape::{VertRelTo,TextWrap}};
+  use super::super::pagination::PageItem;
+  let [section]=source.sections.as_slice()else{return None;};let [page]=result.pages.as_slice()else{return None;};
+  let trace=result.selected_composition_trace.as_ref()?;
+  if !matches!(page.column_contents.len(),2|3)||page.column_contents.len()!=page.layout.column_areas.len(){return None;}
+  let mut tables=0usize;
+  for(i,p)in section.paragraphs.iter().enumerate(){match p.controls.as_slice(){
+   []=>{},[Control::SectionDef(_),Control::ColumnDef(_)]if i==0=>{},
+   [Control::Table(t)]=>{if t.common.vert_rel_to!=VertRelTo::Para||t.common.text_wrap!=TextWrap::TopAndBottom||t.common.treat_as_char||t.common.vertical_offset!=0{return None;}tables=tables.checked_add(1)?;},
+   _=>return None,
+  }}
+  if tables==0{return None;}
+  for(i,col)in page.column_contents.iter().enumerate(){
+   if col.column_index as usize!=i||col.start_height!=0.0||col.endnote_flow||col.zone_layout.is_some()||col.zone_y_offset!=0.0{return None;}
+   let first=col.items.first()?;let pi=match first{PageItem::FullParagraph{para_index}|PageItem::Table{para_index,..}=>*para_index,_=>return None};
+   let p=section.paragraphs.get(pi)?;
+   if (i==0&&p.column_type!=ColumnBreakType::Section)||(i>0&&p.column_type!=ColumnBreakType::Column){return None;}
+   let flow=match first{
+    PageItem::FullParagraph{..}=>{let mut c=trace.commits().iter().filter(|c|c.paragraph==pi);let f=c.next()?;if c.next().is_some()||f.page!=Some(page.page_index)||f.column as usize!=i||f.committed_item_index!=Some(0)||f.final_membership!=Some(true){return None;}f.flow_before},
+    PageItem::Table{control_index,..}=>{let mut c=trace.whole_tables().iter().filter(|c|c.paragraph==pi&&c.control==*control_index);let f=c.next()?;if c.next().is_some()||f.page!=Some(page.page_index)||f.column as usize!=i||f.committed_item_index!=0||f.final_membership!=Some(true){return None;}f.flow_before},
+    _=>return None,
