+/// Scope only: current complete source and finalized membership were checked
+/// by from_current. This does not create placement, row or cache authority.
+fn last_allocated_source_content<'a>(ps:&[Paragraph],items:impl IntoIterator<Item=&'a PageItem>)->Option<usize>{
+ use crate::model::control::Control;
+ let mut last=None;
+ for item in items{let index=match item{
+  PageItem::FullParagraph{para_index}|PageItem::PartialParagraph{para_index,..}=>{
+   let Some(p)=ps.get(*para_index)else{continue;};
+   if p.text.is_empty()&&!p.controls.iter().any(|c|matches!(c,Control::Table(_))){continue;}*para_index
+  },
+  PageItem::Table{para_index,control_index}|PageItem::PartialTable{para_index,control_index,..}=>{
+   if !ps.get(*para_index).and_then(|p|p.controls.get(*control_index)).is_some_and(|c|matches!(c,Control::Table(_))){continue;}*para_index
+  },_=>continue,
+ };last=Some(last.map_or(index,|n:usize|n.max(index)));}
+ last
+}
