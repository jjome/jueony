+// A height-only equivalence. It emits no rows and never transfers horizontal
+// metrics, spacing policy or a lease. The source width is only a refusal bound;
+// fresh partition/metrics and current MeasuredCell remain independent owners.
+fn physical_vertical_partition(
+    source: &[LineSeg],
+    fresh: &[LineSeg],
+    a: &ComposedParagraph,
+    b: &ComposedParagraph,
+    styles: &ResolvedStyleSet,
+    width: f64,
+) -> bool {
+    if source.len() != fresh.len()
+        || !a.tac_controls.is_empty()
+        || !b.tac_controls.is_empty()
+        || a.numbering_text.is_some()
+        || b.numbering_text.is_some()
+        || !a.footnote_positions.is_empty()
+        || !b.footnote_positions.is_empty()
+        || !a.tab_extended.is_empty()
+        || !b.tab_extended.is_empty()
+        || a.horizontal_shaping.is_some()
+        || b.horizontal_shaping.is_some()
+        || a.lines.len() != b.lines.len()
+    {
+        return false;
+    }
+    if !source.iter().zip(fresh).all(|(a, b)| {
+        (a.tag == LineSeg::TAG_SINGLE_SEGMENT_LINE
+            || a.tag == (LineSeg::TAG_SINGLE_SEGMENT_LINE | LineSeg::TAG_IMPLEMENTATION_PROPERTY))
+            && b.tag == (LineSeg::TAG_SINGLE_SEGMENT_LINE | LineSeg::TAG_IMPLEMENTATION_PROPERTY)
+            && a.text_start == b.text_start
+            && a.vertical_pos == b.vertical_pos
+            && a.line_height == b.line_height
+            && a.text_height == b.text_height
+            && a.baseline_distance == b.baseline_distance
+            && a.line_spacing == b.line_spacing
+            && a.column_start == 0
+            && b.column_start == 0
+            && a.segment_width > 0
+            && a.segment_width <= b.segment_width
+    }) {
+        return false;
+    }
+    a.lines.iter().zip(&b.lines).all(|(a, b)| {
+        let w = crate::renderer::composer::estimate_composed_line_width(a, styles);
+        w.is_finite()
+            && w >= 0.0
+            && w <= width
+            && a.char_start == b.char_start
+            && a.line_height == b.line_height
+            && a.baseline_distance == b.baseline_distance
+            && a.line_spacing == b.line_spacing
+            && a.column_start == 0
+            && b.column_start == 0
+            && a.segment_width > 0
+            && a.segment_width <= b.segment_width
+            && !a.has_line_break
+            && !b.has_line_break
+            && a.runs.len() == b.runs.len()
+            && a.runs.iter().zip(&b.runs).all(|(a, b)| {
+                use crate::model::paragraph::SpaceMetric;
+                a.text == b.text
+                    && a.char_style_id == b.char_style_id
+                    && a.lang_index == b.lang_index
+                    && a.char_overlap == b.char_overlap
+                    && a.footnote_marker == b.footnote_marker
+                    && a.display_text == b.display_text
+                    && a.supplemental_metrics_blocked == b.supplemental_metrics_blocked
+                    && a.inserted_control_text == b.inserted_control_text
+                    && matches!(a.space_metric, SpaceMetric::Stored | SpaceMetric::HalfCell)
+                    && b.space_metric == SpaceMetric::Stored
+            })
+    })
+}
