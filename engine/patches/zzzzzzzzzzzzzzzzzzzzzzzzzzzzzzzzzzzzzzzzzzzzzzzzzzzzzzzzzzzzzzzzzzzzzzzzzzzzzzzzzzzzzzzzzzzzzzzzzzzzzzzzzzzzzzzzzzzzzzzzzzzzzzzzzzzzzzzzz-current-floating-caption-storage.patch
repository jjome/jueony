+pub(crate) fn record_caption_measurement161(p:&Paragraph,t:&crate::model::table::Table,m:Option<&crate::renderer::height_measurer::MeasuredTable>){
+ if RUNTIME_DEPTH.with(|d|d.get())!=1{return;}
+ ACTIVE.with(|a|{let Ok(mut a)=a.try_borrow_mut()else{return;};let Some(a)=a.as_mut()else{return;};
+  if !a.caption_capture_only161||a.caption_measurements_invalid161||t.caption.is_none(){return;}
+  let Some(key)=m.and_then(full_fragment_measurement_key148)else{a.caption_measurements_invalid161=true;return;};
+  let paragraph=p as *const _ as usize;let table=t as *const _ as usize;
+  if let Some(old)=a.caption_measurements161.iter().find(|r|r.paragraph==paragraph&&r.table==table){
+   if old.key!=key{a.caption_measurements_invalid161=true;}return;}
+  let fact=CaptionMeasurement161{paragraph,table,key};if a.caption_measurements161.len()>=128||!charge(&mut a.report,&fact){a.caption_measurements_invalid161=true;return;}
+  a.caption_measurements161.push(fact);
