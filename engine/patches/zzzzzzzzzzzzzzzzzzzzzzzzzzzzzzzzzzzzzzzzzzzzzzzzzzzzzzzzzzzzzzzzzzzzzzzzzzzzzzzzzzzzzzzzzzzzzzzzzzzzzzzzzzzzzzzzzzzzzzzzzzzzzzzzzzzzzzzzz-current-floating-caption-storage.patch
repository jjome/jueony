+  let mut ms=self.measurements.iter().filter(|r|r.paragraph==p as *const _ as usize&&r.table==t as *const _ as usize);
+  let Some(r)=ms.next()else{return false;};ms.next().is_none()&&full_fragment_measurement_key148(m)==Some(r.key)
+ }
+ pub(crate) fn trace(&self)->&FinalizedSelectedCompositionTrace{&self.trace}
+ pub(crate) fn matches_current(&self,paragraphs:&[Paragraph],result:&PaginationResult,context:Option<[u8;32]>,profile:LayoutCompatibilityProfile,dpi:f64)->bool{
+  result.caption_allocation161.as_deref().is_some_and(|current|std::ptr::eq(self,current))
+   &&self.trace.purpose==ActualCompositionPurpose::CaptionAllocation161&&self.source_array==paragraphs.as_ptr() as usize
+   &&self.trace.resource==crate::model::native_computed_resource::RESOURCE
