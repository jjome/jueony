+  let s=source();let p=capsule(&s,Mode163::Hwpx);assert!(p.bind_hwpx(&s.clone()).is_some());
+  let mutations:Vec<fn(&mut Document)>=vec![
+   |d|d.sections[0].paragraphs[0].text.push('x'),
+   |d|d.sections[0].paragraphs[0].raw_header_extra.push(1),
+   |d|d.sections[0].paragraphs[0].line_segs[0].vertical_pos+=1,
+   |d|d.sections[0].paragraphs[0].source_line_seg_vertical_pos=Some(vec![1]),
+   |d|d.sections[0].paragraphs[0].layout_space_metrics.push((0,crate::model::paragraph::SpaceMetric::HalfCell)),
+   |d|d.sections[0].paragraphs[0].cell_format_vpos_dirty=true,
+   |d|{use crate::model::paragraph::NumberingMarker;let p=&mut d.sections[0].paragraphs[0];p.numbering_marker=if matches!(p.numbering_marker,NumberingMarker::Absent){NumberingMarker::Unresolved}else{NumberingMarker::Absent};},
+   |d|d.sections[0].section_def.page_def.margin_top+=1,
+   |d|d.header.raw_data.get_or_insert_with(Vec::new).push(1),
+   |d|d.extra_streams.push(("/unknown-owner".into(),vec![1])),
+   |d|d.hwpx_aux_entries.push(("META-INF/unknown-owner".into(),vec![1])),
+   |d|d.preview=Some(crate::model::document::Preview{text:Some("changed".into()),image:None}),
+  ];
+  for (i,f) in mutations.into_iter().enumerate(){let mut t=s.clone();let before=digest(&t,p.resource,p.generation,false).unwrap();f(&mut t);
