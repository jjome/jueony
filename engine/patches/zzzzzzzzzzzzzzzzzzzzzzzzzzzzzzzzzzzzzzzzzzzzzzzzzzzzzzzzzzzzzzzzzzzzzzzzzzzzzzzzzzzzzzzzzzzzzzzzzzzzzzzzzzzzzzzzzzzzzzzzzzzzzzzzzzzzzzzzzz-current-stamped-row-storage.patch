+ // These units exercise the exact-binding boundary, not a synthetic positive
+ // factory. Production factory positives are the separate public304 matrix.
+ fn capsule<'a>(s:&'a Document,mode:Mode163)->CurrentStampedRowsProjection163<'a>{
+  let resource=crate::model::native_computed_resource::RESOURCE;let generation=[17;32];let key=digest(s,resource,generation,false).unwrap();
+  CurrentStampedRowsProjection163{source:s,resource,generation,source_key:key,target_key:key,allow_caption:false,mode,
+   entries:vec![Entry163{owner:Owner163::Body{section:0,paragraph:0},rows:vec![LineSeg{tag:0x80060000,..LineSeg::default()}]}]}
+ }
