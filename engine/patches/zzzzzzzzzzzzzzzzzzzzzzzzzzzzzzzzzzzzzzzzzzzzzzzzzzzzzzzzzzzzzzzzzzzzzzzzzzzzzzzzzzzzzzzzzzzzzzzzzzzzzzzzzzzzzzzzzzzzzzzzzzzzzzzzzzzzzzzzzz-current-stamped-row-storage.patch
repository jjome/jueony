+  let stamped=intent.stamped_source_document(source)?;let target_key=digest(&stamped,resource,generation,false).ok_or("Unsupported stamped native target")?;
+  Ok(Self{source,resource,generation,source_key,target_key,allow_caption:false,mode:Mode163::NativeOriginal,entries})
+ }
+ fn bound(&self,target:&Document)->Option<BoundRows163>{
