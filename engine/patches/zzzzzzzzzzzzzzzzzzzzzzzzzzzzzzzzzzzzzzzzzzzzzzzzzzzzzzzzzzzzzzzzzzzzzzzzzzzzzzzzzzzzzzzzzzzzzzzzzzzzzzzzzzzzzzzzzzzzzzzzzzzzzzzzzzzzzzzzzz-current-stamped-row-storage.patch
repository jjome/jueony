+  p.generation[0]^=1;assert!(p.bind_hwpx(&s).is_none());p.generation[0]^=1;p.resource[0]^=1;assert!(p.bind_hwpx(&s).is_none());
+  let mut t=s.clone();assert!(p.apply_to_original_stamped_source(&mut t).is_err());
