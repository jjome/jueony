+//! Exact, one-shot row binding after a validated metadata-only export intent.
+//! Every row first passes its original opaque producer's original binder at the
+//! real Core lowering boundary. No arbitrary target/map/rows can construct this.
+use crate::{DocumentCore,model::{document::Document,paragraph::{Paragraph,LineSeg},control::Control}};
+use crate::document_core::document_metadata::StoredTimeExportIntent;
+use std::collections::HashMap;
+use super::{SerializeError,current_frame_rows::{CurrentFrameRowsProjection,document_digest157},standard_rows::CurrentStandardRowsProjection,current_caption_rows157::CurrentCaptionRowsProjection157};
+const MAX_ROWS:usize=65536;
+const MAX_OWNERS:usize=4096;
+// Legacy's historical projection has no borrowed source owner. Its marker
+// invokes the actual current Core producer here; no foreign legacy object can
+// be rebound merely because its old narrow definitions/body digest matches.
+pub(crate) enum StampedRowSource163<'a,'d>{Standard,Current(&'a CurrentFrameRowsProjection<'d>),Caption(&'a CurrentCaptionRowsProjection157<'d>)}
+enum BoundOriginalRows163<'a,'d>{Standard(&'a CurrentStandardRowsProjection),Current(&'a CurrentFrameRowsProjection<'d>),Caption(&'a CurrentCaptionRowsProjection157<'d>)}
+impl BoundOriginalRows163<'_,'_>{
+ fn bind(&self,target:&Document)->Option<HashMap<usize,Vec<LineSeg>>>{match self{Self::Standard(p)=>p.bind_for_export(target),Self::Current(p)=>p.bind_for_export(target),Self::Caption(p)=>p.bind_for_export(target)}}
+ fn has_caption(&self)->bool{matches!(self,Self::Caption(_))}
+ fn owns(&self,source:&Document)->bool{match self{Self::Standard(_)=>true,Self::Current(p)=>p.owns_exact_source163(source),Self::Caption(p)=>p.owns_exact_source163(source)}}
+}
