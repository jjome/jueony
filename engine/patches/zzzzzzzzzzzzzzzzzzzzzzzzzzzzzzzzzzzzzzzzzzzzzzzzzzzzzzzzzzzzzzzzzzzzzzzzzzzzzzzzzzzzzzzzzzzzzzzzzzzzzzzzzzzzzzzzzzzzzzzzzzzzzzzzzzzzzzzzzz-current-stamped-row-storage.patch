+#[derive(Clone,Copy)]enum Mode163{Hwpx,NativeOriginal}
+#[derive(Clone,Copy)]enum Owner163{Body{section:usize,paragraph:usize},Caption{section:usize,paragraph:usize,control:usize,caption:usize}}
+struct Entry163{owner:Owner163,rows:Vec<LineSeg>}
+pub(crate) struct CurrentStampedRowsProjection163<'d>{source:&'d Document,resource:[u8;32],generation:[u8;32],source_key:[u8;32],target_key:[u8;32],allow_caption:bool,mode:Mode163,entries:Vec<Entry163>}
+pub(super) struct BoundRows163{pub(super) body:HashMap<usize,Vec<LineSeg>>,pub(super) caption:HashMap<usize,Vec<LineSeg>>}
+fn digest(d:&Document,resource:[u8;32],generation:[u8;32],caption:bool)->Option<[u8;32]>{document_digest157(d,resource,generation,caption)}
+fn collect(target:&Document,mut rows:HashMap<usize,Vec<LineSeg>>,caption_only:bool)->Option<Vec<Entry163>>{
+ let mut entries=Vec::new();let mut total=0usize;
+ for(si,section)in target.sections.iter().enumerate(){for(pi,p)in section.paragraphs.iter().enumerate(){
+  if let Some(value)=rows.remove(&(p as*const _ as usize)){if caption_only{return None;}total=total.checked_add(value.len())?;entries.push(Entry163{owner:Owner163::Body{section:si,paragraph:pi},rows:value});}
+  for(ci,c)in p.controls.iter().enumerate(){if let Control::Table(t)=c{if let Some(caption)=&t.caption{for(qi,q)in caption.paragraphs.iter().enumerate(){
+   if let Some(value)=rows.remove(&(q as*const _ as usize)){if !caption_only{return None;}total=total.checked_add(value.len())?;entries.push(Entry163{owner:Owner163::Caption{section:si,paragraph:pi,control:ci,caption:qi},rows:value});}
+  }}}}
+  if total>MAX_ROWS||entries.len()>MAX_OWNERS{return None;}
+ }}
+ (!entries.is_empty()&&rows.is_empty()&&entries.iter().all(|e|!e.rows.is_empty())).then_some(entries)
+}
+fn generation(source:[u8;32],original_target:[u8;32],entries:&[Entry163])->[u8;32]{
+ let mut h=blake3::Hasher::new();h.update(b"validated-stamped-row-bind163-v1\0");h.update(&source);h.update(&original_target);
+ for e in entries{let fields=match e.owner{Owner163::Body{section,paragraph}=>[0,section,paragraph,0,0],Owner163::Caption{section,paragraph,control,caption}=>[1,section,paragraph,control,caption]};for v in fields{h.update(&(v as u64).to_le_bytes());}h.update(&(e.rows.len()as u64).to_le_bytes());
+  for row in &e.rows{let LineSeg{text_start,vertical_pos,line_height,text_height,baseline_distance,line_spacing,column_start,segment_width,tag}=row;
+   h.update(&text_start.to_le_bytes());for n in[vertical_pos,line_height,text_height,baseline_distance,line_spacing,column_start,segment_width]{h.update(&n.to_le_bytes());}h.update(&tag.to_le_bytes());}
+ }*h.finalize().as_bytes()
+}
+impl<'d> CurrentStampedRowsProjection163<'d>{
+ pub(crate) fn for_hwpx(core:&'d DocumentCore,intent:&StoredTimeExportIntent<'_>,original:StampedRowSource163<'_,'_>)->Result<Self,String>{
+  let legacy=if matches!(original,StampedRowSource163::Standard){Some(core.current_standard_rows_for_export().ok_or("Current legacy projection is no longer eligible")?)}else{None};
+  let original=match original{StampedRowSource163::Standard=>BoundOriginalRows163::Standard(legacy.as_ref().ok_or("Missing current legacy producer")?),StampedRowSource163::Current(p)=>BoundOriginalRows163::Current(p),StampedRowSource163::Caption(p)=>BoundOriginalRows163::Caption(p)};
+  let source=core.document();let resource=crate::model::native_computed_resource::RESOURCE;let allow_caption=original.has_caption();
+  if !original.owns(source){return Err("Stamped projection belongs to another original document".into());}
+  let original_source=digest(source,resource,[0;32],allow_caption).ok_or("Unsupported stamped source story/budget")?;
+  let (entries,original_target)=core.hwpx_document_for_export(|target|{
+   let key=digest(target,resource,[0;32],allow_caption).ok_or_else(||SerializeError::UnsupportedInput("STAMPED_ORIGINAL_TARGET_SCOPE".into()))?;
+   let bound=original.bind(target).ok_or_else(||SerializeError::UnsupportedInput("STAMPED_ORIGINAL_ROW_BINDING".into()))?;
+   let entries=collect(target,bound,allow_caption).ok_or_else(||SerializeError::UnsupportedInput("STAMPED_ORIGINAL_ROW_OWNER".into()))?;
+   Ok((entries,key))
+  }).map_err(|e|e.to_string())?;
+  let generation=generation(original_source,original_target,&entries);
+  let source_key=digest(source,resource,generation,allow_caption).ok_or("Unsupported original source")?;
+  // This is the only metadata target constructor. It checks original pointer,
+  // owner fingerprint and the exact prepared metadata owner, including unknown OLE.
+  let stamped=intent.stamped_source_document(source)?;
+  let target_key=core.hwpx_document_for_export_document(&stamped,|target|digest(target,resource,generation,allow_caption)
+   .ok_or_else(||SerializeError::UnsupportedInput("STAMPED_EXACT_TARGET_SCOPE".into()))).map_err(|e|e.to_string())?;
+  Ok(Self{source,resource,generation,source_key,target_key,allow_caption,mode:Mode163::Hwpx,entries})
+ }
+ pub(crate) fn for_native_original(core:&'d DocumentCore,intent:&StoredTimeExportIntent<'_>,original:&CurrentFrameRowsProjection<'_>)->Result<Self,String>{
+  let source=core.document();let resource=crate::model::native_computed_resource::RESOURCE;
+  if !original.owns_exact_source163(source){return Err("Stamped native rows belong to another original document".into());}
