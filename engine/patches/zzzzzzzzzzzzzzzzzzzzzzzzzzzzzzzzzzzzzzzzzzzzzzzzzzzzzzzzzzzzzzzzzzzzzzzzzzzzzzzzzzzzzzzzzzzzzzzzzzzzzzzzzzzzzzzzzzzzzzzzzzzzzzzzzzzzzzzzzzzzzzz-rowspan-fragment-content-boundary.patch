+    fn rowspan173_actual_fragment_end_and_resume_have_one_unit_owner() {
+        use crate::model::control::Control;
+        use crate::renderer::pagination::PageItem;
+        let d = crate::DocumentCore::from_bytes(include_bytes!(concat!(
+            env!("CARGO_MANIFEST_DIR"), "/tests/fixtures/n001-rowspan173-own/rowspan6.hwp"
+        ))).unwrap();
+        let Control::Table(t) = &d.document.sections[0].paragraphs[1].controls[0] else { panic!() };
+        let c = &t.cells[2];
+        let mt = d.measured_tables[0].iter().find(|m| m.para_index == 1 && m.control_index == 0).unwrap();
+        let fragments = d.pagination[0].pages.iter().flat_map(|p| &p.column_contents)
+            .flat_map(|c| &c.items).filter_map(|i| match i {
+                PageItem::PartialTable { para_index: 1, control_index: 0, start_row,
+                    end_row, start_cut, end_cut, start_row_height_override,
+                    end_row_height_override, .. } => Some((*start_row, *end_row,
+                    start_cut, end_cut, *start_row_height_override, *end_row_height_override)),
+                _ => None,
+            }).collect::<Vec<_>>();
+        assert_eq!(fragments.len(), 2);
+        let first = fragments[0]; let next = fragments[1];
+        assert!(first.2.is_empty() && first.3.is_empty() && next.2.is_empty() && next.3.is_empty());
+        let engine = super::LayoutEngine::new(96.0);
+        engine.set_layout_profile(d.effective_layout_profile());
+        let first_height: f64 = mt.row_heights[usize::from(c.row)..first.1-1].iter().sum::<f64>()
+            + first.5.unwrap();
+        let a = engine.rowbreak_straddle_cut_units(t, c, first.0, first.1,
+            first.2, first.4, first.5, true, first_height, &mt.row_heights, &d.styles);
+        let b = engine.rowbreak_straddle_cut_units(t, c, next.0, next.1,
+            next.2, next.4, next.5, true, 0.0, &mt.row_heights, &d.styles);
+        assert_eq!(a, (0, 5)); assert_eq!(b, (5, usize::MAX));
+        assert_eq!(a.1, b.0);
