+    #[test]
+    fn rowspan173_height_only_end_requires_a_real_partial_final_band() {
+        let mut cell = Cell { row: 2, row_span: 6, ..Default::default() };
+        let rows = [17.0, 17.0, 4.0, 4.0, 4.0, 4.0, 4.0, 105.0];
+        assert!(super::height_only_rowspan_end(&cell, 8, Some(96.0), &rows));
+        for band in [None, Some(0.0), Some(-1.0), Some(105.0), Some(106.0),
+                     Some(f64::NAN), Some(f64::INFINITY)] {
+            assert!(!super::height_only_rowspan_end(&cell, 8, band, &rows));
+        }
+        assert!(!super::height_only_rowspan_end(&cell, 0, Some(1.0), &rows));
+        assert!(!super::height_only_rowspan_end(&cell, 7, Some(1.0), &rows));
+        assert!(!super::height_only_rowspan_end(&cell, 9, Some(1.0), &rows));
+        assert!(!super::height_only_rowspan_end(&cell, 8, Some(1.0), &rows[..7]));
+        cell.row_span = 1;
+        assert!(!super::height_only_rowspan_end(&cell, 3, Some(1.0), &rows));
+        cell.row_span = 6;
+        let mut bad = rows;
+        bad[7] = f64::NAN;
+        assert!(!super::height_only_rowspan_end(&cell, 8, Some(96.0), &bad));
+    }
