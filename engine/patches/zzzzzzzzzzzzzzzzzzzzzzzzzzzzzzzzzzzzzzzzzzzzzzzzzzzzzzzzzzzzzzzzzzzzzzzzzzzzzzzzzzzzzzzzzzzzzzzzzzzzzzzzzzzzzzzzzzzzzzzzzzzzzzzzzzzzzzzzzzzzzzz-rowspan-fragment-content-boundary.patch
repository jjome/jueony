+/// A fragment can end inside the final row of a spanning cell without a
+/// content-cut slot. The actual row-height override is then its ownership
+/// boundary; a full, invalid or unrelated band is not a new boundary.
+pub(super) fn height_only_rowspan_end(
+    cell: &Cell,
+    end_row: usize,
+    end_row_height_override: Option<f64>,
+    resolved_row_heights: &[f64],
+) -> bool {
+    let Some(last_row) = end_row.checked_sub(1) else { return false; };
+    let Some(cell_end) = usize::from(cell.row).checked_add(usize::from(cell.row_span)) else { return false; };
+    let Some(band) = end_row_height_override else { return false; };
+    let Some(full) = resolved_row_heights.get(last_row).copied() else { return false; };
+    cell.row_span > 1 && usize::from(cell.row) < end_row && cell_end == end_row
+        && band.is_finite() && full.is_finite() && band > 0.0 && band < full
 }
 
