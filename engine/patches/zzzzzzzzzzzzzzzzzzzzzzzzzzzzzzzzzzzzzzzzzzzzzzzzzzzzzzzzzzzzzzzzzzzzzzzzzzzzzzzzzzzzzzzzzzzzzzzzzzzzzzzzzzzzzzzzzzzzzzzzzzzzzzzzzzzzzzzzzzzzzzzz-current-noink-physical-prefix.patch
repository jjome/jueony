+//! A committed empty predecessor owns vertical flow, not an ink width.
+//! This ephemeral kind independently recomposes the physical-width empty line
+//! and proves every vertical metric against the actual selected object/commit.
+//! It supplies no row, source-cache, allocation, or serializer permission.
+use super::*;
+use crate::renderer::{composer::ComposedParagraph, selected_composition_observer127::{CurrentFitPrefix156,SelectedFormatFact},
+    style_resolver::ResolvedStyleSet};
+use crate::model::{paragraph::Paragraph,provenance::LayoutCompatibilityProfile};
+
+pub(crate) struct CurrentNoInkFitPrefix175<'a>{composition:ComposedParagraph,format:&'a SelectedFormatFact}
+impl<'a> CurrentNoInkFitPrefix175<'a>{
+ pub(crate) fn from_current(arena:&'a CurrentFitPrefix156,id:usize,p:&Paragraph,width:f64,
+  styles:&ResolvedStyleSet,profile:LayoutCompatibilityProfile,dpi:f64)->Option<Self>{
+  let f=arena.formats().get(id)?;let actual=arena.composition(id)?;
+  if f.paragraph_token!=p as *const _ as usize||f.definition_context!=styles.reset_flow_context||f.dpi!=dpi
+   ||f.profile!=format!("{profile:?}")||f.source_text!=p.text||f.source_char_offsets!=p.char_offsets
+   ||f.actual_input_width_px.is_none_or(|w|!w.is_finite()||w<=0.0)
+   ||f.before!=0.0||f.after!=0.0||f.has_numbering||f.has_horizontal_shaping||f.known_square_band
+   ||f.actual_heights.len()!=1||f.actual_spacings.len()!=1||f.lines.len()!=1{return None;}
+  let composition=fresh_vertical(p,actual,width,styles,dpi)?;
+  let line=&composition.lines[0];let selected=&f.lines[0];
+  if selected.scalar_start!=0||selected.scalar_end!=Some(0)||selected.unicode_utf16_start!=Some(0)
+   ||selected.unicode_utf16_end!=Some(0)||!selected.exact_source_text_span||selected.has_line_break||!selected.runs.is_empty()
+   ||selected.height_hu!=line.line_height||selected.baseline_hu!=line.baseline_distance
+   ||selected.spacing_hu!=line.line_spacing||selected.column_start_hu!=line.column_start
+   ||selected.width_hu!=actual.lines[0].segment_width
+   ||f.actual_heights[0]!=crate::renderer::hwpunit_to_px(line.line_height,dpi)
+   ||f.actual_spacings[0]!=crate::renderer::hwpunit_to_px(line.line_spacing,dpi){return None;}
+  Some(Self{composition,format:f})
+ }
+ pub(crate) fn into_parts(self)->(ComposedParagraph,&'a SelectedFormatFact){(self.composition,self.format)}
+}
+fn fresh_vertical(p:&Paragraph,actual:&ComposedParagraph,width:f64,styles:&ResolvedStyleSet,dpi:f64)->Option<ComposedParagraph>{
+ if !p.text.is_empty()||!p.controls.is_empty()||p.char_count!=1||!p.char_offsets.is_empty(){return None;}
+ // Retain the existing bounded plain source/style validator. Only the actual
+ // unused width is excluded below, never source rows or visible text metrics.
+ super::fresh_body_rows(p,styles,width,dpi)?;
+ let mut fresh=p.clone();super::clear_fresh_input(&mut fresh);
+ crate::renderer::composer::reflow_line_segs(&mut fresh,
+  crate::renderer::composer::ParagraphBox::body_for_style(width,styles.para_styles.get(usize::from(p.para_shape_id)),dpi),styles,dpi);
+ let current=crate::renderer::composer::compose_paragraph_in_context(&fresh,styles);
+ if !same_empty_vertical(actual,&current){return None;}Some(current)
+}
+fn same_empty_vertical(a:&ComposedParagraph,b:&ComposedParagraph)->bool{
+ fn empty(c:&ComposedParagraph)->bool{c.lines.len()==1&&c.lines[0].runs.is_empty()&&c.lines[0].char_start==0
+  &&!c.lines[0].has_line_break&&c.lines[0].segment_width>0&&c.lines[0].column_start==0
+  &&c.numbering_text.is_none()&&c.inline_controls.is_empty()&&c.tac_controls.is_empty()
+  &&c.footnote_positions.is_empty()&&c.tab_extended.is_empty()&&c.horizontal_shaping.is_none()}
+ if !empty(a)||!empty(b)||a.para_style_id!=b.para_style_id{return false;}
+ let a=&a.lines[0];let b=&b.lines[0];
+ a.line_height>0&&a.line_spacing>=0&&a.baseline_distance>=0&&a.baseline_distance<=a.line_height
+  &&a.line_height==b.line_height&&a.line_spacing==b.line_spacing&&a.baseline_distance==b.baseline_distance
+}
+#[cfg(test)]mod tests{
+ use super::*;
+ use crate::model::paragraph::CharShapeRef;
+ use crate::renderer::{composer::{reflow_line_segs,compose_paragraph_in_context,ParagraphBox,ComposedTextRun},
+ style_resolver::{ResolvedCharStyle,ResolvedParaStyle}};
+ fn fixture()->(Paragraph,ComposedParagraph,ResolvedStyleSet){
+  let styles=ResolvedStyleSet{char_styles:vec![ResolvedCharStyle::default()],para_styles:vec![ResolvedParaStyle::default()],..Default::default()};
+  let mut p=Paragraph::default();p.char_count=1;p.char_shapes=vec![CharShapeRef::default()];
+  reflow_line_segs(&mut p,ParagraphBox::body_for_style(190.0,styles.para_styles.first(),96.0),&styles,96.0);
+  let c=compose_paragraph_in_context(&p,&styles);(p,c,styles)
+ }
+ #[test]fn current_noink_fit_prefix175_unused_width_has_only_vertical_ownership(){
+  let(p,c,s)=fixture();let fresh=fresh_vertical(&p,&c,121.0,&s,96.0).unwrap();
+  assert_ne!(c.lines[0].segment_width,fresh.lines[0].segment_width);assert!(same_empty_vertical(&c,&fresh));
+ }
+ #[test]fn current_noink_fit_prefix175_rejects_ink_and_changed_vertical_metrics(){
+  let(p,c,s)=fixture();for change in 0..7{let mut bad=c.clone();let l=&mut bad.lines[0];match change{
+   0=>l.line_height+=1,1=>l.line_spacing+=1,2=>l.baseline_distance+=1,3=>l.column_start=1,
+   4=>l.has_line_break=true,5=>l.char_start=1,_=>l.runs.push(ComposedTextRun{text:"x".into(),..Default::default()})}
+   assert!(fresh_vertical(&p,&bad,121.0,&s,96.0).is_none());}
+ }
+ #[test]fn current_noink_fit_prefix175_rejects_source_style_nonfinite_and_zero_width(){
+  let(mut p,c,mut s)=fixture();p.text="x".into();assert!(fresh_vertical(&p,&c,121.0,&s,96.0).is_none());p.text.clear();
+  for width in [f64::NAN,f64::INFINITY,0.0,-1.0]{assert!(fresh_vertical(&p,&c,width,&s,96.0).is_none());}
+  s.char_styles[0].font_size+=1.0;assert!(fresh_vertical(&p,&c,121.0,&s,96.0).is_none());
+ }
+}
