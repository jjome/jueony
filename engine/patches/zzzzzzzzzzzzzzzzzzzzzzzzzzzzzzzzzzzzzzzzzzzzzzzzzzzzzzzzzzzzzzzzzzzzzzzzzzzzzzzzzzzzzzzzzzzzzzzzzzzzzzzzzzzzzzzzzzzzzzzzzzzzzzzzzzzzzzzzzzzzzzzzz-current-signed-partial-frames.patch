+//! Immutable source-free replay view. This exposes neither a row factory nor
+//! the positive-offset middle/tail export capability. Signed callers must own
+//! every actual host and physical row before assembling an output plan.
+use super::*;
+#[derive(Clone)]
+pub(crate) struct SignedTailFragment177{
+ pub(crate) page:u32,pub(crate) column:u16,pub(crate) item:usize,
+ pub(crate) start:usize,pub(crate) end:usize,pub(crate) rect:LayoutRect,
+ pub(crate) flow_before:f64,pub(crate) flow_after:f64,
+ pub(crate) source_start:usize,pub(crate) source_end:usize,pub(crate) input_width:f64,
+}
+pub(crate) struct CurrentFreshTailReplayView177<'doc,'core>{
+ source:&'doc Document,
+ trace:Arc<FinalizedSelectedCompositionTrace>,
+ tail:super::tail148::CurrentUnequalTail<'doc,'core>,
+ fragments:Vec<SignedTailFragment177>,
+}
+impl<'doc,'core> CurrentFreshTailReplayView177<'doc,'core>{
+ pub(crate) fn from_current(source:&'doc Document,result:&PaginationResult,styles:&ResolvedStyleSet,
+ profile:LayoutCompatibilityProfile,dpi:f64,measurements:&'core [crate::renderer::height_measurer::MeasuredTable])->Option<Self>{
+  if source.sections.len()!=1||dpi!=crate::renderer::DEFAULT_DPI{return None;}
+  let trace=result.selected_composition_trace.as_ref()?;
+  if trace.resource()!=crate::model::native_computed_resource::RESOURCE
+   ||!trace.matches_source(&source.sections[0].paragraphs,styles.reset_flow_context,profile,dpi)
+   ||!trace.matches_finalized_result(result){return None;}
+  let tail=super::tail148::CurrentUnequalTail::from_current(source,result,styles,dpi,measurements)?;
+  let fragments=tail.fragments.iter().map(|f|SignedTailFragment177{page:f.page,column:f.column,item:f.item,start:f.start,end:f.end,rect:f.rect,flow_before:f.flow_before,flow_after:f.flow_after,source_start:f.source_start,source_end:f.source_end,input_width:f.input_width}).collect();
+  Some(Self{source,trace:Arc::clone(trace),tail,fragments})
+ }
+ pub(crate) fn matches_current(&self,source:&Document,result:&PaginationResult,styles:&ResolvedStyleSet,profile:LayoutCompatibilityProfile,dpi:f64)->bool{
+  std::ptr::eq(source,self.source)&&dpi==crate::renderer::DEFAULT_DPI
+   &&result.selected_composition_trace.as_ref().is_some_and(|t|Arc::ptr_eq(t,&self.trace))
+   &&self.trace.resource()==crate::model::native_computed_resource::RESOURCE
+   &&self.trace.matches_source(&source.sections[0].paragraphs,styles.reset_flow_context,profile,dpi)
+   &&self.trace.matches_finalized_result(result)
+ }
+ pub(crate) fn index(&self)->usize{self.tail.index}
+ pub(crate) fn composition(&self)->&ComposedParagraph{&self.tail.composition}
+ pub(crate) fn canonical_rows(&self)->&[LineSeg]{&self.tail.canonical}
+ pub(crate) fn source_lines(&self)->&[usize]{&self.tail.source_lines}
+ pub(crate) fn fragments(&self)->&[SignedTailFragment177]{&self.fragments}
+ pub(crate) fn generation(&self)->u64{self.trace.generation()}
+}
