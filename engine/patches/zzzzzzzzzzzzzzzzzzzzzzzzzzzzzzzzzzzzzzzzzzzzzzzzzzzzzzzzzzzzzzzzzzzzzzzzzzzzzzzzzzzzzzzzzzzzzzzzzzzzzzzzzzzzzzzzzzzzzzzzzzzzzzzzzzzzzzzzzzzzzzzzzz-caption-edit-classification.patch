+#[cfg(test)]
+mod caption_edit_story178 {
+    use crate::{DocumentCore, model::control::Control};
+    fn core()->DocumentCore { DocumentCore::from_bytes(include_bytes!("../../../tests/fixtures/caption-boundary178.hwp")).unwrap() }
+    fn table(d:&DocumentCore)->&crate::model::table::Table { let Control::Table(t)=&d.document.sections[0].paragraphs[1].controls[0]else{panic!()};t }
+    fn registered(d:&DocumentCore)->bool { d.render_normalization.text_reflowed_tables.contains(&crate::document_core::TableTextReflowKey::from_table(table(d))) }
+    #[test] fn caption178_edit_reflows_caption_and_remeasures_without_cell_reflow_permission(){
+        let mut d=core();let cells=format!("{:?}",table(&d).cells);let old=d.measured_tables[0][0].caption_height;
+        assert!(!registered(&d));let n=table(&d).caption.as_ref().unwrap().paragraphs[0].text.chars().count();
+        d.insert_text_in_cell_native(0,1,0,65534,0,n,"Actual cell 🪶 ").unwrap();
+        assert!(!registered(&d));assert_eq!(format!("{:?}",table(&d).cells),cells);
+        assert!(d.measured_tables[0][0].caption_height>old);assert_eq!(d.page_count(),2);
+        let p=&table(&d).caption.as_ref().unwrap().paragraphs[0];assert!(p.text.ends_with("Actual cell 🪶 "));assert_eq!(p.line_segs.len(),4);
+    }
+    #[test] fn caption178_delete_does_not_register_cell_reflow(){
+        let mut d=core();let cells=format!("{:?}",table(&d).cells);let p=&table(&d).caption.as_ref().unwrap().paragraphs[0];let n=p.text.chars().count();
+        d.delete_text_in_cell_native(0,1,0,65534,0,n-1,1).unwrap();
+        assert!(!registered(&d));assert_eq!(format!("{:?}",table(&d).cells),cells);
+    }
+    #[test] fn caption178_does_not_clear_preexisting_real_cell_reflow(){
+        let mut d=core();d.insert_text_in_cell_native(0,1,0,0,0,0,"Real cell edit ").unwrap();assert!(registered(&d));
+        let original=crate::document_core::TableTextReflowKey::from_table(table(&d));let n=table(&d).caption.as_ref().unwrap().paragraphs[0].text.chars().count();
+        d.insert_text_in_cell_native(0,1,0,65534,0,n,"Caption after real edit ").unwrap();
+        assert!(registered(&d));assert!(d.render_normalization.text_reflowed_tables.contains(&original));
+        d.delete_text_in_cell_native(0,1,0,65534,0,n,1).unwrap();assert!(registered(&d));
+    }
