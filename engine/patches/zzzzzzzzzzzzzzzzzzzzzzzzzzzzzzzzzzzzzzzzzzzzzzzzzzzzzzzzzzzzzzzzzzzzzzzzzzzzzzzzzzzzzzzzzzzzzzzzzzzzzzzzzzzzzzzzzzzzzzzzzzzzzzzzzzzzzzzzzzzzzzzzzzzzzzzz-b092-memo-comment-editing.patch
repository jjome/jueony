+fn validate_memo_input(text: &str, author: &str) -> Result<(), HwpError> {
+    let text_units = text.encode_utf16().count();
+    if text_units == 0 || text_units > 4000 || text.chars().any(char::is_control) {
+        return Err(HwpError::InvalidField(
+            "메모 본문은 제어 문자 없이 UTF-16 1~4000자여야 합니다.".into(),
+        ));
+    }
+    let author_len = author.chars().count();
+    if author_len == 0
+        || author_len > 128
+        || author
+            .chars()
+            .any(|ch| ch.is_control() || matches!(ch, '/' | '\\' | ';'))
+    {
+        return Err(HwpError::InvalidField(
+            "메모 작성자는 1~128자이며 '/', '\\', ';' 또는 제어 문자를 포함할 수 없습니다."
+                .into(),
+        ));
+    }
+    Ok(())
+}
+
+fn memo_author(command: &str) -> Option<&str> {
+    let mut parts = command.split('/');
+    if parts.next()? != "MEMO" {
+        return None;
+    }
+    parts.nth(4)
+}
