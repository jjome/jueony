+fn insert_memo_field_in_para(
+    para: &mut Paragraph,
+    char_offset: usize,
+    field_id: u32,
+    memo_index: u32,
+    text: &str,
+    author: &str,
+) -> Result<usize, HwpError> {
+    let host_para_shape = para.para_shape_id;
+    let host_style = para.style_id;
+    let host_char_shape = para
+        .char_shapes
+        .iter()
+        .filter(|shape| shape.start_pos as usize <= char_offset)
+        .last()
+        .map(|shape| shape.char_shape_id)
+        .unwrap_or(0);
+    let start = insert_click_here_field_in_para(para, char_offset, field_id, "", "", "", false)?;
+
+    let mut utf16_offset = 0u32;
+    let char_offsets = text
+        .chars()
+        .map(|ch| {
+            let current = utf16_offset;
+            utf16_offset += ch.len_utf16() as u32;
+            current
+        })
+        .collect();
+    let memo_para = Paragraph {
+        char_count: utf16_offset + 1,
+        para_shape_id: host_para_shape,
+        style_id: host_style,
+        text: text.to_string(),
+        char_offsets,
+        char_shapes: vec![CharShapeRef { start_pos: 0, char_shape_id: host_char_shape }],
+        has_para_text: true,
+        ..Default::default()
+    };
+    let field = para.controls.iter_mut().find_map(|control| match control {
+        Control::Field(field) if field.field_id == field_id => Some(field),
+        _ => None,
+    }).ok_or_else(|| HwpError::InvalidField("삽입한 메모 필드를 찾을 수 없습니다.".into()))?;
+    *field = Field {
+        field_type: FieldType::Memo,
+        command: format!("MEMO/65535/{}/{}/{}/{}/\\;;", memo_index, field_id, field_id, author),
+        properties: 0,
+        extra_properties: 0,
+        field_id,
+        ctrl_id: tags::FIELD_MEMO,
+        instance_id: Some(field_id),
+        memo_index,
+        memo_paragraphs: vec![memo_para],
+        memo_text_direction: Some("HORIZONTAL".to_string()),
+        ..Default::default()
+    };
+    Ok(start)
+}
