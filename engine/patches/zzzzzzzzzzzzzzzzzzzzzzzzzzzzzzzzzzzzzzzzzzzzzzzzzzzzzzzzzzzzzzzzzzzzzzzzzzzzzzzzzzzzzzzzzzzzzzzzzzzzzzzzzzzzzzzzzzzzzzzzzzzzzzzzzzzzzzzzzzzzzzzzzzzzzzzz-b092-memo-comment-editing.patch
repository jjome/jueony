+fn remove_point_memo_in_para(para: &mut Paragraph, field_id: u32) -> Result<usize, HwpError> {
+    let control_idx = para.controls.iter().position(|control| {
+        matches!(control, Control::Field(field)
+            if field.field_type == FieldType::Memo && field.field_id == field_id)
+    }).ok_or_else(|| HwpError::InvalidField("메모 필드를 찾을 수 없습니다.".into()))?;
+    let range_idx = para.field_ranges.iter().position(|range| range.control_idx == control_idx)
+        .ok_or_else(invalid_raw_slots)?;
+    let start = para.field_ranges[range_idx].start_char_idx;
+    let end = para.field_ranges[range_idx].end_char_idx;
+    if start != end {
+        return Err(HwpError::InvalidField(
+            "범위 메모 삭제는 본문 보존 실측 전까지 지원하지 않습니다.".into(),
+        ));
+    }
+    let gaps = raw_slot_gaps(para)?;
+    let merged = gaps[start].1.saturating_sub(gaps[start].0);
+    if merged < 16 {
+        return Err(invalid_raw_slots());
+    }
+    let para_end = gaps[gaps.len() - 1].1.checked_sub(16).ok_or_else(invalid_raw_slots)?;
+    para.field_ranges.remove(range_idx);
+    let slots = gaps[start].0 + merged - 16;
+    let shift = |position: &mut u32| {
+        if *position > slots {
+            *position = position.saturating_sub(16).max(slots);
+        }
+    };
+    for position in &mut para.char_offsets {
+        shift(position);
+    }
+    for shape in &mut para.char_shapes {
+        shift(&mut shape.start_pos);
+    }
+    for range in &mut para.range_tags {
+        shift(&mut range.start);
+        shift(&mut range.end);
+    }
+    for mark in &mut para.markpen_marks {
+        if let Some(position) = &mut mark.utf16_pos {
+            shift(position);
+        }
+    }
+    para.char_count = para_end + 1;
+    let shapes = std::mem::take(&mut para.char_shapes);
+    for shape in shapes {
+        if para.char_shapes.last().is_some_and(|last| last.start_pos == shape.start_pos) {
+            para.char_shapes.pop();
+        }
+        para.char_shapes.push(shape);
+    }
+    para.invalidate_layout_inputs();
+    para.controls.remove(control_idx);
+    if control_idx < para.ctrl_data_records.len() {
+        para.ctrl_data_records.remove(control_idx);
+    }
+    for range in &mut para.field_ranges {
+        if range.control_idx > control_idx {
+            range.control_idx -= 1;
+        }
+    }
+    Ok(control_idx)
+}
