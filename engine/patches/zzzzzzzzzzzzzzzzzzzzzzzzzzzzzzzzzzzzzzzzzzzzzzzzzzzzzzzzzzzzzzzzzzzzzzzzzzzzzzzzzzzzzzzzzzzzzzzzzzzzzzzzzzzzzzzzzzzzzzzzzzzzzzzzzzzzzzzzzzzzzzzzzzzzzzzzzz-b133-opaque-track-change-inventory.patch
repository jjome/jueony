+    /// B133: HWP5 DocInfo에 원시 보존된 변경 추적 레코드의 제한된 목록을 반환한다.
+    ///
+    /// +80/+81 레코드는 형식 문서에 이름만 있고 payload 의미가 공개 모델에 구현되지
+    /// 않았다. 따라서 이 API는 본문 변경 수나 수락/거절 가능성을 주장하지 않고,
+    /// HWP5에서 실제로 보존 중인 레코드의 종류·크기만 최대 64개 노출한다.
+    #[wasm_bindgen(js_name = getDocumentTrackChangeInventoryB133)]
+    pub fn get_document_track_change_inventory_b133(&self, max_records: u32) -> String {
+        const TRACK_CHANGE_RECORD: u16 = crate::parser::tags::HWPTAG_BEGIN + 80;
+        const TRACK_CHANGE_AUTHOR: u16 = crate::parser::tags::HWPTAG_BEGIN + 81;
+        const MAX_RECORDS: usize = 64;
+
+        let format = match self.core.source_format {
+            crate::parser::FileFormat::Hwp => "hwp",
+            crate::parser::FileFormat::Hwpx => "hwpx",
+            crate::parser::FileFormat::Hwp3 => "hwp3",
+            crate::parser::FileFormat::Hml => "hml",
+            _ => "unsupported",
+        };
+        let eligible = self.core.source_format == crate::parser::FileFormat::Hwp;
+        let limit = usize::try_from(max_records)
+            .unwrap_or(usize::MAX)
+            .min(MAX_RECORDS);
+        let info = &self.core.document.doc_info;
+        let change_count = eligible
+            .then(|| {
+                info.extra_records
+                    .iter()
+                    .filter(|record| record.tag_id == TRACK_CHANGE_RECORD)
+                    .count()
+            })
+            .unwrap_or(0);
+        let author_count = eligible
+            .then(|| {
+                info.extra_records
+                    .iter()
+                    .filter(|record| record.tag_id == TRACK_CHANGE_AUTHOR)
+                    .count()
+            })
+            .unwrap_or(0);
+        let total = change_count.saturating_add(author_count);
+        let records = eligible
+            .then(|| {
+                info.extra_records
+                    .iter()
+                    .filter(|record| {
+                        matches!(record.tag_id, TRACK_CHANGE_RECORD | TRACK_CHANGE_AUTHOR)
+                    })
+                    .take(limit)
+                    .enumerate()
+                    .map(|(ordinal, record)| serde_json::json!({
+                        "kind": if record.tag_id == TRACK_CHANGE_RECORD { "change" } else { "author" },
+                        "tagId": record.tag_id,
+                        "ordinal": ordinal,
+                        "level": record.level,
+                        "byteLength": record.data.len(),
+                    }))
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        let config_flags = eligible.then(|| {
+            info.extra_records
+                .iter()
+                .find(|record| record.tag_id == crate::parser::tags::HWPTAG_TRACKCHANGE)
+                .and_then(|record| record.data.get(..4))
+                .map(|bytes| u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]))
+        }).flatten();
+
+        serde_json::json!({
+            "contract": "jueony-document-track-change-opaque-inventory",
+            "version": 1,
+            "source": "hwp-docinfo-opaque-records",
+            "format": format,
+            "coverage": if eligible { "hwp-docinfo-only" } else { "unsupported-source-format" },
+            "headerDeclaresTrackedChanges": eligible.then_some(
+                self.core.document.header.flags & (1 << 14) != 0
+            ),
+            "configFlags": config_flags,
+            "opaqueChangeRecordCount": change_count,
+            "opaqueAuthorRecordCount": author_count,
+            "recordLimit": limit,
+            "returnedRecordCount": records.len(),
+            "truncated": total > limit,
+            "semanticChangesAvailable": false,
+            "acceptRejectAvailable": false,
+            "records": records,
+        }).to_string()
+    }
+
