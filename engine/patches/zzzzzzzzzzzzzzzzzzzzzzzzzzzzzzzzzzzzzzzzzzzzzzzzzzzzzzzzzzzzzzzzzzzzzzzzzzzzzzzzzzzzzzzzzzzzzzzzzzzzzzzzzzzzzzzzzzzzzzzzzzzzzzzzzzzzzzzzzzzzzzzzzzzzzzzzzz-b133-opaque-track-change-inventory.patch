+use rhwp::wasm_api::HwpDocument;
+use serde_json::Value;
+
+fn inventory(doc: &HwpDocument, limit: u32) -> Value {
+    serde_json::from_str(&doc.get_document_track_change_inventory_b133(limit))
+        .expect("B133 inventory JSON")
+}
+
+#[test]
+fn blank_hwp_inventory_stays_read_only_across_hwp_and_hwpx_reopen() {
+    let doc = HwpDocument::from_bytes(include_bytes!("../saved/blank2010.hwp"))
+        .expect("bundled blank HWP opens");
+    let before = inventory(&doc, 64);
+    assert_eq!(before["contract"], "jueony-document-track-change-opaque-inventory");
+    assert_eq!(before["format"], "hwp");
+    assert_eq!(before["coverage"], "hwp-docinfo-only");
+    assert_eq!(before["opaqueChangeRecordCount"], 0);
+    assert_eq!(before["opaqueAuthorRecordCount"], 0);
+    assert_eq!(before["semanticChangesAvailable"], false);
+    assert_eq!(before["acceptRejectAvailable"], false);
+
+    let hwp = doc.export_hwp_native().expect("HWP save");
+    let reopened_hwp = HwpDocument::from_bytes(&hwp).expect("HWP reopen");
+    let after_hwp = inventory(&reopened_hwp, 64);
+    assert_eq!(after_hwp["format"], "hwp");
+    assert_eq!(after_hwp["opaqueChangeRecordCount"], 0);
+    assert_eq!(after_hwp["opaqueAuthorRecordCount"], 0);
+    assert_eq!(after_hwp["semanticChangesAvailable"], false);
+    assert_eq!(after_hwp["acceptRejectAvailable"], false);
+
+    let hwpx = doc.export_hwpx_native().expect("HWPX save");
+    let reopened_hwpx = HwpDocument::from_bytes(&hwpx).expect("HWPX reopen");
+    let after_hwpx = inventory(&reopened_hwpx, 64);
+    assert_eq!(after_hwpx["format"], "hwpx");
+    assert_eq!(after_hwpx["coverage"], "unsupported-source-format");
+    assert_eq!(after_hwpx["headerDeclaresTrackedChanges"], Value::Null);
+    assert_eq!(after_hwpx["configFlags"], Value::Null);
+    assert_eq!(after_hwpx["opaqueChangeRecordCount"], 0);
+    assert_eq!(after_hwpx["opaqueAuthorRecordCount"], 0);
+    assert_eq!(after_hwpx["returnedRecordCount"], 0);
+    assert_eq!(after_hwpx["records"], serde_json::json!([]));
+    assert_eq!(after_hwpx["acceptRejectAvailable"], false);
+}
