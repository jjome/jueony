+#[test]
+fn b133_opaque_track_change_inventory_is_bounded_and_roundtrips_hwp_only() {
+    use crate::model::document::RawRecord;
+
+    const CONFIG: u16 = crate::parser::tags::HWPTAG_TRACKCHANGE;
+    const CHANGE: u16 = crate::parser::tags::HWPTAG_BEGIN + 80;
+    const AUTHOR: u16 = crate::parser::tags::HWPTAG_BEGIN + 81;
+
+    let mut doc = HwpDocument::create_empty();
+    doc.core.document.header.flags |= 1 << 14;
+    doc.core.document.doc_info.extra_records.push(RawRecord {
+        tag_id: CONFIG,
+        level: 1,
+        data: 56_u32.to_le_bytes().to_vec(),
+    });
+    for index in 0..70 {
+        doc.core.document.doc_info.extra_records.push(RawRecord {
+            tag_id: CHANGE,
+            level: 1,
+            data: vec![index as u8; 8],
+        });
+    }
+    for _ in 0..2 {
+        doc.core.document.doc_info.extra_records.push(RawRecord {
+            tag_id: AUTHOR,
+            level: 1,
+            data: vec![0; 4],
+        });
+    }
+
+    let value: Value =
+        serde_json::from_str(&doc.get_document_track_change_inventory_b133(100)).unwrap();
+    assert_eq!(value["format"], "hwp");
+    assert_eq!(value["headerDeclaresTrackedChanges"], true);
+    assert_eq!(value["configFlags"], 56);
+    assert_eq!(value["opaqueChangeRecordCount"], 70);
+    assert_eq!(value["opaqueAuthorRecordCount"], 2);
+    assert_eq!(value["recordLimit"], 64);
+    assert_eq!(value["returnedRecordCount"], 64);
+    assert_eq!(value["truncated"], true);
+    assert_eq!(value["semanticChangesAvailable"], false);
+    assert_eq!(value["acceptRejectAvailable"], false);
+
+    let hwp = doc.export_hwp_native().expect("B133 HWP save");
+    let reopened = HwpDocument::from_bytes(&hwp).expect("B133 HWP reopen");
+    let reopened_value: Value = serde_json::from_str(
+        &reopened.get_document_track_change_inventory_b133(4)
+    ).unwrap();
+    assert_eq!(reopened_value["opaqueChangeRecordCount"], 70);
+    assert_eq!(reopened_value["opaqueAuthorRecordCount"], 2);
+    assert_eq!(reopened_value["returnedRecordCount"], 4);
+
+    let hwpx = doc.export_hwpx_native().expect("B133 HWPX save");
+    let reopened_hwpx = HwpDocument::from_bytes(&hwpx).expect("B133 HWPX reopen");
+    let hwpx_value: Value = serde_json::from_str(
+        &reopened_hwpx.get_document_track_change_inventory_b133(4)
+    ).unwrap();
+    assert_eq!(hwpx_value["format"], "hwpx");
+    assert_eq!(hwpx_value["coverage"], "unsupported-source-format");
+    assert_eq!(hwpx_value["opaqueChangeRecordCount"], 0);
+    assert_eq!(hwpx_value["opaqueAuthorRecordCount"], 0);
+    assert_eq!(hwpx_value["records"].as_array().unwrap().len(), 0);
+}
