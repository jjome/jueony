+
+/// An edited native whole-table host can store its outer-box origin while the
+/// layout pen already points at the visible table top. Require both boundaries
+/// to agree with the current frame before suppressing the XML paint inset.
+fn reflowed_table_outer_top_consumed(
+    host: &Paragraph,
+    next: Option<&Paragraph>,
+    table: &crate::model::table::Table,
+    flow_y: f64,
+    col_area: &LayoutRect,
+    dpi: f64,
+) -> bool {
+    use crate::model::paragraph::{ColumnBreakType, LineSeg};
+    let ([Control::Table(_)], [row]) = (host.controls.as_slice(), host.line_segs.as_slice())
+    else {
+        return false;
+    };
+    let Some(next_row) = next
+        .filter(|next| next.controls.is_empty() && next.column_type == ColumnBreakType::None)
+        .and_then(|next| next.line_segs.first())
+    else {
+        return false;
+    };
+    let top = i64::from(table.outer_margin_top);
+    let height = i64::from(signed_hwpunit(table.common.height));
+    let pen = flow_y - col_area.y;
+    if row.tag != (LineSeg::TAG_SINGLE_SEGMENT_LINE | LineSeg::TAG_IMPLEMENTATION_PROPERTY)
+        || row.text_start != 0
+        || row.vertical_pos <= 0
+        || row.segment_width <= 0
+        || row.line_height <= 0
+        || row.line_height != row.text_height
+        || host.column_type != ColumnBreakType::None
+        || table.caption.is_some()
+        || signed_hwpunit(table.common.vertical_offset) != 0
+        || top == 0
+        || height <= 0
+        || !pen.is_finite()
+        || pen <= 0.0
+        || pen + hwpunit_to_px(height as i32, dpi) > col_area.height
+    {
+        return false;
+    }
+    let pen = i64::from(px_to_hwpunit(pen, dpi));
+    i64::from(row.vertical_pos) + top == pen
+        && i64::from(next_row.vertical_pos) == pen + height
 }
 
